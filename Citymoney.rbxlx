planViewport.LightDirection,planViewport.BorderSizePixel,planViewport.Parent=Vector3.new(-1,-2,-1),0,chooserCard;round(planViewport,12)
local planWorld=Instance.new("WorldModel");planWorld.Parent=planViewport
local planCamera=Instance.new("Camera");planCamera.FieldOfView,planCamera.Parent=34,planViewport;planViewport.CurrentCamera=planCamera
local planDescription=text(chooserCard,"",24,270,472,30,12,C.muted)
local planCards={}
for level=0,Config.maxLevel do
    local x,y=24+(level%2)*242,309+math.floor(level/2)*76
    local option=button(chooserCard,"",x,y,230,66,C.paper,function()
        if not planPending then planLevel=level;planError=nil;renderPlans() end
    end)
    local border=Instance.new("UIStroke");border.Color,border.Transparency,border.Parent=C.line,0.1,option
    local name=text(option,"",12,5,208,21,14,C.ink,true)
    local price=text(option,"",12,28,208,18,12,C.muted)
    local status=text(option,"",12,47,208,14,10,C.muted)
    planCards[level+1]={ button=option, border=border, name=name, price=price, status=status }
end
local planTotal=text(chooserCard,"",24,469,472,26,18,C.ink,true)
local planBalance=text(chooserCard,"",24,499,472,22,13,C.green)
local planNote=text(chooserCard,"",24,526,472,25,11,C.muted)
local confirmPlan=button(chooserCard,"Confirm",24,564,332,40,C.green,function()
    if planPending or not data then return end
    local options=Plans.options(Config,data.game,player.UserId,planIndex,planMode)
    local option=options[(planLevel or -1)+1]
    if not option or not option.affordable then return end
    local command=planMode=="buy" and "Buy" or (planMode=="rent" and "SetRent" or "Upgrade")
    if send(command,planIndex,planMode=="rent" and planLevel+1 or planLevel,planTurn) then
        planPending=true;planError=nil;renderPlans()
        planRequestId=planRequestId+1
        local requestId=planRequestId
        task.delay(4,function()
            if requestId==planRequestId and planPending and chooser.Visible then
                planPending=false
                planError="No confirmation yet. Check the refreshed details before retrying."
                action:FireServer("Sync")
                renderPlans()
            end
        end)
    end
end)
local cancelPlan=button(chooserCard,"Back",368,564,128,40,C.paper,function() if not planPending then chooser.Visible=false end end)
local highlight=Instance.new("Highlight")
highlight.Name,highlight.FillColor,highlight.OutlineColor="SelectedAddress",C.gold,C.green
highlight.FillTransparency,highlight.OutlineTransparency,highlight.Parent=0.94,0.1,workspace
local function resident(state,id)
    for _, value in ipairs(state.players) do if value.id==id then return value end end
    return nil
end
local function pair(state,id,group)
    for index,tile in ipairs(Config.tiles) do if tile.group==group and state.properties[index].ownerId~=id then return false end end
    return true
end
local function rent(state,index)
    local property=state.properties[index]
    return Plans.projectedRent(Config,state,property.ownerId,index,property.level)
end
local function worth(state,person)
    local total=person.cash
    for index,property in ipairs(state.properties) do
        if property.ownerId==person.id then total=total+Plans.investment(Config,index,property.level,property.rentTier) end
    end
    return total
end
local previewKey
local function styleFor(id)
    for _,entry in ipairs(data and data.styles or {}) do if entry.id==id then return entry.styleId end end
    return "classic"
end
local function fillPreview(world,camera,index,owner,property,level)
    world:ClearAllChildren()
    local model=Scene.model(Architecture.property(Config,index,owner and owner.name or "Your next home",owner and Config.playerColors[owner.colorIndex] or "D4AF84",level,property.paint or 0,property,styleFor(owner and owner.id or player.UserId)),"Preview",world,true)
    local cf,size=model:GetBoundingBox()
    local target=cf.Position+Vector3.new(0,1,0)
    local _,yaw=Architecture.site(index)
    local x,z=22,-29
    camera.CFrame=CFrame.lookAt(target+Vector3.new(math.cos(yaw)*x+math.sin(yaw)*z,20+size.Y*0.3,-math.sin(yaw)*x+math.cos(yaw)*z),target)
end
local function propertyPreview(index,owner,property)
    local key=index..":"..tostring(property.ownerId)..":"..property.level..":"..(property.paint or 0)..":"..tostring(property.shield)..":"..(property.boost or 0)..":"..(property.rentTier or 1)..":"..styleFor(owner and owner.id or player.UserId)
    if previewKey==key then return end
    previewKey=key
    fillPreview(viewWorld,viewCamera,index,owner,property,property.level)
end
local homeNames=Config.homeNames
renderPlans=function()
    if not chooser.Visible or not data or not planIndex then return end
    local state=data.game
    local current=state.players[state.turn]
    local property=state.properties[planIndex]
    local valid=state.status=="playing" and state.turnCount==planTurn and current and current.id==player.UserId and current.alive
    if planMode=="buy" then valid=valid and state.phase=="buy" and state.pendingTile==planIndex and not property.ownerId
    else valid=valid and property.ownerId==player.UserId end
    if not valid then chooser.Visible=false;planPending=false;return end
    local mine=resident(state,player.UserId)
    local options=Plans.options(Config,state,player.UserId,planIndex,planMode)
    local chosen=options[planLevel+1]
    if not chosen then chooser.Visible=false;return end
    chooserTitle.Text=planMode=="buy" and "Choose your home level" or (planMode=="rent" and "Choose a rent multiplier" or "Choose your upgrade")
    chooserSubtitle.Text=Config.tiles[planIndex].name.." · $"..mine.cash.." available"..(planMode=="buy" and " · Land included" or (planMode=="rent" and (" · Current "..Config.rentTiers[property.rentTier or 1].."×") or (" · Current L"..property.level)))
    for _,option in ipairs(options) do
        local row=planCards[option.level+1]
        local active=option.level==planLevel
        row.button.BackgroundColor3=active and C.mint or C.paper
        row.border.Color,row.border.Thickness=active and C.green or C.line,active and 2 or 1
        row.name.Text=planMode=="rent" and option.name or ("L"..option.level.." · "..option.name)
        row.price.Text=(option.available and ("$"..option.cost..(planMode=="buy" and " total" or (planMode=="rent" and " fee" or " to upgrade"))) or "Included already").." · $"..option.rent.." rent"
        row.status.Text=option.current and (planMode=="rent" and "CURRENT RATE" or "YOUR CURRENT HOME") or (not option.available and "CHOOSE A HIGHER OPTION" or (option.affordable and (active and "SELECTED" or "TAP TO PREVIEW") or ("Need $"..(-option.remaining).." more")))
        row.status.TextColor3=option.available and not option.affordable and C.red or C.muted
        row.button.Active=not planPending
    end
    local shownLevel=planMode=="rent" and property.level or planLevel
    local key=planIndex..":"..shownLevel..":"..(property.paint or 0)..":"..mine.colorIndex..":"..(property.rentTier or 1)..":"..planLevel..":"..styleFor(player.UserId)
    if key~=planPreviewKey then
        local preview=table.clone(property)
        if planMode=="rent" then preview.rentTier=planLevel+1 end
        planPreviewKey=key;fillPreview(planWorld,planCamera,planIndex,mine,preview,shownLevel)
    end
    planDescription.Text=chosen.description
    local currentRent=planMode~="buy" and rent(state,planIndex) or 0
    planTotal.Text=chosen.available and ((planMode=="buy" and "Total price: $" or (planMode=="rent" and "Rental fee: $" or "Upgrade cost: $"))..chosen.cost.."   ·   Rent $"..currentRent.." → $"..chosen.rent) or "Choose a higher option. Your current one is included."
    planBalance.Text=chosen.available and (chosen.affordable and ("Balance after: $"..chosen.remaining) or ("Need $"..(-chosen.remaining).." more. Choose a lower option, or go back.")) or "Your current investment is already included."
    planBalance.TextColor3=chosen.available and not chosen.affordable and C.red or C.green
    planNote.Text=planError or (planMode=="rent" and "The multiplier stays on this property for future payments." or ("No district pair required. "..(planMode=="buy" and "Land + all selected building levels are included." or "You pay only for the levels you add.")))
    planNote.TextColor3=planError and C.red or C.muted
    local enabled=chosen.affordable and not planPending and not rolling
    confirmPlan.Text=planPending and "Confirming your selection…" or (rolling and "Dice are rolling…" or (chosen.available and ((planMode=="buy" and "Buy " or (planMode=="rent" and "Set " or "Upgrade to "))..chosen.name.." · $"..chosen.cost) or "Choose a higher option"))
    available(confirmPlan,enabled,C.green)
    available(cancelPlan,not planPending,C.paper)
    available(closeChooser,not planPending,C.paper)
end
openPlans=function(mode,index)
    if not data then return end
    if planIndex~=index or planMode~=mode or planTurn~=data.game.turnCount then
        planLevel=mode=="buy" and 0 or (mode=="rent" and math.min(#Config.rentTiers-1,data.game.properties[index].rentTier or 1) or math.min(Config.maxLevel,data.game.properties[index].level+1))
    end
    planIndex,planMode,planTurn,planPending,planError=index,mode,data.game.turnCount,false,nil
    chooser.Visible=true;help.Visible=false;sale.Visible=false
    renderPlans()
end
mainAction=function()
    if mainCommand=="Buy" and data then openPlans("buy",data.game.pendingTile)
    elseif mainCommand=="Plaza" then openCity("festival")
    elseif mainCommand=="Match" and menus then menus:openLobby()
    elseif mainCommand=="Ready" and menus then menus:toggleReady()
    elseif mainCommand then send(mainCommand) end
end
do
    local ui={config=Config,colors=C,root=root,id=player.UserId,frame=frame,text=text,button=button,overlay=overlay,available=available,send=send,notify=notify,data=function() return data end,rent=rent,
        header=header,mark=mark,strap=strap,dieA=dieA,dieB=dieB,dieTextA=dieTextA,dieTextB=dieTextB,cameraBar=cameraBar,
        focus=function(index) selected,focusIndex,inspectorOpen,portfolioOpen=index,nil,true,false;render() end,
        openGoals=function() menus.lobby.Visible=false;menus.actions.Visible=true;boutique.shade.Visible=false;menus:render(data) end,
        openStyles=function() menus.lobby.Visible=false;menus.actions.Visible=false;help.Visible=false;boutique:open() end}
    menus=Menus.new(ui);boutique=Boutique.new(ui);city=CityPlaza.new(ui)
    openCity=function(tab) menus.lobby.Visible=false;menus.actions.Visible=false;boutique.shade.Visible=false;city:open(tab) end
    boardView.onProperty=function(index) selected,inspectorOpen,portfolioOpen=index,true,false;render() end
    boardView.onInteraction=function(tab) openCity(tab) end
end
render=function()
    if not data then return end
    local state=data.game
    local current=state.players[state.turn]
    local mine=resident(state,player.UserId)
    local myTurn=state.status=="playing" and current and current.id==player.UserId and current.alive
    local isHost=data.hostId==player.UserId
    visitIndex=nil
    for _, visitor in ipairs(data.visitors or {}) do if visitor.id==player.UserId then visitIndex=visitor.tile end end
    if sale.Visible and (not myTurn or state.turnCount~=saleTurn) then sale.Visible=false end
    cashLabel.Text=mine and ("$"..mine.cash) or "$1,500"
    worthLabel.Text=mine and ("NET WORTH  $"..worth(state,mine)) or "YOUR STARTING BALANCE"
    local count=0
    for _,property in ipairs(state.properties) do if property.ownerId==player.UserId then count=count+1 end end
    homesButton.Text="Your homes  ·  "..count
    seats:ClearAllChildren()
    local entries=state.status=="lobby" and data.lobby or state.players
    for seat,entry in ipairs(entries) do
        local row=frame(seats,0,(seat-1)*39,168,34,(current and state.status=="playing" and current.id==entry.id) and C.mint or C.card)
        local tint=Color3.fromHex(Config.playerColors[entry.colorIndex or seat] or "DCC098")
        local dot=frame(row,9,13,13,13,tint);round(dot,7)
        local name=text(row,(Cosmetics.get(styleFor(entry.id)).premium and "★ " or "")..entry.name,31,4,125,19,12,entry.alive==false and C.muted or C.ink,true);truncate(name)
        text(row,entry.cash and ("$"..entry.cash..(entry.alive==false and " · out" or "")) or "Ready to move in",31,20,125,12,10,C.muted)
    end
    roster.Size=UDim2.fromOffset(188,52+math.min(#entries,6)*39)
    roundText.Text=state.status=="playing" and ("TURN "..state.turnCount.." / "..Config.maxTurns) or "THE NEIGHBORHOOD IS OPEN"
    if layout then turnChip.Position=UDim2.fromOffset(24,layout.roster[2]+roster.Size.Y.Offset+12) end
    dieTextA.Text,dieTextB.Text=state.dice[1]&gt;0 and tostring(state.dice[1]) or "·",state.dice[2]&gt;0 and tostring(state.dice[2]) or "·"
    passButton.Visible=false;mainCommand=nil
    if state.status~="playing" then
        turnTitle.Text=state.status=="finished" and "Your next neighborhood awaits." or "A neighborhood of possibilities."
        local online=data.matchmaking and data.matchmaking.mode=="match"
        turnHint.Text=online and data.matchmaking.status or "Choose a 2- or 4-player queue, invite friends, or practice with bots."
        mainCommand=online and (state.status=="finished" and "BackLobby" or "Match") or "Match"
        actionButton.Text=online and (state.status=="finished" and "Return to matchmaking" or "Waiting for matched players") or "Play online / Practice"
    else
        turnTitle.Text=myTurn and "Make your next move." or ((current and current.name or "A resident").." is exploring.")
        if state.phase=="end" then turnTitle.Text=myTurn and "Turn complete." or ((current and current.name or "A resident").." has finished.") end
        turnHint.Text=state.notice or "A new address is waiting."
        if myTurn then
            if state.phase=="roll" then mainCommand="Roll";actionButton.Text=mine.detained and "Serve detention" or "Click dice / Roll [R]"
            elseif state.phase=="buy" then
                local tile=Config.tiles[state.pendingTile]
                mainCommand="Buy"
                actionButton.Text="Choose home · from $"..tile.price
                passButton.Visible=true
            else mainCommand="End";actionButton.Text="Next player · Finish now" end
        elseif current and current.id==player.UserId and state.phase=="end" then mainCommand="End";actionButton.Text="End turn"
        else mainCommand="Plaza";actionButton.Text="Explore city plaza [P]" end
    end
    if state.status=="playing" and (not mine or not mine.alive) and data.matchmaking and data.matchmaking.mode=="lobby" then
        mainCommand="Match";actionButton.Text=data.matchmaking.queued and "View matchmaking queue" or "Find an online match"
    end
    if rolling then mainCommand=nil;actionButton.Text="Rolling the dice…" end
    dieA.Active,dieB.Active=mainCommand=="Roll",mainCommand=="Roll"
    dieA.AutoButtonColor,dieB.AutoButtonColor=dieA.Active,dieB.Active
    available(actionButton,mainCommand~=nil,C.green)
    portfolio.Visible=portfolioOpen and not visitIndex
    homeList:ClearAllChildren()
    local row=0
    for index,property in ipairs(state.properties) do
        if property.ownerId==player.UserId then
            local tile=Config.tiles[index]
            local item=button(homeList,"",2,row*68,276,60,C.paper,function() selected=index;inspectorOpen=true;portfolioOpen=false;render() end)
            local strip=frame(item,9,10,5,40,Color3.fromHex(Config.groups[tile.group].color));round(strip,3)
            text(item,tile.name,26,8,235,24,15,C.ink,true)
            text(item,homeNames[property.level+1].." · $"..rent(state,index).." rent"..(pair(state,player.UserId,tile.group) and " · PAIR" or ""),26,32,235,18,11,C.muted)
            row=row+1
        end
    end
    homeList.CanvasSize=UDim2.fromOffset(0,row*68)
    emptyHomes.Visible=row==0
    inspector.Visible=inspectorOpen and selected~=nil and not portfolioOpen and not visitIndex
    highlight.Adornee=nil
    if selected and Config.tiles[selected] and Config.tiles[selected].kind=="property" then
        local tile,property=Config.tiles[selected],state.properties[selected]
        local owner=resident(state,property.ownerId)
        district.Text=string.upper(Config.groups[tile.group].name)
        propertyName.Text=tile.name
        ownerText.Text=owner and (owner.name.."'s home · "..homeNames[property.level+1]) or ("FOR SALE · from $"..tile.price.." including land")
        ownerMark.BackgroundColor3=owner and Color3.fromHex(Config.playerColors[owner.colorIndex]) or C.muted
        rentText.Text="$"..rent(state,selected).." / visit"
        levelText.Text="LEVEL "..property.level.." / 3"
        local own=property.ownerId==player.UserId
        nextRent.Text=owner and ("Rent "..Config.rentTiers[property.rentTier or 1].."×"..(property.shield and " · SHIELDED" or "")..((property.boost or 0)&gt;0 and (" · BOOST "..property.boost) or "")) or "Choose your starting home level before you buy."
        propertyPreview(selected,owner,property)
        upgradeButton.Visible,sellButton.Visible,paintButton.Visible=own and myTurn,own and myTurn,own and myTurn
        rentButton.Visible=own and myTurn
        visitButton.Visible=own and mine and mine.alive and state.status=="playing"
        visitButton.Text="Walk through your home"
        upgradeButton.Text=property.level==3 and "Fully upgraded" or "Upgrade options"
        available(upgradeButton,myTurn and property.level&lt;Config.maxLevel or false,C.green)
        rentButton.Text=(property.rentTier or 1)&gt;=#Config.rentTiers and "Rent maxed" or "Rent options"
        available(rentButton,myTurn and (property.rentTier or 1)&lt;#Config.rentTiers or false,C.green)
        local board=workspace:FindFirstChild("CitymoneyBoard")
        if board and inspector.Visible then highlight.Adornee=board:FindFirstChild("Property"..selected) or board:FindFirstChild("Tile"..selected) end
    else inspector.Visible=false end
    visitBanner.Visible=visitIndex~=nil
    if visitIndex then visitText.Text="At home · "..Config.tiles[visitIndex].name end
    roster.Visible=not visitIndex and not (layout and layout.compact)
    turnChip.Visible=roster.Visible
    cameraBar.Visible=not visitIndex
    available(cameraBar.TableView,true,(root:GetAttribute("ViewMode") or "table")=="table" and C.green or C.paper)
    available(cameraBar.CityView,true,root:GetAttribute("ViewMode")=="city" and C.green or C.paper)
    replay.Visible=isHost or (data.matchmaking and data.matchmaking.mode=="match")
    replay.Text=data.matchmaking and data.matchmaking.mode=="match" and "Return to matchmaking" or "Play again"
    if state.status=="finished" then
        local winner=resident(state,state.winnerId)
        resultTitle.Text=winner and (winner.name.." wins the neighborhood.") or "A neighborhood well built."
        resultSubtitle.Text=winner and ("$"..worth(state,winner).." net worth. Home, sweet home.") or "Time for a fresh start."
        resultRows:ClearAllChildren()
        local standings=table.clone(state.players)
        table.sort(standings,function(a,b)
            if a.alive~=b.alive then return a.alive end
            local aw,bw=worth(state,a),worth(state,b)
            return aw&gt;bw or (aw==bw and a.colorIndex&lt;b.colorIndex)
        end)
        for rank,entry in ipairs(standings) do
            text(resultRows,rank.."   "..entry.name.."     $"..worth(state,entry),0,(rank-1)*33,468,30,16,rank==1 and C.green or C.muted,rank==1)
        end
    end
    renderPlans()
    menus:render(data)
    boutique:render(data)
    city:render(data)
    if layout then menus:resize(layout,roster.Size.Y.Offset) end
end
local function updateLayout()
    local area=safe.AbsoluteSize
    if area.X&lt;1 or area.Y&lt;1 then return end
    layout=Layout.calculate(area.X,area.Y)
    local w,h=layout.width,layout.height
    uiScale.Scale=layout.scale;root.Size,root.Position=UDim2.fromOffset(w,h),UDim2.fromOffset(0,0)
    place(header,24,16,w-48,layout.headerHeight)
    local hw=w-48
    if layout.compact then
        place(brand,54,9,170,30);brand.TextSize=23;strap.Visible=false
        place(cashLabel,18,59,160,28);place(worthLabel,180,64,250,18)
        place(homesButton,hw-228,12,136,36);place(helpButton,hw-84,12,70,36);helpButton.Text="Rules";dayButton.Visible=false
    else
        place(brand,60,7,210,32);brand.TextSize=27;strap.Visible=true
        place(cashLabel,math.max(310,hw*0.34),8,190,30);place(worthLabel,math.max(310,hw*0.34),39,230,16)
        place(homesButton,hw-410,14,150,40);place(dayButton,hw-250,14,110,40);place(helpButton,hw-130,14,116,40)
        helpButton.Text="How to play";dayButton.Visible=true
    end
    local r=layout.roster;place(roster,r[1],r[2],r[3],roster.Size.Y.Offset)
    local card=layout.inspector;place(inspector,card[1],card[2],card[3],462)
    -- Deed cards can scroll on short or portrait screens, instead of clipping.
    if card[4]&lt;462 then
        local fit=math.max(0.76,card[4]/462)
        local inner=inspector:FindFirstChildOfClass("UIScale") or Instance.new("UIScale")
        inner.Scale,inner.Parent=fit,inspector
        inspector.Position=UDim2.fromOffset(w-24-258*fit,card[2])
    else local inner=inspector:FindFirstChildOfClass("UIScale");if inner then inner.Scale=1 end end
    place(portfolio,w-332,layout.headerHeight+46,308,math.min(440,h-layout.headerHeight-210))
    homeList.Size=UDim2.fromOffset(284,portfolio.Size.Y.Offset-102)
    local t=layout.toolbar;place(control,t[1],t[2],t[3],t[4])
    if layout.compact then
        place(dieA,16,16,44,44);place(dieB,66,16,44,44)
        place(turnTitle,124,14,t[3]-140,27);turnTitle.TextSize=18
        place(turnHint,16,67,t[3]-32,22)
        place(actionButton,16,101,t[3]-112,42);place(passButton,t[3]-88,101,72,42)
        place(timeText,124,44,t[3]-140,17)
    else
        place(dieA,16,18,48,48);place(dieB,72,18,48,48)
        place(turnTitle,140,14,t[3]-390,29);turnTitle.TextSize=21
        place(turnHint,140,48,t[3]-390,26)
        place(actionButton,t[3]-236,17,220,54);place(passButton,t[3]-90,79,74,24)
        place(timeText,16,81,t[3]-122,18)
    end
    place(timeTrack,16,t[4]-7,t[3]-32,3)
    place(toast,(w-400)/2,layout.headerHeight+36,400,45)
    place(visitBanner,(w-440)/2,layout.headerHeight+36,440,58)
    if menus then menus:resize(layout,roster.Size.Y.Offset) end
    if data then render() end
end
safe:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateLayout)
updateLayout()
local animationVersion=0
local function diceAnimation(first,second)
    if data and data.club and not data.club.effects then
        dieTextA.Text,dieTextB.Text=tostring(first),tostring(second);return
    end
    animationVersion=animationVersion+1;local version=animationVersion
    rolling=true;render()
    task.spawn(function()
        for step=1,10 do
            if version~=animationVersion then return end
            dieTextA.Text,dieTextB.Text=tostring(math.random(1,6)),tostring(math.random(1,6))
            dieA.Rotation,dieB.Rotation=step%2==0 and 7 or -7,step%2==0 and -7 or 7
            task.wait(0.045+step*0.003)
        end
        if version~=animationVersion then return end
        dieTextA.Text,dieTextB.Text,dieA.Rotation,dieB.Rotation=tostring(first),tostring(second),0,0
        rolling=false;render()
    end)
end
snapshot.OnClientEvent:Connect(function(incoming)
    if data and incoming.revision&lt;data.revision then return end
    local old=data
    local before=old and resident(old.game,player.UserId)
    local after=resident(incoming.game,player.UserId)
    data=incoming
    local state=data.game
    if old and state.status=="playing" and old.game.status~="playing" then
        results.Visible=false;focusIndex=nil;inspectorOpen=false;portfolioOpen=false
        chooser.Visible=false;planPending=false;planIndex=nil;planTurn=nil
    end
    if after and before and after.cash~=before.cash then
        local delta=after.cash-before.cash
        notify((delta&gt;0 and "+$" or "−$")..math.abs(delta).." · Balance $"..after.cash)
    end
    if state.status=="playing" and state.phase=="buy" and state.players[state.turn].id==player.UserId then
        if not old or old.game.phase~="buy" or old.game.pendingTile~=state.pendingTile then
            selected,portfolioOpen=state.pendingTile,false
            local turn,index=state.turnCount,state.pendingTile
            local delay=state.lastRoll and Config.diceSeconds+(state.lastRoll.steps or 0)*0.18+0.15 or 0
            task.delay(delay,function()
                if data and data.game.status=="playing" and data.game.turnCount==turn and data.game.phase=="buy" and data.game.pendingTile==index and not chooser.Visible then openPlans("buy",index) end
            end)
        end
    end
    if planPending and chooser.Visible then
        local property=state.properties[planIndex]
        local applied=property and (planMode=="rent" and (property.rentTier or 1)==planLevel+1 or planMode~="rent" and property.level==planLevel)
        if property and property.ownerId==player.UserId and applied then
            chooser.Visible=false;planPending=false
        end
    end
    if old then
        for index,property in ipairs(state.properties) do
            if property.ownerId==player.UserId and old.game.properties[index].ownerId~=player.UserId then
                selected=index
                notify("Your level "..property.level.." "..homeNames[property.level+1].." at "..Config.tiles[index].name.." is ready.")
            elseif property.ownerId==player.UserId and old.game.properties[index].ownerId==player.UserId and property.level&gt;old.game.properties[index].level then
                selected=index
                notify(Config.tiles[index].name.." is now a level "..property.level.." "..homeNames[property.level+1].."!")
            elseif property.ownerId==player.UserId and (property.rentTier or 1)&gt;(old.game.properties[index].rentTier or 1) then
                notify(Config.tiles[index].name.." now charges "..Config.rentTiers[property.rentTier].."× rent on future visits.")
            elseif old.game.properties[index].ownerId==player.UserId and property.ownerId~=player.UserId and state.lastAction and state.lastAction.kind=="demolish" and state.lastAction.tile==index and state.lastAction.seq&gt;(old.game.lastAction and old.game.lastAction.seq or 0) then
                notify("Your house at "..Config.tiles[index].name.." was demolished. The lot is now for sale.")
            end
        end
        if state.turnCount~=old.game.turnCount then focusIndex=nil end
        if state.lastRoll and state.lastRoll.seq&gt;(old.game.lastRoll and old.game.lastRoll.seq or 0) then diceAnimation(state.lastRoll.values[1],state.lastRoll.values[2]) end
    end
    if state.status=="finished" and (not old or old.game.status~="finished") then
        results.Visible=true;help.Visible=false;sale.Visible=false
        menus.lobby.Visible=false;menus.actions.Visible=false;boutique.shade.Visible=false
        city.shade.Visible=false
        boutique:celebrate()
    end
    render()
end)
feedback.OnClientEvent:Connect(function(message)
    locked=false;planPending=false
    if chooser.Visible then planError=message end
    notify(message);renderPlans();menus:feedback(message);boutique:feedback(message);city:feedback(message)
end)
local function inspect(position)
    if help.Visible or sale.Visible or results.Visible or chooser.Visible or visitIndex or menus:isOpen() or boutique:isOpen() or city:isOpen() then return end
    local camera,board=workspace.CurrentCamera,workspace:FindFirstChild("CitymoneyBoard")
    if not camera or not board then return end
    local ray=camera:ScreenPointToRay(position.X,position.Y)
    local parameters=RaycastParams.new();parameters.FilterType,parameters.FilterDescendantsInstances=Enum.RaycastFilterType.Include,{board}
    local hit=workspace:Raycast(ray.Origin,ray.Direction*1500,parameters)
    local interaction=hit and (hit.Instance:GetAttribute("Interaction") or hit.Instance.Parent:GetAttribute("Interaction"))
    if interaction=="dice" then
        if mainCommand=="Roll" then mainAction() else notify("Click the dice when it is your turn to roll.") end
        return
    elseif interaction then openCity(interaction);return end
    local index=hit and (hit.Instance:GetAttribute("TileIndex") or hit.Instance.Parent:GetAttribute("TileIndex"))
    if index and Config.tiles[index].kind=="property" then selected,inspectorOpen,portfolioOpen=index,true,false;render() end
end
Input.TouchTapInWorld:Connect(function(position,processed) if not processed then inspect(position) end end)
Input.InputBegan:Connect(function(input,processed)
    if not processed and input.UserInputType==Enum.UserInputType.MouseButton1 then inspect(input.Position) end
    if processed or help.Visible or sale.Visible or results.Visible or chooser.Visible or menus:isOpen() or boutique:isOpen() or city:isOpen() then return end
    if input.KeyCode==Enum.KeyCode.B and visitIndex then send("Return")
    elseif input.KeyCode==Enum.KeyCode.R and mainCommand=="Roll" then send("Roll")
    elseif input.KeyCode==Enum.KeyCode.P and not visitIndex then openCity("festival")
    elseif input.KeyCode==Enum.KeyCode.Space and mainCommand and not visitIndex then mainAction() end
end)
Input.InputChanged:Connect(function(input,processed)
    if not processed and not visitIndex and input.UserInputType==Enum.UserInputType.MouseWheel then
        root:SetAttribute("Zoom",math.clamp((root:GetAttribute("Zoom") or 1)-input.Position.Z*0.06,0.75,1.5))
    end
end)
RunService.RenderStepped:Connect(function(dt)
    boardView:update(dt,root,safe,layout,data,focusIndex,inspector.Visible or portfolio.Visible,visitIndex,player)
    dayButton.Text=night and "Night stroll" or "Golden hour"
    if data and data.game.status=="playing" then
        local handing=data.game.phase=="end"
        local seconds=math.max(0,(handing and data.handoffAt or data.deadline)-workspace:GetServerTimeNow())
        timeText.Text=handing and ("Next player's turn starts automatically in "..math.ceil(seconds).."s") or (math.ceil(seconds).."s to decide · Click dice / R · City plaza [P]")
        if chooser.Visible and not planError then
            local tile=Config.tiles[planIndex]
            planNote.Text=(planMode=="buy" and ("Land $"..tile.price.." + building $"..planLevel*tile.upgrade) or (planMode=="rent" and "This multiplier applies to future rent payments." or "Only the added levels are charged.")).."  ·  "..math.ceil(seconds).."s left"
        end
        timeFill.Size,timeFill.BackgroundColor3=UDim2.fromScale(math.clamp(seconds/(handing and Config.autoAdvanceSeconds or Config.turnSeconds),0,1),1),not handing and seconds&lt;10 and C.red or C.green
    else timeText.Text="2 / 4 players · online queues or practice with bots";timeFill.Size=UDim2.fromScale(0,1) end
end)
action:FireServer("Sync")
task.delay(3,function() if not data then action:FireServer("Sync") end end)
</string>
        </Properties>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">BoardView</string>
            <string name="Source">local shared=game:GetService("ReplicatedStorage"):WaitForChild("Citymoney")
local Fit,Layout,Architecture=require(shared.BoardCamera),require(shared.Layout),require(shared.Architecture)
local Labels=require(script.Parent.TileLabels)
local View={}
View.__index=View
function View.new() return setmetatable({frame=nil,key=nil,wasVisiting=false},View) end
function View:update(dt,root,safe,layout,data,focus,inspector,visit,player)
    local camera=workspace.CurrentCamera
    if not camera or not layout then return end
    if visit then
        if self.labels then self.labels:update(camera,safe,layout.scale,data,false) end
        local humanoid=player.Character and player.Character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            camera.CameraSubject,camera.CameraType=humanoid,Enum.CameraType.Custom
            player.CameraMinZoomDistance,player.CameraMaxZoomDistance=4,35
            if not self.wasVisiting and humanoid.RootPart then camera.CFrame=CFrame.lookAt(humanoid.RootPart.Position+Vector3.new(14,11,16),humanoid.RootPart.Position) end
        end
        self.wasVisiting=true;return
    end
    if self.wasVisiting then self.frame=nil;self.key=nil end
    self.wasVisiting=false
    camera.CameraType,camera.FieldOfView=Enum.CameraType.Scriptable,36
    local size,offset=camera.ViewportSize,safe.AbsolutePosition
    local mode=root:GetAttribute("ViewMode") or "table"
    local rotate,zoom=root:GetAttribute("Rotate") or 0,root:GetAttribute("Zoom") or 1
    local key=table.concat({size.X,size.Y,layout.width,layout.height,layout.scale,offset.X,offset.Y,mode,rotate,zoom,tostring(focus),tostring(inspector),data and data.game.properties[focus or 0] and data.game.properties[focus].level or 0},":")
    if self.key~=key then
        self.key=key
        local rectangle=Layout.board(layout,inspector)
        local rect={offset.X+rectangle[1]*layout.scale,offset.Y+rectangle[2]*layout.scale,rectangle[3]*layout.scale,rectangle[4]*layout.scale}
        self.rect=rect
        local yaw=rotate*math.pi/2+(mode=="city" and math.pi/4 or 0)
        local elevation=math.rad(mode=="city" and 52 or 76)
        local bounds
        if focus then
            local p,angle=Architecture.site(focus)
            local level=data and data.game.properties[focus].level or 0
            bounds={min={p[1]-11,1,p[3]-11},max={p[1]+11,13+level*6,p[3]+11}}
            yaw,elevation=angle+math.rad(150),math.rad(40)
        end
        -- Calibrate using Roblox's own projection; this also handles top bars,
        -- phone cutouts and ViewportSize differing from the full rendering area.
        local rayA=camera:ScreenPointToRay(rect[1]+10,rect[2]+10)
        local rayB=camera:ScreenPointToRay(rect[1]+rect[3]-10,rect[2]+rect[4]-10)
        local a=camera.CFrame:VectorToObjectSpace(rayA.Direction)
        local b=camera.CFrame:VectorToObjectSpace(rayB.Direction)
        local fitted=Fit.fromSlopes({a.X/-a.Z,b.X/-b.Z,b.Y/-b.Z,a.Y/-a.Z},yaw,elevation,zoom,bounds)
        self.goal=CFrame.fromMatrix(Vector3.new(table.unpack(fitted.position)),Vector3.new(table.unpack(fitted.right)),Vector3.new(table.unpack(fitted.up)),Vector3.new(table.unpack(fitted.back)))
    end
    local still=data and data.club and not data.club.effects
    if not self.frame or still then self.frame=self.goal
    else self.frame=self.frame:Lerp(self.goal,1-math.exp(-8*math.min(dt,0.1))) end
    camera.CFrame=self.frame
    if not self.labels then self.labels=Labels.new(root,self.onProperty,self.onInteraction) end
    self.labels:update(camera,safe,layout.scale,data,mode=="table" and not focus,self.rect)
end
return View
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">Boutique</string>
            <string name="Source">-- The native Roblox prompt handles all Robux payments. Snapshots grant access.
local Marketplace=game:GetService("MarketplaceService")
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local TweenService=game:GetService("TweenService")
local shared=game:GetService("ReplicatedStorage"):WaitForChild("Citymoney")
local Cosmetics,Architecture,Scene=require(shared.Cosmetics),require(shared.Architecture),require(shared.Scene)
local Boutique={}
Boutique.__index=Boutique
function Boutique.new(ui)
    local self=setmetatable({ui=ui,selected="gilded",price=nil,forSale=false,infoPass=nil,infoState="idle",error=nil,angle=0},Boutique)
    local C=ui.colors
    self.shade,self.card=ui.overlay(520,660)
    ui.text(self.card,"THE WATERFRONT ATELIER",24,16,430,20,10,C.green,true)
    ui.text(self.card,"Make it yours.",24,42,430,37,28,C.ink,true)
    ui.button(self.card,"×",468,18,28,28,C.paper,function() self.shade.Visible=false end)
    ui.text(self.card,"Three signature collections · one permanent Club pass",24,84,472,22,12,C.muted)
    self.viewport=Instance.new("ViewportFrame")
    self.viewport.Position,self.viewport.Size=UDim2.fromOffset(24,118),UDim2.fromOffset(472,180)
    self.viewport.BackgroundColor3,self.viewport.BorderSizePixel=C.mint,0
    self.viewport.Ambient,self.viewport.LightColor=Color3.fromRGB(185,185,178),Color3.fromRGB(255,239,212)
    self.viewport.LightDirection,self.viewport.Parent=Vector3.new(-1,-2,-1),self.card
    local corner=Instance.new("UICorner");corner.CornerRadius,corner.Parent=UDim.new(0,12),self.viewport
    self.world=Instance.new("WorldModel");self.world.Parent=self.viewport
    self.camera=Instance.new("Camera");self.camera.FieldOfView,self.camera.Parent=34,self.viewport
    self.viewport.CurrentCamera=self.camera
    self.buttons={}
    for index,style in ipairs(Cosmetics.styles) do
        local choose=ui.button(self.card,style.name,24+((index-1)%2)*242,311+math.floor((index-1)/2)*48,230,40,C.paper,function()
            self.selected=style.id;self.error=nil;self:render(ui.data())
        end)
        choose.TextSize=12;self.buttons[style.id]=choose
    end
    self.description=ui.text(self.card,"",24,411,472,42,13,C.muted)
    self.motion=ui.button(self.card,"Reduced motion: OFF",24,465,472,34,C.paper,function()
        local data=ui.data()
        if data and data.club then
            self.error=nil;ui.send("Style",{styleId=data.club.styleId,effects=not data.club.effects})
        end
    end);self.motion.TextSize=12
    self.status=ui.text(self.card,"",24,508,472,29,12,C.green,true)
    self.primary=ui.button(self.card,"Preview collection",24,548,304,42,C.green,function() self:activate() end)
    self.restore=ui.button(self.card,"Check ownership",340,548,156,42,C.paper,function()
        self.error=nil;ui.send("ClubRefresh")
        local data=ui.data();if data and data.club then self:product(data.club.passId,true) end
    end);self.restore.TextSize=11
    self.note=ui.text(self.card,"Cosmetics only. Your cash, rent, cards and dice odds stay the same.",24,601,472,39,12,C.muted)
    RunService.RenderStepped:Connect(function(dt)
        if not self.shade.Visible or not self.target then return end
        local data=ui.data()
        if not data or not data.club or data.club.effects then self.angle=self.angle+math.min(dt,0.05)*0.13 end
        local theta=math.rad(145)+math.sin(self.angle)*0.22
        self.camera.CFrame=CFrame.lookAt(self.target+Vector3.new(math.sin(theta)*38,22,math.cos(theta)*38),self.target)
    end)
    Marketplace.PromptGamePassPurchaseFinished:Connect(function(player,passId)
        if player==Players.LocalPlayer and passId==self.infoPass then self.prompting=false;self:render(ui.data()) end
    end)
    return self
end
function Boutique:isOpen() return self.shade.Visible end
function Boutique:open()
    self.shade.Visible=true;self.error=nil
    self:render(self.ui.data())
end
function Boutique:feedback(message)
    if self.shade.Visible then self.error=message;self:render(self.ui.data()) end
end
function Boutique:product(passId,retry)
    if passId&lt;=0 or (self.infoPass==passId and (not retry or self.infoState=="loading")) then return end
    self.infoPass,self.infoState,self.price,self.forSale=passId,"loading",nil,false
    task.spawn(function()
        -- Fetch on the client so Roblox regional/personalized prices are accurate.
        local ok,info=pcall(function() return Marketplace:GetProductInfoAsync(passId,Enum.InfoType.GamePass) end)
        if self.infoPass~=passId then return end
        self.infoState=ok and "ready" or "failed"
        self.forSale=ok and info.IsForSale==true
        self.price=self.forSale and type(info.PriceInRobux)=="number" and info.PriceInRobux or nil
        self:render(self.ui.data())
    end)
end
function Boutique:activate()
    local data=self.ui.data()
    if not data or not data.club or data.club.loading or self.prompting then return end
    local profile,style=data.club,Cosmetics.get(self.selected)
    if Cosmetics.allowed(style.id,profile.ownsPass,profile.studio) then
        self.error=nil;self.ui.send("Style",{styleId=style.id,effects=profile.effects})
    elseif profile.passId&gt;0 and self.forSale then
        self.prompting=true
        local ok=pcall(function() Marketplace:PromptGamePassPurchase(Players.LocalPlayer,profile.passId) end)
        if not ok then self.prompting=false end
        self.error=not ok and "Roblox could not open the purchase prompt. Please try again." or nil
        self:render(data)
    end
end
function Boutique:render(data)
    if not data or not data.club then return end
    local ui,C,profile=self.ui,self.ui.colors,data.club
    local equipped=Cosmetics.get(profile.styleId)
    -- Apply the active collection throughout the HUD, even with the showroom closed.
    ui.dieA.BackgroundColor3,ui.dieB.BackgroundColor3=Color3.fromHex(equipped.dice),Color3.fromHex(equipped.dice)
    ui.dieTextA.TextColor3,ui.dieTextB.TextColor3=Color3.fromHex(equipped.pip),Color3.fromHex(equipped.pip)
    ui.mark.BackgroundColor3=Color3.fromHex(equipped.accent)
    ui.header:FindFirstChildOfClass("UIStroke").Color=equipped.premium and Color3.fromHex(equipped.accent) or C.line
    ui.strap.Text=equipped.premium and ("W A T E R F R O N T   C L U B  ·  "..equipped.label) or "T H E   W A T E R F R O N T   C L U B"
    if not self.shade.Visible then return end
    self:product(profile.passId,false)
    local selected=Cosmetics.get(self.selected)
    for id,button in pairs(self.buttons) do
        local style=Cosmetics.get(id)
        button.BackgroundColor3=id==selected.id and Color3.fromHex(style.dice) or C.paper
        button.TextColor3=id==selected.id and Color3.fromHex(style.pip) or C.ink
        button.Text=style.name..(id==profile.styleId and " ✓" or "")
    end
    local color=ui.config.playerColors[1]
    for _,resident in ipairs(data.game.players) do if resident.id==ui.id then color=ui.config.playerColors[resident.colorIndex] end end
    for _,member in ipairs(data.lobby) do if member.id==ui.id and data.game.status~="playing" then color=ui.config.playerColors[member.colorIndex] or color end end
    local key=selected.id..":"..color
    if self.previewKey~=key then
        self.previewKey=key;self.world:ClearAllChildren();self.angle=0
        local model=Scene.model(Architecture.property(ui.config,2,Players.LocalPlayer.DisplayName,color,2,0,nil,selected.id),"CollectionPreview",self.world,true)
        local cf=model:GetBoundingBox();self.target=cf.Position+Vector3.new(0,0.4,0)
        self.viewport.BackgroundColor3=selected.premium and Color3.fromHex(selected.stone) or C.mint
    end
    self.description.Text=selected.description
    self.motion.Text=profile.effects and "Reduced motion: OFF · animated preview, dice and walking trail" or "Reduced motion: ON · still preview and dice; walking trail off"
    ui.available(self.motion,not profile.loading,C.paper)
    local allowed=Cosmetics.allowed(selected.id,profile.ownsPass,profile.studio)
    local enabled=not profile.loading and not self.prompting and (allowed and profile.styleId~=selected.id or not allowed and self.forSale)
    if self.prompting then self.primary.Text="Complete Roblox checkout…"
    elseif profile.loading then self.primary.Text="Loading collection…"
    elseif profile.styleId==selected.id then self.primary.Text="Equipped ✓"
    elseif allowed then self.primary.Text=profile.studio and "Equip in Studio preview" or "Equip "..selected.name
    elseif profile.passId==0 then self.primary.Text="Club pass coming soon"
    elseif self.infoState=="loading" then self.primary.Text="Checking Roblox price…"
    elseif not self.forSale then self.primary.Text="Pass currently unavailable"
    else self.primary.Text=self.price and ("Unlock all styles · R$ "..self.price) or "Unlock Club · Roblox checkout" end
    ui.available(self.primary,enabled==true,C.green)
    ui.available(self.restore,not profile.loading and not profile.studio and profile.passId&gt;0,C.paper)
    self.status.Text=self.error or (profile.loading and "Loading your collection…" or (profile.studio and "STUDIO PREVIEW · no purchases or permanent unlocks" or (profile.ownsPass and "CLUB MEMBER · all three collections unlocked" or "Preview any collection before purchasing.")))
    self.status.TextColor3=self.error and C.red or C.green
    self.note.Text=self.error and "Purchases and ownership are handled by Roblox. Try Check ownership if needed." or (profile.status~="" and profile.status or "Cosmetics only. Your cash, rent, cards and dice odds stay the same.")
end
function Boutique:celebrate()
    local data=self.ui.data()
    if not data or not data.club or not data.club.effects then return end
    local style=Cosmetics.get(data.club.styleId)
    local layer=Instance.new("Frame")
    layer.Size,layer.BackgroundTransparency,layer.ZIndex,layer.Parent=UDim2.fromScale(1,1),1,40,self.ui.root
    layer.ClipsDescendants=true
    for i=1,28 do
        local confetti=Instance.new("Frame")
        confetti.Size,confetti.Position=UDim2.fromOffset(5+i%3*2,10),UDim2.fromScale((i*0.618)%1,-0.06-i%4*0.06)
        confetti.BackgroundColor3=Color3.fromHex(i%2==0 and style.accent or "F0DCA8")
        confetti.BorderSizePixel,confetti.Rotation,confetti.ZIndex,confetti.Parent=0,i*27,41,layer
        TweenService:Create(confetti,TweenInfo.new(2.3+i%5*0.15,Enum.EasingStyle.Quad,Enum.EasingDirection.In),{Position=UDim2.fromScale((i*0.618+0.12)%1,1.1),Rotation=i*27+190,BackgroundTransparency=0.7}):Play()
    end
    task.delay(3.2,function() layer:Destroy() end)
end
return Boutique
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">CityPlaza</string>
            <string name="Source">local shared=game:GetService("ReplicatedStorage"):WaitForChild("Citymoney")
local Plaza=require(shared.Plaza)
local City={}
City.__index=City
function City.new(ui)
    local self=setmetatable({ui=ui,tab="festival",tile=nil,kind="shield",pending=nil,error=nil},City)
    local C=ui.colors
    self.shade,self.card=ui.overlay(520,628)
    ui.text(self.card,"THE CITY PLAZA",24,14,430,20,10,C.green,true)
    ui.text(self.card,"Something is happening.",24,39,440,34,25,C.ink,true)
    ui.button(self.card,"X",468,18,28,28,C.paper,function() self.shade.Visible=false end)
    self.tabs={}
    for index,tab in ipairs({"festival","market","contracts","news"}) do
        local label=({festival="Festival",market="Card market",contracts="Challenges",news="City news"})[tab]
        self.tabs[tab]=ui.button(self.card,label,24+(index-1)*120,87,112,36,C.paper,function() self:open(tab) end)
        self.tabs[tab].TextSize=12
    end
    self.title=ui.text(self.card,"",24,137,472,32,22,C.ink,true)
    self.description=ui.text(self.card,"",24,176,472,60,14,C.muted)
    self.period=ui.text(self.card,"",24,241,472,22,11,C.green,true)
    self.rows=Instance.new("ScrollingFrame")
    self.rows.Position,self.rows.Size=UDim2.fromOffset(24,274),UDim2.fromOffset(472,204)
    self.rows.BackgroundTransparency,self.rows.BorderSizePixel,self.rows.ScrollBarThickness,self.rows.Parent=1,0,3,self.card
    self.detail=ui.text(self.card,"",24,487,472,41,12,C.muted)
    self.status=ui.text(self.card,"",24,534,472,24,11,C.red)
    self.confirm=ui.button(self.card,"Choose an offer",24,572,332,40,C.green,function() self:confirmOffer() end)
    ui.button(self.card,"Back",368,572,128,40,C.paper,function() self.shade.Visible=false end)
    return self
end
function City:isOpen() return self.shade.Visible end
function City:open(tab)
    if tab=="contracts" then self.shade.Visible=false;self.ui.openGoals();return end
    self.tab=tab or "festival";self.shade.Visible=true;self.error=nil
    self:render(self.ui.data())
end
function City:feedback(message)
    if self.shade.Visible then self.pending=nil;self.error=message;self:render(self.ui.data()) end
end
function City:confirmOffer()
    local data=self.ui.data()
    if not data or self.pending then return end
    local festival=Plaza.festival(self.ui.config,data.game)
    local request={shop=self.tab,kind=self.kind,tile=self.tile,turn=data.game.turnCount,festivalId=festival.id}
    if self.ui.send("Plaza",request) then
        self.pending={turn=request.turn};self.error=nil
        local pending=self.pending
        task.delay(4,function()
            if self.pending==pending then self.pending=nil;self.error="Refreshing the plaza. Check the match before trying again.";self.ui.send("Sync");self:render(self.ui.data()) end
        end)
        self:render(data)
    end
end
function City:render(data)
    if not data or not self.shade.Visible then return end
    local state,ui,C=data.game,self.ui,self.ui.colors
    local me,current
    for _,player in ipairs(state.players) do if player.id==ui.id then me=player end end
    current=state.players[state.turn]
    local myTurn=state.status=="playing" and me and me.alive and current and current.id==ui.id
    local canBuy=myTurn and state.phase=="roll" and not state.plazaUsed and not self.pending
    if self.pending and self.pending.turn~=state.turnCount then self.pending=nil;self.error="Your turn changed. Review the current offer."
    elseif self.pending and state.plazaUsed then self.pending=nil;self.error=nil;ui.notify("Your city plaza purchase is ready.") end
    for tab,button in pairs(self.tabs) do button.BackgroundColor3=tab==self.tab and C.green or C.paper;button.TextColor3=tab==self.tab and C.white or C.ink end
    self.rows:ClearAllChildren()
    local festival,remaining=Plaza.festival(ui.config,state)
    local cost,valid=0,false
    local count=0
    if self.tab=="festival" then
        self.title.Text=festival.name;self.description.Text=festival.description
        self.period.Text=remaining.." total turns until the next festival · choose your property"
        for index,property in ipairs(state.properties) do
            if property.ownerId==ui.id then
                local chosen=self.tile==index
                local option=ui.button(self.rows,(chosen and "&gt; " or "")..ui.config.tiles[index].name.." · Level "..property.level,2,count*42,464,36,chosen and C.green or C.paper,function() self.tile=index;self.error=nil;self:render(ui.data()) end)
                option.TextSize=13;count=count+1
            end
        end
        if count==0 then ui.text(self.rows,"Buy a home to take part in this festival.",12,20,440,48,15,C.muted) end
        cost=festival.cost
        local property=self.tile and state.properties[self.tile]
        valid=property and property.ownerId==ui.id or false
        self.detail.Text="Price: $"..cost.." in game cash · one plaza purchase per turn."
        if valid then
            if festival.kind=="boost" and (property.boost or 0)&gt;0 then valid=false;self.detail.Text="This home already has an active rent boost."
            elseif festival.kind=="shield" and property.shield then valid=false;self.detail.Text="This home is already protected."
            elseif festival.kind=="repair" and property.level&gt;=ui.config.maxLevel then valid=false;self.detail.Text="This home is already fully upgraded." end
        end
    elseif self.tab=="market" then
        self.title.Text="Choose your next move."
        self.description.Text="Buy a tactical card using game cash. Choose exactly what you receive, then play it through Cards &amp; goals."
        self.period.Text="ONE PLAZA PURCHASE PER TURN · MAXIMUM THREE OF EACH CARD"
        for _,kind in ipairs(ui.config.cardTypes) do
            local definition=ui.config.cardDefinitions[kind]
            local chosen=self.kind==kind
            local owned=me and me.cards[kind] or 0
            local option=ui.button(self.rows,definition.name.." · $"..ui.config.cityMarket[kind].." · hand "..owned.." / 3",2,count*40,464,34,chosen and C.green or C.paper,function() self.kind=kind;self.error=nil;self:render(ui.data()) end)
            option.TextSize=12;count=count+1
        end
        self.detail.Text=ui.config.cardDefinitions[self.kind].description
        cost=ui.config.cityMarket[self.kind];valid=me and (me.cards[self.kind] or 0)&lt;ui.config.cardLimit or false
    else
        self.title.Text="Around the table."
        self.description.Text="Current festival: "..festival.name..". "..festival.description
        self.period.Text="RECENT CITY BULLETIN"
        for _,message in ipairs(state.logs) do ui.text(self.rows,message,8,count*47,448,43,13,C.ink);count=count+1 end
        self.detail.Text="Click the plaza's market, festival pavilion or challenge hall to explore."
    end
    self.rows.CanvasSize=UDim2.fromOffset(0,count*(self.tab=="news" and 47 or 42))
    self.status.Text=self.error or (not myTurn and "Explore any time. Purchases open during your turn." or (state.phase~="roll" and "Visit the plaza before you roll on your next turn." or (state.plazaUsed and "Your plaza purchase is used for this turn." or "")))
    local enabled=canBuy and valid and me.cash&gt;=cost and self.tab~="news"
    ui.available(self.confirm,enabled==true,C.green)
    self.confirm.Text=self.pending and "Confirming…" or (self.tab=="news" and "Festival &amp; market tabs have offers" or (not canBuy and "Browse offers for your next turn" or (me.cash&lt;cost and ("Need $"..(cost-me.cash).." more") or ("Confirm · $"..cost.." in game cash"))))
end
return City
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">Menus</string>
            <string name="Source">-- Lobby, tactical targeting and challenge menus share the main HUD's controls.
local SocialService=game:GetService("SocialService")
local RunService=game:GetService("RunService")
local Players=game:GetService("Players")
local Http=game:GetService("HttpService")
local Menus={}
Menus.__index=Menus
function Menus.new(ui)
    local self=setmetatable({ui=ui,kind="demolish",tile=nil,targetId=nil,pending=nil,error=nil},Menus)
    local C,config=ui.colors,ui.config
    local frame,text,button,overlay=ui.frame,ui.text,ui.button,ui.overlay
    self.matchButton=button(ui.root,"Match / invite",24,320,188,38,C.paper,function() self.lobby.Visible=true;self.actions.Visible=false;self.error=nil;self:render(ui.data()) end)
    self.cardsButton=button(ui.root,"Cards &amp; goals",24,366,188,38,C.green,function() self.actions.Visible=true;self.lobby.Visible=false;self.error=nil;self:render(ui.data()) end)
    self.styleButton=button(ui.root,"Club collection",24,412,188,38,C.paper,function() if ui.openStyles then ui.openStyles() end end)
    self.lobby,self.lobbyCard=overlay(520,632)
    text(self.lobbyCard,"Play together",24,16,436,36,26,C.ink,true)
    text(self.lobbyCard,"Choose your match, player color and readiness.",24,55,472,30,13,C.muted)
    self.leaveParty=button(self.lobbyCard,"Leave party",338,18,120,28,C.paper,function() ui.send("LeaveParty") end)
    button(self.lobbyCard,"×",468,18,28,28,C.paper,function() self.lobby.Visible=false end)
    self.two=button(self.lobbyCard,"2 players",24,100,230,44,C.green,function() ui.send("Seats",2) end)
    self.four=button(self.lobbyCard,"4 players",266,100,230,44,C.paper,function() ui.send("Seats",4) end)
    self.bots=button(self.lobbyCard,"Fill empty seats with bots",24,154,472,38,C.paper,function()
        local data=ui.data();if data then ui.send("Bots",not data.lobbyConfig.fillBots) end
    end)
    text(self.lobbyCard,"PRACTICE DEMOLITION RULE · ONLINE ALWAYS DESTROYS THE HOUSE",24,204,472,20,10,C.muted,true)
    self.downgrade=button(self.lobbyCard,"Remove one level",24,232,230,36,C.paper,function() ui.send("AttackRule","downgrade") end)
    self.destroy=button(self.lobbyCard,"Destroy whole house",266,232,230,36,C.paper,function() ui.send("AttackRule","destroy") end)
    self.members=Instance.new("ScrollingFrame")
    self.members.Position,self.members.Size=UDim2.fromOffset(24,286),UDim2.fromOffset(472,118)
    self.members.BackgroundTransparency,self.members.BorderSizePixel,self.members.ScrollBarThickness,self.members.Parent=1,0,3,self.lobbyCard
    text(self.lobbyCard,"YOUR PLAYER COLOR · colors already taken are locked",24,414,472,20,10,C.muted,true)
    self.colorButtons={}
    for index,hex in ipairs(config.playerColors) do
        local choose=button(self.lobbyCard,tostring(index),24+(index-1)*78,442,66,32,Color3.fromHex(hex),function() ui.send("Color",index) end)
        choose.TextColor3=C.ink;table.insert(self.colorButtons,choose)
    end
    self.ready=button(self.lobbyCard,"Ready",24,490,230,40,C.green,function() self:toggleReady() end)
    self.invite=button(self.lobbyCard,"Invite friends",266,490,230,40,C.paper,function()
        task.spawn(function()
            if RunService:IsStudio() or game.PlaceId==0 then self.error="Publish the place, then invite friends from a live Roblox server.";self:render(ui.data());return end
            local data=ui.data()
            if not data then return end
            if data and data.matchmaking and (data.matchmaking.mode=="match" or data.matchmaking.queued) then self.error="Invite friends from the lobby before your party joins a queue.";self:render(ui.data());return end
            local ok,canInvite=pcall(function() return SocialService:CanSendGameInviteAsync(Players.LocalPlayer) end)
            if not ok or not canInvite then self.error="Roblox cannot open invites here. Friends can use the experience's Join button.";self:render(ui.data());return end
            local options=Instance.new("ExperienceInviteOptions")
            options.LaunchData=Http:JSONEncode({citymoneyJob=game.JobId,leaderId=data.hostId})
            local opened=pcall(function() SocialService:PromptGameInvite(Players.LocalPlayer,options) end)
            if not opened then self.error="The invite prompt could not open. Try the Roblox experience page.";self:render(ui.data()) end
        end)
    end)
    self.lobbyStatus=text(self.lobbyCard,"",24,536,472,29,12,C.muted)
    self.queue=button(self.lobbyCard,"Join online queue",24,576,230,40,C.green,function()
        local data=ui.data()
        if data and data.matchmaking and data.matchmaking.mode=="match" then ui.send("BackLobby")
        elseif data and data.matchmaking and data.matchmaking.queued then ui.send("QueueCancel")
        else ui.send("Queue") end
    end)
    self.start=button(self.lobbyCard,"Practice",266,576,230,40,C.paper,function() ui.send("Start") end)
    self.actions,self.actionCard=overlay(520,660)
    text(self.actionCard,"Cards &amp; challenges",24,16,436,36,25,C.ink,true)
    button(self.actionCard,"×",468,18,28,28,C.paper,function() self.actions.Visible=false end)
    local challenge=frame(self.actionCard,24,66,472,101,C.mint)
    self.goalName=text(challenge,"Your challenge",12,7,310,24,15,C.ink,true)
    self.goalText=text(challenge,"",12,34,310,40,12,C.muted)
    self.goalProgress=text(challenge,"",12,78,310,15,10,C.green,true)
    self.claim=button(challenge,"Claim reward",338,12,122,34,C.green,function()
        local data=ui.data();if data then ui.send("Claim",nil,nil,data.game.turnCount) end
    end);self.claim.TextSize=11
    self.newGoal=button(challenge,"New goal $50",338,55,122,30,C.paper,function()
        local data=ui.data();if data then ui.send("NewGoal",nil,nil,data.game.turnCount) end
    end);self.newGoal.TextSize=10
    self.cardStatus=text(self.actionCard,"ONE TACTICAL CARD PER TURN",24,178,472,18,10,C.muted,true)
    self.cardButtons={}
    local short={demolish="Demolish",collect="Demand rent",boost="Rent boost",shield="Shield",repair="Renovate"}
    for index,kind in ipairs(config.cardTypes) do
        local select=button(self.actionCard,short[kind],24+((index-1)%3)*160,202+math.floor((index-1)/3)*44,152,36,C.paper,function()
            if not self.pending then self.kind=kind;self.tile=nil;self.targetId=nil;self.error=nil;self:render(ui.data()) end
        end)
        select.TextSize=11;self.cardButtons[kind]=select
    end
    self.description=text(self.actionCard,"",24,293,472,42,12,C.muted)
    text(self.actionCard,"CHOOSE THE PROPERTY",24,339,472,18,10,C.muted,true)
    self.properties=Instance.new("ScrollingFrame")
    self.properties.Position,self.properties.Size=UDim2.fromOffset(24,365),UDim2.fromOffset(472,112)
    self.properties.BackgroundTransparency,self.properties.BorderSizePixel,self.properties.ScrollBarThickness,self.properties.Parent=1,0,3,self.actionCard
    self.targetCaption=text(self.actionCard,"",24,483,472,18,10,C.muted,true)
    self.opponents=Instance.new("Frame")
    self.opponents.Position,self.opponents.Size,self.opponents.BackgroundTransparency,self.opponents.Parent=UDim2.fromOffset(24,507),UDim2.fromOffset(472,32),1,self.actionCard
    self.effect=text(self.actionCard,"",24,544,472,25,13,C.ink,true)
    self.play=button(self.actionCard,"Choose a property",24,580,332,42,C.green,function() self:playCard() end)
    button(self.actionCard,"Back",368,580,128,42,C.paper,function() self.actions.Visible=false end)
    self.actionStatus=text(self.actionCard,"",24,629,472,20,10,C.red)
    self.shortNames=short
    return self
end
function Menus:isOpen() return self.lobby.Visible or self.actions.Visible end
function Menus:openLobby() self.lobby.Visible=true;self.actions.Visible=false;self.error=nil;self:render(self.ui.data()) end
function Menus:toggleReady()
    local data=self.ui.data()
    if not data then return end
    for _,entry in ipairs(data.lobby) do if entry.id==self.ui.id then self.ui.send("Ready",not entry.ready);return end end
end
function Menus:feedback(message)
    self.pending=nil;self.error=message
    self:render(self.ui.data())
end
function Menus:resize(layout,rosterHeight)
    local y=layout.compact and layout.headerHeight+32 or math.min(layout.roster[2]+rosterHeight+60,layout.toolbar[2]-232)
    for index,button in ipairs({self.matchButton,self.cardsButton,self.styleButton}) do
        button.Position=UDim2.fromOffset(layout.compact and 24+(index-1)*172 or 24,layout.compact and y or y+(index-1)*46)
        button.Size=UDim2.fromOffset(layout.compact and 164 or 188,38)
    end
    if self.ui.cameraBar then
        local bar=self.ui.cameraBar
        bar.Position=UDim2.fromOffset(layout.compact and (layout.width-412)/2 or 24,layout.compact and y+46 or y+138)
        bar.Size=UDim2.fromOffset(layout.compact and 412 or 188,layout.compact and 42 or 84)
        local compact={{"TableView",6,86},{"CityView",96,86},{"RotateLeft",188,28},{"Fit",222,50},{"RotateRight",278,28},{"ZoomOut",312,40},{"ZoomIn",358,48}}
        local desktop={{"TableView",6,6,86},{"CityView",96,6,86},{"RotateLeft",6,45,28},{"Fit",39,45,44},{"RotateRight",88,45,28},{"ZoomOut",121,45,27},{"ZoomIn",153,45,28}}
        for index,spec in ipairs(desktop) do
            local object=bar:FindFirstChild(spec[1])
            object.Position=UDim2.fromOffset(layout.compact and compact[index][2] or spec[2],layout.compact and 6 or spec[3])
            object.Size=UDim2.fromOffset(layout.compact and compact[index][3] or spec[4],30)
        end
    end
end
function Menus:playCard()
    local data=self.ui.data()
    if not data or self.pending or not self.tile then return end
    local request={kind=self.kind,tile=self.tile,targetId=self.targetId,turn=data.game.turnCount}
    if self.ui.send("Card",request) then
        self.pending={turn=request.turn,seq=data.game.lastAction and data.game.lastAction.seq or 0,tile=self.tile}
        local pending=self.pending
        self.error=nil;self:render(data)
        task.delay(4,function()
            if self.pending==pending then
                self.pending=nil;self.error="No confirmation yet. Refreshing the match before you retry."
                self.ui.send("Sync");self:render(self.ui.data())
            end
        end)
    end
end
function Menus:render(data)
    if not data then return end
    local ui,C,config=self.ui,self.ui.colors,self.ui.config
    if self.revision~=data.revision then self.error=nil;self.revision=data.revision end
    local state,settings=data.game,data.lobbyConfig
    if state.status=="playing" and self.lastStatus~="playing" then
        self.lobby.Visible=false;self.actions.Visible=false;self.pending=nil
    end
    self.lastStatus=state.status
    local me,current
    for _,entry in ipairs(state.players) do if entry.id==ui.id then me=entry end end
    current=state.players[state.turn]
    local myTurn=state.status=="playing" and current and current.id==ui.id and current.alive
    local host=data.hostId==ui.id
    local queue=data.matchmaking or {mode="lobby",queued=false,status=""}
    local active=state.status=="playing" and me and me.alive
    local editable=host and not active and not queue.queued and queue.mode~="match"
    local mine,readyCount=nil,0
    for _,entry in ipairs(data.lobby) do
        if entry.id==ui.id then mine=entry end
        if entry.ready then readyCount=readyCount+1 end
    end
    local visiting=false
    for _,visitor in ipairs(data.visitors or {}) do if visitor.id==ui.id then visiting=true end end
    self.matchButton.Visible,self.cardsButton.Visible,self.styleButton.Visible=not visiting,not visiting,not visiting
    local total=0
    for _,count in pairs(me and me.cards or {}) do total=total+count end
    self.cardsButton.Text=me and me.challenge and me.challenge.ready and "Challenge reward ready!" or ("Cards &amp; goals · "..total)
    ui.available(self.cardsButton,state.status=="playing" and me~=nil and me.alive,C.green)
    if not settings then return end
    ui.available(self.two,editable,settings.seats==2 and C.green or C.paper)
    ui.available(self.four,editable,settings.seats==4 and C.green or C.paper)
    ui.available(self.bots,editable,C.paper)
    self.bots.Text="Practice fills empty seats with bots: "..(settings.fillBots and "ON" or "OFF")
    ui.available(self.downgrade,editable,settings.attackMode=="downgrade" and C.green or C.paper)
    ui.available(self.destroy,editable,settings.attackMode=="destroy" and C.green or C.paper)
    self.members:ClearAllChildren()
    for index,entry in ipairs(data.lobby) do
        local name=ui.text(self.members,(entry.ready and "✓ " or "○ ")..entry.name..(entry.id==data.hostId and " · host" or ""),8,(index-1)*28,450,26,13,Color3.fromHex(config.playerColors[entry.colorIndex] or "798579"),entry.id==ui.id)
        name.TextWrapped,name.TextTruncate=false,Enum.TextTruncate.AtEnd
    end
    self.members.CanvasSize=UDim2.fromOffset(0,#data.lobby*28)
    for index,button in ipairs(self.colorButtons) do
        local taken=false
        for _,entry in ipairs(data.lobby) do if entry.id~=ui.id and entry.colorIndex==index then taken=true end end
        button.Active=not active and not queue.queued and queue.mode~="match" and not taken
        button.BackgroundTransparency=taken and 0.6 or 0
        button.Text=mine and mine.colorIndex==index and "✓" or tostring(index)
    end
    self.ready.Text=mine and mine.ready and "Ready ✓ · click to unready" or "I'm ready to play"
    ui.available(self.ready,mine~=nil and not queue.queued and queue.mode~="match",mine and mine.ready and C.green or C.paper)
    local enough=readyCount&gt;=settings.seats or settings.fillBots
    self.lobbyStatus.Text=self.error or ((queue.queued or queue.mode=="match") and queue.status or (queue.status.." · "..#data.lobby.." in party · "..readyCount.." ready"))
    self.lobbyStatus.TextColor3=self.error and C.red or C.muted
    ui.available(self.start,editable and state.status~="playing" and mine~=nil and mine.ready and enough,C.paper)
    self.start.Text="Practice with "..settings.seats.." players"
    local partyReady=readyCount==#data.lobby and #data.lobby&lt;=settings.seats
    ui.available(self.queue,queue.mode=="match" or (queue.queued and not queue.connecting) or (host and not active and mine~=nil and mine.ready and partyReady),C.green)
    self.queue.Text=queue.mode=="match" and "Return to lobby" or (queue.queued and (queue.connecting and "Connecting…" or "Cancel queue") or ("Join "..settings.seats.."-player queue"))
    self.leaveParty.Text=queue.mode=="match" and "Leave match" or "Leave party"
    ui.available(self.leaveParty,not queue.connecting,C.paper)
    if not self.actions.Visible then return end
    if not me or not me.alive or state.status~="playing" then self.actions.Visible=false;self.pending=nil;return end
    if self.pending then
        local event=state.lastAction
        if event and event.seq&gt;self.pending.seq and event.actorId==ui.id then
            local tile=self.pending.tile
            self.pending=nil;self.actions.Visible=false;ui.focus(tile);return
        elseif self.pending.turn~=state.turnCount then self.pending=nil;self.error="Your turn changed. Choose your action again." end
    end
    local goal=me.challenge
    self.goalName.Text=goal.name
    self.goalText.Text=goal.description
    self.goalProgress.Text=goal.progress.." / "..goal.target.." · reward $"..goal.reward.." + card"
    self.claim.Text="Claim $"..goal.reward
    ui.available(self.claim,myTurn and goal.ready and not state.challengeClaimed,C.green)
    ui.available(self.newGoal,myTurn and not state.challengeSwapped and me.cash&gt;=config.challengeSwapCost,C.paper)
    self.cardStatus.Text=state.actionUsed and "YOUR TACTICAL CARD HAS BEEN USED THIS TURN" or "ONE TACTICAL CARD PER TURN · CHOOSE YOUR TARGETS"
    for kind,button in pairs(self.cardButtons) do
        button.Text=self.shortNames[kind].." ×"..(me.cards[kind] or 0)
        button.Active=not self.pending
        button.BackgroundColor3=kind==self.kind and C.green or C.paper
        button.TextColor3=kind==self.kind and C.white or C.ink
    end
    local definition=config.cardDefinitions[self.kind]
    self.description.Text=definition.description
    self.properties:ClearAllChildren();self.opponents:ClearAllChildren()
    local candidates={}
    for index,property in ipairs(state.properties) do
        if property.ownerId and ((definition.target=="rival" and property.ownerId~=ui.id) or (definition.target~="rival" and property.ownerId==ui.id)) then table.insert(candidates,index) end
    end
    if self.tile and not table.find(candidates,self.tile) then self.tile=nil end
    for row,index in ipairs(candidates) do
        local property=state.properties[index]
        local owner
        for _,entry in ipairs(state.players) do if entry.id==property.ownerId then owner=entry end end
        local select=ui.button(self.properties,config.tiles[index].name.." · "..(owner and owner.name or "").." · L"..property.level,2,(row-1)*33,466,28,self.tile==index and C.green or C.paper,function()
            if not self.pending then self.tile=index;self.error=nil;self:render(ui.data()) end
        end)
        select.TextSize=11
    end
    if #candidates==0 then ui.text(self.properties,definition.target=="rival" and "No opponent owns a house yet." or "Buy a property before using this card.",8,8,450,45,13,C.muted) end
    self.properties.CanvasSize=UDim2.fromOffset(0,#candidates*33)
    self.targetCaption.Text=definition.target=="demand" and "CHOOSE WHO MUST PAY" or (settings.attackMode=="destroy" and "ATTACK RULE: FULL HOUSE DEMOLITION" or "ATTACK RULE: REMOVE ONE LEVEL; L0 HOMES ARE DEMOLISHED")
    local activeOpponent=false
    if definition.target=="demand" then
        local row=0
        for _,entry in ipairs(state.players) do
            if entry.alive and entry.id~=ui.id then
                if entry.id==self.targetId then activeOpponent=true end
                local select=ui.button(self.opponents,entry.name, row*157,0,150,30,entry.id==self.targetId and C.green or C.paper,function() self.targetId=entry.id;self.error=nil;self:render(ui.data()) end)
                select.TextSize=11;row=row+1
            end
        end
    end
    local property=self.tile and state.properties[self.tile]
    local canPlay=myTurn and not state.actionUsed and not self.pending and (me.cards[self.kind] or 0)&gt;0 and property~=nil
    local message="Select a property to see the effect."
    if property then
        if self.kind=="collect" then
            local amount=math.min(config.demandCap,ui.rent(state,self.tile)*config.demandMultiplier)
            message="Demand $"..amount.." now using "..config.tiles[self.tile].name.."."
            canPlay=canPlay and activeOpponent
        elseif self.kind=="demolish" then
            message=property.shield and "A shield will block this attack; both cards are used." or (settings.attackMode=="destroy" or property.level==0) and "Demolish this house. The lot returns to the city." or ("Remove one level: L"..property.level.." → L"..(property.level-1))
        elseif self.kind=="boost" then
            message="Rent +50% for the next two payments.";canPlay=canPlay and (property.boost or 0)==0
        elseif self.kind=="shield" then message="Block the next demolition attempt.";canPlay=canPlay and not property.shield
        elseif self.kind=="repair" then message="Free upgrade: L"..property.level.." → L"..math.min(config.maxLevel,property.level+1);canPlay=canPlay and property.level&lt;config.maxLevel end
    end
    self.effect.Text=message
    ui.available(self.play,canPlay==true,C.green)
    self.play.Text=self.pending and "Playing card…" or (canPlay and "Play "..definition.name or (not myTurn and "Wait for your turn" or (state.actionUsed and "Card already used this turn" or "Choose valid targets")))
    self.actionStatus.Text=self.error or ((me.cards[self.kind] or 0)==0 and "You have no copies. Earn cards at City Gate, City News, the park or challenges." or "")
end
return Menus
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">TileLabels</string>
            <string name="Source">-- Upright, screen-sized labels keep the tabletop readable on every board edge.
local shared=game:GetService("ReplicatedStorage"):WaitForChild("Citymoney")
local Config,Architecture,Plans=require(shared.Config),require(shared.Architecture),require(shared.PropertyPlans)
local Labels={}
Labels.__index=Labels
function Labels.new(root,onSelect,onInteraction)
    local self=setmetatable({buttons={},revision=nil,enabled=nil},Labels)
    for index,tile in ipairs(Config.tiles) do
        local button=Instance.new("TextButton")
        button.Name,button.AnchorPoint,button.ZIndex="DeedLabel"..index,Vector2.new(0.5,0.5),5
        button.BackgroundColor3,button.BackgroundTransparency,button.BorderSizePixel=Color3.fromHex("FFF9E9"),0.12,0
        button.TextColor3,button.Font,button.TextWrapped=Color3.fromHex("263E34"),Enum.Font.GothamBold,true
        button.Text=tile.name;button.Parent=root
        local corner=Instance.new("UICorner");corner.CornerRadius,corner.Parent=UDim.new(0,5),button
        local outline=Instance.new("UIStroke");outline.Color,outline.Thickness,outline.ApplyStrokeMode,outline.Parent=Color3.fromHex(tile.group and Config.groups[tile.group].color or "85A393"),1.5,Enum.ApplyStrokeMode.Border,button
        button.Activated:Connect(function()
            if tile.kind=="property" then onSelect(index) else onInteraction(tile.kind=="park" and "contracts" or "news") end
        end)
        self.buttons[index]=button
    end
    return self
end
function Labels:update(camera,safe,scale,data,enabled,rect)
    local board=workspace:FindFirstChild("CitymoneyBoard")
    if self.enabled~=enabled or self.board~=board then
        self.enabled,self.board=enabled,board
        if board then
            for index=1,24 do
                local tile=board:FindFirstChild("Tile"..index)
                local caption=tile and tile:FindFirstChild("Caption")
                if caption then caption.Enabled=not enabled end
            end
        end
    end
    if data and self.revision~=data.revision then
        self.revision=data.revision
        for index,tile in ipairs(Config.tiles) do
            local property=data.game.properties[index]
            local owner
            for _,resident in ipairs(data.game.players) do if resident.id==property.ownerId then owner=resident end end
            local value=tile.kind=="property" and (owner and ("Rent $"..Plans.projectedRent(Config,data.game,owner.id,index,property.level)) or ("$"..tile.price)) or ""
            self.buttons[index].Text=tile.name..(value~="" and ("\n"..value) or "")
            self.buttons[index]:FindFirstChildOfClass("UIStroke").Color=Color3.fromHex(owner and Config.playerColors[owner.colorIndex] or (tile.group and Config.groups[tile.group].color or "85A393"))
        end
    end
    local offset=safe.AbsolutePosition
    for index,button in ipairs(self.buttons) do
        button.Visible=enabled
        if enabled then
            local p=Architecture.position(index)
            local q=Architecture.position(index%24+1)
            local screen,visible=camera:WorldToScreenPoint(Vector3.new(p[1],1.9,p[3]))
            local nextScreen=camera:WorldToScreenPoint(Vector3.new(q[1],1.9,q[3]))
            local dx,dy=math.abs(nextScreen.X-screen.X),math.abs(nextScreen.Y-screen.Y)
            local spacing=math.sqrt(dx*dx+dy*dy)
            local width=dx&gt;=dy and math.clamp(spacing*0.9,34,88) or math.clamp(spacing*1.4,50,86)
            local height=dx&gt;=dy and 40 or math.clamp(spacing*0.88,26,40)
            button.Size,button.Position=UDim2.fromOffset(width/scale,height/scale),UDim2.fromOffset((screen.X-offset.X)/scale,(screen.Y-offset.Y)/scale)
            button.TextSize=math.min(11,height/3.25)/scale
            button.Visible=visible and (not rect or (screen.X-width/2&gt;=rect[1] and screen.X+width/2&lt;=rect[1]+rect[3] and screen.Y-height/2&gt;=rect[2] and screen.Y+height/2&lt;=rect[2]+rect[4]))
        end
    end
end
return Labels
</string>
          </Properties>
        </Item>
      </Item>
    </Item>
