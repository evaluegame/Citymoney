      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Engine</string>
          <string name="Source">-- Pure Luau: no Roblox services. The server alone owns this state.
local Engine = {}
Engine.__index = Engine

function Engine.new(config, randomInteger)
    local self = setmetatable({}, Engine)
    self.config = config
    self.random = randomInteger or math.random
    self.state = { status = "lobby", players = {}, properties = {}, logs = {}, turn = 0,
        turnCount = 0, phase = "roll", pendingTile = false, dice = { 0, 0 }, winnerId = false }
    for i = 1, #config.tiles do
        self.state.properties[i] = { ownerId = false, level = 0 }
    end
    return self
end

function Engine:player(id)
    for _, player in ipairs(self.state.players) do
        if player.id == id then return player end
    end
    return nil
end

function Engine:current()
    return self.state.players[self.state.turn]
end

function Engine:log(message)
    table.insert(self.state.logs, 1, message)
    if #self.state.logs &gt; 6 then table.remove(self.state.logs) end
    self.state.notice = message
end

function Engine:start(roster)
    if self.state.status == "playing" then return false, "A match is already running." end
    if #roster &lt; 2 or #roster &gt; self.config.maxPlayers then return false, "A match needs 2–6 players." end
    local seen = {}
    for _, entry in ipairs(roster) do
        if seen[entry.id] then return false, "Duplicate player." end
        seen[entry.id] = true
    end
    self.state.players = {}
    for index, entry in ipairs(roster) do
        table.insert(self.state.players, { id = entry.id, name = entry.name, bot = entry.bot == true,
            cash = self.config.startingCash, position = 1, alive = true, detained = false, colorIndex = index })
    end
    for _, property in ipairs(self.state.properties) do
        property.ownerId, property.level = false, 0
    end
    self.state.status, self.state.turn, self.state.turnCount = "playing", 1, 1
    self.state.phase, self.state.pendingTile, self.state.winnerId = "roll", false, false
    self.state.dice, self.state.logs = { 0, 0 }, {}
    self:log("Welcome to Citymoney! " .. self:current().name .. " goes first.")
    return true
end

function Engine:ownsGroup(id, group)
    for index, tile in ipairs(self.config.tiles) do
        if tile.group == group and self.state.properties[index].ownerId ~= id then return false end
    end
    return self.config.groups[group] ~= nil
end

function Engine:rent(index)
    local tile, property = self.config.tiles[index], self.state.properties[index]
    if tile.kind ~= "property" then return 0 end
    local amount = tile.rent * self.config.rentMultipliers[property.level + 1]
    if property.level == 0 and property.ownerId and self:ownsGroup(property.ownerId, tile.group) then
        amount = amount * 2
    end
    return amount
end

function Engine:wealth(player)
    local total = player.cash
    for index, property in ipairs(self.state.properties) do
        if property.ownerId == player.id then
            local tile = self.config.tiles[index]
            total = total + tile.price + property.level * tile.upgrade
        end
    end
    return total
end

function Engine:checkWinner()
    local survivors = {}
    for _, player in ipairs(self.state.players) do
        if player.alive then table.insert(survivors, player) end
    end
    if #survivors &lt;= 1 or self.state.turnCount &gt; self.config.maxTurns then
        local winner = survivors[1]
        for _, player in ipairs(survivors) do
            if not winner or self:wealth(player) &gt; self:wealth(winner) then winner = player end
        end
        self.state.status, self.state.winnerId = "finished", winner and winner.id or false
        self.state.pendingTile = false
        self:log(winner and (winner.name .. " wins Citymoney with $" .. self:wealth(winner) .. " net worth!") or "The city is empty. Start a new match!")
        return true
    end
    return false
end

function Engine:liquidate(player, index)
    local property, tile = self.state.properties[index], self.config.tiles[index]
    local value = math.floor((tile.price + property.level * tile.upgrade) / 2)
    property.ownerId, property.level = false, 0
    player.cash = player.cash + value
    self:log(player.name .. " sold " .. tile.name .. " for $" .. value .. ".")
end

function Engine:pay(player, amount, recipient)
    -- Cash shortfalls sell deeds back to the city, in board order, at half cost.
    for index, property in ipairs(self.state.properties) do
        if player.cash &gt;= amount then break end
        if property.ownerId == player.id then self:liquidate(player, index) end
    end
    local paid = math.min(player.cash, amount)
    player.cash = player.cash - paid
    if recipient then recipient.cash = recipient.cash + paid end
    if paid &lt; amount then
        player.alive = false
        self:log(player.name .. " went bankrupt.")
        self:checkWinner()
    end
end

function Engine:sendToDetention(player)
    player.position, player.detained = 7, true
    self:log(player.name .. " is detained and will miss their next move.")
end

function Engine:land(player)
    local index = player.position
    local tile, property = self.config.tiles[index], self.state.properties[index]
    self.state.phase, self.state.pendingTile = "end", false
    self:log(player.name .. " landed on " .. tile.name .. ".")
    if tile.kind == "property" then
        if not property.ownerId then
            self.state.phase, self.state.pendingTile = "buy", index
        elseif property.ownerId ~= player.id then
            local owner = self:player(property.ownerId)
            local rent = self:rent(index)
            self:log(player.name .. " owes " .. owner.name .. " $" .. rent .. " rent.")
            self:pay(player, rent, owner)
        end
    elseif tile.kind == "tax" then
        self:log(player.name .. " owes $" .. tile.amount .. " city tax.")
        self:pay(player, tile.amount)
    elseif tile.kind == "detention" then
        self:sendToDetention(player)
    elseif tile.kind == "event" then
        local card = self.config.events[self.random(1, #self.config.events)]
        self:log(player.name .. ": " .. card.text)
        if card.detention then
            self:sendToDetention(player)
        elseif card.start then
            player.position = 1
            player.cash = player.cash + self.config.startBonus
        elseif card.amount &lt; 0 then
            self:pay(player, -card.amount)
        else
            player.cash = player.cash + card.amount
        end
    elseif tile.kind == "park" then
        self:log(player.name .. " is relaxing in Central Park.")
    end
end

function Engine:nextTurn()
    self.state.turnCount = self.state.turnCount + 1
    if self:checkWinner() then return end
    repeat
        self.state.turn = self.state.turn % #self.state.players + 1
    until self:current().alive
    self.state.phase, self.state.pendingTile, self.state.dice = "roll", false, { 0, 0 }
    self:log("It's " .. self:current().name .. "'s turn.")
end

function Engine:remove(id)
    local player = self:player(id)
    if not player or not player.alive or self.state.status ~= "playing" then return end
    player.alive, player.cash = false, 0
    for _, property in ipairs(self.state.properties) do
        if property.ownerId == id then property.ownerId, property.level = false, 0 end
    end
    self:log(player.name .. " left the match. Their deeds return to the city.")
    if not self:checkWinner() and self:current().id == id then self:nextTurn() end
end

function Engine:act(id, action, tileIndex: any)
    if self.state.status ~= "playing" then return false, "Start a match first." end
    local player = self:current()
    if not player or player.id ~= id then return false, "Wait for your turn." end
    if not player.alive and action ~= "End" then return false, "You are bankrupt. End your turn." end
    local phase = self.state.phase
    if action == "Roll" and phase == "roll" then
        if player.detained then
            player.detained, self.state.phase = false, "end"
            self:log(player.name .. " served their detention and can move next turn.")
        else
            local first, second = self.random(1, 6), self.random(1, 6)
            self.state.dice = { first, second }
            local destination = player.position + first + second
            if destination &gt; #self.config.tiles then
                player.cash = player.cash + self.config.startBonus
                self:log(player.name .. " passed City Gate and collected $" .. self.config.startBonus .. ".")
            end
            player.position = (destination - 1) % #self.config.tiles + 1
            self:land(player)
        end
    elseif action == "Buy" and phase == "buy" then
        local index = self.state.pendingTile
        local tile, property = self.config.tiles[index], self.state.properties[index]
        if property.ownerId then return false, "This property is already owned." end
        if player.cash &lt; tile.price then return false, "You need $" .. tile.price .. " to buy this property." end
        player.cash, property.ownerId = player.cash - tile.price, id
        self.state.phase, self.state.pendingTile = "end", false
        self:log(player.name .. " bought " .. tile.name .. " for $" .. tile.price .. "!")
    elseif action == "Skip" and phase == "buy" then
        self.state.phase, self.state.pendingTile = "end", false
        self:log(player.name .. " passed on the property.")
    elseif action == "End" and phase == "end" then
        self:nextTurn()
    elseif action == "Upgrade" or action == "Sell" then
        if type(tileIndex) ~= "number" or tileIndex ~= math.floor(tileIndex) then return false, "Select a property." end
        local tile, property = self.config.tiles[tileIndex], self.state.properties[tileIndex]
        if not tile or tile.kind ~= "property" or not property or property.ownerId ~= id then return false, "You don't own this property." end
        if action == "Sell" then
            self:liquidate(player, tileIndex)
        else
            if not self:ownsGroup(id, tile.group) then return false, "Own both properties in this district to build." end
            if property.level &gt;= self.config.maxLevel then return false, "This property is fully upgraded." end
            if player.cash &lt; tile.upgrade then return false, "Not enough cash to build." end
            player.cash, property.level = player.cash - tile.upgrade, property.level + 1
            self:log(player.name .. " upgraded " .. tile.name .. " to level " .. property.level .. ".")
        end
    else
        return false, "That action is unavailable right now."
    end
    return true
end

return Engine
</string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="6">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="7">
      <Properties>
        <string name="Name">CitymoneyServer</string>
        <token name="RunContext">0</token>
        <string name="Source">local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local shared = ReplicatedStorage:WaitForChild("Citymoney")
local Config = require(shared.Config)
local Engine = require(shared.Engine)
local World = require(script.World)
local random = Random.new()
local engine = Engine.new(Config, function(low, high) return random:NextInteger(low, high) end)
local world = World.new(Config)

local remotes = Instance.new("Folder")
remotes.Name, remotes.Parent = "Remotes", shared
local action = Instance.new("RemoteEvent")
action.Name, action.Parent = "Action", remotes
local snapshot = Instance.new("RemoteEvent")
snapshot.Name, snapshot.Parent = "Snapshot", remotes
local feedback = Instance.new("RemoteEvent")
feedback.Name, feedback.Parent = "Feedback", remotes

local joined, lastRequest = {}, {}
local deadline = 0
local revision = 0
local botReadyAt = 0
local function roster()
    local result = {}
    for _, player in ipairs(joined) do
        if player.Parent == Players then table.insert(result, { id = player.UserId, name = player.DisplayName }) end
    end
    return result
end

local function payload()
    local lobby = roster()
    return { game = engine.state, lobby = lobby, hostId = lobby[1] and lobby[1].id or false,
        deadline = deadline, serverTime = workspace:GetServerTimeNow(), revision = revision }
end

local function publish(resetTimer)
    revision = revision + 1
    if resetTimer then deadline = workspace:GetServerTimeNow() + Config.turnSeconds end
    botReadyAt = workspace:GetServerTimeNow() + 2.1
    world:sync(engine.state)
    snapshot:FireAllClients(payload())
end

local function perform(id, command, index)
    local previousTurn = engine.state.turnCount
    local previousPhase = engine.state.phase
    local ok, message = engine:act(id, command, index)
    if ok then
        local changedTurn = previousTurn ~= engine.state.turnCount
        publish(changedTurn or previousPhase ~= engine.state.phase)
    end
    return ok, message
end

local function hideAvatar(character)
    local humanoid = character:WaitForChild("Humanoid", 10)
    if humanoid then
        humanoid.WalkSpeed, humanoid.JumpPower, humanoid.AutoRotate = 0, 0, false
        humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
    end
    local root = character:WaitForChild("HumanoidRootPart", 10)
    if root then root.Anchored = true end
    local function hide(object)
        if object:IsA("BasePart") then object.Transparency, object.CanCollide = 1, false end
        if object:IsA("Decal") then object.Transparency = 1 end
    end
    for _, object in ipairs(character:GetDescendants()) do hide(object) end
    character.DescendantAdded:Connect(hide)
end

local function addPlayer(player)
    if table.find(joined, player) then return end
    table.insert(joined, player)
    player.CharacterAdded:Connect(hideAvatar)
    if player.Character then task.spawn(hideAvatar, player.Character) end
    publish(false)
end
Players.PlayerAdded:Connect(addPlayer)
for _, player in ipairs(Players:GetPlayers()) do addPlayer(player) end

Players.PlayerRemoving:Connect(function(player)
    local index = table.find(joined, player)
    if index then table.remove(joined, index) end
    lastRequest[player] = nil
    engine:remove(player.UserId)
    if #roster() == 0 then
        engine = Engine.new(Config, function(low, high) return random:NextInteger(low, high) end)
    end
    publish(true)
end)

action.OnServerEvent:Connect(function(player, command, index)
    if type(command) ~= "string" or #command &gt; 16 then return end
    local now = os.clock()
    if lastRequest[player] and now - lastRequest[player] &lt; 0.18 then return end
    lastRequest[player] = now
    if command == "Sync" then snapshot:FireClient(player, payload()); return end
    if command == "Start" then
        local lobby = roster()
        if not lobby[1] or lobby[1].id ~= player.UserId then feedback:FireClient(player, "Only the host can start a match."); return end
        if #lobby &gt; Config.maxPlayers then feedback:FireClient(player, "Set your server capacity to 6 players or fewer."); return end
        if #lobby == 1 then table.insert(lobby, { id = Config.botId, name = "City Bot", bot = true }) end
        local ok, message = engine:start(lobby)
        if ok then publish(true) else feedback:FireClient(player, message) end
        return
    end
    if index ~= nil and (type(index) ~= "number" or index ~= index or index % 1 ~= 0 or index &lt; 1 or index &gt; #Config.tiles) then return end
    local ok, message = perform(player.UserId, command, index)
    if not ok then feedback:FireClient(player, message) end
end)

-- A short server-owned clock prevents an AFK player from blocking the table.
task.spawn(function()
    while true do
        task.wait(0.5)
        if engine.state.status == "playing" then
            local current = engine:current()
            local now = workspace:GetServerTimeNow()
            if (current.bot and now &gt;= botReadyAt) or now &gt;= deadline then
                local phase = engine.state.phase
                if phase == "roll" then
                    perform(current.id, "Roll")
                elseif phase == "buy" then
                    local tile = Config.tiles[engine.state.pendingTile]
                    local buy = current.bot and current.cash &gt;= tile.price + 180
                    perform(current.id, buy and "Buy" or "Skip")
                else
                    if current.bot then
                        for index, property in ipairs(engine.state.properties) do
                            local tile = Config.tiles[index]
                            if property.ownerId == current.id and property.level &lt; Config.maxLevel
                                and engine:ownsGroup(current.id, tile.group) and current.cash &gt;= tile.upgrade + 250 then
                                engine:act(current.id, "Upgrade", index)
                            end
                        end
                    end
                    perform(current.id, "End")
                end
            end
        end
    end
end)

print("[Citymoney] Board ready. Open the client lobby to start a match.")
</string>
      </Properties>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">World</string>
          <string name="Source">local TweenService = game:GetService("TweenService")
local Board = require(game:GetService("ReplicatedStorage"):WaitForChild("Citymoney").Board)
local World = {}
World.__index = World

local function color(hex) return Color3.fromHex(hex) end

local function part(parent, name, size, position, tint, material)
    local object = Instance.new("Part")
    object.Name, object.Size, object.Position = name, size, position
    object.Anchored, object.Color = true, tint
    object.Material = material or Enum.Material.SmoothPlastic
    object.TopSurface, object.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
    object.Parent = parent
    return object
end

local function surface(object, text, tint, textSize)
    local gui = Instance.new("SurfaceGui")
    gui.Face, gui.SizingMode, gui.PixelsPerStud = Enum.NormalId.Top, Enum.SurfaceGuiSizingMode.PixelsPerStud, 48
    gui.Parent = object
    local label = Instance.new("TextLabel")
    label.Size, label.BackgroundTransparency = UDim2.fromScale(1, 1), 1
    label.Text, label.TextColor3, label.TextSize = text, tint, textSize or 32
    label.Font, label.TextWrapped = Enum.Font.GothamBold, true
    label.Parent = gui
end

function World.tilePosition(index)
    return Vector3.new(table.unpack(Board.position(index)))
end

function World.new(config)
    local self = setmetatable({ config = config, tokens = {}, propertyViews = {}, positions = {}, animations = {}, tweens = {} }, World)
    local old = workspace:FindFirstChild("CitymoneyBoard")
    if old then old:Destroy() end
    self.root = Instance.new("Folder")
    self.root.Name, self.root.Parent = "CitymoneyBoard", workspace
    for _, entry in ipairs(Board.generate(config)) do
        local object
        if entry.className == "SpawnLocation" then
            object = Instance.new("SpawnLocation")
            object.Name, object.Size = entry.name, Vector3.new(table.unpack(entry.size))
            object.Position, object.Anchored, object.Neutral, object.Duration = Vector3.new(table.unpack(entry.position)), true, true, 0
            object.Parent = self.root
        else
            object = part(self.root, entry.name, Vector3.new(table.unpack(entry.size)), Vector3.new(table.unpack(entry.position)), color(entry.color), Enum.Material[entry.material or "SmoothPlastic"])
        end
        object.Transparency = entry.transparency or 0
        if entry.shape then object.Shape = Enum.PartType[entry.shape] end
        if entry.tileIndex then object:SetAttribute("TileIndex", entry.tileIndex) end
        if entry.text then surface(object, entry.text, color(entry.textColor), entry.textSize) end
        if entry.light then
            local light = Instance.new("PointLight")
            light.Color, light.Brightness, light.Range, light.Parent = color(entry.color), 0.4, 10, object
        end
    end
    for index = 1, #config.tiles do
        local view = Instance.new("Folder")
        view.Name, view.Parent = "Ownership" .. index, self.root
        self.propertyViews[index] = { folder = view, key = "" }
    end
    return self
end

function World:tokenPosition(index, seat)
    local offset = Vector3.new(((seat - 1) % 3 - 1) * 2.6, 2.2, math.floor((seat - 1) / 3) * 2.6)
    return World.tilePosition(index) + offset
end

function World:sync(state)
    local present = {}
    for seat, player in ipairs(state.players) do
        present[player.id] = true
        local token = self.tokens[player.id]
        if not token then
            token = part(self.root, "Token_" .. player.id, Vector3.new(2.1, 2.1, 2.1), self:tokenPosition(player.position, seat), color(self.config.playerColors[player.colorIndex]), Enum.Material.Neon)
            token.Shape, token.CanCollide = Enum.PartType.Ball, false
            local tag = Instance.new("BillboardGui")
            tag.Size, tag.StudsOffset, tag.AlwaysOnTop, tag.MaxDistance = UDim2.fromOffset(140, 26), Vector3.new(0, 2, 0), true, 300
            tag.Parent = token
            local label = Instance.new("TextLabel")
            label.Size, label.BackgroundColor3, label.BackgroundTransparency = UDim2.fromScale(1, 1), color("173940"), 0.15
            label.Text, label.Font, label.TextSize, label.TextColor3 = player.name, Enum.Font.GothamBold, 13, color("FFFFFF")
            label.Parent = tag
            self.tokens[player.id] = token
        end
        token.Transparency = player.alive and 0 or 0.8
        local old = self.positions[player.id]
        if old ~= player.position then
            self.positions[player.id] = player.position
            local animation = (self.animations[player.id] or 0) + 1
            self.animations[player.id] = animation
            if self.tweens[player.id] then
                self.tweens[player.id]:Cancel()
                self.tweens[player.id] = nil
            end
            local destination = player.position
            local isDetention = player.detained
            task.spawn(function()
                local distance = old and ((destination - old) % #self.config.tiles) or 0
                if old and not isDetention and distance &gt; 0 and distance &lt;= 12 then
                    for step = 1, distance do
                        if self.animations[player.id] ~= animation or not token.Parent then return end
                        local index = (old + step - 1) % #self.config.tiles + 1
                        local tween = TweenService:Create(token, TweenInfo.new(0.12, Enum.EasingStyle.Quad), { Position = self:tokenPosition(index, seat) })
                        self.tweens[player.id] = tween
                        tween:Play()
                        tween.Completed:Wait()
                    end
                elseif token.Parent then
                    token.Position = self:tokenPosition(destination, seat)
                end
            end)
        end
    end
    for id, token in pairs(self.tokens) do
        if not present[id] then
            if self.tweens[id] then self.tweens[id]:Cancel(); self.tweens[id] = nil end
            token:Destroy()
            self.tokens[id], self.positions[id] = nil, nil
            self.animations[id] = (self.animations[id] or 0) + 1
        end
    end
    for index, property in ipairs(state.properties) do
        local view = self.propertyViews[index]
        local key = tostring(property.ownerId) .. ":" .. property.level
        if view.key ~= key then
            view.key = key
            view.folder:ClearAllChildren()
            if property.ownerId then
                local owner
                for _, player in ipairs(state.players) do
                    if player.id == property.ownerId then owner = player end
                end
                if owner then
                    local position = World.tilePosition(index)
                    part(view.folder, "OwnerMarker", Vector3.new(10, 0.25, 0.65), position + Vector3.new(0, 0.7, 4.8), color(self.config.playerColors[owner.colorIndex]), Enum.Material.Neon)
                    for level = 1, property.level do
                        local height = property.level == 3 and 4.5 or 1.8
                        local buildingPosition = position + Vector3.new((level - 2) * 2.8, 0.5 + height / 2, -2)
                        local building = part(view.folder, "Upgrade", Vector3.new(2.2, height, 2.5), buildingPosition, color(self.config.playerColors[owner.colorIndex]))
                        building:SetAttribute("TileIndex", index)
                        local roof = part(view.folder, "Roof", Vector3.new(2.5, 0.35, 2.8), buildingPosition + Vector3.new(0, height / 2, 0), color("304851"))
                        roof:SetAttribute("TileIndex", index)
                        part(view.folder, "Window", Vector3.new(0.8, 0.7, 0.08), buildingPosition + Vector3.new(0, 0.1, 1.3), color("FFE7AA"), Enum.Material.Neon)
                    end
                end
            end
        end
    end
end

return World
