local Config=require('../src/shared/Config')
local Engine=require('../src/shared/Engine')
local Offers=require('../src/shared/Opportunities')
local Flow=require('../src/shared/TurnFlow')
local Journey=require('../src/shared/Journey')
local Tactics=require('../src/shared/Tactics')
local passed=0
local function check(v,message) assert(v,message or 'Expected true') end
local function equal(a,b) assert(a==b,tostring(a)..' ~= '..tostring(b)) end
local function near(a,b) check(math.abs(a-b)<1e-6,tostring(a)..' is not '..tostring(b)) end
local function test(name,callback)
 local ok,message=pcall(callback);if not ok then error('FAIL '..name..': '..tostring(message),0) end
 passed=passed+1;print('PASS '..name)
end
local function game(random)
 local e=Engine.new(Config,random or function(low) return low end)
 check(e:start({{id=1,name='Avery'},{id=2,name='Riley'}}));return e
end
local function open(e)
 local p=e:player(1);p.stats.news=1;p.position=4;e:land(p);return e.state.pendingOffer
end
test('ordinary first City News still resolves the original event',function()
 local e=game();local p=e:player(1);p.position=4;e:land(p)
 equal(p.stats.news,1);equal(p.cash,1620);equal(e.state.phase,'end');check(not e.state.pendingOffer)
end)
test('the second City News offers a guaranteed choice without spending cash',function()
 local e=game();local pending=open(e)
 equal(e.state.phase,'offer');equal(pending.actorId,1);equal(pending.turn,1);equal(pending.definition,1);equal(e:player(1).cash,1500)
end)
test('opening a choice consumes no extra random draws',function()
 local calls=0;local e=game(function(low) calls=calls+1;return low end)
 open(e);equal(calls,0)
end)
test('snapshots retain old stats, property and goal values without exposing private hands',function()
 local e=game();local before=e:view(1)
 e:player(1).stats.news=2;e.state.properties[2].ownerId=1
 equal(before.players[1].stats.news,0);check(not before.properties[2].ownerId)
 before.players[1].cards.shield=99;equal(e:player(1).cards.shield,1)
 check(next(before.players[2].cards)==nil)
end)
test('cash is awarded once and repeated confirmations cannot grant it again',function()
 local e=game();open(e);local request=Offers.request(e.state,1)
 check(e:act(1,'Offer',request));equal(e:player(1).cash,1590);equal(e.state.phase,'end');check(not e.state.pendingOffer)
 check(not e:act(1,'Offer',request));equal(e:player(1).cash,1590)
end)
test('the card choice grants exactly one selected card and no cash',function()
 local e=game();open(e);local p=e:player(1);local count=p.cards.repair
 check(e:act(1,'Offer',Offers.request(e.state,2)));equal(p.cards.repair,count+1);equal(p.cash,1500)
 equal(e.state.lastOpportunity.card,'repair')
end)
test('a full card hand keeps the offer open and cash remains available',function()
 local e=game();open(e);local p=e:player(1);p.cards.repair=3
 check(not Offers.available(Config,p,Config.opportunities[1].choices[2]))
 check(not e:act(1,'Offer',Offers.request(e.state,2)));equal(p.cash,1500);equal(e.state.phase,'offer')
 check(e:act(1,'Offer',Offers.request(e.state,1)));equal(p.cash,1590)
end)
test('malformed, out-of-range and forged reward requests spend and grant nothing',function()
 local e=game();local pending=open(e)
 for _,request in ipairs({false,'cash',{}, {turn=1,seq=pending.seq,option=0},{turn=1,seq=pending.seq,option=3},{turn=1,seq=pending.seq,option=1.5},{turn=1,seq=pending.seq,option='1'},{turn=1,seq=pending.seq,option=0/0},{turn=1,seq=pending.seq,option=math.huge}}) do
  check(not e:act(1,'Offer',request));equal(e:player(1).cash,1500);equal(e:player(1).cards.repair,1)
 end
end)
test('spectators, opponents and eliminated players cannot take the active reward',function()
 local e=game();open(e);local request=Offers.request(e.state,1)
 check(not e:act(2,'Offer',request));check(not e:act(99,'Offer',request));e:player(1).alive=false
 check(not e:act(1,'Offer',request));equal(e:player(1).cash,1500)
end)
test('expired turns and sequence tokens cannot confirm a different opportunity',function()
 local e=game();open(e);local request=Offers.request(e.state,1)
 request.turn=0;check(not e:act(1,'Offer',request));request.turn=1;request.seq=request.seq+1
 check(not e:act(1,'Offer',request));equal(e:player(1).cash,1500)
end)
test('all five offers rotate deterministically across residents and visits',function()
 for seat=1,2 do for visit=1,#Config.opportunities do
  local e=game();local p=e:player(seat);p.stats.news=visit*2-1;p.position=4;e:land(p)
  local expected=(visit+seat-2)%#Config.opportunities+1
  equal(e.state.pendingOffer.definition,expected)
  local choices=Config.opportunities[expected].choices;check(choices[1].cash>0 and Config.cardDefinitions[choices[2].card]~=nil)
 end end
end)
test('bots take useful renovation cards or safe cash according to their city',function()
 local e=game();open(e);equal(Offers.botChoice(e,1).option,1)
 e.state.properties[2].ownerId=1;equal(Offers.botChoice(e,1).option,2)
 e:player(1).cash=100;equal(Offers.botChoice(e,1).option,1)
 e:player(1).cash=1500;e:player(1).cards.repair=3;equal(Offers.botChoice(e,1).option,1)
end)
test('player colors do not change opportunity rewards',function()
 local e=Engine.new(Config)
 check(e:start({{id=1,name='Avery',colorIndex=4},{id=2,name='Riley',colorIndex=6}}))
 equal(open(e).definition,1)
end)
test('random card rewards use remaining hand space instead of wasting a full card type',function()
 local e=game();local p=e:player(1)
 for _,kind in ipairs(Config.cardTypes) do p.cards[kind]=3 end
 p.cards.repair=1
 equal(Tactics.draw(e,p,2),2);equal(p.cards.repair,3);equal(Tactics.draw(e,p,1),0)
end)
test('full hands still earn challenge cash without a false card reward',function()
 local e=game();local p=e:player(1)
 for _,kind in ipairs(Config.cardTypes) do p.cards[kind]=3 end
 e.state.properties[2].ownerId=1;e.state.properties[3].ownerId=1;Tactics.refresh(e)
 check(e:act(1,'Claim',nil,nil,1));equal(p.cash,1640);check(string.find(e.state.notice,'hand is full',1,true)~=nil)
end)
test('AFK opportunities automatically choose cash after their decision deadline',function()
 local e=game();open(e);local f=Flow.new(Config);f:observe(e.state,100)
 equal(f:due(e.state,154.99),nil)
 local command,request=f:due(e.state,155);equal(command,'Offer');equal(request.option,1)
 check(e:act(1,command,request));equal(e:player(1).cash,1590);f:observe(e.state,155);equal(f.handoffAt,159)
end)
test('leaving, finishing and starting a new match clear pending rewards',function()
 local e=game();open(e);e:remove(1);check(not e.state.pendingOffer)
 check(e:start({{id=1,name='Avery'},{id=2,name='Riley'}}));check(not e.state.pendingOffer);equal(e.state.offerSeq,0);check(not e.state.lastOpportunity)
end)
test('a roll records the actual route before a City News teleport changes its destination',function()
 local e=game(function(low,high) return high==6 and 3 or (high==#Config.events and 6 or low) end)
 e:player(1).position=22;check(e:act(1,'Roll'))
 local roll=e.state.lastRoll;equal(roll.from,22);equal(roll.landedTile,4);equal(roll.to,1);equal(roll.steps,6)
 equal(e:player(1).position,1)
end)
test('detention movement records the route to the detention event before returning to jail',function()
 local e=game(function(_,high) return high==6 and 3 or 1 end)
 e:player(1).position=13;check(e:act(1,'Roll'))
 local roll=e.state.lastRoll;equal(roll.landedTile,19);equal(roll.to,7);check(e:player(1).detained)
end)
test('automatic handoff leaves four seconds to read the result after a twelve-space journey',function()
 local e=game(function(_,high) return high==6 and 6 or 1 end);local f=Flow.new(Config)
 f:observe(e.state,99);check(e:act(1,'Roll'));f:observe(e.state,100)
 near(f.journeyUntil,103.41);near(f.handoffAt,107.41);equal(f:due(e.state,107.40),nil);equal(f:due(e.state,107.41),'End')
end)
test('buy and offer decision clocks start after the dice and token have arrived',function()
 for _,phase in ipairs({'buy','offer'}) do
  local e=game();e.state.phase=phase;e.state.lastRoll={seq=1,turn=1,steps=8};local f=Flow.new(Config);f:observe(e.state,100)
  near(f.deadline,100+Journey.duration(Config,e.state.lastRoll)+55);equal(f:due(e.state,155),nil)
 end
end)
test('refreshes, cards and menus cannot replay or postpone a journey',function()
 local e=game();e.state.phase='end';e.state.lastRoll={seq=1,turn=1,steps=8};local f=Flow.new(Config);f:observe(e.state,100)
 local arrival,handoff=f.journeyUntil,f.handoffAt
 f:observe(e.state,101);e.state.lastAction={seq=1};f:observe(e.state,102)
 equal(f.journeyUntil,arrival);equal(f.handoffAt,handoff)
end)
test('early finish, purchase and reward requests wait until the token arrives',function()
 local e=game();e.state.phase='end';e.state.lastRoll={seq=1,turn=1,steps=8};local f=Flow.new(Config);f:observe(e.state,100)
 for _,command in ipairs({'End','Buy','Skip','Offer'}) do check(not f:allows(e.state,command,101));check(f:allows(e.state,command,f.journeyUntil)) end
end)
test('an early purchase cannot advance the next player before the visible landing',function()
 local e=game();local f=Flow.new(Config);e.state.phase='buy';e.state.lastRoll={seq=1,turn=1,steps=12};f:observe(e.state,100)
 e.state.phase='end';f:observe(e.state,100.2);near(f.handoffAt,107.41)
end)
test('historic rolls do not animate again on the next turn or after a match finishes',function()
 local e=game();e.state.phase='end';e.state.lastRoll={seq=1,turn=1,steps=8};local f=Flow.new(Config);f:observe(e.state,100)
 check(e:act(1,'End'));f:observe(e.state,200);equal(f.journeyUntil,0);equal(f.deadline,255)
 e.state.status='finished';f:observe(e.state,201);equal(f.journeyUntil,0);equal(f.deadline,0)
end)
print('\n'..passed..' opportunity, route and presentation-timing cases passed.')
