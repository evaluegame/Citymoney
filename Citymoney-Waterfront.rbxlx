      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Actors</string>
          <string name="Source">-- Asset-free residents and board poses, shared with the runtime and previews.
local runtimeScript=getfenv().script
local A=runtimeScript and require(runtimeScript.Parent.Architecture) or require("./Architecture")
local Journey=runtimeScript and require(runtimeScript.Parent.Journey) or require("./Journey")
local Actors={}
function Actors.offset(seat,index)
    local x,z=((seat-1)%3-1)*4.4,math.floor((seat-1)/3)*4.4-2.2
    local _,yaw=A.site(index or 1)
    return math.cos(yaw)*x+math.sin(yaw)*z,-math.sin(yaw)*x+math.cos(yaw)*z
end
function Actors.pose(index,seat,height,from)
    local p=A.position(index);local x,z=Actors.offset(seat,index)
    local dx,dz=-p[1],-p[3]
    if from then local previous=A.position(from);dx,dz=p[1]-previous[1],p[3]-previous[3] end
    return {p[1]+x,p[2]+(height or 2.3),p[3]+z},math.atan2(-dx,-dz)
end
function Actors.travel(config,roll,seat,elapsed,height)
    local steps=math.clamp(roll.steps or 0,0,12)
    if elapsed&lt;0 or steps==0 then return Actors.pose(roll.from,seat,height) end
    if elapsed&gt;=steps*Journey.stepSeconds(config) then return Actors.pose(roll.to or roll.landedTile,seat,height) end
    local step,progress,lift=Journey.sample(config,steps,elapsed)
    local from=(roll.from+step-2)%#config.tiles+1
    local to=from%#config.tiles+1
    local p=Actors.pose(from,seat,height)
    local q,yaw=Actors.pose(to,seat,height,from)
    return {p[1]+(q[1]-p[1])*progress,p[2]+(q[2]-p[2])*progress+lift,p[3]+(q[3]-p[3])*progress},yaw
end
function Actors.figure(color)
    local parts={}
    local function add(name,size,p,tint,extra)
        local s={};local position={}
        for axis=1,3 do s[axis]=size[axis]*1.15;position[axis]=p[axis]*1.15 end
        local entry={name=name,size=s,position=position,color=tint,material="SmoothPlastic",canCollide=false}
        for k,v in pairs(extra or {}) do entry[k]=v end
        table.insert(parts,entry)
    end
    add("Torso",{1.45,1.5,0.8},{0,0,0},color)
    add("Shirt",{0.7,1.15,0.09},{0,0.04,-0.45},"FFFFFF")
    add("Tie",{0.18,0.75,0.1},{0,0.14,-0.52},"3555A5")
    add("Collar",{1.1,0.18,0.1},{0,0.59,-0.49},"FFFFFF")
    add("Head",{1.1,1.1,1},{0,1.28,0},"F3C9A2",{shape="Ball"})
    add("Hair",{1.18,0.36,1.05},{0,1.74,0.08},"384C73")
    add("Fringe",{0.75,0.22,0.15},{-0.18,1.6,-0.48},"384C73")
    for _,side in ipairs({-1,1}) do
        add("Eye",{0.09,0.12,0.07},{side*0.22,1.33,-0.5},"243757",{shape="Ball"})
        add(side&lt;0 and "LeftLeg" or "RightLeg",{0.57,1.15,0.7},{side*0.4,-1.28,0},"355079")
        add("Shoe",{0.62,0.32,0.86},{side*0.4,-1.72,-0.08},"233554")
        add(side&lt;0 and "LeftArm" or "RightArm",{0.45,1.2,0.65},{side*1.02,0.02,0},color)
        add("Hand",{0.46,0.35,0.64},{side*1.02,-0.76,0},"F3C9A2")
    end
    add("Smile",{0.24,0.06,0.07},{0,1.06,-0.51},"A25D57")
    add("Briefcase",{0.7,0.65,0.32},{1.18,-1.04,0},"FFC34D")
    add("CaseHandle",{0.3,0.12,0.13},{1.18,-0.68,0},"355079")
    return parts
end
function Actors.preview(color,p,yaw)
    local parts=Actors.figure(color)
    local c,s=math.cos(yaw),math.sin(yaw)
    for _,entry in ipairs(parts) do
        local x,y,z=table.unpack(entry.position)
        entry.position={p[1]+c*x+s*z,p[2]+y,p[3]-s*x+c*z}
        entry.rotation=A.rotation(yaw)
    end
    table.insert(parts,{name="PlayerColorRing",size={0.12,4.4,4.4},position={p[1],p[2]-2.04,p[3]},color=color,shape="Cylinder",rotation=A.rotation(0,0,math.pi/2),material="Neon",canCollide=false})
    return parts
end
return Actors
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Architecture</string>
          <string name="Source">-- Asset-free, walkable homes. Shared by the live world, deed previews and build.
local Architecture = {}
local runtimeScript=getfenv().script
local Cosmetics=runtimeScript and require(runtimeScript.Parent.Cosmetics) or require("./Cosmetics")
Architecture.spacing, Architecture.radius = 20, 60

function Architecture.position(index)
    local step = index - 1
    if step &lt;= 6 then return { 60 - step * 20, 1.4, 60 } end
    if step &lt;= 12 then return { -60, 1.4, 60 - (step - 6) * 20 } end
    if step &lt;= 18 then return { -60 + (step - 12) * 20, 1.4, -60 } end
    return { 60, 1.4, -60 + (step - 18) * 20 }
end

function Architecture.site(index)
    local position = Architecture.position(index)
    local side = math.floor((index - 1) / 6)
    local yaw = -side * math.pi / 2
    local s, c = math.sin(yaw), math.cos(yaw)
    return { position[1] + s * 14, 1.8, position[3] + c * 14 }, yaw
end

-- Rotation = yaw * pitch * roll. Matrix rows are Roblox CFrame components.
function Architecture.rotation(yaw, pitch, roll)
    local c, s, a, b, d, e = math.cos(yaw), math.sin(yaw), math.cos(pitch or 0), math.sin(pitch or 0), math.cos(roll or 0), math.sin(roll or 0)
    return { c*d+s*b*e, -c*e+s*b*d, s*a, a*e, a*d, -b, -s*d+c*b*e, s*e+c*b*d, c*a }
end

function Architecture.house(origin, yaw, theme, level, tint, paint, owned, styleId)
    local parts = {}
    local c, s = math.cos(yaw), math.sin(yaw)
    local function add(name, size, x, y, z, color, extra)
        local value = { name = name, size = size, position = { origin[1]+c*x+s*z, origin[2]+y, origin[3]-s*x+c*z }, color = color,
            rotation = Architecture.rotation(yaw), material = "SmoothPlastic" }
        for key, entry in pairs(extra or {}) do value[key] = entry end
        if value.pitch or value.roll then value.rotation = Architecture.rotation(yaw, value.pitch, value.roll) end
        table.insert(parts, value)
        return value
    end
    local wall = ({ theme, tint, "FFF6DE", "6F89B4" })[(paint or 0) + 1] or theme
    local style=Cosmetics.get(styleId)
    local roof, trim, glass = owned and tint or "40535B", style.trim, style.glass
    local floors = level == 0 and 1 or (level == 3 and 3 or 2)
    local height, width, depth = floors * 6.5, ({12,13,14.2,14.8})[level+1], 9
    add("Foundation", { width+1, 0.5, depth+1 }, 0, 0.25, 0.8, style.stone, { material = style.premium and "Marble" or "Concrete" })
    add("Floor", { width, 0.25, depth }, 0, 0.65, 0.8, "C9AE89", { material = "WoodPlanks" })
    add("BackWall", { width, height, 0.4 }, 0, 0.7+height/2, 5.1, wall)
    add("LeftWall", { 0.4, height, depth }, -width/2, 0.7+height/2, 0.8, wall)
    add("RightWall", { 0.4, height, depth }, width/2, 0.7+height/2, 0.8, wall)
    -- A real opening, rather than a solid box with a painted-on door.
    add("FrontLeft", { width/2-1.5, 6.5, 0.4 }, -(width/4+0.75), 3.95, -3.7, wall)
    add("FrontRight", { width/2-1.5, 6.5, 0.4 }, width/4+0.75, 3.95, -3.7, wall)
    add("DoorLintel", { 3, 1, 0.5 }, 0, 6.7, -3.7, trim)
    add("Door", { 2.8, 5.5, 0.22 }, 0, 3.45, -3.78, style.door, { door = true, material = "Wood" })
    add("DoorGlass", { 1.75, 2.3, 0.08 }, 0, 4.1, -3.92, glass, { transparency = 0.2, material = "Glass", canCollide = false })
    add("Doorknob", { style.premium and 0.12 or 0.16, style.premium and 0.85 or 0.16, 0.16 }, 0.95, 3, -3.98, style.premium and style.accent or "CDB67E", { shape = style.premium and "Block" or "Ball", material = "Metal", canCollide = false })
    add("DoorFrame", { 3.3, 0.25, 0.7 }, 0, 6.25, -3.75, trim)
    add("Porch", { width+0.5, 0.35, 2.7 }, 0, 0.6, -5.1, style.premium and style.stone or "E4DDCD", {material=style.premium and "Marble" or "SmoothPlastic"})
    add("Step", { 4, 0.2, 1.4 }, 0, 0.25, -7, style.premium and style.stone or "E4DDCD")
    for _, x in ipairs({ -width/2+0.35, width/2-0.35 }) do
        add("PorchColumn", { 0.35, 5.8, 0.35 }, x, 3.65, -5.9, trim)
    end
    add("PorchCanopy", { width+1, 0.35, 3.1 }, 0, 6.7, -5.1, roof)
    add("OwnerFascia", { width+1.05, 0.2, 0.25 }, 0, 6.65, -6.65, tint)
    for _,x in ipairs({-width/2,width/2}) do
        add("FacadeCorner",{0.28,height,0.5},x,0.7+height/2,-3.9,trim)
        add("PorchRail",{0.2,1.4,2.1},x,1.8,-5.2,trim)
        add("PorchRailCap",{0.36,0.18,2.3},x,2.55,-5.2,tint)
    end
    for floor = 0, floors-1 do
        local base = 0.7 + floor * 6.5
        if floor &gt; 0 then
            add("UpperFacade", { width, 6.5, 0.4 }, 0, base+3.25, -3.7, wall)
            add("FloorBand", { width+0.3, 0.3, 0.5 }, 0, base, -3.7, trim)
            add("FloorBand", { width+0.3, 0.3, 0.5 }, 0, base, 5.1, trim)
            add("UpperFloor", { width-2.6, 0.25, depth }, -1.3, base, 0.8, "C9AE89", { material = "WoodPlanks" })
            add("StairLanding", { 2.6, 0.25, 1.5 }, width/2-1.3, base, 4.45, "C9AE89", { material = "WoodPlanks" })
            for step = 1, 12 do
                local rise = step*6.5/12
                add("StairTread", { 2.1, 0.2, 0.65 }, width/2-1.3, base-6.5+rise, -2.7+step*0.5, "C9AE89", { material = "WoodPlanks" })
            end
            add("BedFrame", { 3.5, 0.6, 4 }, -2.1, base+0.6, 1.1, "A38D70", { material = "Wood" })
            add("BedLinen", { 3.3, 0.4, 3.8 }, -2.1, base+1.1, 1.1, "EAE2CF")
            add("BedPillow", { 2.7, 0.3, 0.8 }, -2.1, base+1.4, 2.4, tint)
        end
        for _, x in ipairs({ -width*0.32, width*0.32 }) do
            add("WindowFrame", { 2.7, 3.3, 0.3 }, x, base+3.45, -3.98, trim)
            add("Window", { 2.25, 2.8, 0.1 }, x, base+3.45, -4.16, glass, { material = "Glass", canCollide = false })
            add("WindowMullion", { 0.12, 2.8, 0.12 }, x, base+3.45, -4.25, trim)
            add("WindowCrossbar", { 2.3, 0.12, 0.12 }, x, base+3.45, -4.25, trim)
            for _,side in ipairs({-1,1}) do add("WindowShutter",{0.55,3.1,0.18},x+side*1.64,base+3.45,-4.08,tint) end
            if floor == 0 then
                add("FlowerBox", { 3, 0.5, 0.7 }, x, base+1.6, -4.45, "9D8069", { material = "WoodPlanks" })
                add("Flowers", { 2.6, 0.35, 0.6 }, x, base+1.9, -4.45, "64815C", { canCollide = false })
                for flower = -1, 1 do
                    add("Blossom", { 0.4, 0.4, 0.4 }, x+flower*0.75, base+2.15, -4.45, flower==0 and "E6CCA2" or "D4A4AD", { shape = "Ball", canCollide = false })
                end
            end
        end
        for _, side in ipairs({ -1, 1 }) do
            add("SideWindowFrame", { 0.2, 2.9, 3 }, side*(width/2+0.22), base+3.5, 0.8, trim)
            add("SideWindow", { 0.1, 2.45, 2.6 }, side*(width/2+0.35), base+3.5, 0.8, glass, { material = "Glass", canCollide = false })
            add("BackWindowFrame", { 2.8, 3.1, 0.25 }, side*width*0.28, base+3.5, 5.35, trim)
            add("BackWindow", { 2.3, 2.6, 0.2 }, side*width*0.28, base+3.5, 5.52, glass, { material = "Glass", canCollide = false })
            add("BackMullion", { 0.13, 2.6, 0.1 }, side*width*0.28, base+3.5, 5.67, trim)
        end
    end
    if level &lt; 2 then
        local roofY = height + 2.35
        add("FrontRoof", { width+2, 0.5, 6.3 }, 0, roofY, -1.65, roof, { pitch = math.rad(-27), material = "Slate" })
        add("BackRoof", { width+2, 0.5, 6.3 }, 0, roofY, 3.25, roof, { pitch = math.rad(27), material = "Slate" })
        add("RoofRidge", { width+2.1, 0.4, 0.45 }, 0, roofY+1.4, 0.8, tint)
        add("Chimney", { 1.1, 3.3, 1.1 }, width/2-1.2, height+2.2, 2, "B88B72", { material = "Brick" })
        add("ChimneyCap",{1.5,0.35,1.5},width/2-1.2,height+3.8,2,trim)
        for _,x in ipairs({-(width+1.6)/2,(width+1.6)/2}) do
            add("RoofBarge",{0.2,0.65,6.4},x,roofY,-1.65,trim,{pitch=math.rad(-27)})
            add("RoofBarge",{0.2,0.65,6.4},x,roofY,3.25,trim,{pitch=math.rad(27)})
        end
        if level==1 then
            add("DormerWall",{3.8,2.1,1.4},0,roofY+0.9,-1.8,trim)
            add("DormerGlass",{2.6,1.5,0.12},0,roofY+1,-2.58,glass,{material="Glass",canCollide=false})
            add("DormerRoof",{4.4,0.3,1.9},0,roofY+2.1,-1.9,tint)
        end
    else
        add("PenthouseRoof", { width+1.1, 0.5, depth+1.1 }, 0, height+0.95, 0.8, owned and tint or trim)
        add("RoofGarden", { width-1, 0.25, depth-1 }, 0, height+1.35, 0.8, "7E9D76", { material = "Grass" })
        add("RoofHedge", { width, 1, 0.7 }, 0, height+1.9, 5, "547C61", { material = "Grass" })
        for _, x in ipairs({ -width*0.35, width*0.35 }) do
            for _, z in ipairs({ -2, 3.2 }) do
                add("PergolaPost", { 0.22, 3.1, 0.22 }, x, height+2.9, z, "A38D70", { material = "Wood" })
            end
        end
        for z = -2.3, 3.7, 1 do
            add("PergolaSlat", { width*0.8, 0.2, 0.35 }, 0, height+4.5, z, "A38D70", { material = "Wood" })
        end
        add("Balcony", { width+0.6, 0.3, 2.3 }, 0, 7.1, -4.6, trim)
        add("BalconyGlass", { width+0.6, 1.9, 0.15 }, 0, 8.15, -5.65, glass, { transparency = 0.4, material = "Glass" })
        for _, x in ipairs({ -width/2, width/2 }) do add("BalconyPost", { 0.12, 2, 0.2 }, x, 8.1, -5.65, roof) end
        if level==3 then
            for _,x in ipairs({-width/2+0.5,width/2-0.5}) do
                add("VillaTower",{height+0.3,1.4,1.4},x,height/2+0.8,4.5,trim,{shape="Cylinder",roll=math.pi/2})
                add("VillaFinial",{1.8,1.8,1.8},x,height+1.8,4.5,tint,{shape="Ball"})
            end
        end
    end
    -- Interior details visible through the doorway in walking mode.
    add("Rug", { 5, 0.06, 4 }, 0, 0.81, 0.3, "D8BD9C", { canCollide = false })
    add("Sofa", { 4, 0.9, 1.8 }, -2.4, 1.4, 3.4, "A4B5A8")
    add("SofaBack", { 4, 1.5, 0.4 }, -2.4, 2, 4.1, "A4B5A8")
    add("CoffeeTable", { 2.4, 0.7, 1.4 }, -1.8, 1.2, 1, "9B7C5B", { material = "Wood" })
    add("InteriorLight", { 1.4, 0.2, 1.4 }, 0, 6.7, 0.8, style.light, { material = "Neon", light = true, canCollide = false })
    return parts
end

function Architecture.property(config, index, ownerName, ownerTint, level, paint, effects, styleId)
    local tile = config.tiles[index]
    local origin, yaw = Architecture.site(index)
    local c, s, entries = math.cos(yaw), math.sin(yaw), {}
    local function add(name, size, x, y, z, tint, extra)
        local value = { name = name, size = size, position = { origin[1]+c*x+s*z, origin[2]+y, origin[3]-s*x+c*z }, color = tint,
            rotation = Architecture.rotation(yaw), tileIndex = index }
        for key, entry in pairs(extra or {}) do value[key] = entry end
        table.insert(entries, value)
    end
    add("ParcelPlinth",{18.9,0.35,18.9},0,-0.35,0,"DCE6F4")
    add("Lawn", { 18.6, 0.3, 18.6 }, 0, -0.1, 0, ownerName and "72D394" or "EDF4FF", { material = ownerName and "Grass" or "SmoothPlastic" })
    if ownerName then
    add("GardenPath", { 3.5, 0.12, 8 }, 0, 0.12, -5.2, "F6FAFF", { material = "Concrete" })
    for _, x in ipairs({ -8.4, 8.4 }) do
        add("Hedge", { 0.85, 1.3, 16.5 }, x, 0.6, 0.2, "557D5A", { material = "Grass" })
        for z = -7, 7, 7 do add("FencePost", { 0.35, 1.8, 0.35 }, x, 0.8, z, "EEE3CC") end
    end
    add("BackHedge", { 17.6, 1.3, 0.85 }, 0, 0.6, 8.1, "557D5A", { material = "Grass" })
    else
        add("DeedAccent",{17.8,0.2,2},0,0.15,7.6,config.groups[tile.group].color)
        for _,x in ipairs({-7.6,7.6}) do for _,z in ipairs({-7.6,7.6}) do
            add("LotCorner",{2.4,0.08,0.22},x-(x&gt;0 and 1 or -1),0.13,z,"B8CDE8")
            add("LotCorner",{0.22,0.08,2.4},x,0.13,z-(z&gt;0 and 1 or -1),"B8CDE8")
        end end
    end
    if ownerName then
        for _,x in ipairs({-9,9}) do add("OwnershipBorder",{0.3,0.35,18.3},x,0.22,0,ownerTint) end
        for _,z in ipairs({-9,9}) do add("OwnershipBorder",{18.3,0.35,0.3},0,0.22,z,ownerTint) end
        local style=Cosmetics.get(styleId)
        local house = Architecture.house(origin, yaw, config.groups[tile.group].color, level or 0, ownerTint, paint or 0, true,style.id)
        for _, entry in ipairs(house) do entry.tileIndex = index; table.insert(entries, entry) end
        add("Mailbox", { 0.7, 1, 0.65 }, 5.9, 1.7, -7.9, ownerTint)
        add("MailboxPost", { 0.2, 1.4, 0.2 }, 5.9, 0.7, -7.9, "EEE3CC")
        add("OwnerSign", { 5, 1.4, 0.16 }, -5.2, 1.7, -8, "F6EFDF",
            { text = ownerName .. "'s home", textFace = "Front", textColor = "263E3A", textSize = 27, canCollide = false })
        add("OwnerStripe", { 5, 0.18, 0.2 }, -5.2, 2.5, -8, ownerTint)
        add("OwnerFlagpole",{0.16,4.2,0.16},7.6,2.1,-7.6,"ECE6D5",{material="Metal"})
        add("OwnerFlag",{1.8,1.1,0.12},6.7,3.7,-7.6,ownerTint)
        if style.premium then
            -- Decorations are queryable for inspection, but never obstruct the doorway or stairs.
            for _,x in ipairs({-8.2,8.2}) do
                add("ClubPlanter",{1.05,0.9,1.8},x,0.5,2.4,style.stone,{material="Marble",canCollide=false})
                add("ClubPlanterBand",{1.1,0.15,1.85},x,0.95,2.4,style.accent,{material="Metal",canCollide=false})
                add("ClubTopiary",{1.1,2.4,1.5},x,2.2,2.4,style.id=="rose" and "F298BD" or "69CC96",{shape="Ball",material="Grass",canCollide=false})
                add("ClubLanternPost",{0.18,2.4,0.18},x,1.2,-5.6,style.accent,{material="Metal",canCollide=false})
                add("ClubLanternBase",{0.7,0.2,0.7},x,2.45,-5.6,style.accent,{material="Metal",canCollide=false})
                add("ClubLantern",{0.45,0.8,0.45},x,2.9,-5.6,style.light,{material="Neon",light=true,canCollide=false})
                add("ClubLanternCap",{0.75,0.16,0.75},x,3.4,-5.6,style.accent,{material="Metal",canCollide=false})
            end
            add("ClubStepInlay",{3.8,0.04,0.12},0,0.37,-7.5,style.accent,{material="Metal",canCollide=false})
            add("ClubCanopyTrim",{(level or 0)&gt;=2 and 12.6 or 11.1,0.12,0.2},0,6.85,-6.65,style.accent,{material="Metal",canCollide=false})
            for _,x in ipairs({-8.75,8.75}) do add("ClubLightInlay",{0.08,0.08,15.5},x,0.45,0,style.accent,{material="Neon",canCollide=false}) end
            add("ClubCrest",{0.7,0.7,0.14},6.7,3.7,-7.7,style.accent,{roll=math.pi/4,rotation=Architecture.rotation(yaw,0,math.pi/4),material="Metal",canCollide=false})
            add("ClubPlaque",{5,0.65,0.16},-5.2,0.6,-8.08,style.dice,{text="CLUB · "..style.label,textFace="Front",textColor=style.accent,textSize=20,canCollide=false})
            add("ClubSculptureBase",{1.8,0.55,1.8},-6.5,0.4,6.3,style.stone,{material="Marble",canCollide=false})
            add("ClubSculpture",{1.25,style.id=="aurora" and 3.3 or 1.7,1.25},-6.5,2,6.3,style.accent,{shape=style.id=="aurora" and "Block" or "Ball",material=style.id=="aurora" and "Glass" or "Metal",canCollide=false,rotation=Architecture.rotation(yaw,0,math.pi/5)})
        end
        if effects and effects.shield then
            add("ProtectionSign",{4,0.9,0.16},-5.2,3.4,-8,"A9D0DE",{text="SHIELDED",textFace="Front",textColor="284453",textSize=24,canCollide=false})
        end
        if effects and (effects.boost or 0)&gt;0 then
            add("RentBoostSign",{4,0.9,0.16},2.5,1.5,-8,"E8C78B",{text="RENT +50%",textFace="Front",textColor="59462C",textSize=22,canCollide=false})
        end
        if effects and (effects.rentTier or 1)&gt;1 then
            add("RentRateSign",{4,0.9,0.16},2.5,2.6,-8,"DCE4CF",{text=tostring(config.rentTiers[effects.rentTier]).."× RENT",textFace="Front",textColor="3D583D",textSize=22,canCollide=false})
        end
        add("GardenTreeTrunk", { 0.35, 2.5, 0.35 }, 7.8, 1.25, 6.8, "AA8869", { material = "Wood" })
        add("GardenTree", { 2.4, 2.7, 2.4 }, 7.8, 3.7, 6.8, "67C98F", { shape = "Ball", material = "Grass" })
    else
        -- Empty lots stay empty until a player buys the selected home level.
        add("SaleSign", { 13.6, 0.12, 8.2 }, 0, 0.23, -0.4, "FFFFFF",
            { text = "FOR SALE\n$" .. tile.price, textFace = "Top", textColor = "3555A5", textSize = 64,canCollide=false })
    end
    return entries
end

function Architecture.porch(index)
    local origin, yaw = Architecture.site(index)
    return { origin[1]-math.sin(yaw)*7, 2.5, origin[3]-math.cos(yaw)*7 }, yaw
end

return Architecture
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Board</string>
          <string name="Source">-- A clear tabletop route surrounding four interactive city-plaza destinations.
local runtimeScript=getfenv().script
local Architecture=runtimeScript and require(runtimeScript.Parent.Architecture) or require("./Architecture")
local Dice=runtimeScript and require(runtimeScript.Parent.Dice) or require("./Dice")
local Art=runtimeScript and require(runtimeScript.Parent.CityArt) or require("./CityArt")
local Districts=runtimeScript and require(runtimeScript.Parent.CityDistricts) or require("./CityDistricts")
local Scenery=runtimeScript and require(runtimeScript.Parent.CityScenery) or require("./CityScenery")
local Board={spacing=Architecture.spacing}
Board.position=Architecture.position
function Board.generate(config)
    local parts={}
    local function add(name,size,position,color,extra)
        local entry={name=name,size=size,position=position,color=color,material="SmoothPlastic"}
        for key,value in pairs(extra or {}) do entry[key]=value end
        table.insert(parts,entry)
    end
    local function rounded(name,size,position,radius,color,extra)
        for _,entry in ipairs(Art.rounded(name,size,position,radius,color,extra)) do table.insert(parts,entry) end
    end
    add("Sea",{1400,3,1400},{0,-7,0},"56C9E6",{reflectance=0.08,canCollide=false})
    rounded("IslandBody",{181,5,181},{0,-2,0},14,"3F9DD4")
    rounded("IslandBeach",{179,0.7,179},{0,0.75,0},13,"F8DE9D")
    rounded("TableSurface",{175,0.4,175},{0,1.22,0},11,"F7FAFF")
    rounded("EventPlaza",{99,0.28,99},{0,1.5,0},8,"74D6A0")
    add("CityRoad",{10,0.12,97},{0,1.75,0},"8FA9CB")
    add("CityRoad",{97,0.12,10},{0,1.75,0},"8FA9CB")
    for offset=-43,43,8.6 do
        add("RoadMark",{0.3,0.06,3},{0,1.84,offset},"FFFFFF")
        add("RoadMark",{3,0.06,0.3},{offset,1.84,0},"FFFFFF")
    end
    rounded("DiceTray",{40,0.45,28},{0,1.95,0},3,"386BF0",{interaction="dice"})
    for _,x in ipairs({-20,20}) do add("DiceRail",{0.55,0.65,23},{x,2.5,0},"FFFFFF",{interaction="dice"}) end
    for _,z in ipairs({-14,14}) do add("DiceRail",{34,0.65,0.55},{0,2.5,z},"FFFFFF",{interaction="dice"}) end
    add("DiceInstructions",{30,0.08,4.7},{0,2.23,9},"386BF0",{text="LET'S ROLL!",textColor="FFFFFF",textSize=60,interaction="dice"})
    for side,value in ipairs({1,6}) do for _,entry in ipairs(Dice.preview(value,side)) do table.insert(parts,entry) end end
    for _,entry in ipairs(Districts.generate()) do table.insert(parts,entry) end
    for _,entry in ipairs(Scenery.generate()) do table.insert(parts,entry) end
    add("CityTitle",{40,0.1,6},{0,1.75,-44},"74D6A0",{text="CITYMONEY",textSize=80,textColor="FFFFFF"})
    local function car(x,z,color)
        rounded("CityCar",{3.8,1.2,6.4},{x,2.7,z},0.8,color)
        rounded("CarCabin",{3.2,1.4,3.1},{x,3.75,z+0.25},0.6,"C8EDFA")
        for _,dx in ipairs({-1.7,1.7}) do for _,dz in ipairs({-1.9,1.9}) do add("CarWheel",{0.55,1.25,1.25},{x+dx,2.3,z+dz},"355079",{shape="Cylinder"}) end end
    end
    car(-44,17,"FFC34D");car(44,-17,"FF8B9B")
    for index,tile in ipairs(config.tiles) do
        local position=Board.position(index)
        local _,yaw=Architecture.site(index)
        local tint=tile.group and config.groups[tile.group].color or "7DC8F1"
        local caption=tile.price and (tile.name.."\n$"..tile.price) or tile.name
        local tileSize=(index-1)%6==0 and {18.8,0.4,18.8} or {18.8,0.4,11.4}
        add("Tile"..index,tileSize,position,"FFFFFF",{rotation=Architecture.rotation(yaw),text=caption,textSize=100,textColor="29466D",tileIndex=index})
        local c,s=math.cos(yaw),math.sin(yaw)
        add("DistrictInlay",{18.4,0.1,1.65},{position[1]+s*4.7,1.68,position[3]+c*4.7},tint,{tileIndex=index,rotation=Architecture.rotation(yaw)})
        if tile.kind=="property" then
            for _,entry in ipairs(Architecture.property(config,index,false,tint,0,0)) do table.insert(parts,entry) end
        else
            local site=Architecture.site(index)
            for _,entry in ipairs(Art.rounded("CityStop",{16,0.3,16},site,2.5,tint)) do table.insert(parts,entry) end
            local interaction=tile.kind=="event" and "news" or (tile.kind=="park" and "contracts" or "news")
            add("CityStopLabel",{14,0.1,9},{site[1],2,site[3]},"FFFFFF",{rotation=Architecture.rotation(yaw),interaction=interaction,text=tile.kind=="park" and "FREE CARD" or (tile.kind=="start" and "+$200" or tile.name),textColor="386BF0",textSize=70})
        end
    end
    add("LobbySpawn",{4,1,4},{0,2,44},"FFFFFF",{className="SpawnLocation",transparency=1})
    return parts
end
return Board
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">BoardCamera</string>
          <string name="Source">-- Perspective fitting into a HUD-free screen rectangle, including tall houses.
local Camera={}
local function dot(a,b) return a[1]*b[1]+a[2]*b[2]+a[3]*b[3] end
function Camera.cityBounds(config,architecture,state)
    local points={}
    for _,x in ipairs({-91,91}) do for _,y in ipairs({-4,2}) do for _,z in ipairs({-91,91}) do table.insert(points,{x,y,z}) end end end
    for index,tile in ipairs(config.tiles) do if tile.kind=="property" then
        local site=architecture.site(index)
        local height=29
        if state then
            local property=state.properties[index]
            height=property.ownerId and ({13,20,21,29})[property.level+1] or 2.2
        end
        for _,x in ipairs({-9.5,9.5}) do for _,y in ipairs({1.5,height}) do for _,z in ipairs({-9.5,9.5}) do table.insert(points,{site[1]+x,y,site[3]+z}) end end end
    end end
    for _,x in ipairs({-39,39}) do for _,z in ipairs({-39,39}) do table.insert(points,{x,21,z}) end end
    return {min={-92,-4,-92},max={92,29,92},target={0,5,0},points=points}
end
function Camera.fromSlopes(slopes,yaw,elevation,zoom,bounds)
    local left,right,bottom,top=table.unpack(slopes)
    local back={math.sin(yaw)*math.cos(elevation),math.sin(elevation),math.cos(yaw)*math.cos(elevation)}
    local rightAxis={math.cos(yaw),0,-math.sin(yaw)}
    local up={-math.sin(yaw)*math.sin(elevation),math.cos(elevation),-math.cos(yaw)*math.sin(elevation)}
    bounds=bounds or {min={-92,-4,-92},max={92,33,92}}
    local target={}
    for axis=1,3 do target[axis]=(bounds.min[axis]+bounds.max[axis])/2 end
    target=bounds.target or target
    local points=bounds.points
    if not points then
        points={}
        for _,x in ipairs({bounds.min[1],bounds.max[1]}) do for _,y in ipairs({bounds.min[2],bounds.max[2]}) do for _,z in ipairs({bounds.min[3],bounds.max[3]}) do table.insert(points,{x,y,z}) end end end
    end
    -- Solve the smallest perspective frustum containing the city. Allowing the
    -- target to shift within the free rectangle avoids wasted space above it.
    local rMax,rMin,uMax,uMin,near=-math.huge,math.huge,-math.huge,math.huge,1
    for _,point in ipairs(points) do
        local p={point[1]-target[1],point[2]-target[2],point[3]-target[3]}
        local r,u,b=dot(p,rightAxis),dot(p,up),dot(p,back)
        rMax,rMin=math.max(rMax,r+right*b),math.min(rMin,r+left*b)
        uMax,uMin=math.max(uMax,u+top*b),math.min(uMin,u+bottom*b)
        near=math.max(near,b+1)
    end
    local distance=math.max(near,(rMax-rMin)/(right-left),(uMax-uMin)/(top-bottom))*(zoom or 1)
    local offsetR=(rMax+rMin-(right+left)*distance)/2
    local offsetU=(uMax+uMin-(top+bottom)*distance)/2
    local position={}
    for axis=1,3 do position[axis]=target[axis]+back[axis]*distance+rightAxis[axis]*offsetR+up[axis]*offsetU end
    return {position=position,right=rightAxis,up=up,back=back,fov=36}
end
function Camera.fit(width,height,rect,yaw,elevation,zoom,bounds)
    local tanV=math.tan(math.rad(36)/2)
    local tanH=tanV*width/height
    local left,right=((rect[1]+10)/width*2-1)*tanH,((rect[1]+rect[3]-10)/width*2-1)*tanH
    local bottom,top=(1-(rect[2]+rect[4]-10)/height*2)*tanV,(1-(rect[2]+10)/height*2)*tanV
    local result=Camera.fromSlopes({left,right,bottom,top},yaw,elevation,zoom,bounds)
    result.tanV,result.tanH,result.width,result.height=tanV,tanH,width,height
    return result
end
function Camera.project(frame,point)
    local relative={point[1]-frame.position[1],point[2]-frame.position[2],point[3]-frame.position[3]}
    local depth=-dot(relative,frame.back)
    return (dot(relative,frame.right)/(depth*frame.tanH)+1)*frame.width/2,(1-dot(relative,frame.up)/(depth*frame.tanV))*frame.height/2,depth
end
return Camera
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">CityArt</string>
          <string name="Source">-- Sculpted primitives shared by Studio, the runtime world and review renders.
local runtimeScript=getfenv().script
local Architecture=runtimeScript and require(runtimeScript.Parent.Architecture) or require("./Architecture")
local Art={}
function Art.rounded(name,size,position,radius,color,extra)
    local result={}
    local function add(s,p,shape,rotation)
        local entry={name=name,size=s,position=p,color=color,shape=shape,rotation=rotation,material="SmoothPlastic"}
        for key,value in pairs(extra or {}) do entry[key]=value end
        table.insert(result,entry)
    end
    local x,y,z=table.unpack(size)
    add({x-2*radius,y,z},position)
    for _,side in ipairs({-1,1}) do
        add({radius,y,z-2*radius},{position[1]+side*(x/2-radius/2),position[2],position[3]})
    end
    for _,dx in ipairs({-1,1}) do for _,dz in ipairs({-1,1}) do
        -- Sink round caps slightly; coplanar overlapping top faces flicker in-engine.
        add({y,radius*2,radius*2},{position[1]+dx*(x/2-radius),position[2]-0.018,position[3]+dz*(z/2-radius)},"Cylinder",Architecture.rotation(0,0,math.pi/2))
    end end
    return result
end
return Art
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">CityDistricts</string>
          <string name="Source">local runtimeScript=getfenv().script
local A=runtimeScript and require(runtimeScript.Parent.Architecture) or require("./Architecture")
local Art=runtimeScript and require(runtimeScript.Parent.CityArt) or require("./CityArt")
local Districts={}
function Districts.generate()
    local entries={}
    local stations={
        {id="market",x=-27,z=27,color="FF9A65",title="CARD MARKET"},
        {id="festival",x=27,z=27,color="F58EC2",title="FESTIVAL"},
        {id="contracts",x=-27,z=-27,color="818FF0",title="CHALLENGES"},
        {id="news",x=27,z=-27,color="62CDE1",title="CITY NEWS"},
    }
    for _,station in ipairs(stations) do
        local function add(name,size,x,y,z,color,extra)
            local p={name=name,size=size,position={station.x+x,y,station.z+z},color=color,material="SmoothPlastic",interaction=station.id}
            for k,v in pairs(extra or {}) do p[k]=v end
            table.insert(entries,p)
        end
        local function cylinder(name,width,height,x,y,z,color)
            add(name,{height,width,width},x,y,z,color,{shape="Cylinder",rotation=A.rotation(0,0,math.pi/2)})
        end
        for _,p in ipairs(Art.rounded("StationPlatform",{23,0.6,21},{station.x,1.9,station.z},3,"F9FCFF",{interaction=station.id})) do table.insert(entries,p) end
        add("StationLabel",{20,0.09,5},0,2.25,7.2,station.color,{text=station.title,textColor="FFFFFF",textSize=64})
        if station.id=="market" then
            add("MarketShop",{16,5.4,8},0,4.9,-2.2,"FFF6DF")
            add("MarketFascia",{17,1.2,0.5},0,7.7,-6.4,station.color)
            for i=-2,2 do
                add("ShopGlass",{2.55,3.5,0.2},i*3.1,4.8,-6.33,"73D8EB",{material="Glass"})
                add("ShopMullion",{0.18,4.5,0.3},i*3.1-1.4,4.9,-6.5,"FFFFFF")
                add("ShopAwning",{3.2,0.3,3.6},i*3.2,7.8,-6.4,i%2==0 and "FF926B" or "FFFFFF",{rotation=A.rotation(0,math.rad(-14),0)})
                add("AwningValance",{3.2,0.7,0.2},i*3.2,7.1,-8,i%2==0 and "FF926B" or "FFFFFF")
            end
            add("MarketTower",{6.5,6.5,6},3,9.5,-1,"FFFFFF")
            add("MarketRoof",{7.5,0.6,7},3,13,-1,"FF9A65")
            add("ClockRim",{0.3,3.6,3.6},3,10.6,-4.18,"FFC34D",{shape="Cylinder",rotation=A.rotation(math.pi/2,0,0)})
            add("MarketClock",{0.18,3.1,3.1},3,10.6,-4.4,"FFFFFF",{shape="Cylinder",rotation=A.rotation(math.pi/2,0,0)})
            add("ClockHand",{0.15,1.1,0.28},3,10.9,-4.55,"3555A5")
            add("ClockHand",{0.9,0.15,0.28},3.4,10.35,-4.55,"3555A5")
        elseif station.id=="festival" then
            cylinder("FestivalStage",16,0.8,0,2.7,-1,"FFC34D")
            cylinder("FestivalDeck",14.8,0.4,0,3.3,-1,"FFF4EE")
            for i=0,7 do
                local angle=i*math.pi/4
                cylinder("FestivalColumn",0.55,5,math.cos(angle)*6,5.9,-1+math.sin(angle)*6,"FFFFFF")
                add("FestivalBulb",{0.75,0.75,0.75},math.cos(angle)*6,8.7,-1+math.sin(angle)*6,"FFE2A4",{shape="Ball",material="Neon"})
            end
            add("FestivalDome",{17,6,17},0,8.6,-1,"F68CBC",{shape="Ball"})
            cylinder("FestivalCrown",11,0.5,0,10.5,-1,"FFFFFF")
            cylinder("FestivalMast",0.3,4,0,12.2,-1,"FFC34D")
            add("FestivalFlag",{3,1.5,0.2},1.3,13.6,-1,"FFBA4C")
        elseif station.id=="contracts" then
            add("HallBody",{14,7,10},0,5.8,-1,"A7B3FF")
            add("HallGlass",{12,4.7,0.15},0,5.4,-6.1,"6CCDE5",{material="Glass"})
            for _,x in ipairs({-6,-2,2,6}) do
                cylinder("HallColumn",1.1,6,x,5.3,-6.6,"FFFFFF")
                cylinder("HallCapital",1.65,0.4,x,8.5,-6.6,"FFF4D6")
            end
            add("HallCornice",{17,0.7,13},0,9.2,-1,"FFFFFF")
            add("HallRoof",{12.5,4.2,8.5},0,9.3,-1,"7F91EC",{shape="Ball"})
            cylinder("TrophyBase",2.8,0.5,0,11.7,-1,"FFFFFF")
            cylinder("TrophyStem",0.65,1.6,0,12.7,-1,"FFC34D")
            add("TrophyCup",{2.5,1.9,2.5},0,13.8,-1,"FFC34D",{shape="Ball"})
        else
            add("NewsPodium",{14,4,10},0,4.5,-1,"FFFFFF")
            add("BroadcastTower",{7.2,11,7.2},0,10,-1,"66D1E5",{material="Glass"})
            for _,x in ipairs({-3.6,3.6}) do for _,z in ipairs({-4.6,2.6}) do add("BroadcastPillar",{0.45,12,0.45},x,10,z,"FFFFFF") end end
            for y=5,14,3 do add("BroadcastBand",{7.8,0.3,7.8},0,y,-1,"FFFFFF") end
            add("NewsScreen",{11,4.3,0.4},0,6.8,-6.2,"386BF0",{text="NEWS",textFace="Front",textColor="FFFFFF",textSize=60})
            add("NewsScreenBack",{11,4.3,0.4},0,6.8,4.2,"386BF0",{text="NEWS",textFace="Back",textColor="FFFFFF",textSize=60})
            cylinder("BroadcastCap",10,0.7,0,15.8,-1,"FFC34D")
            cylinder("BroadcastAntenna",0.3,3.4,0,17.7,-1,"FFFFFF")
            add("BroadcastOrb",{1.4,1.4,1.4},0,19.5,-1,"FFC34D",{shape="Ball"})
        end
    end
    return entries
end
return Districts
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">CityScenery</string>
          <string name="Source">-- Public city scenery stays outside the purchasable parcels and the pawn route.
local runtimeScript=getfenv().script
local A=runtimeScript and require(runtimeScript.Parent.Architecture) or require("./Architecture")
local Art=runtimeScript and require(runtimeScript.Parent.CityArt) or require("./CityArt")
local City={}
function City.bounds()
    return {min={-130,-8,-156},max={130,38,139},target={0,6,-10}}
end
function City.generate()
    local parts={}
    local background=false
    local function add(name,size,p,color,extra)
        local entry={name=name,size=size,position=p,color=color,material="SmoothPlastic",background=background,canQuery=false}
        for k,v in pairs(extra or {}) do entry[k]=v end
        table.insert(parts,entry)
    end
    local function round(name,size,p,radius,color,extra)
        local flags={background=background,canQuery=false}
        for k,v in pairs(extra or {}) do flags[k]=v end
        for _,entry in ipairs(Art.rounded(name,size,p,radius,color,flags)) do table.insert(parts,entry) end
    end
    local function cylinder(name,width,height,p,color,extra)
        local flags={shape="Cylinder",rotation=A.rotation(0,0,math.pi/2)}
        for k,v in pairs(extra or {}) do flags[k]=v end
        add(name,{height,width,width},p,color,flags)
    end
    -- Pedestrian crossings connect the four existing, functional event stations.
    for _,side in ipairs({-1,1}) do
        add("CityCurb",{1,0.3,36},{side*6,1.95,side*30},"FFFFFF")
        add("CityCurb",{36,0.3,1},{side*30,1.95,-side*6},"FFFFFF")
        for stripe=-2,2 do
            add("Crosswalk",{8,0.06,0.75},{0,1.87,side*35+stripe*1.5},"FFFFFF")
            add("Crosswalk",{0.75,0.06,8},{side*35+stripe*1.5,1.87,0},"FFFFFF")
        end
    end
    for _,x in ipairs({-44,44}) do for _,z in ipairs({-44,44}) do
        round("PocketPlaza",{8.5,0.2,8.5},{x,1.72,z},1.8,"FFF3D7")
        cylinder("FountainBowl",6,0.65,{x,2.05,z},"FFF9EA")
        cylinder("FountainWater",5,0.12,{x,2.43,z},"51D4EE",{material="Glass"})
        cylinder("FountainPedestal",1.1,1.8,{x,3.2,z},"FFC34D")
        add("FountainJet",{0.4,1.6,0.4},{x,4.4,z},"B5F5FF",{material="Neon",canCollide=false})
        add("FountainSpark",{0.75,0.75,0.75},{x,5.2,z},"E6FCFF",{shape="Ball",canCollide=false})
    end end
    -- The waterfront is background scenery: overview framing remains focused
    -- on the complete playable board instead of shrinking it to fit a skyline.
    background=true
    for _,side in ipairs({-1,1}) do
        round("WaterfrontQuay",{216,7.1,15},{0,-2.4,side*99},3,"D6E4ED")
        round("WaterfrontQuay",{15,7.1,183},{side*99,-2.4,0},3,"D6E4ED")
        add("Boardwalk",{210,0.2,11},{0,1.17,side*99},"E9CFA7",{material="WoodPlanks"})
        add("Boardwalk",{11,0.2,181},{side*99,1.17,0},"E9CFA7",{material="WoodPlanks"})
        for _,railY in ipairs({2.2,3.4}) do
            add("HarborRail",{212,0.2,0.2},{0,railY,side*106},"446BA6",{material="Metal"})
            add("HarborRail",{0.2,0.2,181},{side*106,railY,0},"446BA6",{material="Metal"})
        end
        for at=-100,100,20 do
            add("HarborPost",{0.45,2.8,0.45},{at,2.6,side*106},"FFFFFF")
            add("RailCap",{0.65,0.25,0.65},{at,4.1,side*106},"FFC34D")
            if math.abs(at)&lt;90 then
                add("HarborPost",{0.45,2.8,0.45},{side*106,2.6,at},"FFFFFF")
                add("RailCap",{0.65,0.25,0.65},{side*106,4.1,at},"FFC34D")
            end
        end
    end
    local function lamp(x,z)
        cylinder("StreetLampBase",1.3,0.35,{x,1.55,z},"3555A5")
        cylinder("StreetLamp",0.35,7,{x,5,z},"3555A5")
        cylinder("LampCap",1.8,0.3,{x,8.7,z},"FFC34D")
        add("LampGlow",{1.05,1.1,1.05},{x,8,z},"FFF1C9",{shape="Ball",material="Neon",light=true,canCollide=false})
    end
    local function bench(x,z,yaw,color)
        local c,s=math.cos(yaw),math.sin(yaw)
        local function piece(name,size,dx,y,dz,tint)
            add(name,size,{x+c*dx+s*dz,y,z-s*dx+c*dz},tint,{rotation=A.rotation(yaw)})
        end
        piece("BenchSeat",{5.5,0.35,1.7},0,2.2,0,color)
        piece("BenchBack",{5.5,1.4,0.3},0,3.05,0.65,color)
        for _,side in ipairs({-1,1}) do piece("BenchLeg",{0.35,1,1.6},side*2.1,1.65,0,"355079") end
    end
    for _,side in ipairs({-1,1}) do
        for _,at in ipairs({-70,0,70}) do lamp(at,side*101) end
        for _,at in ipairs({-50,50}) do
            lamp(side*101,at)
            bench(at,side*98,side&lt;0 and 0 or math.pi,side&lt;0 and "B8ACFF" or "FFAC8D")
            bench(side*98,at,side*math.pi/2,"76D8CD")
        end
    end
    -- A separate public downtown backs the player-owned waterfront lots.
    round("DowntownIsland",{248,9,45},{0,-3.55,-131},5,"D6E4ED")
    add("DowntownRoad",{235,0.12,10},{0,1.03,-113},"647EA5")
    for x=-112,112,14 do add("DowntownLane",{6,0.05,0.22},{x,1.12,-113},"FFF5D9") end
    local blocks={
        {-102,3,"B6A4F2","ARTS"},{-74,4,"6DCBD7","HARBOR"},{-45,3,"FFA98B","BAKERY"},
        {-16,5,"82B9F1","CITY HALL"},{16,4,"8CD7AD","LIBRARY"},{45,3,"F49DB9","CAFE"},
        {74,5,"8E9EEA","CITY HOTEL"},{102,3,"FFC96C","MARKET"},
    }
    for _,block in ipairs(blocks) do
        local x,floors,color,title=table.unpack(block)
        local h=floors*5.8
        add("CivicFoundation",{20,0.5,17},{x,1.5,-135},"FFFFFF")
        add("CivicBuilding",{17,h,13},{x,1.8+h/2,-135},color)
        for floor=1,floors do
            local y=1.8+(floor-0.5)*5.8
            add("CivicCornice",{18,0.35,14},{x,1.8+floor*5.8,-135},"FFF9EA")
            for column=-1,1 do
                add("CivicWindow",{3.8,3.4,0.16},{x+column*5,y,-128.4},"BCEBFA",{material="Glass"})
                add("CivicWindowSill",{4.3,0.28,0.7},{x+column*5,y-1.85,-128.1},"FFFFFF")
                add("WindowMullion",{0.14,3.4,0.22},{x+column*5,y,-128.25},"FFFFFF")
            end
        end
        add("CivicRoof",{18.5,0.6,14.5},{x,h+2.2,-135},"3F618C")
        add("RooftopGarden",{12,0.2,8},{x,h+2.6,-135},"79CFA4")
        add("RoofLantern",{2,2.1,2},{x-5,h+3.7,-135},"FFF1BC",{material="Neon"})
        add("PublicShopSign",{14,1.6,0.3},{x,4.5,-128.1},"3555A5",{text=title,textFace="Back",textColor="FFFFFF",textSize=64})
        for stripe=-2,2 do add("PublicAwning",{3.7,0.3,3.1},{x+stripe*3.7,5.6,-127.1},stripe%2==0 and color or "FFFFFF",{rotation=A.rotation(0,math.rad(12),0)}) end
    end
    -- A bright ferry makes the waterfront read as a small, lived-in city.
    round("FerryPier",{10,1.3,25},{0,0.3,117},1.5,"E2BF8F",{material="WoodPlanks"})
    for _,x in ipairs({-4,4}) do for _,z in ipairs({110,122}) do cylinder("PierBollard",0.8,1.5,{x,1.8,z},"3555A5") end end
    local boatStart=#parts+1
    round("FerryHull",{10,2.2,22},{15,-0.9,119},3,"386BF0")
    round("FerryDeck",{9.3,0.7,20},{15,0.6,119},2.7,"FFFFFF")
    round("FerryCabin",{7,3.3,12},{15,2.5,118},1.4,"B6ECFA")
    round("FerryRoof",{8.5,0.6,14},{15,4.45,118},1.8,"FFC34D")
    for _,x in ipairs({11.4,18.6}) do for z=114,122,4 do add("FerryWindowFrame",{0.18,2,0.25},{x,2.6,z},"FFFFFF") end end
    add("FerryMast",{0.25,4,0.25},{15,6.4,117},"3555A5")
    add("FerryFlag",{2.2,1.2,0.15},{16,8,117},"FF8C9F")
    for index=boatStart,#parts do parts[index].position[2]=parts[index].position[2]-3.7 end
    return parts
end
return City
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
