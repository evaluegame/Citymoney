        <Properties>
          <string name="Name">Architecture</string>
          <string name="Source">-- Asset-free, walkable homes. Shared by the live world, deed previews and build.
local Architecture = {}
Architecture.spacing, Architecture.radius = 20, 60

function Architecture.position(index)
    local step = index - 1
    if step &lt;= 6 then return { 60 - step * 20, 1.4, 60 } end
    if step &lt;= 12 then return { -60, 1.4, 60 - (step - 6) * 20 } end
    if step &lt;= 18 then return { -60 + (step - 12) * 20, 1.4, -60 } end
    return { 60, 1.4, -60 + (step - 18) * 20 }
end

function Architecture.site(index)
    local position = Architecture.position(index)
    local side = math.floor((index - 1) / 6)
    local yaw = -side * math.pi / 2
    local s, c = math.sin(yaw), math.cos(yaw)
    return { position[1] + s * 14, 1.8, position[3] + c * 14 }, yaw
end

-- Rotation = yaw * pitch * roll. Matrix rows are Roblox CFrame components.
function Architecture.rotation(yaw, pitch, roll)
    local c, s, a, b, d, e = math.cos(yaw), math.sin(yaw), math.cos(pitch or 0), math.sin(pitch or 0), math.cos(roll or 0), math.sin(roll or 0)
    return { c*d+s*b*e, -c*e+s*b*d, s*a, a*e, a*d, -b, -s*d+c*b*e, s*e+c*b*d, c*a }
end

function Architecture.house(origin, yaw, theme, level, tint, paint)
    local parts = {}
    local c, s = math.cos(yaw), math.sin(yaw)
    local function add(name, size, x, y, z, color, extra)
        local value = { name = name, size = size, position = { origin[1]+c*x+s*z, origin[2]+y, origin[3]-s*x+c*z }, color = color,
            rotation = Architecture.rotation(yaw), material = "SmoothPlastic" }
        for key, entry in pairs(extra or {}) do value[key] = entry end
        if value.pitch or value.roll then value.rotation = Architecture.rotation(yaw, value.pitch, value.roll) end
        table.insert(parts, value)
        return value
    end
    local wall = ({ theme, tint, "F0E7D5", "56636A" })[(paint or 0) + 1] or theme
    local roof, trim, glass = "40535B", "F8F0DF", "96C2CE"
    local floors = level == 0 and 1 or (level == 3 and 3 or 2)
    local height, width, depth = floors * 6.5, level &gt;= 2 and 11.5 or 10, 9
    add("Foundation", { width+1, 0.5, depth+1 }, 0, 0.25, 0.8, "D7D1C4", { material = "Concrete" })
    add("Floor", { width, 0.25, depth }, 0, 0.65, 0.8, "C9AE89", { material = "WoodPlanks" })
    add("BackWall", { width, height, 0.4 }, 0, 0.7+height/2, 5.1, wall)
    add("LeftWall", { 0.4, height, depth }, -width/2, 0.7+height/2, 0.8, wall)
    add("RightWall", { 0.4, height, depth }, width/2, 0.7+height/2, 0.8, wall)
    -- A real opening, rather than a solid box with a painted-on door.
    add("FrontLeft", { width/2-1.5, 6.5, 0.4 }, -(width/4+0.75), 3.95, -3.7, wall)
    add("FrontRight", { width/2-1.5, 6.5, 0.4 }, width/4+0.75, 3.95, -3.7, wall)
    add("DoorLintel", { 3, 1, 0.5 }, 0, 6.7, -3.7, trim)
    add("Door", { 2.8, 5.5, 0.22 }, 0, 3.45, -3.78, "556F66", { door = true, material = "Wood" })
    add("DoorGlass", { 1.75, 2.3, 0.08 }, 0, 4.1, -3.92, glass, { transparency = 0.2, material = "Glass", canCollide = false })
    add("Doorknob", { 0.16, 0.16, 0.16 }, 0.95, 3, -3.98, "CDB67E", { shape = "Ball", material = "Metal", canCollide = false })
    add("DoorFrame", { 3.3, 0.25, 0.7 }, 0, 6.25, -3.75, trim)
    add("Porch", { width+0.5, 0.35, 2.7 }, 0, 0.6, -5.1, "E4DDCD")
    add("Step", { 4, 0.2, 1.4 }, 0, 0.25, -7, "E4DDCD")
    for _, x in ipairs({ -width/2+0.35, width/2-0.35 }) do
        add("PorchColumn", { 0.35, 5.8, 0.35 }, x, 3.65, -5.9, trim)
    end
    add("PorchCanopy", { width+1, 0.35, 3.1 }, 0, 6.7, -5.1, roof)
    for floor = 0, floors-1 do
        local base = 0.7 + floor * 6.5
        if floor &gt; 0 then
            add("UpperFacade", { width, 6.5, 0.4 }, 0, base+3.25, -3.7, wall)
            add("FloorBand", { width+0.3, 0.3, 0.5 }, 0, base, -3.7, trim)
            add("FloorBand", { width+0.3, 0.3, 0.5 }, 0, base, 5.1, trim)
            add("UpperFloor", { width-2.6, 0.25, depth }, -1.3, base, 0.8, "C9AE89", { material = "WoodPlanks" })
            add("StairLanding", { 2.6, 0.25, 1.5 }, width/2-1.3, base, 4.45, "C9AE89", { material = "WoodPlanks" })
            for step = 1, 12 do
                local rise = step*6.5/12
                add("StairTread", { 2.1, 0.2, 0.65 }, width/2-1.3, base-6.5+rise, -2.7+step*0.5, "C9AE89", { material = "WoodPlanks" })
            end
            add("BedFrame", { 3.5, 0.6, 4 }, -2.1, base+0.6, 1.1, "A38D70", { material = "Wood" })
            add("BedLinen", { 3.3, 0.4, 3.8 }, -2.1, base+1.1, 1.1, "EAE2CF")
            add("BedPillow", { 2.7, 0.3, 0.8 }, -2.1, base+1.4, 2.4, tint)
        end
        for _, x in ipairs({ -width*0.32, width*0.32 }) do
            add("WindowFrame", { 2.7, 3.3, 0.3 }, x, base+3.45, -3.98, trim)
            add("Window", { 2.25, 2.8, 0.1 }, x, base+3.45, -4.16, glass, { material = "Glass", canCollide = false })
            add("WindowMullion", { 0.12, 2.8, 0.12 }, x, base+3.45, -4.25, trim)
            add("WindowCrossbar", { 2.3, 0.12, 0.12 }, x, base+3.45, -4.25, trim)
            if floor == 0 then
                add("FlowerBox", { 3, 0.5, 0.7 }, x, base+1.6, -4.45, "9D8069", { material = "WoodPlanks" })
                add("Flowers", { 2.6, 0.35, 0.6 }, x, base+1.9, -4.45, "64815C", { canCollide = false })
                for flower = -1, 1 do
                    add("Blossom", { 0.4, 0.4, 0.4 }, x+flower*0.75, base+2.15, -4.45, flower==0 and "E6CCA2" or "D4A4AD", { shape = "Ball", canCollide = false })
                end
            end
        end
        for _, side in ipairs({ -1, 1 }) do
            add("SideWindowFrame", { 0.2, 2.9, 3 }, side*(width/2+0.22), base+3.5, 0.8, trim)
            add("SideWindow", { 0.1, 2.45, 2.6 }, side*(width/2+0.35), base+3.5, 0.8, glass, { material = "Glass", canCollide = false })
            add("BackWindowFrame", { 2.8, 3.1, 0.25 }, side*width*0.28, base+3.5, 5.35, trim)
            add("BackWindow", { 2.3, 2.6, 0.2 }, side*width*0.28, base+3.5, 5.52, glass, { material = "Glass", canCollide = false })
            add("BackMullion", { 0.13, 2.6, 0.1 }, side*width*0.28, base+3.5, 5.67, trim)
        end
    end
    if level &lt; 2 then
        local roofY = height + 2.35
        add("FrontRoof", { width+2, 0.5, 6.3 }, 0, roofY, -1.65, roof, { pitch = math.rad(-27), material = "Slate" })
        add("BackRoof", { width+2, 0.5, 6.3 }, 0, roofY, 3.25, roof, { pitch = math.rad(27), material = "Slate" })
        add("RoofRidge", { width+2.1, 0.4, 0.45 }, 0, roofY+1.4, 0.8, roof)
        add("Chimney", { 1.1, 3.3, 1.1 }, width/2-1.2, height+2.2, 2, "B88B72", { material = "Brick" })
    else
        add("PenthouseRoof", { width+1.1, 0.5, depth+1.1 }, 0, height+0.95, 0.8, trim)
        add("RoofGarden", { width-1, 0.25, depth-1 }, 0, height+1.35, 0.8, "7E9D76", { material = "Grass" })
        add("RoofHedge", { width, 1, 0.7 }, 0, height+1.9, 5, "547C61", { material = "Grass" })
        for _, x in ipairs({ -width*0.35, width*0.35 }) do
            for _, z in ipairs({ -2, 3.2 }) do
                add("PergolaPost", { 0.22, 3.1, 0.22 }, x, height+2.9, z, "A38D70", { material = "Wood" })
            end
        end
        for z = -2.3, 3.7, 1 do
            add("PergolaSlat", { width*0.8, 0.2, 0.35 }, 0, height+4.5, z, "A38D70", { material = "Wood" })
        end
        add("Balcony", { width+0.6, 0.3, 2.3 }, 0, 7.1, -4.6, trim)
        add("BalconyGlass", { width+0.6, 1.9, 0.15 }, 0, 8.15, -5.65, glass, { transparency = 0.4, material = "Glass" })
        for _, x in ipairs({ -width/2, width/2 }) do add("BalconyPost", { 0.12, 2, 0.2 }, x, 8.1, -5.65, roof) end
    end
    -- Interior details visible through the doorway in walking mode.
    add("Rug", { 5, 0.06, 4 }, 0, 0.81, 0.3, "D8BD9C", { canCollide = false })
    add("Sofa", { 4, 0.9, 1.8 }, -2.4, 1.4, 3.4, "A4B5A8")
    add("SofaBack", { 4, 1.5, 0.4 }, -2.4, 2, 4.1, "A4B5A8")
    add("CoffeeTable", { 2.4, 0.7, 1.4 }, -1.8, 1.2, 1, "9B7C5B", { material = "Wood" })
    add("InteriorLight", { 1.4, 0.2, 1.4 }, 0, 6.7, 0.8, "FFE4BA", { material = "Neon", light = true, canCollide = false })
    return parts
end

function Architecture.property(config, index, ownerName, ownerTint, level, paint)
    local tile = config.tiles[index]
    local origin, yaw = Architecture.site(index)
    local c, s, entries = math.cos(yaw), math.sin(yaw), {}
    local function add(name, size, x, y, z, tint, extra)
        local value = { name = name, size = size, position = { origin[1]+c*x+s*z, origin[2]+y, origin[3]-s*x+c*z }, color = tint,
            rotation = Architecture.rotation(yaw), tileIndex = index }
        for key, entry in pairs(extra or {}) do value[key] = entry end
        table.insert(entries, value)
    end
    add("Lawn", { 18.6, 0.3, 18.6 }, 0, -0.1, 0, "91AA7E", { material = "Grass" })
    add("GardenPath", { 3.5, 0.12, 8 }, 0, 0.12, -5.2, "E2D7BF", { material = "Cobblestone" })
    for _, x in ipairs({ -8.4, 8.4 }) do
        add("Hedge", { 0.85, 1.3, 16.5 }, x, 0.6, 0.2, "557D5A", { material = "Grass" })
        for z = -7, 7, 7 do add("FencePost", { 0.35, 1.8, 0.35 }, x, 0.8, z, "EEE3CC") end
    end
    add("BackHedge", { 17.6, 1.3, 0.85 }, 0, 0.6, 8.1, "557D5A", { material = "Grass" })
    if ownerName then
        local house = Architecture.house(origin, yaw, config.groups[tile.group].color, level or 0, ownerTint, paint or 0)
        for _, entry in ipairs(house) do entry.tileIndex = index; table.insert(entries, entry) end
        add("Mailbox", { 0.7, 1, 0.65 }, 5.9, 1.7, -7.9, ownerTint)
        add("MailboxPost", { 0.2, 1.4, 0.2 }, 5.9, 0.7, -7.9, "EEE3CC")
        add("OwnerSign", { 5, 1.4, 0.16 }, -5.2, 1.7, -8, "F6EFDF",
            { text = ownerName .. "'s home", textFace = "Front", textColor = "263E3A", textSize = 27, canCollide = false })
        add("OwnerStripe", { 5, 0.18, 0.2 }, -5.2, 2.5, -8, ownerTint)
        add("GardenTreeTrunk", { 0.35, 2.5, 0.35 }, 6.8, 1.25, 5.6, "9C8366", { material = "Wood" })
        add("GardenTree", { 2.6, 2.7, 2.6 }, 6.8, 3.7, 5.6, "7C9B70", { shape = "Ball", material = "Grass" })
    else
        add("SaleSign", { 5.8, 3, 0.2 }, 0, 2, 0, "F5F0E5",
            { text = "FOR SALE\n$" .. tile.price, textFace = "Front", textColor = "35564A", textSize = 38 })
        add("SaleSignPost", { 0.3, 2, 0.3 }, 0, 0.7, 0, "A58C6E", { material = "Wood" })
        add("FlowerBed", { 4, 0.5, 2.5 }, 5, 0.3, 5, "B7C899", { material = "Grass" })
    end
    return entries
end

function Architecture.porch(index)
    local origin, yaw = Architecture.site(index)
    return { origin[1]-math.sin(yaw)*7, 2.5, origin[3]-math.cos(yaw)*7 }, yaw
end

return Architecture
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Board</string>
          <string name="Source">-- A waterfront neighborhood. Each purchasable parcel is a physical garden lot.
local runtimeScript = getfenv().script
local Architecture = runtimeScript and require(runtimeScript.Parent.Architecture) or require("./Architecture")
local Board = { spacing = Architecture.spacing }
Board.position = Architecture.position

function Board.generate(config)
    local parts = {}
    local function add(name, size, position, tint, extra)
        local entry = { name = name, size = size, position = position, color = tint }
        for key, value in pairs(extra or {}) do entry[key] = value end
        table.insert(parts, entry)
    end
    local function tree(x, z, scale)
        scale = scale or 1
        add("TreeTrunk", { 0.6*scale, 4*scale, 0.6*scale }, { x, 2+2*scale, z }, "967B60", { material = "Wood" })
        for layer = 0, 2 do
            local size = (4.3-layer*0.65)*scale
            add("TreeCanopy", { size, size, size }, { x+layer*0.2, 4*scale+layer*1.3, z }, ({ "648B64", "7E9C6D", "92AC7C" })[layer+1], { shape = "Ball", material = "Grass" })
        end
    end
    local function bench(x, z)
        add("BenchSeat", { 5, 0.3, 1.5 }, { x, 2.3, z }, "A48862", { material = "WoodPlanks" })
        add("BenchBack", { 5, 1.3, 0.2 }, { x, 3, z+0.7 }, "A48862", { material = "WoodPlanks" })
        for _, dx in ipairs({ -1.8, 1.8 }) do add("BenchLeg", { 0.25, 1.1, 1.3 }, { x+dx, 1.8, z }, "44594F", { material = "Metal" }) end
    end
    add("Sea", { 1400, 3, 1400 }, { 0, -7, 0 }, "87B4B3", { material = "SmoothPlastic", reflectance = 0.12, canCollide = false })
    add("IslandStone", { 181, 6, 181 }, { 0, -2, 0 }, "ACB4A5", { material = "Limestone" })
    add("IslandRim", { 179, 0.8, 179 }, { 0, 0.7, 0 }, "D7D4BD", { material = "Concrete" })
    add("IslandGarden", { 174, 0.4, 174 }, { 0, 1, 0 }, "A8B98F", { material = "Grass" })
    -- A pale promenade with colored deed inlays around the park.
    for side = 0, 3 do
        local vertical = side % 2 == 1
        local x, z = vertical and (side == 1 and -60 or 60) or 0, not vertical and (side == 0 and 60 or -60) or 0
        add("Promenade", vertical and { 14, 0.35, 134 } or { 134, 0.35, 14 }, { x, 1.2, z }, "D7D1BE", { material = "Cobblestone" })
    end
    add("CentralPark", { 92, 0.3, 92 }, { 0, 1.25, 0 }, "8FAA81", { material = "Grass" })
    add("ParkCrossing", { 10, 0.16, 98 }, { 0, 1.55, 0 }, "E3D8C0", { material = "Cobblestone" })
    add("ParkCrossing", { 98, 0.16, 10 }, { 0, 1.55, 0 }, "E3D8C0", { material = "Cobblestone" })
    add("FountainPlaza", { 27, 0.2, 27 }, { 0, 1.6, 0 }, "DDD9C7", { material = "Marble" })
    add("FountainBase", { 15, 0.6, 15 }, { 0, 1.9, 0 }, "C4C0AD", { material = "Marble" })
    add("FountainWater", { 12.8, 0.2, 12.8 }, { 0, 2.4, 0 }, "A2CDD0", { material = "Glass", reflectance = 0.2 })
    for _, z in ipairs({ -7, 7 }) do add("FountainRim", { 15, 0.9, 0.65 }, { 0, 2.5, z }, "D9D3BE", { material = "Marble" }) end
    for _, x in ipairs({ -7, 7 }) do add("FountainRim", { 0.65, 0.9, 15 }, { x, 2.5, 0 }, "D9D3BE", { material = "Marble" }) end
    add("FountainColumn", { 1.4, 4.4, 1.4 }, { 0, 4.4, 0 }, "E2D9C2", { material = "Marble" })
    add("FountainUpperTray", { 5.6, 0.4, 5.6 }, { 0, 5.7, 0 }, "C9C4B0", { material = "Marble" })
    add("FountainUpperWater", { 5, 0.1, 5 }, { 0, 5.95, 0 }, "A2CDD0", { material = "Glass" })
    add("FountainFinial", { 2.1, 2.1, 2.1 }, { 0, 7, 0 }, "D8D2BF", { shape = "Ball", material = "Marble" })
    -- Landscaped terraces rather than a field of identical towers.
    local themes = { "E3C1A0", "C0CCB6", "C8BCC4", "C6D5D5" }
    local count = 0
    for _, x in ipairs({ -29, 29 }) do
        for _, z in ipairs({ -29, 29 }) do
            count = count+1
            local yaw = z &gt; 0 and 0 or math.pi
            local home = Architecture.house({ x, 1.7, z }, yaw, themes[count], count == 1 and 2 or 0, "E1B783", 0)
            for _, entry in ipairs(home) do entry.name = "Club_" .. entry.name; entry.door = nil; table.insert(parts, entry) end
            tree(x-11, z, 1.2)
            tree(x+11, z, 0.95)
        end
    end
    for _, x in ipairs({ -17, 17 }) do
        for _, z in ipairs({ -17, 17 }) do
            add("FlowerGarden", { 9, 0.3, 9 }, { x, 1.6, z }, "B1BD91", { material = "Grass" })
            for dx = -2, 2, 2 do
                for dz = -2, 2, 2 do add("Flowers", { 1.3, 0.9, 1.3 }, { x+dx, 2.2, z+dz }, dx == dz and "E4BCB0" or "E4D4AB", { shape = "Ball", canCollide = false }) end
            end
        end
    end
    bench(-13, 10); bench(13, 10); bench(-13, -10); bench(13, -10)
    for _, x in ipairs({ -46, 46 }) do
        for z = -40, 40, 20 do tree(x, z, z == 0 and 1.3 or 1) end
    end
    for _, z in ipairs({ -46, 46 }) do for x = -30, 30, 30 do tree(x, z, 0.8) end end
    for _, x in ipairs({ -50, 50 }) do
        for _, z in ipairs({ -50, -10, 10, 50 }) do
            add("StreetLamp", { 0.25, 6, 0.25 }, { x, 4.5, z }, "4D6258", { material = "Metal" })
            add("Lantern", { 1.1, 1.4, 1.1 }, { x, 7.8, z }, "FFE6BA", { material = "Neon", light = true })
            add("LanternCap", { 1.6, 0.2, 1.6 }, { x, 8.55, z }, "4D6258")
        end
    end
    add("ClubName", { 33, 0.12, 7 }, { 0, 1.8, 23 }, "DCD7C4", { text = "C I T Y M O N E Y", textSize = 44, textColor = "526A59" })
    for index, tile in ipairs(config.tiles) do
        local position = Board.position(index)
        local _, yaw = Architecture.site(index)
        local tint = tile.group and config.groups[tile.group].color or "9BB6AE"
        local caption = tile.price and (tile.name .. "\n$" .. tile.price) or tile.name
        local tileSize = (index-1)%6==0 and { 18.8, 0.4, 18.8 } or { 18.8, 0.4, 11.4 }
        add("Tile" .. index, tileSize, position, "F0EADA", { rotation = Architecture.rotation(yaw), text = caption,
            textSize = 100, textColor = "475C50", tileIndex = index, material = "Concrete" })
        local c, s = math.cos(yaw), math.sin(yaw)
        add("DistrictInlay", { 18.4, 0.07, 1 }, { position[1]+s*4.9, 1.65, position[3]+c*4.9 }, tint, { tileIndex = index, rotation = Architecture.rotation(yaw) })
        if tile.kind == "property" then
            for _, entry in ipairs(Architecture.property(config, index, false, tint, 0, 0)) do table.insert(parts, entry) end
        else
            local site = Architecture.site(index)
            add("CornerGarden", { 16, 0.3, 16 }, site, "B3C09A", { rotation = Architecture.rotation(yaw), material = "Grass" })
            tree(site[1], site[3], tile.kind == "park" and 1.2 or 0.8)
        end
    end
    -- Timber jetties and moored boats soften the edge of the island.
    for _, x in ipairs({ -52, 45 }) do
        add("Jetty", { 7, 0.6, 24 }, { x, -0.2, 100 }, "A78D66", { material = "WoodPlanks" })
        for _, dx in ipairs({ -3, 3 }) do
            for z = 91, 111, 10 do add("JettyPost", { 0.5, 5, 0.5 }, { x+dx, -1.4, z }, "8D7657", { material = "Wood" }) end
        end
        add("BoatHull", { 5, 1.6, 12 }, { x+7, -3, 102 }, "F4EBDD")
        add("BoatDeck", { 4, 0.4, 9 }, { x+7, -2.1, 102 }, "B7996B", { material = "WoodPlanks" })
        add("BoatCabin", { 3, 2.7, 4 }, { x+7, -0.6, 103 }, "E4D6BB")
        add("BoatWindow", { 3.1, 1.1, 1.6 }, { x+7, 0, 102 }, "9FBEC1", { material = "Glass" })
    end
    add("LobbySpawn", { 4, 1, 4 }, { 0, 2, 42 }, "FFFFFF", { className = "SpawnLocation", transparency = 1 })
    return parts
end
return Board
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source">-- Original Citymoney rules and districts. Money is in-game currency, never Robux.
local Config = {
    startingCash = 1500,
    startBonus = 200,
    turnSeconds = 55,
    maxPlayers = 6,
    maxTurns = 120,
    maxLevel = 3,
    homeNames = { "Cottage", "Townhouse", "Garden villa", "Grand villa" },
    homeDescriptions = {
        "A furnished cottage, porch, flower boxes and private garden.",
        "Two floors, an upstairs bedroom and a staircase.",
        "A larger villa with a balcony, roof garden and pergola.",
        "Three floors, upstairs bedrooms and the highest rental income.",
    },
    botId = "city-bot", -- Studio test players can have negative numeric UserIds.
    rentMultipliers = { 1, 3, 6, 10 },
    playerColors = { "FFBE55", "6BDDC3", "AA9FFF", "FF8C9F", "71BDFF", "E6E984" },
    groups = {
        old = { name = "Old Town", color = "D0A581" },
        sunset = { name = "Sunset District", color = "E2B28E" },
        harbor = { name = "Harbor District", color = "A0BEC5" },
        metro = { name = "Metro District", color = "B4AECA" },
        garden = { name = "Garden District", color = "A4B79C" },
        neon = { name = "Rose District", color = "CCA5AF" },
        sky = { name = "Sky District", color = "A2B6CC" },
        crown = { name = "Crown District", color = "D5C08E" },
    },
    tiles = {
        { name = "CITY GATE", kind = "start" },
        { name = "Copper Lane", kind = "property", group = "old", price = 90, rent = 12, upgrade = 60 },
        { name = "Brick Courtyard", kind = "property", group = "old", price = 110, rent = 16, upgrade = 60 },
        { name = "CITY NEWS", kind = "event" },
        { name = "Sunset Street", kind = "property", group = "sunset", price = 140, rent = 20, upgrade = 80 },
        { name = "Mango Market", kind = "property", group = "sunset", price = 160, rent = 24, upgrade = 80 },
        { name = "DETENTION", kind = "visit" },
        { name = "Harbor Walk", kind = "property", group = "harbor", price = 180, rent = 28, upgrade = 100 },
        { name = "Portside", kind = "property", group = "harbor", price = 200, rent = 32, upgrade = 100 },
        { name = "CITY TAX", kind = "tax", amount = 120 },
        { name = "Midtown Loft", kind = "property", group = "metro", price = 220, rent = 36, upgrade = 120 },
        { name = "Metro Square", kind = "property", group = "metro", price = 240, rent = 40, upgrade = 120 },
        { name = "CENTRAL PARK", kind = "park" },
        { name = "Garden Lane", kind = "property", group = "garden", price = 260, rent = 44, upgrade = 140 },
        { name = "Fern Park", kind = "property", group = "garden", price = 280, rent = 48, upgrade = 140 },
        { name = "CITY NEWS", kind = "event" },
        { name = "Neon Row", kind = "property", group = "neon", price = 300, rent = 52, upgrade = 160 },
        { name = "Pixel Pier", kind = "property", group = "neon", price = 320, rent = 56, upgrade = 160 },
        { name = "GO TO DETENTION", kind = "detention" },
        { name = "Sky Avenue", kind = "property", group = "sky", price = 340, rent = 60, upgrade = 180 },
        { name = "Cloud Court", kind = "property", group = "sky", price = 360, rent = 64, upgrade = 180 },
        { name = "CITY NEWS", kind = "event" },
        { name = "Crown Heights", kind = "property", group = "crown", price = 380, rent = 70, upgrade = 200 },
        { name = "Grand Boulevard", kind = "property", group = "crown", price = 400, rent = 80, upgrade = 200 },
    },
    events = {
        { text = "Your startup pays a dividend. Collect $120.", amount = 120 },
        { text = "A city grant arrives. Collect $80.", amount = 80 },
        { text = "Street repairs cost $90.", amount = -90 },
        { text = "You win the design contest! Collect $150.", amount = 150 },
        { text = "A paperwork mix-up! Go to detention.", detention = true },
        { text = "Express ride to City Gate! Collect $200.", start = true },
        { text = "Your phone needs repairs. Pay $60.", amount = -60 },
        { text = "The night market is a hit. Collect $100.", amount = 100 },
    },
}
return Config
