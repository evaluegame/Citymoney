local highlight=Instance.new("Highlight")
highlight.Name,highlight.FillColor,highlight.OutlineColor="SelectedAddress",C.gold,C.green
highlight.FillTransparency,highlight.OutlineTransparency,highlight.Parent=0.94,0.1,workspace
local function resident(state,id)
    for _, value in ipairs(state.players) do if value.id==id then return value end end
    return nil
end
local function pair(state,id,group)
    for index,tile in ipairs(Config.tiles) do if tile.group==group and state.properties[index].ownerId~=id then return false end end
    return true
end
local function rent(state,index)
    local property=state.properties[index]
    return Plans.projectedRent(Config,state,property.ownerId,index,property.level)
end
local function worth(state,person)
    local total=person.cash
    for index,property in ipairs(state.properties) do
        if property.ownerId==person.id then total=total+Plans.investment(Config,index,property.level,property.rentTier) end
    end
    return total
end
local previewKey
local function styleFor(id)
    for _,entry in ipairs(data and data.styles or {}) do if entry.id==id then return entry.styleId end end
    return "classic"
end
local function fillPreview(world,camera,index,owner,property,level)
    world:ClearAllChildren()
    local model=Scene.model(Architecture.property(Config,index,owner and owner.name or "Your next home",owner and Config.playerColors[owner.colorIndex] or "D4AF84",level,property.paint or 0,property,styleFor(owner and owner.id or player.UserId)),"Preview",world,true)
    local cf,size=model:GetBoundingBox()
    local target=cf.Position+Vector3.new(0,1,0)
    local _,yaw=Architecture.site(index)
    local x,z=22,-29
    camera.CFrame=CFrame.lookAt(target+Vector3.new(math.cos(yaw)*x+math.sin(yaw)*z,20+size.Y*0.3,-math.sin(yaw)*x+math.cos(yaw)*z),target)
end
local function propertyPreview(index,owner,property)
    local key=index..":"..tostring(property.ownerId)..":"..property.level..":"..(property.paint or 0)..":"..tostring(property.shield)..":"..(property.boost or 0)..":"..(property.rentTier or 1)..":"..styleFor(owner and owner.id or player.UserId)
    if previewKey==key then return end
    previewKey=key
    fillPreview(viewWorld,viewCamera,index,owner,property,property.level)
end
local homeNames=Config.homeNames
renderPlans=function()
    if not chooser.Visible or not data or not planIndex then return end
    local state=data.game
    local current=state.players[state.turn]
    local property=state.properties[planIndex]
    local valid=state.status=="playing" and state.turnCount==planTurn and current and current.id==player.UserId and current.alive
    if planMode=="buy" then valid=valid and state.phase=="buy" and state.pendingTile==planIndex and not property.ownerId
    else valid=valid and property.ownerId==player.UserId end
    if not valid then chooser.Visible=false;planPending=false;return end
    local mine=resident(state,player.UserId)
    local options=Plans.options(Config,state,player.UserId,planIndex,planMode)
    local chosen=options[planLevel+1]
    if not chosen then chooser.Visible=false;return end
    chooserTitle.Text=planMode=="buy" and "Choose your home level" or (planMode=="rent" and "Choose a rent multiplier" or "Choose your upgrade")
    chooserSubtitle.Text=Config.tiles[planIndex].name.." · $"..mine.cash.." available"..(planMode=="buy" and " · Land included" or (planMode=="rent" and (" · Current "..Config.rentTiers[property.rentTier or 1].."×") or (" · Current L"..property.level)))
    for _,option in ipairs(options) do
        local row=planCards[option.level+1]
        local active=option.level==planLevel
        row.button.BackgroundColor3=active and C.mint or C.paper
        row.border.Color,row.border.Thickness=active and C.green or C.line,active and 2 or 1
        row.name.Text=planMode=="rent" and option.name or ("L"..option.level.." · "..option.name)
        row.price.Text=(option.available and ("$"..option.cost..(planMode=="buy" and " total" or (planMode=="rent" and " fee" or " to upgrade"))) or "Included already").." · $"..option.rent.." rent"
        row.status.Text=option.current and (planMode=="rent" and "CURRENT RATE" or "YOUR CURRENT HOME") or (not option.available and "CHOOSE A HIGHER OPTION" or (option.affordable and (active and "SELECTED" or "TAP TO PREVIEW") or ("Need $"..(-option.remaining).." more")))
        row.status.TextColor3=option.available and not option.affordable and C.red or C.muted
        row.button.Active=not planPending
    end
    local shownLevel=planMode=="rent" and property.level or planLevel
    local key=planIndex..":"..shownLevel..":"..(property.paint or 0)..":"..mine.colorIndex..":"..(property.rentTier or 1)..":"..planLevel..":"..styleFor(player.UserId)
    if key~=planPreviewKey then
        local preview=table.clone(property)
        if planMode=="rent" then preview.rentTier=planLevel+1 end
        planPreviewKey=key;fillPreview(planWorld,planCamera,planIndex,mine,preview,shownLevel)
    end
    planDescription.Text=chosen.description
    local currentRent=planMode~="buy" and rent(state,planIndex) or 0
    planTotal.Text=chosen.available and ((planMode=="buy" and "Total price: $" or (planMode=="rent" and "Rental fee: $" or "Upgrade cost: $"))..chosen.cost.."   ·   Rent $"..currentRent.." → $"..chosen.rent) or "Choose a higher option. Your current one is included."
    planBalance.Text=chosen.available and (chosen.affordable and ("Balance after: $"..chosen.remaining) or ("Need $"..(-chosen.remaining).." more. Choose a lower option, or go back.")) or "Your current investment is already included."
    planBalance.TextColor3=chosen.available and not chosen.affordable and C.red or C.green
    planNote.Text=planError or (planMode=="rent" and "The multiplier stays on this property for future payments." or ("No district pair required. "..(planMode=="buy" and "Land + all selected building levels are included." or "You pay only for the levels you add.")))
    planNote.TextColor3=planError and C.red or C.muted
    local enabled=chosen.affordable and not planPending and not rolling
    confirmPlan.Text=planPending and "Confirming your selection…" or (rolling and "Dice are rolling…" or (chosen.available and ((planMode=="buy" and "Buy " or (planMode=="rent" and "Set " or "Upgrade to "))..chosen.name.." · $"..chosen.cost) or "Choose a higher option"))
    available(confirmPlan,enabled,C.green)
    available(cancelPlan,not planPending,C.paper)
    available(closeChooser,not planPending,C.paper)
end
local function closePanels()
    help.Visible=false;sale.Visible=false;chooser.Visible=false
    inspectorOpen=false;portfolioOpen=false
    inspector.Visible=false;portfolio.Visible=false
    if menus then menus.lobby.Visible=false;menus.actions.Visible=false;menus.practiceSettings.Visible=false end
    if boutique then boutique.shade.Visible=false end
    if city then city.shade.Visible=false end
    if commandMenu then commandMenu.shade.Visible=false end
    if opportunity then opportunity.shade.Visible=false end
end
openPlans=function(mode,index)
    if not data then return end
    if planIndex~=index or planMode~=mode or planTurn~=data.game.turnCount then
        planLevel=mode=="buy" and 0 or (mode=="rent" and math.min(#Config.rentTiers-1,data.game.properties[index].rentTier or 1) or math.min(Config.maxLevel,data.game.properties[index].level+1))
    end
    planIndex,planMode,planTurn,planPending,planError=index,mode,data.game.turnCount,false,nil
    closePanels();chooser.Visible=true
    renderPlans()
end
mainAction=function()
    if mainCommand=="Buy" and data then openPlans("buy",data.game.pendingTile)
    elseif mainCommand=="Offer" then opportunity:open()
    elseif mainCommand=="Plaza" then openCity("overview")
    elseif mainCommand=="Match" and menus then closePanels();menus:openLobby()
    elseif mainCommand=="Ready" and menus then menus:toggleReady()
    elseif mainCommand then send(mainCommand) end
end
do
    local ui={config=Config,colors=C,root=root,id=player.UserId,frame=frame,text=text,button=button,overlay=overlay,available=available,send=send,notify=notify,data=function() return data end,rent=rent,
        header=header,mark=mark,strap=strap,dieA=dieA,dieB=dieB,dieTextA=dieTextA,dieTextB=dieTextB,cameraBar=cameraBar,closePanels=closePanels,
        hideToast=function()
            toast.Visible=false
            for _,child in ipairs(header:GetChildren()) do if child.Name=="CashChange" then child:Destroy() end end
        end,
        focus=function(index) selected,focusIndex,inspectorOpen,portfolioOpen=index,nil,true,false;render() end,
        openGoals=function()
            if not data or data.game.status~="playing" or not resident(data.game,player.UserId) then notify("Start a match to receive cards and challenges.");return end
            closePanels();menus.actions.Visible=true;menus:render(data);render()
        end,
        openMatch=function() closePanels();menus:openLobby() end,
        openHomes=function() closePanels();portfolioOpen=true;render() end,
        openHelp=function() closePanels();help.Visible=true;render() end,
        openCity=function() openCity("overview") end,
        switchLight=function() night=not night;Lighting.ClockTime=night and 19.2 or 14.4 end,
        openStyles=function() closePanels();boutique:open();render() end}
    menus=Menus.new(ui);boutique=Boutique.new(ui);city=CityPlaza.new(ui);commandMenu=CommandMenu.new(ui);hover=HoverCard.new(ui,player)
    opportunity=CityOffer.new(ui);goals=GoalDisplay.new(ui);moments=MatchFeedback.new(ui)
    openCity=function(tab) closePanels();city:open(tab);render() end
    boardView.onProperty=function(index) selected,inspectorOpen,portfolioOpen=index,true,false;render() end
    boardView.onInteraction=function(tab) openCity(tab) end
end
render=function()
    if not data then return end
    local state=data.game
    root:SetAttribute("ReducedMotion",data.club and not data.club.effects or false)
    local current=state.players[state.turn]
    local mine=resident(state,player.UserId)
    local myTurn=state.status=="playing" and current and current.id==player.UserId and current.alive
    journeyActive=state.status=="playing" and workspace:GetServerTimeNow()&lt;(data.journeyUntil or 0)
    local isHost=data.hostId==player.UserId
    visitIndex=nil
    for _, visitor in ipairs(data.visitors or {}) do if visitor.id==player.UserId then visitIndex=visitor.tile end end
    if sale.Visible and (not myTurn or state.turnCount~=saleTurn) then sale.Visible=false end
    cashLabel.Text=mine and ("$"..mine.cash) or "$1,500"
    worthLabel.Text=mine and ("NET WORTH  $"..worth(state,mine)) or "YOUR STARTING BALANCE"
    local count=0
    for _,property in ipairs(state.properties) do if property.ownerId==player.UserId then count=count+1 end end
    homesButton.Text="Your homes  ·  "..count
    seats:ClearAllChildren()
    local entries=state.status=="lobby" and data.lobby or state.players
    for seat,entry in ipairs(entries) do
        local row=frame(seats,0,(seat-1)*54,134,48,(current and state.status=="playing" and current.id==entry.id) and C.mint or C.card)
        local tint=Color3.fromHex(Config.playerColors[entry.colorIndex or seat] or "DCC098")
        local dot=frame(row,0,7,5,34,tint);round(dot,3)
        local avatar=frame(row,8,10,30,30,tint);round(avatar,15)
        local initial=text(avatar,string.sub(entry.name,1,1),0,0,30,30,16,C.white,true);initial.TextXAlignment=Enum.TextXAlignment.Center
        if type(entry.id)=="number" and entry.id&gt;0 and portraits[entry.id]==nil then
            portraits[entry.id]=false
            task.spawn(function()
                local ok,url=pcall(function() return Players:GetUserThumbnailAsync(entry.id,Enum.ThumbnailType.HeadShot,Enum.ThumbnailSize.Size100x100) end)
                portraits[entry.id]=ok and url or ""
                if ok then render() end
            end)
        end
        if portraits[entry.id] and portraits[entry.id]~="" then
            local image=Instance.new("ImageLabel");image.Size,image.BackgroundTransparency,image.Image,image.Parent=UDim2.fromScale(1,1),1,portraits[entry.id],avatar
            round(image,15);initial.Visible=false
        end
        local name=text(row,entry.name,44,4,84,18,12,entry.alive==false and C.muted or C.ink,true);truncate(name)
        text(row,entry.cash and ("$"..entry.cash..(entry.alive==false and " · out" or "")) or "READY",44,24,84,19,14,C.green,true)
    end
    roster.Size=UDim2.fromOffset(154,44+math.min(#entries,4)*54)
    roundText.Text=state.status=="playing" and ("TURN "..state.turnCount.." / "..Config.maxTurns) or "LOBBY OPEN"
    if layout then turnChip.Position,turnChip.Size=UDim2.fromOffset(20,layout.roster[2]+roster.Size.Y.Offset+10),UDim2.fromOffset(154,32) end
    dieTextA.Text,dieTextB.Text="",""
    local pipColor=Color3.fromHex(Cosmetics.get(data.club and data.club.styleId or "classic").pip)
    passButton.Visible=false;mainCommand=nil
    if state.status~="playing" then
        turnTitle.Text=state.status=="finished" and "Your next city awaits." or "Build your city."
        local online=data.matchmaking and data.matchmaking.mode=="match"
        turnHint.Text=online and data.matchmaking.status or "Choose online play or practice with bots."
        mainCommand=online and (state.status=="finished" and "BackLobby" or "Match") or "Match"
        actionButton.Text=online and (state.status=="finished" and "Return to lobby" or "Connecting players...") or "PLAY NOW"
    else
        turnTitle.Text=myTurn and "YOUR TURN" or ((current and current.name or "A resident").."'s turn")
        if state.phase=="end" then turnTitle.Text=myTurn and "Turn complete." or ((current and current.name or "A resident").." has finished.") end
        turnHint.Text=state.notice or "A new address is waiting."
        if myTurn then turnHint.Text=state.phase=="roll" and "Roll to move. Events are optional." or (state.phase=="buy" and "Choose a home level, or skip this lot." or (state.phase=="offer" and "Choose cash or a tactical card." or "Next player starts automatically.")) end
        if myTurn then
            if state.phase=="roll" then mainCommand="Roll";actionButton.Text=mine.detained and "Serve detention" or "ROLL DICE"
            elseif state.phase=="buy" then
                local tile=Config.tiles[state.pendingTile]
                mainCommand="Buy"
                actionButton.Text="Buy home · $"..tile.price.."+"
                passButton.Visible=true
            elseif state.phase=="offer" then mainCommand="Offer";actionButton.Text="CHOOSE REWARD"
            else mainCommand="End";actionButton.Text="Next player" end
        elseif current and current.id==player.UserId and state.phase=="end" then mainCommand="End";actionButton.Text="End turn"
        else mainCommand="Plaza";actionButton.Text="City events" end
    end
    if state.status=="playing" and (not mine or not mine.alive) and data.matchmaking and data.matchmaking.mode=="lobby" then
        mainCommand="Match";actionButton.Text=data.matchmaking.queued and "View matchmaking queue" or "Find an online match"
    end
    if rolling then mainCommand=nil;actionButton.Text="Rolling the dice…" end
    if journeyActive and myTurn then
        mainCommand=nil;passButton.Visible=false;actionButton.Text="ON THE MOVE..."
        turnTitle.Text="YOUR TOKEN IS MOVING"
        turnHint.Text="Your result appears when you land."
    end
    dieA.Active,dieB.Active=mainCommand=="Roll",mainCommand=="Roll"
    dieA:SetAttribute("RollReady",dieA.Active);dieB:SetAttribute("RollReady",dieB.Active)
    dieA.AutoButtonColor,dieB.AutoButtonColor=dieA.Active,dieB.Active
    available(actionButton,mainCommand~=nil,C.gold)
    actionDepth.Visible=mainCommand~=nil and not rolling
    diceTotal.Text=rolling and "ROLLING..." or (state.lastRoll and ("TOTAL "..(state.dice[1]+state.dice[2])) or "TAP TO ROLL")
    if layout and layout.compact then
        actionButton.Size=UDim2.fromOffset(layout.toolbar[3]-(passButton.Visible and 130 or 32),64)
        actionDepth.Size=actionButton.Size
    end
    portfolio.Visible=portfolioOpen and not visitIndex
    homeList:ClearAllChildren()
    local row=0
    for index,property in ipairs(state.properties) do
        if property.ownerId==player.UserId then
            local tile=Config.tiles[index]
            local item=button(homeList,"",2,row*68,276,60,C.paper,function() selected=index;inspectorOpen=true;portfolioOpen=false;render() end)
            local strip=frame(item,9,10,5,40,Color3.fromHex(Config.groups[tile.group].color));round(strip,3)
            text(item,tile.name,26,8,235,24,15,C.ink,true)
            text(item,homeNames[property.level+1].." · $"..rent(state,index).." rent"..(pair(state,player.UserId,tile.group) and " · PAIR" or ""),26,32,235,18,11,C.muted)
            row=row+1
        end
    end
    homeList.CanvasSize=UDim2.fromOffset(0,row*68)
    emptyHomes.Visible=row==0
    inspector.Visible=inspectorOpen and selected~=nil and not portfolioOpen and not visitIndex
    highlight.Adornee=nil
    if selected and Config.tiles[selected] and Config.tiles[selected].kind=="property" then
        local tile,property=Config.tiles[selected],state.properties[selected]
        local owner=resident(state,property.ownerId)
        district.Text=string.upper(Config.groups[tile.group].name)
        propertyName.Text=tile.name
        ownerText.Text=owner and (owner.name.."'s home · "..homeNames[property.level+1]) or ("FOR SALE · from $"..tile.price.." including land")
        ownerMark.BackgroundColor3=owner and Color3.fromHex(Config.playerColors[owner.colorIndex]) or C.muted
        rentText.Text="$"..rent(state,selected).." / visit"
        levelText.Text="LEVEL "..property.level.." / 3"
        local own=property.ownerId==player.UserId
        nextRent.Text=owner and ("Rent "..Config.rentTiers[property.rentTier or 1].."×"..(property.shield and " · SHIELDED" or "")..((property.boost or 0)&gt;0 and (" · BOOST "..property.boost) or "")) or "Choose your starting home level before you buy."
        propertyPreview(selected,owner,property)
        upgradeButton.Visible,sellButton.Visible,paintButton.Visible=own and myTurn,own and myTurn,own and myTurn
        rentButton.Visible=own and myTurn
        visitButton.Visible=own and mine and mine.alive and state.status=="playing"
        visitButton.Text="Walk through your home"
        upgradeButton.Text=property.level==3 and "Fully upgraded" or "Upgrade options"
        available(upgradeButton,myTurn and property.level&lt;Config.maxLevel or false,C.green)
        rentButton.Text=(property.rentTier or 1)&gt;=#Config.rentTiers and "Rent maxed" or "Rent options"
        available(rentButton,myTurn and (property.rentTier or 1)&lt;#Config.rentTiers or false,C.green)
        local board=workspace:FindFirstChild("CitymoneyBoard")
        if board and inspector.Visible then highlight.Adornee=board:FindFirstChild("Property"..selected) or board:FindFirstChild("Tile"..selected) end
    else inspector.Visible=false end
    visitBanner.Visible=visitIndex~=nil
    if visitIndex then visitText.Text="At home · "..Config.tiles[visitIndex].name end
    roster.Visible=not visitIndex and not (layout and layout.compact)
    turnChip.Visible=roster.Visible
    cameraBar.Visible=not visitIndex
    cameraBar.TableView.Text=(root:GetAttribute("ViewMode") or Presentation.defaultView)=="city" and "Top view" or "3D view"
    replay.Visible=isHost or (data.matchmaking and data.matchmaking.mode=="match")
    replay.Text=data.matchmaking and data.matchmaking.mode=="match" and "Return to matchmaking" or "Play again"
    if state.status=="finished" then
        local winner=resident(state,state.winnerId)
        resultTitle.Text=winner and (winner.name.." wins the neighborhood.") or "A neighborhood well built."
        resultSubtitle.Text=winner and ("$"..worth(state,winner).." net worth. Home, sweet home.") or "Time for a fresh start."
        resultRows:ClearAllChildren()
        local standings=table.clone(state.players)
        table.sort(standings,function(a,b)
            if a.alive~=b.alive then return a.alive end
            local aw,bw=worth(state,a),worth(state,b)
            return aw&gt;bw or (aw==bw and a.colorIndex&lt;b.colorIndex)
        end)
        for rank,entry in ipairs(standings) do
            text(resultRows,rank.."   "..entry.name.."     $"..worth(state,entry),0,(rank-1)*33,468,30,16,rank==1 and C.green or C.muted,rank==1)
        end
    end
    renderPlans()
    menus:render(data)
    boutique:render(data)
    Motion.face(dieA,state.dice[1]&gt;0 and state.dice[1] or 1,pipColor);Motion.face(dieB,state.dice[2]&gt;0 and state.dice[2] or 6,pipColor)
    city:render(data)
    opportunity:render(data)
    commandMenu.button.Visible=not visitIndex
    commandMenu.button.Text="MENU  [M]"
    commandMenu.quick.Visible=state.status=="playing" and not visitIndex
    commandMenu.cards.Text=mine and mine.challenge and mine.challenge.ready and not state.challengeClaimed and "CLAIM REWARD" or "CARDS &amp; GOALS"
    commandMenu.homes.Text="MY HOMES · "..count
    if layout then commandMenu:resize(layout,roster.Size.Y.Offset) end
    goals:render(data,layout,roster.Size.Y.Offset,visitIndex~=nil)
    if layout then menus:resize(layout,roster.Size.Y.Offset) end
end
local function updateLayout()
    local area=safe.AbsoluteSize
    if area.X&lt;1 or area.Y&lt;1 then return end
    layout=Layout.calculate(area.X,area.Y)
    local w,h=layout.width,layout.height
    uiScale.Scale=layout.scale;root.Size,root.Position=UDim2.fromOffset(w,h),UDim2.fromOffset(0,0)
    place(header,20,16,w-40,layout.headerHeight)
    local hw=w-40
    place(mark,14,12,32,32)
    place(brand,58,5,220,32);brand.TextSize=29
    place(strap,60,36,260,15);strap.Visible=not layout.compact
    place(cashLabel,hw-185,7,168,28);cashLabel.TextSize=25
    place(worthLabel,hw-185,36,168,15)
    homesButton.Visible,helpButton.Visible,dayButton.Visible=false,false,false
    if layout.compact then
        place(brand,58,12,210,32);brand.TextSize=25
        place(cashLabel,hw-166,12,150,28);place(worthLabel,hw-166,44,150,17)
    end
    local r=layout.roster;place(roster,r[1],r[2],r[3],roster.Size.Y.Offset)
    local card=layout.inspector;place(inspector,card[1],card[2],card[3],462)
    local fit=layout.compact and math.min(1.6,(layout.toolbar[2]-card[2]-16)/462) or math.min(1,math.max(0.76,card[4]/462))
    local inner=inspector:FindFirstChildOfClass("UIScale") or Instance.new("UIScale")
    inner.Scale,inner.Parent=fit,inspector
    inspector.Position=UDim2.fromOffset(layout.compact and (w-card[3]*fit)/2 or w-20-card[3]*fit,card[2])
    place(portfolio,w-328,92,308,math.min(440,h-layout.toolbar[4]-125))
    local collectionScale=portfolio:FindFirstChildOfClass("UIScale") or Instance.new("UIScale")
    collectionScale.Scale,collectionScale.Parent=layout.compact and 1.45 or 1,portfolio
    if layout.compact then
        portfolio.Position=UDim2.fromOffset((w-308*1.45)/2,92)
        portfolio.Size=UDim2.fromOffset(308,math.min(440,(layout.toolbar[2]-112)/1.45))
    end
    homeList.Size=UDim2.fromOffset(284,portfolio.Size.Y.Offset-102)
    local t=layout.toolbar;place(control,t[1],t[2],t[3],t[4])
    if layout.compact then
        place(dieA,16,14,80,80);place(dieB,108,14,80,80)
        place(diceTotal,16,104,172,22);diceTotal.TextSize=16
        place(turnTitle,208,14,t[3]-224,30);turnTitle.TextSize=23
        place(turnHint,208,50,t[3]-224,48);turnHint.TextSize=18
        place(timeText,208,104,t[3]-224,22);timeText.TextSize=16
        place(actionButton,16,144,t[3]-32,64);place(passButton,t[3]-98,144,82,64)
        actionButton.TextSize=22
    else
        place(dieA,18,14,72,72);place(dieB,102,14,72,72)
        place(diceTotal,18,89,156,17);diceTotal.TextSize=11
        place(turnTitle,194,13,t[3]-498,30);turnTitle.TextSize=22
        place(turnHint,194,46,t[3]-498,36);turnHint.TextSize=14
        place(timeText,194,84,t[3]-230,16);timeText.TextSize=12
        place(actionButton,t[3]-208,25,190,58);place(passButton,t[3]-288,31,70,50)
        actionButton.TextSize=18
    end
    turnHint.TextWrapped=true
    place(dieTextA,0,0,48,48);place(dieTextB,0,0,48,48)
    actionDepth.Position,actionDepth.Size=actionButton.Position+UDim2.fromOffset(0,4),actionButton.Size
    place(timeTrack,16,t[4]-5,t[3]-32,3)
    place(toast,(w-400)/2,86,400,45)
    place(visitBanner,(w-440)/2,86,440,58)
    if menus then menus:resize(layout,roster.Size.Y.Offset) end
    if commandMenu then commandMenu:resize(layout,roster.Size.Y.Offset) end
    if data then render() end
end
safe:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateLayout)
updateLayout()
local animationVersion=0
local function diceAnimation(first,second)
    if data and data.club and not data.club.effects then
        Motion.face(dieA,first,dieTextA.TextColor3);Motion.face(dieB,second,dieTextB.TextColor3);return
    end
    animationVersion=animationVersion+1;local version=animationVersion
    rolling=true;render()
    task.spawn(function()
        for step=1,10 do
            if version~=animationVersion then return end
            Motion.face(dieA,math.random(1,6),dieTextA.TextColor3);Motion.face(dieB,math.random(1,6),dieTextB.TextColor3)
            dieA.Rotation,dieB.Rotation=step%2==0 and 7 or -7,step%2==0 and -7 or 7
            task.wait(0.045+step*0.003)
        end
        if version~=animationVersion then return end
        Motion.face(dieA,first,dieTextA.TextColor3);Motion.face(dieB,second,dieTextB.TextColor3);dieA.Rotation,dieB.Rotation=0,0
        rolling=false;render()
    end)
end
snapshot.OnClientEvent:Connect(function(incoming)
    if data and incoming.revision&lt;data.revision then return end
    local old=data
    local before=old and resident(old.game,player.UserId)
    local after=resident(incoming.game,player.UserId)
    data=incoming
    local state=data.game
    if old and state.status=="playing" and old.game.status~="playing" then
        results.Visible=false;focusIndex=nil;inspectorOpen=false;portfolioOpen=false
        chooser.Visible=false;planPending=false;planIndex=nil;planTurn=nil
    end
    if old and state.status=="playing" and state.players[state.turn].id==player.UserId and (old.game.turnCount~=state.turnCount or old.game.status~="playing") then
        notify("YOUR TURN · Upgrade, play a card, or roll the dice!")
    end
    if after and before and after.cash~=before.cash then
        local delta=after.cash-before.cash
        if not layout or not layout.compact then Motion.delta(cashLabel,delta,delta&gt;0 and C.green or C.red,root) end
    end
    if state.status=="playing" and state.phase=="buy" and state.players[state.turn].id==player.UserId then
        if not old or old.game.phase~="buy" or old.game.pendingTile~=state.pendingTile then
            selected,portfolioOpen=state.pendingTile,false
            local turn,index=state.turnCount,state.pendingTile
            local delay=math.max(0,(data.journeyUntil or 0)-workspace:GetServerTimeNow())
            task.delay(delay,function()
                if data and data.game.status=="playing" and data.game.turnCount==turn and data.game.phase=="buy" and data.game.pendingTile==index and not chooser.Visible then openPlans("buy",index) end
            end)
        end
    end
    if planPending and chooser.Visible then
        local property=state.properties[planIndex]
        local applied=property and (planMode=="rent" and (property.rentTier or 1)==planLevel+1 or planMode~="rent" and property.level==planLevel)
        if property and property.ownerId==player.UserId and applied then
            chooser.Visible=false;planPending=false
        end
    end
    if old then
        for index,property in ipairs(state.properties) do
            if property.ownerId==player.UserId and old.game.properties[index].ownerId~=player.UserId then
                selected=index
                notify("Your level "..property.level.." "..homeNames[property.level+1].." at "..Config.tiles[index].name.." is ready.")
            elseif property.ownerId==player.UserId and old.game.properties[index].ownerId==player.UserId and property.level&gt;old.game.properties[index].level then
                selected=index
                notify(Config.tiles[index].name.." is now a level "..property.level.." "..homeNames[property.level+1].."!")
            elseif property.ownerId==player.UserId and (property.rentTier or 1)&gt;(old.game.properties[index].rentTier or 1) then
                notify(Config.tiles[index].name.." now charges "..Config.rentTiers[property.rentTier].."× rent on future visits.")
            elseif old.game.properties[index].ownerId==player.UserId and property.ownerId~=player.UserId and state.lastAction and state.lastAction.kind=="demolish" and state.lastAction.tile==index and state.lastAction.seq&gt;(old.game.lastAction and old.game.lastAction.seq or 0) then
                notify("Your house at "..Config.tiles[index].name.." was demolished. The lot is now for sale.")
            end
        end
        if state.turnCount~=old.game.turnCount then focusIndex=nil end
        if state.lastRoll and state.lastRoll.seq&gt;(old.game.lastRoll and old.game.lastRoll.seq or 0) then diceAnimation(state.lastRoll.values[1],state.lastRoll.values[2]) end
    end
    if state.status=="finished" and (not old or old.game.status~="finished") then
        results.Visible=true;help.Visible=false;sale.Visible=false
        menus.lobby.Visible=false;menus.actions.Visible=false;menus.practiceSettings.Visible=false;boutique.shade.Visible=false
        city.shade.Visible=false;commandMenu.shade.Visible=false
        opportunity.shade.Visible=false
        boutique:celebrate()
    end
    moments:observe(data,old)
    render()
end)
feedback.OnClientEvent:Connect(function(message)
    locked=false;planPending=false
    if chooser.Visible then planError=message end
    notify(message);renderPlans();menus:feedback(message);boutique:feedback(message);city:feedback(message)
    opportunity:feedback(message);goals:feedback()
end)
local function inspect(position)
    if help.Visible or sale.Visible or results.Visible or chooser.Visible or visitIndex or menus:isOpen() or boutique:isOpen() or city:isOpen() or commandMenu:isOpen() or opportunity:isOpen() then return end
    local camera,board=workspace.CurrentCamera,workspace:FindFirstChild("CitymoneyBoard")
    if not camera or not board then return end
    local ray=camera:ScreenPointToRay(position.X,position.Y)
    local parameters=RaycastParams.new();parameters.FilterType,parameters.FilterDescendantsInstances=Enum.RaycastFilterType.Include,{board}
    local hit=workspace:Raycast(ray.Origin,ray.Direction*1500,parameters)
    local interaction=hit and (hit.Instance:GetAttribute("Interaction") or hit.Instance.Parent:GetAttribute("Interaction"))
    if interaction=="dice" then
        if mainCommand=="Roll" then mainAction() else notify("Click the dice when it is your turn to roll.") end
        return
    elseif interaction then openCity(interaction);return end
    local index=hit and (hit.Instance:GetAttribute("TileIndex") or hit.Instance.Parent:GetAttribute("TileIndex"))
    if index and Config.tiles[index].kind=="property" then selected,inspectorOpen,portfolioOpen=index,true,false;render() end
end
Input.TouchTapInWorld:Connect(function(position,processed) if not processed then inspect(position) end end)
Input.InputBegan:Connect(function(input,processed)
    if not processed and input.UserInputType==Enum.UserInputType.MouseButton1 then inspect(input.Position) end
    if not processed and input.KeyCode==Enum.KeyCode.M and not visitIndex and not help.Visible and not sale.Visible and not results.Visible and not chooser.Visible and not menus:isOpen() and not boutique:isOpen() and not city:isOpen() and not opportunity:isOpen() then commandMenu.shade.Visible=not commandMenu.shade.Visible;return end
    if processed or help.Visible or sale.Visible or results.Visible or chooser.Visible or menus:isOpen() or boutique:isOpen() or city:isOpen() or commandMenu:isOpen() or opportunity:isOpen() then return end
    if input.KeyCode==Enum.KeyCode.B and visitIndex then send("Return")
    elseif input.KeyCode==Enum.KeyCode.R and mainCommand=="Roll" then send("Roll")
    elseif input.KeyCode==Enum.KeyCode.P and not visitIndex then openCity("overview")
    elseif input.KeyCode==Enum.KeyCode.Space and mainCommand and not visitIndex then mainAction() end
end)
Input.InputChanged:Connect(function(input,processed)
    if not processed and not visitIndex and input.UserInputType==Enum.UserInputType.MouseWheel then
        root:SetAttribute("Zoom",math.clamp((root:GetAttribute("Zoom") or 1)-input.Position.Z*0.06,0.75,1.5))
    end
end)
RunService.RenderStepped:Connect(function(dt)
    if data then
        local travelling=data.game.status=="playing" and workspace:GetServerTimeNow()&lt;(data.journeyUntil or 0)
        if travelling~=journeyActive then render() end
        opportunity:update(data)
    end
    boardView:update(dt,root,safe,layout,data,focusIndex,inspector.Visible or portfolio.Visible,visitIndex,player)
    local blocked=visitIndex or inspector.Visible or portfolio.Visible or help.Visible or sale.Visible or results.Visible or chooser.Visible or menus:isOpen() or boutique:isOpen() or city:isOpen() or commandMenu:isOpen() or opportunity:isOpen()
    hover:update(data,layout,safe,blocked or moments.card.Visible)
    if data then moments:update(data,layout,blocked) end
    if data and data.game.status=="playing" then
        local handing=data.game.phase=="end"
        local seconds=math.max(0,(handing and data.handoffAt or data.deadline)-workspace:GetServerTimeNow())
        local myTurn=data.game.players[data.game.turn].id==player.UserId
        timeText.Text=journeyActive and "DICE · MOVE · ARRIVE" or (handing and ("NEXT TURN IN "..math.ceil(seconds).."s") or (myTurn and (math.ceil(seconds).."s left"..(layout.compact and "" or " · Events [P]")) or "Your turn starts automatically"))
        if chooser.Visible and not planError then
            local tile=Config.tiles[planIndex]
            planNote.Text=(planMode=="buy" and ("Land $"..tile.price.." + building $"..planLevel*tile.upgrade) or (planMode=="rent" and "This multiplier applies to future rent payments." or "Only the added levels are charged.")).."  ·  "..math.ceil(seconds).."s left"
        end
        timeFill.Size,timeFill.BackgroundColor3=UDim2.fromScale(math.clamp(seconds/(handing and Config.autoAdvanceSeconds or Config.turnSeconds),0,1),1),not handing and seconds&lt;10 and C.red or C.green
        if journeyActive then timeFill.Size,timeFill.BackgroundColor3=UDim2.fromScale(Journey.progress(Config,data.game.lastRoll,data.journeyUntil-workspace:GetServerTimeNow()),1),C.gold end
    else timeText.Text="2 / 4 players · online queues or practice with bots";timeFill.Size=UDim2.fromScale(0,1) end
end)
-- Run after Roblox's camera controller, which can hide the local avatar after
-- a first-person home visit. Scriptable board/follow views show its real body.
RunService:BindToRenderStep("CitymoneyAvatarVisibility",Enum.RenderPriority.Camera.Value+1,function()
    if not visitIndex then boardView:revealCharacter(player.Character) end
end)
action:FireServer("Sync")
task.delay(3,function() if not data then action:FireServer("Sync") end end)
</string>
        </Properties>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">BoardView</string>
            <string name="Source">local shared=game:GetService("ReplicatedStorage"):WaitForChild("Citymoney")
local Fit,Layout,Architecture,Config=require(shared.BoardCamera),require(shared.Layout),require(shared.Architecture),require(shared.Config)
local Labels=require(script.Parent.TileLabels)
local Presentation=require(shared.Presentation)
local Follow=require(shared.FollowView)
local Players=game:GetService("Players")
local City=require(shared.CityScenery)
local View={}
View.__index=View
function View.new() return setmetatable({frame=nil,key=nil,wasVisiting=false,bounds=Fit.cityBounds(Config,Architecture)},View) end
function View:revealCharacter(character)
    if self.character~=character then
        if self.characterAdded then self.characterAdded:Disconnect() end
        self.character,self.characterParts=character,{}
        if character then
            for _,part in ipairs(character:GetDescendants()) do if part:IsA("BasePart") then table.insert(self.characterParts,part) end end
            self.characterAdded=character.DescendantAdded:Connect(function(part) if part:IsA("BasePart") then table.insert(self.characterParts,part) end end)
        end
    end
    for _,part in ipairs(self.characterParts or {}) do
        if part.Parent and part.LocalTransparencyModifier~=0 then part.LocalTransparencyModifier=0 end
    end
end
function View:update(dt,root,safe,layout,data,focus,inspector,visit,player)
    local camera=workspace.CurrentCamera
    if not camera or not layout then return end
    if data and self.revision~=data.revision then
        self.revision=data.revision
        local heights={}
        for _,property in ipairs(data.game.properties) do table.insert(heights,property.ownerId and property.level+1 or 0) end
        local signature=table.concat(heights,":")
        if signature~=self.heights then self.heights=signature;self.bounds=Fit.cityBounds(Config,Architecture,data.game);self.key=nil end
    end
    if visit then
        self.following=false;root:SetAttribute("FollowingResident",nil)
        if self.labels then self.labels:update(camera,safe,layout.scale,data,false) end
        local humanoid=player.Character and player.Character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            camera.CameraSubject,camera.CameraType=humanoid,Enum.CameraType.Custom
            player.CameraMinZoomDistance,player.CameraMaxZoomDistance=4,35
            if not self.wasVisiting and humanoid.RootPart then camera.CFrame=CFrame.lookAt(humanoid.RootPart.Position+Vector3.new(14,11,16),humanoid.RootPart.Position) end
        end
        self.wasVisiting=true;return
    end
    if self.wasVisiting then self.frame=nil;self.key=nil end
    self.wasVisiting=false
    camera.CameraType,camera.FieldOfView=Enum.CameraType.Scriptable,36
    local size,offset=camera.ViewportSize,safe.AbsolutePosition
    local mode=root:GetAttribute("ViewMode") or Presentation.defaultView
    local rotate,zoom=root:GetAttribute("Rotate") or 0,root:GetAttribute("Zoom") or 1
    local still=data and data.club and not data.club.effects
    local tracking=not focus and data and Follow.plan(Config,data.game,data.journeyUntil,workspace:GetServerTimeNow(),root:GetAttribute("FollowSuppressed"),still)
    if (tracking~=nil and tracking~=false)~=self.following then self.key=nil end
    self.following=tracking~=nil and tracking~=false
    root:SetAttribute("FollowingResident",tracking and tracking.id or nil)
    local key=table.concat({size.X,size.Y,layout.width,layout.height,layout.scale,offset.X,offset.Y,mode,rotate,zoom,tostring(focus),tostring(inspector),data and data.game.properties[focus or 0] and data.game.properties[focus].level or 0},":")
    if self.key~=key or tracking then
        self.key=key
        local rectangle=Layout.board(layout,inspector)
        local rect={offset.X+rectangle[1]*layout.scale,offset.Y+rectangle[2]*layout.scale,rectangle[3]*layout.scale,rectangle[4]*layout.scale}
        self.rect=rect
        local yaw,elevation=Presentation.viewAngles(mode,rotate)
        local bounds=mode=="city" and City.bounds() or self.bounds
        if tracking then
            local resident=type(tracking.id)=="number" and Players:GetPlayerByUserId(tracking.id)
            local board=workspace:FindFirstChild("CitymoneyBoard")
            local character=resident and resident.Character
            local model=character and character:GetAttribute("CitymoneyPrepared") and character or (board and board:FindFirstChild("Figure_"..tracking.id))
            local body=model and (model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso"))
            local position=body and {body.Position.X,body.Position.Y,body.Position.Z} or tracking.position
            bounds,yaw,elevation=Follow.framing(position)
        elseif focus then
            local p,angle=Architecture.site(focus)
            local level=data and data.game.properties[focus].level or 0
            bounds={min={p[1]-11,1,p[3]-11},max={p[1]+11,13+level*6,p[3]+11}}
            yaw,elevation=angle+math.rad(150),math.rad(40)
        end
        -- Calibrate using Roblox's own projection; this also handles top bars,
        -- phone cutouts and ViewportSize differing from the full rendering area.
        local rayA=camera:ScreenPointToRay(rect[1]+10,rect[2]+10)
        local rayB=camera:ScreenPointToRay(rect[1]+rect[3]-10,rect[2]+rect[4]-10)
        local a=camera.CFrame:VectorToObjectSpace(rayA.Direction)
        local b=camera.CFrame:VectorToObjectSpace(rayB.Direction)
        local fitted=Fit.fromSlopes({a.X/-a.Z,b.X/-b.Z,b.Y/-b.Z,a.Y/-a.Z},yaw,elevation,zoom,bounds)
        self.goal=CFrame.fromMatrix(Vector3.new(table.unpack(fitted.position)),Vector3.new(table.unpack(fitted.right)),Vector3.new(table.unpack(fitted.up)),Vector3.new(table.unpack(fitted.back)))
    end
    if not self.frame or still then self.frame=self.goal
    else self.frame=self.frame:Lerp(self.goal,1-math.exp(-(tracking and 12 or 8)*math.min(dt,0.1))) end
    camera.CFrame=self.frame
    if not self.labels then self.labels=Labels.new(root,self.onProperty,self.onInteraction) end
    self.labels:update(camera,safe,layout.scale,data,mode=="table" and not focus and not tracking,self.rect)
end
return View
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">Boutique</string>
            <string name="Source">-- The native Roblox prompt handles all Robux payments. Snapshots grant access.
local Marketplace=game:GetService("MarketplaceService")
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local TweenService=game:GetService("TweenService")
local shared=game:GetService("ReplicatedStorage"):WaitForChild("Citymoney")
local Cosmetics,Architecture,Scene=require(shared.Cosmetics),require(shared.Architecture),require(shared.Scene)
local Boutique={}
Boutique.__index=Boutique
function Boutique.new(ui)
    local self=setmetatable({ui=ui,selected="gilded",price=nil,forSale=false,infoPass=nil,infoState="idle",error=nil,angle=0},Boutique)
    local C=ui.colors
    self.shade,self.card=ui.overlay(520,660)
    ui.text(self.card,"THE WATERFRONT ATELIER",24,16,430,20,10,C.green,true)
    ui.text(self.card,"Make it yours.",24,42,430,37,28,C.ink,true)
    ui.button(self.card,"×",468,18,28,28,C.paper,function() self.shade.Visible=false end)
    ui.text(self.card,"Three signature collections · one permanent Club pass",24,84,472,22,12,C.muted)
    self.viewport=Instance.new("ViewportFrame")
    self.viewport.Position,self.viewport.Size=UDim2.fromOffset(24,118),UDim2.fromOffset(472,180)
    self.viewport.BackgroundColor3,self.viewport.BorderSizePixel=C.mint,0
    self.viewport.Ambient,self.viewport.LightColor=Color3.fromRGB(185,185,178),Color3.fromRGB(255,239,212)
    self.viewport.LightDirection,self.viewport.Parent=Vector3.new(-1,-2,-1),self.card
    local corner=Instance.new("UICorner");corner.CornerRadius,corner.Parent=UDim.new(0,12),self.viewport
    self.world=Instance.new("WorldModel");self.world.Parent=self.viewport
    self.camera=Instance.new("Camera");self.camera.FieldOfView,self.camera.Parent=34,self.viewport
    self.viewport.CurrentCamera=self.camera
    self.buttons={}
    for index,style in ipairs(Cosmetics.styles) do
        local choose=ui.button(self.card,style.name,24+((index-1)%2)*242,311+math.floor((index-1)/2)*48,230,40,C.paper,function()
            self.selected=style.id;self.error=nil;self:render(ui.data())
        end)
        choose.TextSize=12;self.buttons[style.id]=choose
    end
    self.description=ui.text(self.card,"",24,411,472,42,13,C.muted)
    self.motion=ui.button(self.card,"Reduced motion: OFF",24,465,472,34,C.paper,function()
        local data=ui.data()
        if data and data.club then
            self.error=nil;ui.send("Style",{styleId=data.club.styleId,effects=not data.club.effects})
        end
    end);self.motion.TextSize=12
    self.status=ui.text(self.card,"",24,508,472,29,12,C.green,true)
    self.primary=ui.button(self.card,"Preview collection",24,548,304,42,C.green,function() self:activate() end)
    self.restore=ui.button(self.card,"Check ownership",340,548,156,42,C.paper,function()
        self.error=nil;ui.send("ClubRefresh")
        local data=ui.data();if data and data.club then self:product(data.club.passId,true) end
    end);self.restore.TextSize=11
    self.note=ui.text(self.card,"Cosmetics only. Your cash, rent, cards and dice odds stay the same.",24,601,472,39,12,C.muted)
    RunService.RenderStepped:Connect(function(dt)
        if not self.shade.Visible or not self.target then return end
        local data=ui.data()
        if not data or not data.club or data.club.effects then self.angle=self.angle+math.min(dt,0.05)*0.13 end
        local theta=math.rad(145)+math.sin(self.angle)*0.22
        self.camera.CFrame=CFrame.lookAt(self.target+Vector3.new(math.sin(theta)*38,22,math.cos(theta)*38),self.target)
    end)
    Marketplace.PromptGamePassPurchaseFinished:Connect(function(player,passId)
        if player==Players.LocalPlayer and passId==self.infoPass then self.prompting=false;self:render(ui.data()) end
    end)
    return self
end
function Boutique:isOpen() return self.shade.Visible end
function Boutique:open()
    self.shade.Visible=true;self.error=nil
    self:render(self.ui.data())
end
function Boutique:feedback(message)
    if self.shade.Visible then self.error=message;self:render(self.ui.data()) end
end
function Boutique:product(passId,retry)
    if passId&lt;=0 or (self.infoPass==passId and (not retry or self.infoState=="loading")) then return end
    self.infoPass,self.infoState,self.price,self.forSale=passId,"loading",nil,false
    task.spawn(function()
        -- Fetch on the client so Roblox regional/personalized prices are accurate.
        local ok,info=pcall(function() return Marketplace:GetProductInfoAsync(passId,Enum.InfoType.GamePass) end)
        if self.infoPass~=passId then return end
        self.infoState=ok and "ready" or "failed"
        self.forSale=ok and info.IsForSale==true
        self.price=self.forSale and type(info.PriceInRobux)=="number" and info.PriceInRobux or nil
        self:render(self.ui.data())
    end)
end
function Boutique:activate()
    local data=self.ui.data()
    if not data or not data.club or data.club.loading or self.prompting then return end
    local profile,style=data.club,Cosmetics.get(self.selected)
    if Cosmetics.allowed(style.id,profile.ownsPass,profile.studio) then
        self.error=nil;self.ui.send("Style",{styleId=style.id,effects=profile.effects})
    elseif profile.passId&gt;0 and self.forSale then
        self.prompting=true
        local ok=pcall(function() Marketplace:PromptGamePassPurchase(Players.LocalPlayer,profile.passId) end)
        if not ok then self.prompting=false end
        self.error=not ok and "Roblox could not open the purchase prompt. Please try again." or nil
        self:render(data)
    end
end
function Boutique:render(data)
    if not data or not data.club then return end
    local ui,C,profile=self.ui,self.ui.colors,data.club
    local equipped=Cosmetics.get(profile.styleId)
    -- Apply the active collection throughout the HUD, even with the showroom closed.
    ui.dieA.BackgroundColor3,ui.dieB.BackgroundColor3=Color3.fromHex(equipped.dice),Color3.fromHex(equipped.dice)
    ui.dieTextA.TextColor3,ui.dieTextB.TextColor3=Color3.fromHex(equipped.pip),Color3.fromHex(equipped.pip)
    ui.mark.BackgroundColor3=Color3.fromHex(equipped.accent)
    ui.header:FindFirstChildOfClass("UIStroke").Color=equipped.premium and Color3.fromHex(equipped.accent) or C.line
    ui.strap.Text=equipped.premium and ("CLUB MEMBER · "..equipped.label) or "BUILD YOUR CITY"
    if not self.shade.Visible then return end
    self:product(profile.passId,false)
    local selected=Cosmetics.get(self.selected)
    for id,button in pairs(self.buttons) do
        local style=Cosmetics.get(id)
        button.BackgroundColor3=id==selected.id and Color3.fromHex(style.dice) or C.paper
        button.TextColor3=id==selected.id and Color3.fromHex(style.pip) or C.ink
        button.Text=style.name..(id==profile.styleId and " ✓" or "")
    end
    local color=ui.config.playerColors[1]
    for _,resident in ipairs(data.game.players) do if resident.id==ui.id then color=ui.config.playerColors[resident.colorIndex] end end
    for _,member in ipairs(data.lobby) do if member.id==ui.id and data.game.status~="playing" then color=ui.config.playerColors[member.colorIndex] or color end end
    local key=selected.id..":"..color
    if self.previewKey~=key then
        self.previewKey=key;self.world:ClearAllChildren();self.angle=0
        local model=Scene.model(Architecture.property(ui.config,2,Players.LocalPlayer.DisplayName,color,2,0,nil,selected.id),"CollectionPreview",self.world,true)
        local cf=model:GetBoundingBox();self.target=cf.Position+Vector3.new(0,0.4,0)
        self.viewport.BackgroundColor3=selected.premium and Color3.fromHex(selected.stone) or C.mint
    end
    self.description.Text=selected.description
    self.motion.Text=profile.effects and "Reduced motion: OFF · animated preview, dice and walking trail" or "Reduced motion: ON · still preview and dice; walking trail off"
    ui.available(self.motion,not profile.loading,C.paper)
    local allowed=Cosmetics.allowed(selected.id,profile.ownsPass,profile.studio)
    local enabled=not profile.loading and not self.prompting and (allowed and profile.styleId~=selected.id or not allowed and self.forSale)
    if self.prompting then self.primary.Text="Complete Roblox checkout…"
    elseif profile.loading then self.primary.Text="Loading collection…"
    elseif profile.styleId==selected.id then self.primary.Text="Equipped ✓"
    elseif allowed then self.primary.Text=profile.studio and "Equip in Studio preview" or "Equip "..selected.name
    elseif profile.passId==0 then self.primary.Text="Club pass coming soon"
    elseif self.infoState=="loading" then self.primary.Text="Checking Roblox price…"
    elseif not self.forSale then self.primary.Text="Pass currently unavailable"
    else self.primary.Text=self.price and ("Unlock all styles · R$ "..self.price) or "Unlock Club · Roblox checkout" end
    ui.available(self.primary,enabled==true,C.green)
    ui.available(self.restore,not profile.loading and not profile.studio and profile.passId&gt;0,C.paper)
    self.status.Text=self.error or (profile.loading and "Loading your collection…" or (profile.studio and "STUDIO PREVIEW · no purchases or permanent unlocks" or (profile.ownsPass and "CLUB MEMBER · all three collections unlocked" or "Preview any collection before purchasing.")))
    self.status.TextColor3=self.error and C.red or C.green
    self.note.Text=self.error and "Purchases and ownership are handled by Roblox. Try Check ownership if needed." or (profile.status~="" and profile.status or "Cosmetics only. Your cash, rent, cards and dice odds stay the same.")
end
function Boutique:celebrate()
    local data=self.ui.data()
    if not data or not data.club or not data.club.effects then return end
    local style=Cosmetics.get(data.club.styleId)
    local layer=Instance.new("Frame")
    layer.Size,layer.BackgroundTransparency,layer.ZIndex,layer.Parent=UDim2.fromScale(1,1),1,40,self.ui.root
    layer.ClipsDescendants=true
    for i=1,28 do
        local confetti=Instance.new("Frame")
        confetti.Size,confetti.Position=UDim2.fromOffset(5+i%3*2,10),UDim2.fromScale((i*0.618)%1,-0.06-i%4*0.06)
        confetti.BackgroundColor3=Color3.fromHex(i%2==0 and style.accent or "F0DCA8")
        confetti.BorderSizePixel,confetti.Rotation,confetti.ZIndex,confetti.Parent=0,i*27,41,layer
        TweenService:Create(confetti,TweenInfo.new(2.3+i%5*0.15,Enum.EasingStyle.Quad,Enum.EasingDirection.In),{Position=UDim2.fromScale((i*0.618+0.12)%1,1.1),Rotation=i*27+190,BackgroundTransparency=0.7}):Play()
    end
    task.delay(3.2,function() layer:Destroy() end)
end
return Boutique
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">CityOffer</string>
            <string name="Source">local shared=game:GetService("ReplicatedStorage"):WaitForChild("Citymoney")
local Offers=require(shared.Opportunities)
local View={}
View.__index=View
function View.new(ui)
 local self=setmetatable({ui=ui,seen=nil,pending=nil,error=nil},View)
 local C=ui.colors
 self.shade,self.card=ui.overlay(520,554)
 self.shade.Name="OpportunityOverlay"
 ui.text(self.card,"CITY OPPORTUNITY",24,17,380,24,13,C.green,true)
 self.title=ui.text(self.card,"Choose your reward.",24,51,420,40,27,C.ink,true)
 ui.button(self.card,"X",452,17,44,44,C.paper,function() if not self.pending then self.shade.Visible=false end end)
 self.description=ui.text(self.card,"",24,99,472,54,16,C.muted)
 self.choices={}
 for index=1,2 do
  local button=ui.button(self.card,"",24,170+(index-1)*145,472,132,C.paper,function() self:choose(index) end)
  local icon=ui.frame(button,16,29,66,66,index==1 and C.gold or C.green)
  local glyph=ui.text(icon,index==1 and "$" or "CARD",0,0,66,66,index==1 and 34 or 17,index==1 and C.ink or C.white,true)
  glyph.TextXAlignment=Enum.TextXAlignment.Center
  local title=ui.text(button,"",104,14,346,32,23,C.ink,true)
  local detail=ui.text(button,"",104,52,346,45,16,C.muted)
  local hint=ui.text(button,"CHOOSE THIS &gt;",104,101,346,22,14,C.green,true)
  self.choices[index]={button=button,title=title,detail=detail,hint=hint}
 end
 self.status=ui.text(self.card,"",24,463,472,27,15,C.green,true)
 ui.text(self.card,"No cost. If time runs out, cash is chosen automatically.",24,500,472,34,14,C.muted)
 return self
end
function View:isOpen() return self.shade.Visible end
function View:valid(data)
 local s=data and data.game
 return s and s.status=="playing" and s.phase=="offer" and s.pendingOffer and s.pendingOffer.actorId==self.ui.id
end
function View:open()
 local data=self.ui.data()
 if not self:valid(data) then return end
 if workspace:GetServerTimeNow()&lt;(data.journeyUntil or 0) then return end
 self.ui.closePanels();self.shade.Visible=true;self:render(data)
end
function View:update(data)
 if not self:valid(data) then self.seen=nil;self.pending=nil;self.shade.Visible=false;return end
 local p=data.game.pendingOffer
 local key=p.turn..":"..p.seq
 if self.seen~=key and workspace:GetServerTimeNow()&gt;=(data.journeyUntil or 0) then
  self.seen=key;self.error=nil;self:open()
 end
 if self.shade.Visible then self:render(data) end
end
function View:choose(index)
 local data=self.ui.data()
 if self.pending or not self:valid(data) then return end
 if self.ui.send("Offer",Offers.request(data.game,index)) then self.pending=data.game.pendingOffer.seq;self.error=nil;self:render(data) end
end
function View:feedback(message)
 if self.shade.Visible then self.pending=nil;self.error=message;self:render(self.ui.data()) end
end
function View:render(data)
 if not self.shade.Visible then return end
 if not self:valid(data) then self.shade.Visible=false;self.pending=nil;return end
 local ui,C=self.ui,self.ui.colors
 local player
 for _,p in ipairs(data.game.players) do if p.id==ui.id then player=p end end
 local definition=ui.config.opportunities[data.game.pendingOffer.definition]
 self.title.Text=definition.name;self.description.Text=definition.description
 for index,row in ipairs(self.choices) do
  local reward=definition.choices[index];local allowed=Offers.available(ui.config,player,reward)
  ui.available(row.button,allowed and not self.pending,C.paper)
  row.title.Text,row.detail.Text=reward.label,reward.detail
  row.hint.Text=allowed and "CHOOSE THIS &gt;" or "HAND FULL · TAKE CASH INSTEAD"
  row.hint.TextColor3=allowed and C.green or C.red
 end
 local seconds=math.max(0,math.ceil(data.deadline-workspace:GetServerTimeNow()))
 self.status.Text=self.error or (self.pending and "Confirming your reward..." or ("Your choice · "..seconds.." seconds left"))
 self.status.TextColor3=self.error and C.red or C.green
end
return View
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">CityPlaza</string>
            <string name="Source">-- Large event choices and explicit prices; transactions remain server-validated.
local shared=game:GetService("ReplicatedStorage"):WaitForChild("Citymoney")
local Plaza=require(shared.Plaza)
local City={}
City.__index=City
local function eligible(config,offer,property,id)
    if not property or property.ownerId~=id then return false,"Choose one of your homes" end
    if offer.kind=="boost" and (property.boost or 0)&gt;0 then return false,"Rent boost already active" end
    if offer.kind=="shield" and property.shield then return false,"Already protected" end
    if offer.kind=="repair" and property.level&gt;=config.maxLevel then return false,"Already fully upgraded" end
    return true,offer.kind=="boost" and "+50% rent for 2 payments" or (offer.kind=="shield" and "Block the next demolition" or ("Upgrade to level "..(property.level+1)))
end
function City.new(ui)
    local self=setmetatable({ui=ui,tab="overview",tile=nil,kind="shield",pending=nil,error=nil},City)
    local C=ui.colors
    self.shade,self.card=ui.overlay(520,656)
    ui.text(self.card,"CITY EVENTS",24,15,380,22,13,C.green,true)
    self.heading=ui.text(self.card,"Choose an event.",24,45,425,38,27,C.ink,true)
    self.close=ui.button(self.card,"X",452,17,44,44,C.paper,function() self.shade.Visible=false end)
    self.back=ui.button(self.card,"&lt; ALL EVENTS",24,96,168,46,C.paper,function() self:open("overview") end)
    self.title=ui.text(self.card,"",24,154,472,32,23,C.ink,true)
    self.description=ui.text(self.card,"",24,194,472,54,16,C.muted)
    self.period=ui.text(self.card,"",24,254,472,26,13,C.green,true)
    self.rows=Instance.new("ScrollingFrame")
    self.rows.Position,self.rows.Size=UDim2.fromOffset(24,292),UDim2.fromOffset(472,194)
    self.rows.BackgroundTransparency,self.rows.BorderSizePixel,self.rows.ScrollBarThickness,self.rows.Parent=1,0,6,self.card
    self.detail=ui.text(self.card,"",24,498,472,36,15,C.ink,true)
    self.status=ui.text(self.card,"",24,537,472,27,13,C.muted)
    self.confirm=ui.button(self.card,"Choose a home",24,574,332,64,C.gold,function() self:confirmOffer() end)
    self.done=ui.button(self.card,"CLOSE",368,574,128,64,C.paper,function() self.shade.Visible=false end)
    self.confirm.TextSize=17;self.done.TextSize=17
    self.overview=Instance.new("Frame")
    self.overview.Size,self.overview.Position,self.overview.BackgroundTransparency,self.overview.Parent=UDim2.fromOffset(472,452),UDim2.fromOffset(24,102),1,self.card
    self.options={}
    local destinations={
        {"festival","FESTIVAL","Improve one of your homes","FF9DCF"},
        {"market","CARD MARKET","Buy the card you choose","FFC34D"},
        {"contracts","CHALLENGES","Complete goals, collect rewards","AFACFF"},
        {"news","CITY NEWS","Read the city bulletin","75D9EC"},
    }
    for index,item in ipairs(destinations) do
        local x,y=((index-1)%2)*242,math.floor((index-1)/2)*172
        local button=ui.button(self.overview,"",x,y,230,158,C.paper,function() self:open(item[1]) end)
        ui.frame(button,16,16,38,7,Color3.fromHex(item[4]))
        ui.text(button,item[2],16,34,198,27,18,C.ink,true)
        ui.text(button,item[3],16,69,198,42,15,C.muted)
        local note=ui.text(button,"OPEN &gt;",16,121,198,23,14,C.green,true)
        self.options[item[1]]={button=button,note=note}
    end
    ui.text(self.overview,"One paid city offer per turn, before rolling.\nAll prices use game cash.",0,354,472,66,16,C.muted)
    return self
end
function City:isOpen() return self.shade.Visible end
function City:open(tab)
    if tab=="contracts" then self.shade.Visible=false;self.ui.openGoals();return end
    if tab=="festival" and (self.tab~="festival" or not self.shade.Visible) then self.tile=nil end
    self.tab=tab or "overview";self.shade.Visible=true;self.error=nil
    self:render(self.ui.data())
end
function City:feedback(message)
    if self.shade.Visible then self.pending=nil;self.error=message;self:render(self.ui.data()) end
end
function City:confirmOffer()
    local data=self.ui.data()
    if not data or self.pending or (self.tab~="festival" and self.tab~="market") then return end
    local festival=Plaza.festival(self.ui.config,data.game)
    local request={shop=self.tab,kind=self.kind,tile=self.tile,turn=data.game.turnCount,festivalId=festival.id}
    if self.ui.send("Plaza",request) then
        self.pending={turn=request.turn,shop=self.tab};self.error=nil
        local pending=self.pending
        task.delay(4,function()
            if self.pending==pending then self.pending=nil;self.error="Checking your purchase. Please wait for the refreshed match.";self.ui.send("Sync");self:render(self.ui.data()) end
        end)
        self:render(data)
    end
end
function City:render(data)
    if not data or not self.shade.Visible then return end
    local state,ui,C=data.game,self.ui,self.ui.colors
    local me,current
    for _,player in ipairs(state.players) do if player.id==ui.id then me=player end end
    current=state.players[state.turn]
    local myTurn=state.status=="playing" and me and me.alive and current and current.id==ui.id
    if self.pending and self.pending.turn~=state.turnCount then self.pending=nil;self.error="Your turn changed. Review the current offer."
    elseif self.pending and state.plazaUsed then
        local message=self.pending.shop=="festival" and "Festival applied to your home!" or "Card added! Open Cards &amp; Goals to play it."
        self.pending=nil;self.error=nil;self.shade.Visible=false;ui.notify(message);return
    end
    local canBuy=myTurn and state.phase=="roll" and not state.plazaUsed and not self.pending
    local overview=self.tab=="overview"
    self.overview.Visible=overview;self.back.Visible=not overview
    for _,object in ipairs({self.title,self.description,self.period,self.rows,self.detail,self.status,self.confirm}) do object.Visible=not overview end
    self.done.Position,self.done.Size=UDim2.fromOffset(overview and 24 or 368,574),UDim2.fromOffset(overview and 472 or 128,64)
    self.done.Text=overview and "BACK TO BOARD" or "CLOSE"
    self.heading.Text=overview and "Choose an event." or (self.tab=="market" and "Pick a card." or (self.tab=="news" and "Around the city." or "Join the festival."))
    local festival,remaining=Plaza.festival(ui.config,state)
    if overview then
        self.options.festival.note.Text=festival.name.." · $"..festival.cost
        local cheapest=math.huge
        for _,price in pairs(ui.config.cityMarket) do cheapest=math.min(cheapest,price) end
        self.options.market.note.Text="CARDS FROM $"..cheapest.." &gt;"
        self.options.contracts.note.Text=me and me.challenge and me.challenge.ready and "REWARD READY &gt;" or "VIEW YOUR GOAL &gt;"
        self.options.news.note.Text="LATEST UPDATES &gt;"
        return
    end
    self.rows:ClearAllChildren()
    self.detail.TextSize=15
    local cost,valid,count=0,false,0
    local function option(title,subtitle,right,chosen,enabled,callback)
        local button=ui.button(self.rows,"",2,count*70,460,64,chosen and C.mint or C.paper,callback)
        button.Active=enabled
        ui.text(button,title,14,5,324,28,17,enabled and C.ink or C.muted,true)
        ui.text(button,subtitle,14,35,382,23,14,C.muted)
        ui.text(button,right,350,9,96,24,16,C.green,true)
        count=count+1
    end
    if self.tab=="festival" then
        self.title.Text=festival.name;self.description.Text=festival.description
        self.period.Text=remaining.." turns left · choose your home below"
        local allowed={}
        for index,property in ipairs(state.properties) do if eligible(ui.config,festival,property,ui.id) then table.insert(allowed,index) end end
        -- A sole eligible home needs no unnecessary selection click. Multiple
        -- eligible homes always require the player's explicit choice.
        if self.tile and not table.find(allowed,self.tile) then self.tile=nil end
        if not self.tile and #allowed==1 then self.tile=allowed[1] end
        for index,property in ipairs(state.properties) do if property.ownerId==ui.id then
            local enabled,explanation=eligible(ui.config,festival,property,ui.id)
            local chosen=self.tile==index
            option(ui.config.tiles[index].name,explanation,chosen and "CHOSEN" or ("L"..property.level),chosen,enabled,function() self.tile=index;self.error=nil;self:render(ui.data()) end)
        end end
        if count==0 then ui.text(self.rows,"Buy a home first to join this festival.\nYou can still visit the Card Market.",12,22,440,100,18,C.muted) end
        cost=festival.cost;valid=self.tile~=nil
        self.detail.Text=valid and ("Cost $"..cost.." · Balance after $"..((me and me.cash or 0)-cost)) or ("Choose a home · festival costs $"..cost)
    elseif self.tab=="market" then
        self.title.Text="Choose exactly what you get."
        self.description.Text="Buy a card, then open Cards &amp; Goals to choose its target and play it."
        self.period.Text="One purchase per turn · up to 3 of each card"
        for _,kind in ipairs(ui.config.cardTypes) do
            local definition=ui.config.cardDefinitions[kind]
            local owned=me and me.cards[kind] or 0
            local chosen=self.kind==kind
            local enabled=owned&lt;ui.config.cardLimit
            option(definition.name,(chosen and "SELECTED · " or "")..owned.." / 3 in your hand","$"..ui.config.cityMarket[kind],chosen,enabled,function() self.kind=kind;self.error=nil;self:render(ui.data()) end)
        end
        self.detail.Text=ui.config.cardDefinitions[self.kind].description
        self.detail.TextSize=14
        cost=ui.config.cityMarket[self.kind];valid=me and (me.cards[self.kind] or 0)&lt;ui.config.cardLimit or false
    else
        self.title.Text="Current festival: "..festival.name
        self.description.Text=festival.description
        self.period.Text="RECENT CITY NEWS"
        for _,message in ipairs(state.logs) do ui.text(self.rows,message,8,count*64,444,60,16,C.ink);count=count+1 end
        self.detail.Text="Events and offers change as the match progresses."
    end
    self.rows.CanvasSize=UDim2.fromOffset(0,count*(self.tab=="news" and 64 or 70))
    self.status.Text=self.error or (not myTurn and "Look around! Paid offers open on your turn." or (state.phase~="roll" and "Use city offers before rolling on your next turn." or (state.plazaUsed and "City offer used. Your next step is to roll." or "")))
    self.status.TextColor3=self.error and C.red or C.muted
    local enabled=canBuy and valid and me.cash&gt;=cost and self.tab~="news"
    ui.available(self.confirm,enabled==true,C.gold)
    self.confirm.Visible=self.tab~="news"
    if self.pending then self.confirm.Text="CONFIRMING..."
    elseif not canBuy then self.confirm.Text="BROWSE FOR NEXT TURN"
    elseif not valid then self.confirm.Text=self.tab=="festival" and "CHOOSE A HOME" or "CARD LIMIT REACHED"
    elseif me.cash&lt;cost then self.confirm.Text="NEED $"..(cost-me.cash).." MORE"
    else self.confirm.Text=(self.tab=="market" and "BUY CARD · $" or "JOIN FESTIVAL · $")..cost end
end
return City
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">CommandMenu</string>
            <string name="Source">local P=require(game:GetService("ReplicatedStorage"):WaitForChild("Citymoney").Presentation)
local Command={}
Command.__index=Command
function Command.new(ui)
    local self=setmetatable({ui=ui},Command)
    local C=ui.colors
    self.button=ui.button(ui.root,"MENU",20,620,154,46,C.card,function() self.shade.Visible=not self.shade.Visible end)
    self.button.Name="CityMenuButton"
    self.shade,self.card=ui.overlay(490,510)
    ui.text(self.card,"CITYMONEY",24,19,260,20,12,C.green,true)
    ui.text(self.card,"Everything in one place.",24,46,420,40,26,C.ink,true)
    ui.button(self.card,"DAY / NIGHT",300,18,126,26,C.paper,function() self.shade.Visible=false;ui.switchLight() end).TextSize=10
    ui.button(self.card,"X",438,20,32,44,C.paper,function() self.shade.Visible=false end)
    local commands={
        {"PLAY TOGETHER","Online, friends or practice",function() ui.openMatch() end},
        {"CARDS &amp; GOALS","Play a card or claim a reward",function() ui.openGoals() end},
        {"CITY EVENTS","Festival, market and news",function() ui.openCity() end},
        {"YOUR PROPERTIES","Upgrade, set rent or visit",function() ui.openHomes() end},
        {"STYLE STUDIO","House and dice cosmetics",function() ui.openStyles() end},
        {"HOW TO PLAY","Learn the three easy steps",function() ui.openHelp() end},
    }
    for index,item in ipairs(commands) do
        local x,y=24+((index-1)%2)*225,110+math.floor((index-1)/2)*112
        local tile=ui.button(self.card,"",x,y,217,100,C.paper,function() self.shade.Visible=false;item[3]() end)
        ui.frame(tile,14,14,30,5,index==3 and C.gold or C.green)
        ui.text(tile,item[1],14,31,190,26,16,C.ink,true)
        ui.text(tile,item[2],14,62,190,29,13,C.muted)
    end
    ui.text(self.card,"Turns move on automatically. Just roll, choose, and play.",24,456,442,30,13,C.muted)
    self.quick=ui.frame(ui.root,20,410,154,144,C.card)
    self.quick.Name="QuickActions"
    self.events=ui.button(self.quick,"EVENTS",8,8,138,40,C.green,function() ui.openCity() end)
    self.events.Name="OpenEvents"
    self.cards=ui.button(self.quick,"CARDS &amp; GOALS",8,56,138,36,C.paper,function() ui.openGoals() end)
    self.cards.Name="OpenCards"
    self.homes=ui.button(self.quick,"MY HOMES",8,100,138,36,C.paper,function() ui.openHomes() end)
    self.homes.Name="OpenHomes"
    return self
end
function Command:isOpen() return self.shade.Visible end
function Command:resize(layout,rosterHeight)
    local r=layout.menu
    self.button.Position,self.button.Size=UDim2.fromOffset(r[1],r[2]),UDim2.fromOffset(r[3],r[4])
    local q=P.shortcuts(layout,rosterHeight)
    self.quick.Position,self.quick.Size=UDim2.fromOffset(q[1],q[2]),UDim2.fromOffset(q[3],q[4])
    local buttons={self.events,self.cards,self.homes}
    for i,button in ipairs(buttons) do
        if layout.compact then
            local w=(q[3]-16)/3
            button.Position,button.Size=UDim2.fromOffset((i-1)*(w+8),0),UDim2.fromOffset(w,64)
            button.TextSize=17
        else
            button.Position,button.Size=UDim2.fromOffset(8,8+(i-1)*44),UDim2.fromOffset(138,40)
            button.TextSize=14
        end
    end
end
return Command
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">GoalDisplay</string>
            <string name="Source">local P=require(game:GetService("ReplicatedStorage"):WaitForChild("Citymoney").Presentation)
local Tween=game:GetService("TweenService")
local Goal={}
Goal.__index=Goal
function Goal.new(ui)
 local self=setmetatable({ui=ui,ratio=nil,pending=nil},Goal)
 local C=ui.colors
 self.button=ui.button(ui.root,"",20,566,154,80,C.card,function() self:activate() end)
 self.button.Name="GoalProgress"
 self.button.Visible=false
 self.tag=ui.text(self.button,"YOUR GOAL",10,5,134,16,10,C.green,true)
 self.name=ui.text(self.button,"",10,22,134,34,14,C.ink,true)
 self.detail=ui.text(self.button,"",10,58,134,14,11,C.muted)
 self.track=ui.frame(self.button,10,73,134,3,C.paper)
 self.fill=Instance.new("Frame");self.fill.Size,self.fill.BackgroundColor3,self.fill.BorderSizePixel,self.fill.Parent=UDim2.fromScale(0,1),C.green,0,self.track
 return self
end
function Goal:activate()
 if self.pending then return end
 local data=self.ui.data()
 if not data then return end
 local me
 for _,p in ipairs(data.game.players) do if p.id==self.ui.id then me=p end end
 local current=data.game.players[data.game.turn]
 if me and me.challenge.ready and current and current.id==me.id and not data.game.challengeClaimed and not self.pending then
  if self.ui.send("Claim",nil,nil,data.game.turnCount) then self.pending=data.game.turnCount;self:render(data,self.layout,self.rosterHeight,self.walking) end
 else self.ui.openGoals() end
end
function Goal:feedback() self.pending=nil;self:render(self.ui.data(),self.layout,self.rosterHeight,self.walking) end
function Goal:render(data,layout,rosterHeight,walking)
 if not layout or not data then return end
 self.layout,self.rosterHeight,self.walking=layout,rosterHeight,walking
 local s,C=data.game,self.ui.colors
 local me
 for _,p in ipairs(s.players) do if p.id==self.ui.id then me=p end end
 self.button.Visible=s.status=="playing" and me and me.alive and not walking or false
 if not self.button.Visible then return end
 if s.challengeClaimed or self.pending~=s.turnCount then self.pending=nil end
 local goal=me.challenge
 local current=s.players[s.turn]
 local myTurn=current and current.id==me.id
 local ready=goal.ready and not s.challengeClaimed
 local cardSpace=false
 for _,kind in ipairs(self.ui.config.cardTypes) do if (me.cards[kind] or 0)&lt;self.ui.config.cardLimit then cardSpace=true end end
 local ratio=math.clamp(goal.progress/math.max(1,goal.target),0,1)
 self.button.BackgroundColor3=ready and C.gold or C.card
 self.button.Active=workspace:GetServerTimeNow()&gt;=(data.journeyUntil or 0) and not self.pending
 self.tag.Text=ready and (myTurn and "TAP TO CLAIM" or "REWARD READY") or "YOUR NEXT GOAL"
 self.name.Text=ready and ("Claim $"..goal.reward..(cardSpace and " + card" or "")) or goal.name
 self.detail.Text=self.pending and "CLAIMING..." or (ready and (myTurn and "You earned it!" or "Claim on your turn") or (goal.progress.." / "..goal.target.." · $"..goal.reward))
 local r=P.goal(layout,rosterHeight)
 self.button.Position,self.button.Size=UDim2.fromOffset(r[1],r[2]),UDim2.fromOffset(r[3],r[4])
 if layout.compact then
  self.tag.Position,self.tag.Size,self.tag.TextSize=UDim2.fromOffset(12,5),UDim2.fromOffset(r[3]-180,17),12
  self.name.Position,self.name.Size,self.name.TextSize=UDim2.fromOffset(12,23),UDim2.fromOffset(r[3]-180,25),17
  self.detail.Position,self.detail.Size,self.detail.TextSize=UDim2.fromOffset(r[3]-158,17),UDim2.fromOffset(146,30),16
  self.track.Position,self.track.Size=UDim2.fromOffset(12,53),UDim2.fromOffset(r[3]-24,5)
 else
  self.tag.Position,self.tag.Size,self.tag.TextSize=UDim2.fromOffset(10,5),UDim2.fromOffset(134,16),10
  self.name.Position,self.name.Size,self.name.TextSize=UDim2.fromOffset(10,22),UDim2.fromOffset(134,34),14
  self.detail.Position,self.detail.Size,self.detail.TextSize=UDim2.fromOffset(10,58),UDim2.fromOffset(134,14),11
  self.track.Position,self.track.Size=UDim2.fromOffset(10,73),UDim2.fromOffset(134,3)
 end
 if self.ratio~=ratio then
  self.ratio=ratio
  if self.ui.root:GetAttribute("ReducedMotion") then self.fill.Size=UDim2.fromScale(ratio,1)
  else Tween:Create(self.fill,TweenInfo.new(0.3,Enum.EasingStyle.Quad),{Size=UDim2.fromScale(ratio,1)}):Play() end
 end
end
return Goal
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">HoverCard</string>
            <string name="Source">local Input=game:GetService("UserInputService")
local shared=game:GetService("ReplicatedStorage"):WaitForChild("Citymoney")
local Config,Plans=require(shared.Config),require(shared.PropertyPlans)
local Layout=require(shared.Layout)
local Plaza=require(shared.Plaza)
local Hover={}
Hover.__index=Hover
function Hover.new(ui,player)
    local self=setmetatable({ui=ui,mouse=player:GetMouse(),pointer=nil,nextUpdate=0},Hover)
    self.card=ui.frame(ui.root,0,0,240,91,ui.colors.card)
    self.card.Name,self.card.ZIndex,self.card.Visible="PropertyHover",12,false
    self.name=ui.text(self.card,"",14,10,214,25,15,ui.colors.ink,true)
    self.owner=ui.text(self.card,"",14,38,214,17,11,ui.colors.muted)
    self.price=ui.text(self.card,"",14,61,214,18,12,ui.colors.green,true)
    for _,child in ipairs(self.card:GetChildren()) do if child:IsA("GuiObject") then child.ZIndex=13 end end
    Input.InputChanged:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseMovement then self.pointer=input.Position end end)
    return self
end
function Hover:update(data,layout,safe,blocked)
    self.card.Visible=false
    if blocked or not data or not layout or not self.pointer then return end
    local rect=Layout.board(layout,false)
    local point=self.pointer
    local x,y=(point.X-safe.AbsolutePosition.X)/layout.scale,(point.Y-safe.AbsolutePosition.Y)/layout.scale
    if x&lt;rect[1] or x&gt;rect[1]+rect[3] or y&lt;rect[2] or y&gt;rect[2]+rect[4] then return end
    local target=self.mouse.Target
    local index=target and (target:GetAttribute("TileIndex") or target.Parent:GetAttribute("TileIndex"))
    local tile=index and Config.tiles[index]
    local interaction=target and (target:GetAttribute("Interaction") or target.Parent:GetAttribute("Interaction"))
    if interaction then
        local descriptions={market={"City Market","Choose a tactical card","Click to open the market"},contracts={"Challenge Hall","Your city goals and rewards","Click to view challenges"},news={"City News","See what is happening","Click to read the bulletin"},dice={"Let's roll!","Your next move starts here","Click the dice on your turn"}}
        local details=descriptions[interaction]
        if interaction=="festival" then
            local offer,remaining=Plaza.festival(Config,data.game)
            details={offer.name,remaining.." turns until the next festival","Offer $"..offer.cost.." · click to explore"}
        end
        if not details then return end
        self.name.Text,self.owner.Text,self.price.Text=details[1],details[2],details[3]
    elseif tile and tile.kind=="property" then
    local p=data.game.properties[index]
    local owner
    for _,resident in ipairs(data.game.players) do if resident.id==p.ownerId then owner=resident end end
    self.name.Text=tile.name
    self.owner.Text=owner and (owner.name.." · Level "..p.level) or Config.groups[tile.group].name
    self.price.Text=owner and ("RENT $"..Plans.projectedRent(Config,data.game,owner.id,index,p.level).." · click to inspect") or ("FROM $"..tile.price.." · click to inspect")
    else return end
    self.card.Position=UDim2.fromOffset(math.clamp(x+18,12,layout.width-252),math.clamp(y+14,12,layout.height-105))
    self.card.Visible=true
end
return Hover
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">MatchFeedback</string>
            <string name="Source">local shared=game:GetService("ReplicatedStorage"):WaitForChild("Citymoney")
local Layout=require(shared.Layout)
local Motion=require(script.Parent.Motion)
local Feedback={}
Feedback.__index=Feedback
local function resident(state,id)
 for _,p in ipairs(state.players) do if p.id==id then return p end end
 return nil
end
function Feedback.new(ui)
 local self=setmetatable({ui=ui,untilTime=0,journey=nil},Feedback)
 local C=ui.colors
 self.card=ui.frame(ui.root,300,92,480,100,C.card)
 self.card.Name,self.card.ZIndex,self.card.Visible="MatchMoment",14,false
 self.icon=ui.frame(self.card,14,18,64,64,C.green)
 self.badge=ui.text(self.icon,"GO!",0,0,64,64,25,C.white,true);self.badge.TextXAlignment=Enum.TextXAlignment.Center
 self.title=ui.text(self.card,"",94,14,370,30,22,C.ink,true)
 self.detail=ui.text(self.card,"",94,48,370,40,14,C.muted)
 for _,object in ipairs(self.card:GetDescendants()) do if object:IsA("GuiObject") then object.ZIndex=15 end end
 return self
end
function Feedback:show(title,detail,badge,tint,seconds,celebrate)
 self.ui.hideToast()
 self.title.Text,self.detail.Text,self.badge.Text=title,detail,badge
 self.icon.BackgroundColor3=tint or self.ui.colors.green
 self.badge.TextSize=#badge&lt;=2 and 30 or 17
 self.untilTime=workspace:GetServerTimeNow()+(seconds or 3)
 self.card.Visible=true
 if self.animation then self.animation:Cancel() end
 if self.basePosition then self.card.Position=self.basePosition end
 self.animation=Motion.pop(self.card,self.ui.root)
 if celebrate then Motion.burst(self.card,self.ui.root,self.icon.BackgroundColor3) end
end
function Feedback:hide()
 self.untilTime=0;self.card.Visible=false
end
function Feedback:observe(data,old)
 local state=data.game
 if state.status~="playing" then self.journey=nil;self.card.Visible=false;self.untilTime=0;return end
 if not old or old.game.status~="playing" then
  self.journey=nil
  if old then self:show("YOUR CITY STARTS HERE","Roll, build homes, and outsmart the table.","GO!",self.ui.colors.green,2.5) end
  return
 end
 local roll=state.lastRoll
 if roll and roll.seq&gt;(old.game.lastRoll and old.game.lastRoll.seq or 0) then
  local actor=resident(state,roll.actorId)
  local total=roll.values[1]+roll.values[2]
  local tint=Color3.fromHex(self.ui.config.playerColors[actor.colorIndex])
  self.journey={turn=roll.turn,roll=roll,state=state,untilTime=data.journeyUntil or workspace:GetServerTimeNow()}
  self:show(actor.name.." ROLLED "..total,"Follow the token. Your result appears when it lands.",tostring(total),tint,math.max(0.1,self.journey.untilTime-workspace:GetServerTimeNow()))
 end
 local action=state.lastAction
 if action and action.seq&gt;(old.game.lastAction and old.game.lastAction.seq or 0) then
  local actor=resident(state,action.actorId)
  local name=self.ui.config.tiles[action.tile].name
  local titles={demolish=action.blocked and "SHIELD SAVED THE HOUSE!" or "DEMOLITION!",repair=(action.amount or 0)&gt;0 and "HOME UPGRADED!" or "FREE HOME UPGRADE!",boost="RENT BOOST ACTIVATED",shield="HOME PROTECTED",collect="RENT DEMAND!"}
  local title=titles[action.kind]
  local detail=(actor and actor.name or "A resident").." · "..name
  if action.kind=="collect" then detail=(actor and actor.name or "A resident").." collected $"..action.amount.." using "..name.."." end
  if title then self:show(title,detail,"CARD",self.ui.colors.green,3,action.kind~="demolish") end
 end
 local opportunity=state.lastOpportunity
 if opportunity and opportunity.seq&gt;(old.game.lastOpportunity and old.game.lastOpportunity.seq or 0) then
  local actor=resident(state,opportunity.actorId)
  self:show("CITY REWARD!",(actor and actor.name or "A resident").." chose "..opportunity.reward..".",opportunity.card and "CARD" or "+$",self.ui.colors.green,3,true)
 end
 local me,before=resident(state,self.ui.id),resident(old.game,self.ui.id)
 if me and before and me.completedChallenges&gt;before.completedChallenges then
  local cardAdded=false
  for kind,count in pairs(me.cards) do if count&gt;(before.cards[kind] or 0) then cardAdded=true end end
  self:show("GOAL COMPLETE!","+$"..before.challenge.reward..(cardAdded and " and a card." or ".").." Your next goal is ready.","WIN",self.ui.colors.green,3.5,true)
 end
end
function Feedback:landing(journey)
 local s,roll,config=journey.state,journey.roll,self.ui.config
 local actor=resident(s,roll.actorId)
 local tile=config.tiles[roll.landedTile or actor.position]
 local title,badge="CITY NEWS","NEWS"
 if not actor.alive then title,badge="OUT OF CASH","CITY"
 elseif tile.kind=="property" then
  local p=s.properties[roll.landedTile or actor.position]
  title,badge=not p.ownerId and "YOUR NEXT HOME?" or (p.ownerId==actor.id and "WELCOME HOME!" or "RENT PAID"),"HOME"
 elseif tile.kind=="start" then title,badge="PAYDAY AT CITY GATE!","+$"
 elseif tile.kind=="park" then title,badge="A CARD FOR YOUR NEXT MOVE","CARD"
 elseif tile.kind=="tax" then title,badge="CITY TAX","TAX"
 elseif tile.kind=="detention" then title,badge="A DETOUR TO DETENTION","CITY"
 elseif tile.kind=="visit" then title,badge="JUST VISITING","CITY"
 elseif s.pendingOffer then title,badge="CHOOSE YOUR REWARD!","PICK" end
 self:show(title,roll.summary or tile.name,badge,Color3.fromHex(config.playerColors[actor.colorIndex]),3.5,tile.kind=="start" or tile.kind=="park")
end
function Feedback:update(data,layout,blocked)
 if not layout then return end
 if self.journey and workspace:GetServerTimeNow()&gt;=self.journey.untilTime then
  local journey=self.journey;self.journey=nil
  if data.game.status=="playing" and data.game.turnCount==journey.turn then self:landing(journey) end
 end
 local rect=Layout.board(layout,false)
 local width=math.min(480,rect[3]-24)
 local key=rect[1]..":"..rect[2]..":"..width
 if self.layoutKey~=key then
  self.layoutKey=key
  if self.animation then self.animation:Cancel();self.animation=nil end
  self.card.Position,self.card.Size=UDim2.fromOffset(rect[1]+(rect[3]-width)/2,rect[2]+8),UDim2.fromOffset(width,100)
  self.basePosition=self.card.Position
 end
 self.title.Size,self.detail.Size=UDim2.fromOffset(width-110,30),UDim2.fromOffset(width-110,40)
 self.card.Visible=not blocked and workspace:GetServerTimeNow()&lt;self.untilTime and data.game.status=="playing"
end
return Feedback
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">Menus</string>
            <string name="Source">-- Lobby, tactical targeting and challenge menus share the main HUD's controls.
local SocialService=game:GetService("SocialService")
local RunService=game:GetService("RunService")
local Players=game:GetService("Players")
local Http=game:GetService("HttpService")
local Menus={}
Menus.__index=Menus
function Menus.new(ui)
    local self=setmetatable({ui=ui,kind="demolish",tile=nil,targetId=nil,pending=nil,error=nil},Menus)
    local C,config=ui.colors,ui.config
    local frame,text,button,overlay=ui.frame,ui.text,ui.button,ui.overlay
    self.lobby,self.lobbyCard=overlay(520,676)
    text(self.lobbyCard,"Play together",24,16,436,36,26,C.ink,true)
    text(self.lobbyCard,"Choose 2 or 4 players, then start playing.",24,58,472,28,16,C.muted)
    self.leaveParty=button(self.lobbyCard,"Leave party",334,18,108,36,C.paper,function() ui.send("LeaveParty") end)
    button(self.lobbyCard,"×",452,17,44,44,C.paper,function() self.lobby.Visible=false end)
    self.two=button(self.lobbyCard,"2 PLAYERS",24,101,230,56,C.green,function() ui.send("Seats",2) end)
    self.four=button(self.lobbyCard,"4 PLAYERS",266,101,230,56,C.paper,function() ui.send("Seats",4) end)
    self.practiceSettings,self.settingsCard=overlay(480,340)
    text(self.settingsCard,"Practice settings",24,20,386,36,25,C.ink,true)
    button(self.settingsCard,"×",412,17,44,44,C.paper,function() self.practiceSettings.Visible=false;self.lobby.Visible=true end)
    self.bots=button(self.settingsCard,"Fill empty seats with bots",24,83,432,58,C.paper,function()
        local data=ui.data();if data then ui.send("Bots",not data.lobbyConfig.fillBots) end
    end)
    text(self.settingsCard,"DEMOLITION RULE",24,157,432,20,13,C.muted,true)
    self.downgrade=button(self.settingsCard,"Remove one level",24,190,210,54,C.paper,function() ui.send("AttackRule","downgrade") end)
    self.destroy=button(self.settingsCard,"Destroy whole house",246,190,210,54,C.paper,function() ui.send("AttackRule","destroy") end)
    text(self.settingsCard,"Online matches always use full-house demolition.",24,264,432,48,15,C.muted)
    text(self.lobbyCard,"YOUR COLOR · pick one if you like",24,173,472,23,13,C.muted,true)
    text(self.lobbyCard,"YOUR PARTY",24,260,472,22,13,C.muted,true)
    self.members=Instance.new("ScrollingFrame")
    self.members.Position,self.members.Size=UDim2.fromOffset(24,290),UDim2.fromOffset(472,96)
    self.members.BackgroundTransparency,self.members.BorderSizePixel,self.members.ScrollBarThickness,self.members.Parent=1,0,3,self.lobbyCard
    self.colorButtons={}
    for index,hex in ipairs(config.playerColors) do
        local choose=button(self.lobbyCard,tostring(index),24+(index-1)*78,205,66,42,Color3.fromHex(hex),function() ui.send("Color",index) end)
        choose.TextColor3=C.ink;table.insert(self.colorButtons,choose)
    end
    self.ready=button(self.lobbyCard,"Ready",24,404,230,48,C.green,function() self:toggleReady() end)
    self.invite=button(self.lobbyCard,"INVITE FRIENDS",266,404,230,48,C.paper,function()
        task.spawn(function()
            if RunService:IsStudio() or game.PlaceId==0 then self.error="Publish the place, then invite friends from a live Roblox server.";self:render(ui.data());return end
            local data=ui.data()
            if not data then return end
            if data and data.matchmaking and (data.matchmaking.mode=="match" or data.matchmaking.queued) then self.error="Invite friends from the lobby before your party joins a queue.";self:render(ui.data());return end
            local ok,canInvite=pcall(function() return SocialService:CanSendGameInviteAsync(Players.LocalPlayer) end)
            if not ok or not canInvite then self.error="Roblox cannot open invites here. Friends can use the experience's Join button.";self:render(ui.data());return end
            local options=Instance.new("ExperienceInviteOptions")
            options.LaunchData=Http:JSONEncode({citymoneyJob=game.JobId,leaderId=data.hostId})
            local opened=pcall(function() SocialService:PromptGameInvite(Players.LocalPlayer,options) end)
            if not opened then self.error="The invite prompt could not open. Try the Roblox experience page.";self:render(ui.data()) end
        end)
    end)
    self.lobbyStatus=text(self.lobbyCard,"",24,465,472,36,15,C.muted)
    self.queue=button(self.lobbyCard,"PLAY ONLINE",24,514,472,64,C.green,function()
        local data=ui.data()
        if data and data.matchmaking and data.matchmaking.mode=="match" then ui.send("BackLobby")
        elseif data and data.matchmaking and data.matchmaking.queued then ui.send("QueueCancel")
        else ui.send("Queue") end
    end)
    self.start=button(self.lobbyCard,"PRACTICE WITH BOTS",24,592,302,64,C.paper,function() ui.send("Start") end)
    self.settings=button(self.lobbyCard,"SETTINGS",338,592,158,64,C.paper,function() self.lobby.Visible=false;self.practiceSettings.Visible=true end)
    self.queue.TextSize=18;self.start.TextSize=16
    self.actions,self.actionCard=overlay(520,700)
    text(self.actionCard,"Cards &amp; challenges",24,16,436,36,25,C.ink,true)
    button(self.actionCard,"×",468,18,28,28,C.paper,function() self.actions.Visible=false end)
    local challenge=frame(self.actionCard,24,66,472,101,C.mint)
    self.goalName=text(challenge,"Your challenge",12,7,310,24,15,C.ink,true)
    self.goalText=text(challenge,"",12,34,310,40,12,C.muted)
    self.goalProgress=text(challenge,"",12,78,310,15,10,C.green,true)
    self.claim=button(challenge,"Claim reward",338,12,122,44,C.green,function()
        local data=ui.data();if data then ui.send("Claim",nil,nil,data.game.turnCount) end
    end);self.claim.TextSize=14
    self.newGoal=button(challenge,"New goal $50",338,63,122,30,C.paper,function()
        local data=ui.data();if data then ui.send("NewGoal",nil,nil,data.game.turnCount) end
    end);self.newGoal.TextSize=10
    self.cardStatus=text(self.actionCard,"ONE TACTICAL CARD PER TURN",24,178,472,18,10,C.muted,true)
    self.cardButtons={}
    local short={demolish="Demolish",collect="Demand rent",boost="Rent boost",shield="Shield",repair="Renovate"}
    for index,kind in ipairs(config.cardTypes) do
        local select=button(self.actionCard,short[kind],24+((index-1)%3)*160,194+math.floor((index-1)/3)*52,152,44,C.paper,function()
            if not self.pending then self.kind=kind;self.tile=nil;self.targetId=nil;self.error=nil;self:render(ui.data()) end
        end)
        select.TextSize=14;self.cardButtons[kind]=select
    end
    self.description=text(self.actionCard,"",24,298,472,42,15,C.muted)
    text(self.actionCard,"CHOOSE THE PROPERTY",24,339,472,18,12,C.muted,true)
    self.properties=Instance.new("ScrollingFrame")
    self.properties.Position,self.properties.Size=UDim2.fromOffset(24,365),UDim2.fromOffset(472,112)
    self.properties.BackgroundTransparency,self.properties.BorderSizePixel,self.properties.ScrollBarThickness,self.properties.Parent=1,0,3,self.actionCard
    self.targetCaption=text(self.actionCard,"",24,483,472,18,10,C.muted,true)
    self.opponents=Instance.new("Frame")
    self.opponents.Position,self.opponents.Size,self.opponents.BackgroundTransparency,self.opponents.Parent=UDim2.fromOffset(24,507),UDim2.fromOffset(472,52),1,self.actionCard
    self.effect=text(self.actionCard,"",24,566,472,32,15,C.ink,true)
    self.play=button(self.actionCard,"Choose a property",24,606,332,64,C.green,function() self:playCard() end)
    self.play.TextSize=17
    button(self.actionCard,"Back",368,606,128,64,C.paper,function() self.actions.Visible=false end)
    self.actionStatus=text(self.actionCard,"",24,675,472,20,12,C.red)
    self.shortNames=short
    return self
end
function Menus:isOpen() return self.lobby.Visible or self.actions.Visible or self.practiceSettings.Visible end
function Menus:openLobby() self.lobby.Visible=true;self.actions.Visible=false;self.practiceSettings.Visible=false;self.error=nil;self:render(self.ui.data()) end
function Menus:toggleReady()
    local data=self.ui.data()
    if not data then return end
    for _,entry in ipairs(data.lobby) do if entry.id==self.ui.id then self.ui.send("Ready",not entry.ready);return end end
end
function Menus:feedback(message)
    self.pending=nil;self.error=message
    self:render(self.ui.data())
end
function Menus:resize(layout,_rosterHeight)
    if not self.ui.cameraBar then return end
    local bar=self.ui.cameraBar
    local r=layout.camera
    bar.Position,bar.Size=UDim2.fromOffset(r[1],r[2]),UDim2.fromOffset(r[3],r[4])
    local specs={{"TableView",4,100},{"Fit",108,60},{"ZoomOut",172,36},{"ZoomIn",212,36}}
    if layout.compact then specs={{"TableView",4,144},{"Fit",156,80},{"ZoomOut",244,64},{"ZoomIn",316,64}} end
    for _,spec in ipairs(specs) do
        local object=bar:FindFirstChild(spec[1])
        object.Position,object.Size=UDim2.fromOffset(spec[2],2),UDim2.fromOffset(spec[3],layout.compact and 64 or 30)
        object.TextSize=layout.compact and 18 or 14
    end
end
function Menus:playCard()
    local data=self.ui.data()
    if not data or self.pending or not self.tile then return end
    local request={kind=self.kind,tile=self.tile,targetId=self.targetId,turn=data.game.turnCount}
    if self.ui.send("Card",request) then
        self.pending={turn=request.turn,seq=data.game.lastAction and data.game.lastAction.seq or 0,tile=self.tile}
        local pending=self.pending
        self.error=nil;self:render(data)
        task.delay(4,function()
            if self.pending==pending then
                self.pending=nil;self.error="No confirmation yet. Refreshing the match before you retry."
                self.ui.send("Sync");self:render(self.ui.data())
            end
        end)
    end
end
function Menus:render(data)
    if not data then return end
    local ui,C,config=self.ui,self.ui.colors,self.ui.config
    if self.revision~=data.revision then self.error=nil;self.revision=data.revision end
    local state,settings=data.game,data.lobbyConfig
    if state.status=="playing" and self.lastStatus~="playing" then
        self.lobby.Visible=false;self.actions.Visible=false;self.practiceSettings.Visible=false;self.pending=nil
    end
    self.lastStatus=state.status
    local me,current
    for _,entry in ipairs(state.players) do if entry.id==ui.id then me=entry end end
    current=state.players[state.turn]
    local myTurn=state.status=="playing" and current and current.id==ui.id and current.alive
    local host=data.hostId==ui.id
    local queue=data.matchmaking or {mode="lobby",queued=false,status=""}
    local active=state.status=="playing" and me and me.alive
    local editable=host and not active and not queue.queued and queue.mode~="match"
    local mine,readyCount=nil,0
    for _,entry in ipairs(data.lobby) do
        if entry.id==ui.id then mine=entry end
        if entry.ready then readyCount=readyCount+1 end
    end
    if not settings then return end
    ui.available(self.two,editable,settings.seats==2 and C.green or C.paper)
    ui.available(self.four,editable,settings.seats==4 and C.green or C.paper)
    ui.available(self.bots,editable,C.paper)
    self.bots.Text="Fill empty seats with bots: "..(settings.fillBots and "ON" or "OFF")
    ui.available(self.downgrade,editable,settings.attackMode=="downgrade" and C.green or C.paper)
    ui.available(self.destroy,editable,settings.attackMode=="destroy" and C.green or C.paper)
    self.members:ClearAllChildren()
    for index,entry in ipairs(data.lobby) do
        local name=ui.text(self.members,(entry.ready and "READY · " or "WAITING · ")..entry.name..(entry.id==data.hostId and " · host" or ""),8,(index-1)*32,450,30,16,C.ink,entry.id==ui.id)
        name.TextWrapped,name.TextTruncate=false,Enum.TextTruncate.AtEnd
    end
    self.members.CanvasSize=UDim2.fromOffset(0,#data.lobby*32)
    for index,button in ipairs(self.colorButtons) do
        local taken=false
        for _,entry in ipairs(data.lobby) do if entry.id~=ui.id and entry.colorIndex==index then taken=true end end
        button.Active=not active and not queue.queued and queue.mode~="match" and not taken
        button.BackgroundTransparency=taken and 0.6 or 0
        button.Text=mine and mine.colorIndex==index and "✓" or tostring(index)
    end
    self.ready.Text=mine and mine.ready and "READY · tap to unready" or "I'M READY TO PLAY"
    self.ready.Visible=#data.lobby&gt;1 or not (mine and mine.ready)
    self.invite.Position,self.invite.Size=UDim2.fromOffset(self.ready.Visible and 266 or 24,404),UDim2.fromOffset(self.ready.Visible and 230 or 472,48)
    ui.available(self.ready,mine~=nil and not queue.queued and queue.mode~="match",mine and mine.ready and C.green or C.paper)
    local enough=readyCount&gt;=settings.seats or settings.fillBots
    self.lobbyStatus.Text=self.error or ((queue.queued or queue.mode=="match") and queue.status or (readyCount&lt;#data.lobby and "Waiting for your friends to tap Ready." or (#data.lobby==1 and "Play online, or try a quick practice game." or "Everyone is ready. The host can start!")))
    self.lobbyStatus.TextColor3=self.error and C.red or C.muted
    ui.available(self.start,editable and state.status~="playing" and mine~=nil and mine.ready and enough,C.paper)
    self.start.Text=settings.fillBots and "PRACTICE WITH BOTS" or "PRACTICE WITH PARTY"
    local partyReady=readyCount==#data.lobby and #data.lobby&lt;=settings.seats
    ui.available(self.queue,queue.mode=="match" or (queue.queued and not queue.connecting) or (host and not active and mine~=nil and mine.ready and partyReady),C.green)
    self.queue.Text=queue.mode=="match" and "RETURN TO LOBBY" or (queue.queued and (queue.connecting and "CONNECTING..." or "CANCEL SEARCH") or ("PLAY ONLINE · "..settings.seats.." PLAYERS"))
    self.leaveParty.Visible=#data.lobby&gt;1 or queue.mode=="match"
    self.leaveParty.Text=queue.mode=="match" and "Leave match" or "Leave party"
    ui.available(self.leaveParty,not queue.connecting,C.paper)
    if not self.actions.Visible then return end
    if not me or not me.alive or state.status~="playing" then self.actions.Visible=false;self.pending=nil;return end
    if self.pending then
        local event=state.lastAction
        if event and event.seq&gt;self.pending.seq and event.actorId==ui.id then
            local tile=self.pending.tile
            self.pending=nil;self.actions.Visible=false;ui.focus(tile);return
        elseif self.pending.turn~=state.turnCount then self.pending=nil;self.error="Your turn changed. Choose your action again." end
    end
    local goal=me.challenge
    self.goalName.Text=goal.name
    self.goalText.Text=goal.description
    local cardSpace=false
    for _,kind in ipairs(config.cardTypes) do if (me.cards[kind] or 0)&lt;config.cardLimit then cardSpace=true end end
    self.goalProgress.Text=goal.progress.." / "..goal.target.." · reward $"..goal.reward..(cardSpace and " + card" or " · hand full")
    self.claim.Text="Claim $"..goal.reward
    ui.available(self.claim,myTurn and goal.ready and not state.challengeClaimed,C.green)
    ui.available(self.newGoal,myTurn and not state.challengeSwapped and me.cash&gt;=config.challengeSwapCost,C.paper)
    self.cardStatus.Text=state.actionUsed and "YOUR TACTICAL CARD HAS BEEN USED THIS TURN" or "ONE TACTICAL CARD PER TURN · CHOOSE YOUR TARGETS"
    for kind,button in pairs(self.cardButtons) do
        button.Text=self.shortNames[kind].." ×"..(me.cards[kind] or 0)
        button.Active=not self.pending
        button.BackgroundColor3=kind==self.kind and C.green or C.paper
        button.TextColor3=kind==self.kind and C.white or C.ink
    end
    local definition=config.cardDefinitions[self.kind]
    self.description.Text=definition.description
    self.properties:ClearAllChildren();self.opponents:ClearAllChildren()
    local candidates={}
    for index,property in ipairs(state.properties) do
        if property.ownerId and ((definition.target=="rival" and property.ownerId~=ui.id) or (definition.target~="rival" and property.ownerId==ui.id)) then table.insert(candidates,index) end
    end
    if self.tile and not table.find(candidates,self.tile) then self.tile=nil end
    for row,index in ipairs(candidates) do
        local property=state.properties[index]
        local owner
        for _,entry in ipairs(state.players) do if entry.id==property.ownerId then owner=entry end end
        local select=ui.button(self.properties,config.tiles[index].name.." · "..(owner and owner.name or "").." · L"..property.level,2,(row-1)*70,466,64,self.tile==index and C.green or C.paper,function()
            if not self.pending then self.tile=index;self.error=nil;self:render(ui.data()) end
        end)
        select.TextSize=17
    end
    if #candidates==0 then ui.text(self.properties,definition.target=="rival" and "No opponent owns a house yet." or "Buy a property before using this card.",8,8,450,45,13,C.muted) end
    self.properties.CanvasSize=UDim2.fromOffset(0,#candidates*70)
    self.targetCaption.Text=definition.target=="demand" and "CHOOSE WHO MUST PAY" or (settings.attackMode=="destroy" and "ATTACK RULE: FULL HOUSE DEMOLITION" or "ATTACK RULE: REMOVE ONE LEVEL; L0 HOMES ARE DEMOLISHED")
    local activeOpponent=false
    if definition.target=="demand" then
        local row=0
        for _,entry in ipairs(state.players) do
            if entry.alive and entry.id~=ui.id then
                if entry.id==self.targetId then activeOpponent=true end
                local select=ui.button(self.opponents,entry.name, row*157,0,150,52,entry.id==self.targetId and C.green or C.paper,function() self.targetId=entry.id;self.error=nil;self:render(ui.data()) end)
                select.TextSize=15;row=row+1
            end
        end
    end
    local property=self.tile and state.properties[self.tile]
    local canPlay=myTurn and not state.actionUsed and not self.pending and (me.cards[self.kind] or 0)&gt;0 and property~=nil
    local message="Select a property to see the effect."
    if property then
        if self.kind=="collect" then
            local amount=math.min(config.demandCap,ui.rent(state,self.tile)*config.demandMultiplier)
            message="Demand $"..amount.." now using "..config.tiles[self.tile].name.."."
            canPlay=canPlay and activeOpponent
        elseif self.kind=="demolish" then
            message=property.shield and "A shield will block this attack; both cards are used." or (settings.attackMode=="destroy" or property.level==0) and "Demolish this house. The lot returns to the city." or ("Remove one level: L"..property.level.." → L"..(property.level-1))
        elseif self.kind=="boost" then
            message="Rent +50% for the next two payments.";canPlay=canPlay and (property.boost or 0)==0
        elseif self.kind=="shield" then message="Block the next demolition attempt.";canPlay=canPlay and not property.shield
        elseif self.kind=="repair" then message="Free upgrade: L"..property.level.." → L"..math.min(config.maxLevel,property.level+1);canPlay=canPlay and property.level&lt;config.maxLevel end
    end
    self.effect.Text=message
    ui.available(self.play,canPlay==true,C.green)
    self.play.Text=self.pending and "Playing card…" or (canPlay and "Play "..definition.name or (not myTurn and "Wait for your turn" or (state.actionUsed and "Card already used this turn" or "Choose valid targets")))
    self.actionStatus.Text=self.error or ((me.cards[self.kind] or 0)==0 and "You have no copies. Earn cards at City Gate, City News, the park or challenges." or "")
end
return Menus
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">Motion</string>
            <string name="Source">local Tween=game:GetService("TweenService")
local Motion={}
local Dice=require(game:GetService("ReplicatedStorage"):WaitForChild("Citymoney").Dice)
function Motion.face(button,value,color)
    local layer=button:FindFirstChild("Pips")
    if not layer then
        local surface=Instance.new("Frame")
        surface.Name,surface.Position,surface.Size,surface.BorderSizePixel,surface.Parent="DieFace",UDim2.fromOffset(3,2),UDim2.new(1,-6,1,-9),0,button
        local round=Instance.new("UICorner");round.CornerRadius,round.Parent=UDim.new(0,12),surface
        local edge=Instance.new("UIStroke");edge.Thickness,edge.Transparency,edge.Parent=1.4,0.55,surface
        layer=Instance.new("Frame");layer.Name,layer.Position,layer.Size,layer.BackgroundTransparency,layer.Parent="Pips",UDim2.fromScale(0.07,0.015),UDim2.fromScale(0.86,0.86),1,button
        for i=1,6 do
            local dot=Instance.new("Frame")
            dot.Name,dot.AnchorPoint,dot.Size,dot.BorderSizePixel,dot.Parent=tostring(i),Vector2.new(0.5,0.5),UDim2.fromScale(0.13,0.13),0,layer
            local corner=Instance.new("UICorner");corner.CornerRadius,corner.Parent=UDim.new(1,0),dot
        end
    end
    local face=button:FindFirstChild("DieFace")
    local body=button.BackgroundColor3
    face.BackgroundColor3=Color3.new(math.min(1,body.R+0.035),math.min(1,body.G+0.035),math.min(1,body.B+0.035))
    face:FindFirstChildOfClass("UIStroke").Color=button:GetAttribute("RollReady") and Color3.fromHex("386BF0") or color
    local points=Dice.pips[value&gt;0 and value or 3]
    for i=1,6 do
        local dot=layer:FindFirstChild(tostring(i));local point=points[i]
        dot.Visible=point~=nil
        if point then dot.Position,dot.BackgroundColor3=UDim2.fromScale(0.5+point[1]*0.25,0.5+point[2]*0.25),color end
    end
end
function Motion.button(button,root)
    local scale=Instance.new("UIScale");scale.Parent=button
    local function to(value)
        if root:GetAttribute("ReducedMotion") then scale.Scale=1;return end
        Tween:Create(scale,TweenInfo.new(0.12,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Scale=value}):Play()
    end
    button.MouseEnter:Connect(function() if button.Active then to(1.025) end end)
    button.MouseLeave:Connect(function() to(1) end)
    button.MouseButton1Down:Connect(function() if button.Active then to(0.96) end end)
    button.MouseButton1Up:Connect(function() to(1) end)
end
function Motion.pop(frame,root)
    if root:GetAttribute("ReducedMotion") then return end
    local original=frame.Position
    frame.Position=original+UDim2.fromOffset(0,8)
    local animation=Tween:Create(frame,TweenInfo.new(0.2,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Position=original})
    animation:Play()
    return animation
end
function Motion.delta(parent,value,color,root)
    local label=Instance.new("TextLabel")
    local y=parent.Parent.Size.Y.Offset+12
    label.Name,label.Size,label.Position,label.BackgroundTransparency="CashChange",UDim2.fromOffset(130,24),UDim2.fromOffset(parent.Position.X.Offset,y),0.05
    label.BackgroundColor3,label.BorderSizePixel=Color3.fromHex("FFFFFF"),0
    label.Text,label.TextColor3,label.TextSize,label.Font=(value&gt;0 and "+$" or "-$")..math.abs(value),color,17,Enum.Font.GothamBold
    label.ZIndex,label.Parent=20,parent.Parent
    local corner=Instance.new("UICorner");corner.CornerRadius,corner.Parent=UDim.new(0,10),label
    local goal={TextTransparency=1}
    goal.BackgroundTransparency=1
    if not root:GetAttribute("ReducedMotion") then goal.Position=UDim2.fromOffset(parent.Position.X.Offset,y-10) end
    Tween:Create(label,TweenInfo.new(1.1,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),goal):Play()
    task.delay(1.2,function() label:Destroy() end)
end
function Motion.burst(parent,root,color)
    if root:GetAttribute("ReducedMotion") then return end
    for index=1,10 do
        local piece=Instance.new("Frame")
        piece.Name,piece.Size,piece.Position,piece.BorderSizePixel="RewardConfetti",UDim2.fromOffset(7,11),UDim2.fromOffset(46,42),0
        piece.BackgroundColor3,piece.ZIndex,piece.Parent=index%2==0 and color or Color3.fromHex("FFC34D"),16,parent
        local angle=index*math.pi/5
        Tween:Create(piece,TweenInfo.new(0.85,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Position=UDim2.fromOffset(46+math.cos(angle)*100,42+math.sin(angle)*55),Rotation=index*47,BackgroundTransparency=1}):Play()
        task.delay(0.9,function() piece:Destroy() end)
    end
end
return Motion
</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">TileLabels</string>
            <string name="Source">-- Upright, screen-sized labels keep the tabletop readable on every board edge.
local shared=game:GetService("ReplicatedStorage"):WaitForChild("Citymoney")
local Players=game:GetService("Players")
local Config,Architecture,Plans=require(shared.Config),require(shared.Architecture),require(shared.PropertyPlans)
local Labels={}
Labels.__index=Labels
local special={start={"GATE","+$200"},visit={"JAIL","VISIT"},park={"PARK","CARD"},detention={"JAIL","GO TO"},event={"NEWS",""},tax={"TAX","$120"}}
local function position(index)
    local p=Architecture.position(index)
    return Vector3.new(p[1],1.9,p[3])
end
function Labels.new(root,onSelect,onInteraction)
    local self=setmetatable({buttons={},captions={},revision=nil,enabled=nil},Labels)
    for index,tile in ipairs(Config.tiles) do
        local button=Instance.new("TextButton")
        button.Name,button.AnchorPoint,button.ZIndex="DeedLabel"..index,Vector2.new(0.5,0.5),5
        button.BackgroundColor3,button.BackgroundTransparency,button.BorderSizePixel=Color3.fromHex("FFFFFF"),0.04,0
        button.TextColor3,button.Font,button.TextWrapped=Color3.fromHex("1B2C48"),Enum.Font.GothamBold,false
        button.Text=tile.name;button.Parent=root
        local corner=Instance.new("UICorner");corner.CornerRadius,corner.Parent=UDim.new(0,5),button
        local outline=Instance.new("UIStroke");outline.Color,outline.Thickness,outline.ApplyStrokeMode,outline.Parent=Color3.fromHex(tile.group and Config.groups[tile.group].color or "85A393"),1.5,Enum.ApplyStrokeMode.Border,button
        button.Activated:Connect(function()
            if tile.kind=="property" then onSelect(index) else onInteraction(tile.kind=="park" and "contracts" or "news") end
        end)
        self.buttons[index]=button
    end
    return self
end
function Labels:update(camera,safe,scale,data,enabled,rect)
    local board=workspace:FindFirstChild("CitymoneyBoard")
    if self.enabled~=enabled or self.board~=board then
        self.enabled,self.board=enabled,board
        if board then
            for index=1,24 do
                local tile=board:FindFirstChild("Tile"..index)
                local caption=tile and tile:FindFirstChild("Caption")
                if caption then caption.Enabled=not enabled end
            end
        end
    end
    if data and self.revision~=data.revision then
        self.revision=data.revision
        for index,tile in ipairs(Config.tiles) do
            local property=data.game.properties[index]
            local owner
            for _,resident in ipairs(data.game.players) do if resident.id==property.ownerId then owner=resident end end
            local value=tile.kind=="property" and ("$"..(owner and Plans.projectedRent(Config,data.game,owner.id,index,property.level) or tile.price)) or ""
            self.captions[index]={name=tile.name,value=value,owned=owner~=nil}
            local stroke=self.buttons[index]:FindFirstChildOfClass("UIStroke")
            stroke.Color=Color3.fromHex(owner and Config.playerColors[owner.colorIndex] or (tile.group and Config.groups[tile.group].color or "85A393"))
            stroke.Thickness=owner and 2.5 or 1.5
        end
    end
    local offset=safe.AbsolutePosition
    local figures={}
    if enabled and data and board then
        for _,resident in ipairs(data.game.players) do if resident.alive then
            local player=type(resident.id)=="number" and Players:GetPlayerByUserId(resident.id)
            local character=player and player.Character
            local model=character and character:GetAttribute("CitymoneyPrepared") and character or board:FindFirstChild("Figure_"..resident.id)
            local head=model and model:FindFirstChild("Head")
            if head then
                local point,visible=camera:WorldToScreenPoint(head.Position)
                if visible then table.insert(figures,point) end
            end
        end end
    end
    for index,button in ipairs(self.buttons) do
        button.Visible=enabled
        if enabled then
            local screen,visible=camera:WorldToScreenPoint(position(index))
            local nextScreen=camera:WorldToScreenPoint(position(index%24+1))
            local previousScreen=camera:WorldToScreenPoint(position((index-2)%24+1))
            local dx,dy=math.abs(nextScreen.X-screen.X),math.abs(nextScreen.Y-screen.Y)
            local px,py=previousScreen.X-screen.X,previousScreen.Y-screen.Y
            local spacing=math.min(math.sqrt(dx*dx+dy*dy),math.sqrt(px*px+py*py))
            local corner=(index-1)%6==0
            -- Corners need compact badges; an oversized corner would obscure
            -- the neighboring space. Every badge scales down with the route.
            local width=corner and math.min(44,spacing*0.8) or math.min(96,spacing*(dx&gt;=dy and 0.96 or 1.7))
            local height=math.min(corner and 44 or (dx&gt;=dy and 44 or 38),spacing*(corner and 0.8 or (dx&gt;=dy and 0.88 or 0.8)))
            local caption=self.captions[index]
            if caption then
                -- Short map names stay legible; the property card gives the full name.
                local name=string.match(caption.name,"^%S+")
                local short=special[Config.tiles[index].kind]
                if short then name=short[1] end
                local value=short and short[2] or caption.value
                if caption.owned then value=(width&lt;48 and "RENT\n" or "Rent ")..value end
                if width&lt;48 then
                    if not short then name=""
                    elseif Config.tiles[index].kind=="start" then name,value="GO",""
                    elseif Config.tiles[index].kind=="visit" or Config.tiles[index].kind=="park" then value=""
                    elseif Config.tiles[index].kind=="detention" then name,value="TO","JAIL" end
                end
                button.Text=name..(value~="" and ((name~="" and "\n" or "")..value) or "")
                local longest=math.max(#name,#value)
                button.TextSize=math.max(9,math.min(12,height/2.8,(width-3)/math.max(1,longest*0.85)))/scale
            end
            button.Size,button.Position=UDim2.fromOffset(width/scale,height/scale),UDim2.fromOffset((screen.X-offset.X)/scale,(screen.Y-offset.Y)/scale)
            button.Visible=visible and (not rect or (screen.X-width/2&gt;=rect[1] and screen.X+width/2&lt;=rect[1]+rect[3] and screen.Y-height/2&gt;=rect[2] and screen.Y+height/2&lt;=rect[2]+rect[4]))
            -- A screen label must never cover a pawn. Reveal the underlying
            -- floor caption while a real avatar or bot crosses its space.
            for _,figure in ipairs(figures) do
                if math.abs(figure.X-screen.X)&lt;width/2+14 and math.abs(figure.Y-screen.Y)&lt;height/2+14 then button.Visible=false;break end
            end
        end
        local tile=board and board:FindFirstChild("Tile"..index)
        local caption=tile and tile:FindFirstChild("Caption")
        if caption then caption.Enabled=not button.Visible end
    end
end
return Labels
</string>
          </Properties>
        </Item>
      </Item>
    </Item>
