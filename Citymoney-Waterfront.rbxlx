    festivals = {
        {id="lantern",name="Lantern Festival",kind="boost",cost=80,description="Sponsor one of your homes: +50% rent for its next two paid collections."},
        {id="renovation",name="Design Fair",kind="repair",cost=110,description="Choose one of your homes and add a building level for $110, up to L3."},
        {id="safety",name="Neighborhood Watch",kind="shield",cost=60,description="Protect one of your homes against its next demolition attempt for $60."},
    },
    maxPlayers = 6,
    maxTurns = 120,
    maxLevel = 3,
    clubPassId = 0, -- Create a pass for THIS experience, paste its asset ID here, then republish.
    homeNames = { "Cottage", "Townhouse", "Garden villa", "Grand villa" },
    homeDescriptions = {
