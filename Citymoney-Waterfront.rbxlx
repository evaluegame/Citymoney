      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Engine</string>
          <string name="Source">-- Pure Luau: no Roblox services. The server alone owns this state.
local runtimeScript = getfenv().script
local Plans = runtimeScript and require(runtimeScript.Parent.PropertyPlans) or require("./PropertyPlans")
local Engine = {}
Engine.__index = Engine

function Engine.new(config, randomInteger)
    local self = setmetatable({}, Engine)
    self.config = config
    self.random = randomInteger or math.random
    self.state = { status = "lobby", players = {}, properties = {}, logs = {}, turn = 0,
        turnCount = 0, phase = "roll", pendingTile = false, dice = { 0, 0 }, winnerId = false }
    for i = 1, #config.tiles do
        self.state.properties[i] = { ownerId = false, level = 0, paint = 0 }
    end
    return self
end

function Engine:player(id)
    for _, player in ipairs(self.state.players) do
        if player.id == id then return player end
    end
    return nil
end

function Engine:current()
    return self.state.players[self.state.turn]
end

function Engine:log(message)
    table.insert(self.state.logs, 1, message)
    if #self.state.logs &gt; 6 then table.remove(self.state.logs) end
    self.state.notice = message
end

function Engine:start(roster)
    if self.state.status == "playing" then return false, "A match is already running." end
    if #roster &lt; 2 or #roster &gt; self.config.maxPlayers then return false, "A match needs 2–6 players." end
    local seen = {}
    for _, entry in ipairs(roster) do
        if seen[entry.id] then return false, "Duplicate player." end
        seen[entry.id] = true
    end
    self.state.players = {}
    for index, entry in ipairs(roster) do
        table.insert(self.state.players, { id = entry.id, name = entry.name, bot = entry.bot == true,
            cash = self.config.startingCash, position = 1, alive = true, detained = false, colorIndex = index })
    end
    for _, property in ipairs(self.state.properties) do
        property.ownerId, property.level, property.paint = false, 0, 0
    end
    self.state.status, self.state.turn, self.state.turnCount = "playing", 1, 1
    self.state.phase, self.state.pendingTile, self.state.winnerId = "roll", false, false
    self.state.dice, self.state.logs = { 0, 0 }, {}
    self:log("Welcome to Citymoney! " .. self:current().name .. " goes first.")
    return true
end

function Engine:ownsGroup(id, group)
    for index, tile in ipairs(self.config.tiles) do
        if tile.group == group and self.state.properties[index].ownerId ~= id then return false end
    end
    return self.config.groups[group] ~= nil
end

function Engine:rent(index)
    local tile, property = self.config.tiles[index], self.state.properties[index]
    if tile.kind ~= "property" then return 0 end
    local amount = tile.rent * self.config.rentMultipliers[property.level + 1]
    if property.level == 0 and property.ownerId and self:ownsGroup(property.ownerId, tile.group) then
        amount = amount * 2
    end
    return amount
end

function Engine:wealth(player)
    local total = player.cash
    for index, property in ipairs(self.state.properties) do
        if property.ownerId == player.id then
            local tile = self.config.tiles[index]
            total = total + tile.price + property.level * tile.upgrade
        end
    end
    return total
end

function Engine:checkWinner()
    local survivors = {}
    for _, player in ipairs(self.state.players) do
        if player.alive then table.insert(survivors, player) end
    end
    if #survivors &lt;= 1 or self.state.turnCount &gt; self.config.maxTurns then
        local winner = survivors[1]
        for _, player in ipairs(survivors) do
            if not winner or self:wealth(player) &gt; self:wealth(winner) then winner = player end
        end
        self.state.status, self.state.winnerId = "finished", winner and winner.id or false
        self.state.pendingTile = false
        self:log(winner and (winner.name .. " wins Citymoney with $" .. self:wealth(winner) .. " net worth!") or "The city is empty. Start a new match!")
        return true
    end
    return false
end

function Engine:liquidate(player, index)
    local property, tile = self.state.properties[index], self.config.tiles[index]
    local value = math.floor((tile.price + property.level * tile.upgrade) / 2)
    property.ownerId, property.level, property.paint = false, 0, 0
    player.cash = player.cash + value
    self:log(player.name .. " sold " .. tile.name .. " for $" .. value .. ".")
end

function Engine:pay(player, amount, recipient)
    -- Cash shortfalls sell deeds back to the city, in board order, at half cost.
    for index, property in ipairs(self.state.properties) do
        if player.cash &gt;= amount then break end
        if property.ownerId == player.id then self:liquidate(player, index) end
    end
    local paid = math.min(player.cash, amount)
    player.cash = player.cash - paid
    if recipient then recipient.cash = recipient.cash + paid end
    if paid &lt; amount then
        player.alive = false
        self:log(player.name .. " went bankrupt.")
        self:checkWinner()
    end
end

function Engine:sendToDetention(player)
    player.position, player.detained = 7, true
    self:log(player.name .. " is detained and will miss their next move.")
end

function Engine:land(player)
    local index = player.position
    local tile, property = self.config.tiles[index], self.state.properties[index]
    self.state.phase, self.state.pendingTile = "end", false
    self:log(player.name .. " landed on " .. tile.name .. ".")
    if tile.kind == "property" then
        if not property.ownerId then
            self.state.phase, self.state.pendingTile = "buy", index
        elseif property.ownerId ~= player.id then
            local owner = self:player(property.ownerId)
            local rent = self:rent(index)
            self:log(player.name .. " owes " .. owner.name .. " $" .. rent .. " rent.")
            self:pay(player, rent, owner)
        end
    elseif tile.kind == "tax" then
        self:log(player.name .. " owes $" .. tile.amount .. " city tax.")
        self:pay(player, tile.amount)
    elseif tile.kind == "detention" then
        self:sendToDetention(player)
    elseif tile.kind == "event" then
        local card = self.config.events[self.random(1, #self.config.events)]
        self:log(player.name .. ": " .. card.text)
        if card.detention then
            self:sendToDetention(player)
        elseif card.start then
            player.position = 1
            player.cash = player.cash + self.config.startBonus
        elseif card.amount &lt; 0 then
            self:pay(player, -card.amount)
        else
            player.cash = player.cash + card.amount
        end
    elseif tile.kind == "park" then
        self:log(player.name .. " is relaxing in Central Park.")
    end
end

function Engine:nextTurn()
    self.state.turnCount = self.state.turnCount + 1
    if self:checkWinner() then return end
    repeat
        self.state.turn = self.state.turn % #self.state.players + 1
    until self:current().alive
    self.state.phase, self.state.pendingTile, self.state.dice = "roll", false, { 0, 0 }
    self:log("It's " .. self:current().name .. "'s turn.")
end

function Engine:remove(id)
    local player = self:player(id)
    if not player or not player.alive or self.state.status ~= "playing" then return end
    player.alive, player.cash = false, 0
    for _, property in ipairs(self.state.properties) do
        if property.ownerId == id then property.ownerId, property.level, property.paint = false, 0, 0 end
    end
    self:log(player.name .. " left the match. Their deeds return to the city.")
    if not self:checkWinner() and self:current().id == id then self:nextTurn() end
end

function Engine:canVisit(id, tileIndex: any)
    if self.state.status ~= "playing" then return false, "Start a match first." end
    local player = self:player(id)
    if not player or not player.alive then return false, "Only active residents can visit a home." end
    if type(tileIndex) ~= "number" or tileIndex ~= math.floor(tileIndex) then return false, "Select a property." end
    local property = self.state.properties[tileIndex]
    if not property or property.ownerId ~= id then return false, "You can walk through homes you own." end
    return true
end

function Engine:act(id, action, tileIndex: any, targetLevel: any, expectedTurn: any)
    if self.state.status ~= "playing" then return false, "Start a match first." end
    local player = self:current()
    if not player or player.id ~= id then return false, "Wait for your turn." end
    if not player.alive and action ~= "End" then return false, "You are bankrupt. End your turn." end
    if (action=="Buy" or action=="Upgrade") and expectedTurn~=nil and expectedTurn~=self.state.turnCount then
        return false, "That home selection expired. Open the options again."
    end
    local phase = self.state.phase
    if action == "Roll" and phase == "roll" then
        if player.detained then
            player.detained, self.state.phase = false, "end"
            self:log(player.name .. " served their detention and can move next turn.")
        else
            local first, second = self.random(1, 6), self.random(1, 6)
            self.state.dice = { first, second }
            local destination = player.position + first + second
            if destination &gt; #self.config.tiles then
                player.cash = player.cash + self.config.startBonus
                self:log(player.name .. " passed City Gate and collected $" .. self.config.startBonus .. ".")
            end
            player.position = (destination - 1) % #self.config.tiles + 1
            self:land(player)
        end
    elseif action == "Buy" and phase == "buy" then
        local index = self.state.pendingTile
        local tile, property = self.config.tiles[index], self.state.properties[index]
        if tileIndex~=nil and tileIndex~=index then return false, "This is a different property. Open its options again." end
        if property.ownerId then return false, "This property is already owned." end
        local level = targetLevel==nil and 0 or targetLevel
        local cost = Plans.purchaseCost(self.config,index,level)
        if not cost then return false, "Choose a home level from 0 to "..self.config.maxLevel.."." end
        if player.cash &lt; cost then return false, "You need $" .. cost .. " for this home and its land." end
        player.cash, property.ownerId, property.level = player.cash - cost, id, level
        self.state.phase, self.state.pendingTile = "end", false
        self:log(player.name .. " bought " .. tile.name .. " as a level "..level.." "..self.config.homeNames[level+1].." for $" .. cost .. "!")
    elseif action == "Skip" and phase == "buy" then
        self.state.phase, self.state.pendingTile = "end", false
        self:log(player.name .. " passed on the property.")
    elseif action == "End" and phase == "end" then
        self:nextTurn()
    elseif action == "Upgrade" or action == "Sell" or action == "Paint" then
        if type(tileIndex) ~= "number" or tileIndex ~= math.floor(tileIndex) then return false, "Select a property." end
        local tile, property = self.config.tiles[tileIndex], self.state.properties[tileIndex]
        if not tile or tile.kind ~= "property" or not property or property.ownerId ~= id then return false, "You don't own this property." end
        if action == "Paint" then
            property.paint = ((property.paint or 0) + 1) % 4
            self:log(player.name .. " refreshed the exterior of " .. tile.name .. ".")
        elseif action == "Sell" then
            self:liquidate(player, tileIndex)
        else
            if property.level &gt;= self.config.maxLevel then return false, "This property is fully upgraded." end
            local level = targetLevel==nil and property.level+1 or targetLevel
            local cost = Plans.upgradeCost(self.config,tileIndex,property.level,level)
            if not cost then return false, "Choose a higher home level, up to "..self.config.maxLevel.."." end
            if player.cash &lt; cost then return false, "You need $"..cost.." for this upgrade." end
            player.cash, property.level = player.cash - cost, level
            self:log(player.name .. " upgraded " .. tile.name .. " to level " .. property.level .. " "..self.config.homeNames[level+1].." for $"..cost..".")
        end
    else
        return false, "That action is unavailable right now."
    end
    return true
end

return Engine
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Layout</string>
          <string name="Source">-- Layout uses the actual safe GUI area, so Studio's top bar never clips it.
local Layout = { homeChooserWidth=520, homeChooserHeight=620 }
function Layout.calculate(width, height)
    local compact = width &lt; 800 or width/height &lt; 1.15
    local scale = compact and math.min(width/560,height/860) or math.min(height/720,1.35)
    scale = math.max(0.25, scale)
    local w, h = width/scale, height/scale
    local toolbarHeight = compact and 158 or 112
    local toolbarWidth = math.min(compact and 528 or 810,w-32)
    local headerHeight = compact and 100 or 68
    return { scale=scale, width=w, height=h, compact=compact, headerHeight=headerHeight,
        toolbar={ (w-toolbarWidth)/2,h-toolbarHeight-18,toolbarWidth,toolbarHeight },
        inspector={ w-282,headerHeight+46,258,math.min(462,h-headerHeight-toolbarHeight-78) },
        roster={ 24,headerHeight+46,188,320 } }
end
return Layout
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">PropertyPlans</string>
          <string name="Source">-- Shared quotes keep the selector and authoritative server prices identical.
local Plans = {}

function Plans.isLevel(config, value: any)
    return type(value)=="number" and value==value and value%1==0 and value&gt;=0 and value&lt;=config.maxLevel
end

function Plans.purchaseCost(config, index, level: any)
    local tile=config.tiles[index]
    if not tile or tile.kind~="property" or not Plans.isLevel(config,level) then return nil end
    return tile.price+level*tile.upgrade
end

function Plans.upgradeCost(config, index, current: any, target: any)
    local tile=config.tiles[index]
    if not tile or tile.kind~="property" or not Plans.isLevel(config,current) or not Plans.isLevel(config,target) or target&lt;=current then return nil end
    return (target-current)*tile.upgrade
end

function Plans.projectedRent(config, state, id, index, level)
    local tile=config.tiles[index]
    if not tile or tile.kind~="property" or not Plans.isLevel(config,level) then return 0 end
    local amount=tile.rent*config.rentMultipliers[level+1]
    if level==0 then
        local complete=true
        for other,entry in ipairs(config.tiles) do
            if other~=index and entry.group==tile.group and state.properties[other].ownerId~=id then complete=false end
        end
        if complete then amount=amount*2 end
    end
    return amount
end

function Plans.options(config, state, id, index, mode)
    local property,tile=state.properties[index],config.tiles[index]
    if not property or not tile or tile.kind~="property" or (mode~="buy" and mode~="upgrade") then return {} end
    local player
    for _,entry in ipairs(state.players) do if entry.id==id then player=entry end end
    if not player then return {} end
    local options={}
    for level=0,config.maxLevel do
        local cost
        if mode=="buy" then cost=Plans.purchaseCost(config,index,level)
        else cost=Plans.upgradeCost(config,index,property.level,level) end
        table.insert(options, { level=level, name=config.homeNames[level+1], description=config.homeDescriptions[level+1],
            cost=cost or 0, available=cost~=nil, affordable=cost~=nil and player.cash&gt;=cost,
            remaining=player.cash-(cost or 0), rent=Plans.projectedRent(config,state,id,index,level),
            current=mode=="upgrade" and property.level==level })
    end
    return options
end
return Plans
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Scene</string>
          <string name="Source">-- The same part descriptions power the world and the property ViewportFrames.
local Scene = {}
function Scene.populate(entries, parent, preview)
    local objects = {}
    for _, entry in ipairs(entries) do
        local object = Instance.new(entry.className or "Part")
        object.Name, object.Size = entry.name, Vector3.new(table.unpack(entry.size))
        local p, r = entry.position, entry.rotation or { 1,0,0,0,1,0,0,0,1 }
        object.CFrame = CFrame.new(p[1], p[2], p[3], table.unpack(r))
        object.Anchored, object.Color = true, Color3.fromHex(entry.color)
        object.Material = Enum.Material[entry.material or "SmoothPlastic"]
        object.TopSurface, object.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
        object.Transparency, object.Reflectance = entry.transparency or 0, entry.reflectance or 0
        object.CanCollide = entry.canCollide ~= false
        if entry.shape then object.Shape = Enum.PartType[entry.shape] end
        if object:IsA("SpawnLocation") then object.Neutral, object.Duration = true, 0 end
        if entry.tileIndex then object:SetAttribute("TileIndex", entry.tileIndex) end
        if entry.door then object:SetAttribute("Door", true) end
        object.Parent = parent
        if entry.text and not preview then
            local surface = Instance.new("SurfaceGui")
            surface.Name, surface.Face = "Caption", Enum.NormalId[entry.textFace or "Top"]
            surface.SizingMode, surface.PixelsPerStud, surface.LightInfluence = Enum.SurfaceGuiSizingMode.PixelsPerStud, 40, 0.25
            surface.Parent = object
            local label = Instance.new("TextLabel")
            label.Size, label.BackgroundTransparency = UDim2.fromScale(1,1), 1
            label.Text, label.TextColor3 = entry.text, Color3.fromHex(entry.textColor or "3C5149")
            label.Font, label.TextWrapped, label.TextScaled = Enum.Font.GothamBold, true, true
            label.Parent = surface
            local limit = Instance.new("UITextSizeConstraint")
            limit.MaxTextSize, limit.MinTextSize, limit.Parent = entry.textSize or 72, 8, label
            local padding = Instance.new("UIPadding")
            padding.PaddingTop, padding.PaddingBottom, padding.PaddingLeft, padding.PaddingRight = UDim.new(0.08,0), UDim.new(0.08,0), UDim.new(0.06,0), UDim.new(0.06,0)
            padding.Parent = label
        end
        if entry.light and not preview then
            local light = Instance.new("PointLight")
            light.Color, light.Brightness, light.Range = Color3.fromHex("FFE2B3"), 0.7, 13
            light.Parent = object
        end
        table.insert(objects, object)
    end
    return objects
end
function Scene.model(entries, name, parent, preview)
    local model = Instance.new("Model")
    model.Name, model.Parent = name, parent
    Scene.populate(entries, model, preview)
    return model
end
return Scene
</string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="14">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="15">
      <Properties>
        <string name="Name">CitymoneyServer</string>
        <token name="RunContext">0</token>
        <string name="Source">local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local shared = ReplicatedStorage:WaitForChild("Citymoney")
local Config = require(shared.Config)
local Engine = require(shared.Engine)
local World = require(script.World)
local random = Random.new()
local engine = Engine.new(Config, function(low, high) return random:NextInteger(low, high) end)
local world = World.new(Config)

local remotes = Instance.new("Folder")
remotes.Name, remotes.Parent = "Remotes", shared
local action = Instance.new("RemoteEvent")
action.Name, action.Parent = "Action", remotes
local snapshot = Instance.new("RemoteEvent")
snapshot.Name, snapshot.Parent = "Snapshot", remotes
local feedback = Instance.new("RemoteEvent")
feedback.Name, feedback.Parent = "Feedback", remotes

local joined, lastRequest = {}, {}
local deadline = 0
local revision = 0
local botReadyAt = 0
local function roster()
    local result = {}
    for _, player in ipairs(joined) do
        if player.Parent == Players then table.insert(result, { id = player.UserId, name = player.DisplayName }) end
    end
    return result
end

local function payload()
    local lobby = roster()
    return { game = engine.state, lobby = lobby, hostId = lobby[1] and lobby[1].id or false,
        deadline = deadline, serverTime = workspace:GetServerTimeNow(), revision = revision, visitors = world:visitorList() }
end

local function publish(resetTimer)
    revision = revision + 1
    if resetTimer then deadline = workspace:GetServerTimeNow() + Config.turnSeconds end
    if resetTimer or botReadyAt == 0 then botReadyAt = workspace:GetServerTimeNow() + 2.1 end
    world:sync(engine.state)
    snapshot:FireAllClients(payload())
end

local function perform(id, command, index, level, expectedTurn)
    local previousTurn = engine.state.turnCount
    local previousPhase = engine.state.phase
    local ok, message = engine:act(id, command, index, level, expectedTurn)
    if ok then
        if command == "Roll" or command == "End" then world:endVisit(id) end
        local changedTurn = previousTurn ~= engine.state.turnCount
        publish(changedTurn or previousPhase ~= engine.state.phase)
    end
    return ok, message
end

local function addPlayer(player)
    if table.find(joined, player) then return end
    table.insert(joined, player)
    player.CharacterAdded:Connect(function(character) task.spawn(function() world:prepareCharacter(player, character) end) end)
    if player.Character then task.spawn(function() world:prepareCharacter(player, player.Character) end) end
    publish(false)
end
Players.PlayerAdded:Connect(addPlayer)
for _, player in ipairs(Players:GetPlayers()) do addPlayer(player) end

Players.PlayerRemoving:Connect(function(player)
    local index = table.find(joined, player)
    if index then table.remove(joined, index) end
    lastRequest[player] = nil
    engine:remove(player.UserId)
    if #roster() == 0 then
        engine = Engine.new(Config, function(low, high) return random:NextInteger(low, high) end)
    end
    publish(true)
end)

action.OnServerEvent:Connect(function(player, command, index, level, expectedTurn)
    if type(command) ~= "string" or #command &gt; 16 then return end
    local now = os.clock()
    if lastRequest[player] and now - lastRequest[player] &lt; 0.18 then return end
    lastRequest[player] = now
    if command == "Sync" then snapshot:FireClient(player, payload()); return end
    if command == "Return" then
        if world.visiting[player.UserId] then world:endVisit(player.UserId); publish(false) end
        return
    end
    if command == "Start" then
        local lobby = roster()
        if not lobby[1] or lobby[1].id ~= player.UserId then feedback:FireClient(player, "Only the host can start a match."); return end
        if #lobby &gt; Config.maxPlayers then feedback:FireClient(player, "Set your server capacity to 6 players or fewer."); return end
        if #lobby == 1 then table.insert(lobby, { id = Config.botId, name = "City Bot", bot = true }) end
        local ok, message = engine:start(lobby)
        if ok then
            for id in pairs(world.visiting) do world:endVisit(id) end
            publish(true)
        else feedback:FireClient(player, message) end
        return
    end
    if index ~= nil and (type(index) ~= "number" or index ~= index or index % 1 ~= 0 or index &lt; 1 or index &gt; #Config.tiles) then return end
    if command=="Buy" or command=="Upgrade" then
        if level~=nil and (type(level)~="number" or level~=level or level%1~=0 or level&lt;0 or level&gt;Config.maxLevel) then
            feedback:FireClient(player,"Choose a valid home level."); return
        end
        if expectedTurn~=nil and expectedTurn~=engine.state.turnCount then
            feedback:FireClient(player,"That home selection expired. Open the options again."); return
        end
    end
    if command == "Visit" then
        local ok, message = engine:canVisit(player.UserId, index)
        if ok then ok, message = world:visit(player, index) end
        if ok then publish(false) else feedback:FireClient(player, message) end
        return
    end
    local ok, message = perform(player.UserId, command, index, level, expectedTurn)
    if not ok then feedback:FireClient(player, message) end
end)

-- A short server-owned clock prevents an AFK player from blocking the table.
task.spawn(function()
    while true do
        task.wait(0.5)
        if engine.state.status == "playing" then
            local current = engine:current()
            local now = workspace:GetServerTimeNow()
            if (current.bot and now &gt;= botReadyAt) or now &gt;= deadline then
                local phase = engine.state.phase
                if phase == "roll" then
                    perform(current.id, "Roll")
                elseif phase == "buy" then
                    local tile = Config.tiles[engine.state.pendingTile]
                    local buy = current.bot and current.cash &gt;= tile.price + 180
                    local level=current.bot and current.cash&gt;=tile.price+tile.upgrade+350 and 1 or 0
                    perform(current.id, buy and "Buy" or "Skip",nil,level)
                else
                    if current.bot then
                        for index, property in ipairs(engine.state.properties) do
                            local tile = Config.tiles[index]
                            if property.ownerId == current.id and property.level &lt; Config.maxLevel
                                and current.cash &gt;= tile.upgrade + 250 then
                                engine:act(current.id, "Upgrade", index)
                            end
                        end
                    end
                    perform(current.id, "End")
                end
            end
        end
    end
end)

print("[Citymoney] Board ready. Open the client lobby to start a match.")
</string>
      </Properties>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">World</string>
          <string name="Source">local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local shared = game:GetService("ReplicatedStorage"):WaitForChild("Citymoney")
local Board, Architecture, Scene = require(shared.Board), require(shared.Architecture), require(shared.Scene)
local World = {}
World.__index = World

function World.tilePosition(index)
    return Vector3.new(table.unpack(Board.position(index)))
end

function World.new(config)
    local self = setmetatable({ config=config, tokens={}, positions={}, motions={}, generations={}, propertyViews={}, visiting={} }, World)
    local old = workspace:FindFirstChild("CitymoneyBoard")
    if old then old:Destroy() end
    self.root = Instance.new("Folder")
    self.root.Name, self.root.Parent = "CitymoneyBoard", workspace
    -- Parcel geometry is replaced independently on purchase, repaint and upgrade.
    local entries = {}
    for _, entry in ipairs(Board.generate(config)) do
        if not (entry.tileIndex and config.tiles[entry.tileIndex].kind == "property" and entry.name ~= "Tile"..entry.tileIndex and entry.name ~= "DistrictInlay") then
            table.insert(entries, entry)
        end
    end
    Scene.populate(entries, self.root)
    for index, tile in ipairs(config.tiles) do
        if tile.kind == "property" then self.propertyViews[index] = { key="", model=nil } end
    end
    return self
end

function World:cancelMotion(id)
    self.generations[id] = (self.generations[id] or 0) + 1
    local motion = self.motions[id]
    if motion then
        motion.connection:Disconnect()
        motion.tween:Cancel()
        motion.value:Destroy()
        self.motions[id] = nil
    end
end

function World:tokenFrame(index, seat, model)
    local position = World.tilePosition(index)
    local x, z = ((seat-1)%3-1)*2.2, math.floor((seat-1)/3)*2.2-1
    local humanoid = model and model:FindFirstChildOfClass("Humanoid")
    local root = model and model:FindFirstChild("HumanoidRootPart")
    local height = humanoid and root and (humanoid.HipHeight+root.Size.Y/2+0.2) or 2.3
    return CFrame.new(position + Vector3.new(x, height, z)) * CFrame.Angles(0, math.rad(-35), 0)
end

function World:figure(resident)
    local tint = self.config.playerColors[resident.colorIndex]
    local origin = { 0,0,0 }
    local parts = {
        { name="Torso", size={1.4,1.5,0.8}, position={0,0,0}, color=tint },
        { name="Head", size={1,1,1}, position={0,1.25,0}, color="E7C8A2", shape="Ball" },
        { name="Hair", size={1.1,0.4,1.05}, position={0,1.65,0}, color="4D4B47" },
        { name="LeftLeg", size={0.5,1.1,0.65}, position={-0.4,-1.25,0}, color="394E52" },
        { name="RightLeg", size={0.5,1.1,0.65}, position={0.4,-1.25,0}, color="394E52" },
        { name="LeftArm", size={0.4,1.4,0.6}, position={-0.95,0,0}, color=tint },
        { name="RightArm", size={0.4,1.4,0.6}, position={0.95,0,0}, color=tint },
        { name="Briefcase", size={0.8,0.7,0.3}, position={1.2,-0.7,0}, color="A58E6F" },
    }
    local model = Scene.model(parts,"Figure_"..resident.id,self.root)
    model.PrimaryPart = model:FindFirstChild("Torso")
    model:PivotTo(CFrame.new(table.unpack(origin)))
    return model
end

function World:prepareCharacter(player, character)
    local humanoid = character:WaitForChild("Humanoid", 10)
    local root = character:WaitForChild("HumanoidRootPart", 10)
    if not humanoid or not root or player.Character ~= character then return end
    if not character:GetAttribute("CitymoneyScaled") then
        pcall(function() character:ScaleTo(0.72) end)
        character:SetAttribute("CitymoneyScaled", true)
    end
    humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
    if self.visiting[player.UserId] then
        self:visit(player, self.visiting[player.UserId])
    else
        humanoid.WalkSpeed, humanoid.AutoRotate, root.Anchored = 0, false, true
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
    end
    if self.state then self:sync(self.state) end
end

function World:visitorList()
    local list = {}
    for id, tile in pairs(self.visiting) do table.insert(list,{ id=id, tile=tile }) end
    return list
end

function World:visit(player, index)
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not humanoid or not root then return false, "Your avatar is still loading." end
    self:cancelMotion(player.UserId)
    self.visiting[player.UserId] = index
    local position, yaw = Architecture.porch(index)
    root.Anchored, humanoid.WalkSpeed, humanoid.AutoRotate = false, 12, true
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = part==root or part.Name=="Torso" or part.Name=="UpperTorso" or part.Name=="LowerTorso"
        end
    end
    humanoid.JumpPower = 32
    root.AssemblyLinearVelocity, root.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
    character:PivotTo(CFrame.new(position[1],position[2]+humanoid.HipHeight+root.Size.Y/2,position[3]) * CFrame.Angles(0,yaw,0))
    return true
end

function World:endVisit(id)
    if not self.visiting[id] then return end
    self.visiting[id] = nil
    local model = self.tokens[id]
    if model and model.Parent then
        local humanoid, root = model:FindFirstChildOfClass("Humanoid"), model:FindFirstChild("HumanoidRootPart")
        if humanoid and root then humanoid.WalkSpeed, humanoid.AutoRotate, root.Anchored = 0, false, true end
        for _, part in ipairs(model:GetDescendants()) do if part:IsA("BasePart") then part.CanCollide=false end end
        local seat = 1
        for index, resident in ipairs(self.state and self.state.players or {}) do if resident.id==id then seat=index end end
        model:PivotTo(self:tokenFrame(self.positions[id] or 1,seat,model))
    end
end

function World:wireDoor(model, ownerId)
    local door = model:FindFirstChild("Door")
    if not door then return end
    local prompt = Instance.new("ProximityPrompt")
    prompt.ActionText, prompt.ObjectText, prompt.HoldDuration = "Open / close", "Your front door", 0
    prompt.MaxActivationDistance, prompt.RequiresLineOfSight, prompt.Parent = 8, false, door
    local pieces = {}
    local hinge = door.CFrame * CFrame.new(-door.Size.X/2,0,0)
    for _, name in ipairs({ "Door", "DoorGlass", "Doorknob" }) do
        local object=model:FindFirstChild(name)
        if object then table.insert(pieces,{ object=object, offset=hinge:ToObjectSpace(object.CFrame) }) end
    end
    local opened, busy = false, false
    prompt.Triggered:Connect(function(player)
        if player.UserId ~= ownerId or busy or not model.Parent then return end
        busy, opened = true, not opened
        for _, piece in ipairs(pieces) do
            piece.object.CanCollide = not opened and piece.object==door
            TweenService:Create(piece.object,TweenInfo.new(0.35,Enum.EasingStyle.Quad),
                { CFrame=hinge*CFrame.Angles(0,opened and math.rad(105) or 0,0)*piece.offset }):Play()
        end
        task.delay(0.4,function() busy=false end)
    end)
end

function World:sync(state)
    self.state = state
    -- Buying immediately constructs a complete home, including its owner's sign.
    for index, view in pairs(self.propertyViews) do
        local property = state.properties[index]
        local key = tostring(property.ownerId)..":"..property.level..":"..(property.paint or 0)
        if key ~= view.key then
            view.key = key
            if view.model then view.model:Destroy() end
            local owner
            for _, resident in ipairs(state.players) do if resident.id==property.ownerId then owner=resident end end
            local entries = Architecture.property(self.config,index,owner and owner.name or false,
                owner and self.config.playerColors[owner.colorIndex] or "A6B4A0",property.level,property.paint or 0)
            view.model = Scene.model(entries,"Property"..index,self.root)
            view.model:SetAttribute("TileIndex",index)
            if owner then
                self:wireDoor(view.model,owner.id)
                local glow=Instance.new("Highlight")
                glow.FillTransparency,glow.OutlineColor,glow.OutlineTransparency=1,Color3.fromHex(self.config.playerColors[owner.colorIndex]),0.1
                glow.Adornee,glow.Parent=view.model,view.model
                TweenService:Create(glow,TweenInfo.new(1.1),{OutlineTransparency=1}):Play()
                task.delay(1.2,function() glow:Destroy() end)
            end
            for id, visitingIndex in pairs(self.visiting) do
                if visitingIndex==index then
                    local visitor=Players:GetPlayerByUserId(id)
                    if owner and owner.id==id and visitor then self:visit(visitor,index) else self:endVisit(id) end
                end
            end
        end
    end
    local present = {}
    for seat, resident in ipairs(state.players) do
        present[resident.id] = true
        local player = type(resident.id)=="number" and Players:GetPlayerByUserId(resident.id) or nil
        local character = player and player.Character
        if character and not character:FindFirstChild("HumanoidRootPart") then character=nil end
        local model = self.tokens[resident.id]
        if character and model~=character then
            self:cancelMotion(resident.id)
            if model and model:GetAttribute("GeneratedFigure") then model:Destroy() end
            model, self.tokens[resident.id], self.positions[resident.id] = character, character, nil
        elseif not model or not model.Parent then
            model = self:figure(resident)
            model:SetAttribute("GeneratedFigure",true)
            self.tokens[resident.id], self.positions[resident.id] = model, nil
        end
        local tag = model:FindFirstChild("ResidentTag")
        if not tag then
            tag=Instance.new("BillboardGui")
            tag.Name, tag.Size, tag.StudsOffset, tag.AlwaysOnTop, tag.MaxDistance = "ResidentTag", UDim2.fromOffset(100,22),Vector3.new(0,3.5,0),true,500
            tag.Adornee, tag.Parent = model:FindFirstChild("Head") or model.PrimaryPart, model
            local label=Instance.new("TextLabel")
            label.Size,label.BackgroundTransparency,label.TextSize,label.Font = UDim2.fromScale(1,1),1,12,Enum.Font.GothamBold
            label.TextColor3,label.TextStrokeTransparency,label.Parent = Color3.fromHex("FFFFFF"),0.5,tag
        end
        local active = state.status=="playing" and state.players[state.turn].id==resident.id
        tag.TextLabel.Text = (active and "▸ " or "")..resident.name
        tag.Enabled = resident.alive
        if self.visiting[resident.id] and (not resident.alive or state.status~="playing") then self:endVisit(resident.id) end
        if not self.visiting[resident.id] then
            local old = self.positions[resident.id]
            if old~=resident.position then
                self:cancelMotion(resident.id)
                self.positions[resident.id] = resident.position
                local generation = self.generations[resident.id]
                local destination, detained = resident.position, resident.detained
                task.spawn(function()
                    if self.generations[resident.id]~=generation or not model.Parent then return end
                    local steps=old and (destination-old)%#self.config.tiles or 0
                    if not old or detained or steps&gt;12 then model:PivotTo(self:tokenFrame(destination,seat,model)); return end
                    for step=1,steps do
                        if self.generations[resident.id]~=generation or not model.Parent then return end
                        local value=Instance.new("CFrameValue")
                        value.Value=model:GetPivot()
                        local target=self:tokenFrame((old+step-1)%#self.config.tiles+1,seat,model)
                        local connection=value.Changed:Connect(function(frame) if model.Parent then model:PivotTo(frame) end end)
                        local tween=TweenService:Create(value,TweenInfo.new(0.18,Enum.EasingStyle.Sine),{Value=target})
                        self.motions[resident.id]={ value=value, connection=connection, tween=tween }
                        tween:Play(); tween.Completed:Wait()
                        if self.generations[resident.id]~=generation then return end
                        connection:Disconnect(); value:Destroy(); self.motions[resident.id]=nil
                    end
                end)
            end
        end
    end
    for id, model in pairs(self.tokens) do
        if not present[id] then
            self:cancelMotion(id)
            if model:GetAttribute("GeneratedFigure") then model:Destroy() end
            self.tokens[id],self.positions[id],self.visiting[id] = nil,nil,nil
        end
    end
end
return World
