    },
    challenges = {
        { id="homes", name="Neighborhood builder", description="Own two homes at the same time.", target=2, reward=140 },
        { id="upgrades", name="Home improvement", description="Add two building levels.", target=2, reward=150 },
        { id="rent", name="Rental business", description="Collect $200 in rent payments.", target=200, reward=160 },
        { id="passes", name="City explorer", description="Pass City Gate twice.", target=2, reward=140 },
