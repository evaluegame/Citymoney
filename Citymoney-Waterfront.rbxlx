      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Engine</string>
          <string name="Source">-- Pure Luau: no Roblox services. The server alone owns this state.
local runtimeScript = getfenv().script
local Plans = runtimeScript and require(runtimeScript.Parent.PropertyPlans) or require("./PropertyPlans")
local Tactics = runtimeScript and require(runtimeScript.Parent.Tactics) or require("./Tactics")
local Engine = {}
Engine.__index = Engine

function Engine.new(config, randomInteger)
    local self = setmetatable({}, Engine)
    self.config = config
    self.random = randomInteger or math.random
    self.state = { status = "lobby", players = {}, properties = {}, logs = {}, turn = 0,
        turnCount = 0, phase = "roll", pendingTile = false, dice = { 0, 0 }, winnerId = false }
    for i = 1, #config.tiles do
        self.state.properties[i] = {}
        Tactics.resetProperty(self.state.properties[i])
    end
    return self
end

function Engine:player(id)
    for _, player in ipairs(self.state.players) do
        if player.id == id then return player end
    end
    return nil
end

function Engine:current()
    return self.state.players[self.state.turn]
end

function Engine:log(message)
    table.insert(self.state.logs, 1, message)
    if #self.state.logs &gt; 6 then table.remove(self.state.logs) end
    self.state.notice = message
end

function Engine:start(roster, rules)
    if self.state.status == "playing" then return false, "A match is already running." end
    if #roster &lt; 2 or #roster &gt; self.config.maxPlayers then return false, "A match needs 2–6 players." end
    local seen,colors = {},{}
    for index, entry in ipairs(roster) do
        if seen[entry.id] then return false, "Duplicate player." end
        local color=entry.colorIndex or index
        if type(color)~="number" or color%1~=0 or color&lt;1 or color&gt;#self.config.playerColors or colors[color] then return false,"Each resident needs a different color." end
        colors[color]=true
        seen[entry.id] = true
    end
    self.state.players = {}
    for index, entry in ipairs(roster) do
        local resident={ id = entry.id, name = entry.name, bot = entry.bot == true,
            cash = self.config.startingCash, position = 1, alive = true, detained = false, colorIndex = entry.colorIndex or index }
        Tactics.initialize(self.config,resident,index)
        table.insert(self.state.players,resident)
    end
    for _, property in ipairs(self.state.properties) do
        Tactics.resetProperty(property)
    end
    self.state.status, self.state.turn, self.state.turnCount = "playing", 1, 1
    self.state.phase, self.state.pendingTile, self.state.winnerId = "roll", false, false
    self.state.dice, self.state.logs = { 0, 0 }, {}
    self.state.rules={attackMode=rules and rules.attackMode=="downgrade" and "downgrade" or "destroy"}
    self.state.actionUsed,self.state.challengeClaimed,self.state.challengeSwapped=false,false,false
    self.state.lastAction=false
    Tactics.refresh(self)
    self:log("Welcome to Citymoney! " .. self:current().name .. " goes first.")
    return true
end

function Engine:ownsGroup(id, group)
    for index, tile in ipairs(self.config.tiles) do
        if tile.group == group and self.state.properties[index].ownerId ~= id then return false end
    end
    return self.config.groups[group] ~= nil
end

function Engine:rent(index)
    local tile, property = self.config.tiles[index], self.state.properties[index]
    if tile.kind ~= "property" then return 0 end
    return Plans.projectedRent(self.config,self.state,property.ownerId,index,property.level)
end

function Engine:wealth(player)
    local total = player.cash
    for index, property in ipairs(self.state.properties) do
        if property.ownerId == player.id then
            total = total + Plans.investment(self.config,index,property.level,property.rentTier)
        end
    end
    return total
end

function Engine:checkWinner()
    local survivors = {}
    for _, player in ipairs(self.state.players) do
        if player.alive then table.insert(survivors, player) end
    end
    if #survivors &lt;= 1 or self.state.turnCount &gt; self.config.maxTurns then
        local winner = survivors[1]
        for _, player in ipairs(survivors) do
            if not winner or self:wealth(player) &gt; self:wealth(winner) then winner = player end
        end
        self.state.status, self.state.winnerId = "finished", winner and winner.id or false
        self.state.pendingTile = false
        self:log(winner and (winner.name .. " wins Citymoney with $" .. self:wealth(winner) .. " net worth!") or "The city is empty. Start a new match!")
        return true
    end
    return false
end

function Engine:liquidate(player, index)
    local property, tile = self.state.properties[index], self.config.tiles[index]
    local value = math.floor(Plans.investment(self.config,index,property.level,property.rentTier) / 2)
    Tactics.resetProperty(property)
    player.cash = player.cash + value
    self:log(player.name .. " sold " .. tile.name .. " for $" .. value .. ".")
end

function Engine:pay(player, amount, recipient, category)
    -- Cash shortfalls sell deeds back to the city, in board order, at half cost.
    for index, property in ipairs(self.state.properties) do
        if player.cash &gt;= amount then break end
        if property.ownerId == player.id then self:liquidate(player, index) end
    end
    local paid = math.min(player.cash, amount)
    player.cash = player.cash - paid
    if recipient then recipient.cash = recipient.cash + paid end
    if recipient and category=="rent" then recipient.stats.rent=recipient.stats.rent+paid end
    if paid &lt; amount then
        player.alive = false
        self:log(player.name .. " went bankrupt.")
        self:checkWinner()
    end
    return paid
end

function Engine:awardGate(player)
    player.cash=player.cash+self.config.startBonus
    player.stats.passes=player.stats.passes+1
    Tactics.draw(self,player,1)
end

function Engine:playCard(id,kind,index,targetId,turn)
    return Tactics.play(self,id,kind,index,targetId,turn)
end

function Engine:view(id)
    local result=table.clone(self.state)
    result.players={}
    for _,player in ipairs(self.state.players) do
        local copy=table.clone(player)
        if player.id~=id then copy.cards={} end
        table.insert(result.players,copy)
    end
    return result
end

function Engine:sendToDetention(player)
    player.position, player.detained = 7, true
    self:log(player.name .. " is detained and will miss their next move.")
end

function Engine:land(player)
    local index = player.position
    local tile, property = self.config.tiles[index], self.state.properties[index]
    self.state.phase, self.state.pendingTile = "end", false
    self:log(player.name .. " landed on " .. tile.name .. ".")
    if tile.kind == "property" then
        if not property.ownerId then
            self.state.phase, self.state.pendingTile = "buy", index
        elseif property.ownerId ~= player.id then
            local owner = self:player(property.ownerId)
            local rent = self:rent(index)
            self:log(player.name .. " owes " .. owner.name .. " $" .. rent .. " rent.")
            local paid=self:pay(player, rent, owner,"rent")
            if paid&gt;0 and (property.boost or 0)&gt;0 then property.boost=property.boost-1 end
        end
    elseif tile.kind == "tax" then
        self:log(player.name .. " owes $" .. tile.amount .. " city tax.")
        self:pay(player, tile.amount)
    elseif tile.kind == "detention" then
        self:sendToDetention(player)
    elseif tile.kind == "event" then
        player.stats.news=player.stats.news+1
        local card = self.config.events[self.random(1, #self.config.events)]
        self:log(player.name .. ": " .. card.text)
        if card.detention then
            self:sendToDetention(player)
        elseif card.start then
            player.position = 1
            self:awardGate(player)
        elseif card.card then Tactics.grant(self,player,card.card,1)
        elseif card.draw then Tactics.draw(self,player,card.draw)
        elseif card.communityGift then
            for _,resident in ipairs(self.state.players) do if resident.alive then resident.cash=resident.cash+card.communityGift end end
        elseif card.maintenance or card.levelMaintenance or card.dividend then
            local homes,levels=0,0
            for _,asset in ipairs(self.state.properties) do if asset.ownerId==player.id then homes=homes+1;levels=levels+asset.level end end
            if card.dividend then player.cash=player.cash+homes*card.dividend
            else self:pay(player,homes*(card.maintenance or 0)+levels*(card.levelMaintenance or 0)) end
        elseif card.amount and card.amount &lt; 0 then
            self:pay(player, -card.amount)
        else
            player.cash = player.cash + (card.amount or 0)
        end
    elseif tile.kind == "park" then
        Tactics.draw(self,player,1)
        self:log(player.name .. " found a tactical card in Central Park.")
    end
end

function Engine:nextTurn()
    self.state.turnCount = self.state.turnCount + 1
    if self:checkWinner() then return end
    repeat
        self.state.turn = self.state.turn % #self.state.players + 1
    until self:current().alive
    self.state.phase, self.state.pendingTile, self.state.dice = "roll", false, { 0, 0 }
    self.state.actionUsed,self.state.challengeClaimed,self.state.challengeSwapped=false,false,false
    self:log("It's " .. self:current().name .. "'s turn.")
end

function Engine:remove(id)
    local player = self:player(id)
    if not player or not player.alive or self.state.status ~= "playing" then return end
    player.alive, player.cash = false, 0
    for _, property in ipairs(self.state.properties) do
        if property.ownerId == id then Tactics.resetProperty(property) end
    end
    self:log(player.name .. " left the match. Their deeds return to the city.")
    if not self:checkWinner() and self:current().id == id then self:nextTurn() end
end

function Engine:canVisit(id, tileIndex: any)
    if self.state.status ~= "playing" then return false, "Start a match first." end
    local player = self:player(id)
    if not player or not player.alive then return false, "Only active residents can visit a home." end
    if type(tileIndex) ~= "number" or tileIndex ~= math.floor(tileIndex) then return false, "Select a property." end
    local property = self.state.properties[tileIndex]
    if not property or property.ownerId ~= id then return false, "You can walk through homes you own." end
    return true
end

function Engine:act(id, action, tileIndex: any, targetLevel: any, expectedTurn: any)
    if self.state.status ~= "playing" then return false, "Start a match first." end
    local player = self:current()
    if not player or player.id ~= id then return false, "Wait for your turn." end
    if not player.alive and action ~= "End" then return false, "You are bankrupt. End your turn." end
    if (action=="Buy" or action=="Upgrade" or action=="SetRent" or action=="Claim" or action=="NewGoal") and expectedTurn~=nil and expectedTurn~=self.state.turnCount then
        return false, "That home selection expired. Open the options again."
    end
    local phase = self.state.phase
    if action=="Claim" then
        local ok,message=Tactics.claim(self,player)
        if not ok then return false,message end
    elseif action=="NewGoal" then
        local ok,message=Tactics.swap(self,player)
        if not ok then return false,message end
    elseif action == "Roll" and phase == "roll" then
        if player.detained then
            player.detained, self.state.phase = false, "end"
            self:log(player.name .. " served their detention and can move next turn.")
        else
            local first, second = self.random(1, 6), self.random(1, 6)
            self.state.dice = { first, second }
            local destination = player.position + first + second
            if destination &gt; #self.config.tiles then
                self:awardGate(player)
                self:log(player.name .. " passed City Gate and collected $" .. self.config.startBonus .. ".")
            end
            player.position = (destination - 1) % #self.config.tiles + 1
            self:land(player)
        end
    elseif action == "Buy" and phase == "buy" then
        local index = self.state.pendingTile
        local tile, property = self.config.tiles[index], self.state.properties[index]
        if tileIndex~=nil and tileIndex~=index then return false, "This is a different property. Open its options again." end
        if property.ownerId then return false, "This property is already owned." end
        local level = targetLevel==nil and 0 or targetLevel
        local cost = Plans.purchaseCost(self.config,index,level)
        if not cost then return false, "Choose a home level from 0 to "..self.config.maxLevel.."." end
        if player.cash &lt; cost then return false, "You need $" .. cost .. " for this home and its land." end
        player.cash, property.ownerId, property.level = player.cash - cost, id, level
        player.stats.upgrades=player.stats.upgrades+level
        self.state.phase, self.state.pendingTile = "end", false
        self:log(player.name .. " bought " .. tile.name .. " as a level "..level.." "..self.config.homeNames[level+1].." for $" .. cost .. "!")
    elseif action == "Skip" and phase == "buy" then
        self.state.phase, self.state.pendingTile = "end", false
        self:log(player.name .. " passed on the property.")
    elseif action == "End" and phase == "end" then
        self:nextTurn()
    elseif action == "Upgrade" or action == "Sell" or action == "Paint" or action=="SetRent" then
        if type(tileIndex) ~= "number" or tileIndex ~= math.floor(tileIndex) then return false, "Select a property." end
        local tile, property = self.config.tiles[tileIndex], self.state.properties[tileIndex]
        if not tile or tile.kind ~= "property" or not property or property.ownerId ~= id then return false, "You don't own this property." end
        if action=="SetRent" then
            local cost=Plans.rentCost(self.config,tileIndex,property.rentTier or 1,targetLevel)
            if not cost then return false,"Choose a higher rent multiplier." end
            if player.cash&lt;cost then return false,"This rental improvement costs $"..cost.."." end
            player.cash,property.rentTier=player.cash-cost,targetLevel
            self:log(player.name.." raised future rent at "..tile.name.." to "..self.config.rentTiers[targetLevel].."× for $"..cost..".")
        elseif action == "Paint" then
            property.paint = ((property.paint or 0) + 1) % 4
            self:log(player.name .. " refreshed the exterior of " .. tile.name .. ".")
        elseif action == "Sell" then
            self:liquidate(player, tileIndex)
        else
            if property.level &gt;= self.config.maxLevel then return false, "This property is fully upgraded." end
            local level = targetLevel==nil and property.level+1 or targetLevel
            local cost = Plans.upgradeCost(self.config,tileIndex,property.level,level)
            if not cost then return false, "Choose a higher home level, up to "..self.config.maxLevel.."." end
            if player.cash &lt; cost then return false, "You need $"..cost.." for this upgrade." end
            player.stats.upgrades=player.stats.upgrades+(level-property.level)
            player.cash, property.level = player.cash - cost, level
            self:log(player.name .. " upgraded " .. tile.name .. " to level " .. property.level .. " "..self.config.homeNames[level+1].." for $"..cost..".")
        end
    else
        return false, "That action is unavailable right now."
    end
    Tactics.refresh(self)
    return true
end

return Engine
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Layout</string>
          <string name="Source">-- Layout uses the actual safe GUI area, so Studio's top bar never clips it.
local Layout = { homeChooserWidth=520, homeChooserHeight=620 }
function Layout.calculate(width, height)
    local compact = width &lt; 800 or width/height &lt; 1.15
    local scale = compact and math.min(width/560,height/860) or math.min(height/720,1.35)
    scale = math.max(0.25, scale)
    local w, h = width/scale, height/scale
    local toolbarHeight = compact and 158 or 112
    local toolbarWidth = math.min(compact and 528 or 810,w-32)
    local headerHeight = compact and 100 or 68
    return { scale=scale, width=w, height=h, compact=compact, headerHeight=headerHeight,
        toolbar={ (w-toolbarWidth)/2,h-toolbarHeight-18,toolbarWidth,toolbarHeight },
        inspector={ w-282,headerHeight+46,258,math.min(462,h-headerHeight-toolbarHeight-78) },
        roster={ 24,headerHeight+46,188,320 } }
end
return Layout
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Lobby</string>
          <string name="Source">-- Platform-independent party settings and unique ownership colors.
local Lobby={}
Lobby.__index=Lobby
function Lobby.new(config)
    return setmetatable({ config=config, members={}, seats=2, fillBots=true, attackMode="destroy" },Lobby)
end
function Lobby:member(id)
    for _,entry in ipairs(self.members) do if entry.id==id then return entry end end
    return nil
end
function Lobby:hostId() return self.members[1] and self.members[1].id or false end
function Lobby:join(id,name)
    if self:member(id) then return false,"Already joined." end
    local color=1
    while color&lt;=#self.config.playerColors do
        local used=false
        for _,entry in ipairs(self.members) do if entry.colorIndex==color then used=true end end
        if not used then break end
        color=color+1
    end
    table.insert(self.members,{ id=id,name=name,colorIndex=color&lt;=#self.config.playerColors and color or false,ready=#self.members==0 })
    return true
end
function Lobby:leave(id)
    for index,entry in ipairs(self.members) do if entry.id==id then table.remove(self.members,index);return end end
end
function Lobby:configure(id,field,value)
    if self:hostId()~=id then return false,"Only the host can change match settings." end
    if field=="seats" and (value==2 or value==4) then self.seats=value
    elseif field=="bots" and type(value)=="boolean" then self.fillBots=value
    elseif field=="attack" and (value=="downgrade" or value=="destroy") then self.attackMode=value
    else return false,"Choose a valid match setting." end
    return true
end
function Lobby:setReady(id,value)
    local entry=self:member(id)
    if not entry or type(value)~="boolean" then return false,"Choose ready or not ready." end
    entry.ready=value;return true
end
function Lobby:setColor(id,value)
    local entry=self:member(id)
    if not entry or type(value)~="number" or value%1~=0 or value&lt;1 or value&gt;#self.config.playerColors then return false,"Choose a player color." end
    for _,other in ipairs(self.members) do if other.id~=id and other.colorIndex==value then return false,"That color is already taken." end end
    entry.colorIndex=value;return true
end
function Lobby:buildRoster(id)
    if self:hostId()~=id then return nil,"Only the host can start the match." end
    if not self.members[1].ready then return nil,"The host must be ready first." end
    local roster,used={},{}
    for _,entry in ipairs(self.members) do
        if entry.ready and #roster&lt;self.seats then
            local color=entry.colorIndex
            if not color or used[color] then return nil,"A resident still needs an available color." end
            used[color]=true
            table.insert(roster,{id=entry.id,name=entry.name,colorIndex=color})
        end
    end
    if #roster&lt;self.seats and not self.fillBots then return nil,"Waiting for "..(self.seats-#roster).." more ready player(s). Invite friends, or enable bots." end
    local bot=1
    while #roster&lt;self.seats do
        local color=1
        while used[color] do color=color+1 end
        used[color]=true
        table.insert(roster,{id=self.config.botId.."-"..bot,name="City Bot "..bot,bot=true,colorIndex=color})
        bot=bot+1
    end
    return roster
end
function Lobby:snapshot()
    return {seats=self.seats,fillBots=self.fillBots,attackMode=self.attackMode,hostId=self:hostId(),members=self.members}
end
return Lobby
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">MatchProtocol</string>
          <string name="Source">-- Testable multi-party reservation protocol. Only the server supplies adapters.
local runtimeScript=getfenv().script
local Queue=runtimeScript and require(runtimeScript.Parent.QueuePlanner) or require("./QueuePlanner")
local Protocol={}
function Protocol.create(config,selected,map: any,tickets: any,adapter: any)
    local claim=adapter.guid()
    local held={}
    local seats=0
    for _,entry in ipairs(selected) do seats=seats+#entry.value.users end
    if seats~=2 and seats~=4 then return nil end
    local ticket
    local ok=pcall(function()
        for _,entry in ipairs(selected) do
            local record=map:UpdateAsync(entry.key,function(current,sort)
                if Queue.valid(current,seats,adapter.now()) and not current.cancelled then current.claim=claim;current.claimUntil=adapter.now()+40;return current,sort end
                return nil
            end,90)
            if not record or record.claim~=claim then error("Party already claimed") end
            table.insert(held,{key=entry.key,value=record})
        end
        local users=Queue.roster(held,#config.playerColors)
        if not users or #users~=seats then error("Invalid roster") end
        local code,privateId=adapter.reserve()
        ticket={id=claim,seats=seats,users=users,code=code,privateId=privateId,status="preparing",created=adapter.now()}
        tickets:SetAsync(claim,ticket,180,adapter.now())
        for _,entry in ipairs(held) do
            local record=map:UpdateAsync(entry.key,function(current,sort)
                if current and not current.cancelled and current.claim==claim then current.matchId=claim;return current,sort end
                return nil
            end,150)
            if not record or record.matchId~=claim or record.cancelled then error("Party left during reservation") end
        end
        ticket.status="ready";tickets:SetAsync(claim,ticket,180,adapter.now())
    end)
    if not ok then
        pcall(function() tickets:RemoveAsync(claim) end)
        for _,entry in ipairs(held) do
            pcall(function()
                map:UpdateAsync(entry.key,function(current,sort)
                    if current and current.claim==claim then current.claim=nil;current.claimUntil=nil;current.matchId=nil;return current,sort end
                    return nil
                end,90)
            end)
        end
        return nil
    end
    return ticket
end
function Protocol.recover(map: any,key,record,ticket,now)
    if not record or not record.matchId or (record.claimUntil or 0)&gt;now or (ticket and ticket.status=="ready") then return false end
    local matchId=record.matchId
    map:UpdateAsync(key,function(current,sort)
        if current and current.matchId==matchId and (current.claimUntil or 0)&lt;=now and not current.cancelled then
            current.matchId,current.claim,current.claimUntil=nil,nil,nil
            current.updated=now
            return current,sort
        end
        return nil
    end,90)
    return true
end
return Protocol
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Parties</string>
          <string name="Source">local runtimeScript=getfenv().script
local Lobby=runtimeScript and require(runtimeScript.Parent.Lobby) or require("./Lobby")
local Parties={}
Parties.__index=Parties
function Parties.new(config) return setmetatable({config=config,groups={},membership={}},Parties) end
function Parties:get(id) return self.groups[self.membership[id]] end
function Parties:add(id,name)
    if self:get(id) then return self:get(id) end
    local party=Lobby.new(self.config);party:join(id,name)
    self.groups[id],self.membership[id]=party,id
    return party
end
function Parties:remove(id)
    local party=self:get(id)
    if not party then return end
    local old=party:hostId()
    party:leave(id);self.membership[id]=nil;self.groups[old]=nil
    if #party.members&gt;0 then
        local leader=party:hostId();self.groups[leader]=party
        for _,entry in ipairs(party.members) do self.membership[entry.id]=leader end
    end
end
function Parties:join(id,leader)
    local old,target=self:get(id),self:get(leader)
    if not old or not target or target:hostId()~=leader then return false,"That party leader is no longer in this lobby." end
    if old==target then return true end
    if #old.members&gt;1 then return false,"Leave your existing party before joining a friend." end
    if #target.members&gt;=4 then return false,"That party already has four players." end
    local member=old:member(id)
    self:remove(id);target:join(id,member.name);target:setReady(id,false)
    self.membership[id]=leader
    return true
end
function Parties:leave(id)
    local party=self:get(id)
    local member=party and party:member(id)
    if not member then return false,"You are not in a party." end
    local name=member.name
    self:remove(id);self:add(id,name)
    return true
end
function Parties:combine(roster)
    for _,user in ipairs(roster) do self:remove(user.id) end
    local party=Lobby.new(self.config)
    party.seats,party.fillBots,party.attackMode=#roster,false,"destroy"
    local leader=roster[1].id
    for _,user in ipairs(roster) do
        party:join(user.id,user.name)
        local member=party:member(user.id)
        member.colorIndex,member.ready=user.colorIndex,true
        self.membership[user.id]=leader
    end
    self.groups[leader]=party
    return party
end
return Parties
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">PropertyPlans</string>
          <string name="Source">-- Shared quotes keep the selector and authoritative server prices identical.
local Plans = {}

function Plans.isLevel(config, value: any)
    return type(value)=="number" and value==value and value%1==0 and value&gt;=0 and value&lt;=config.maxLevel
end

function Plans.purchaseCost(config, index, level: any)
    local tile=config.tiles[index]
    if not tile or tile.kind~="property" or not Plans.isLevel(config,level) then return nil end
    return tile.price+level*tile.upgrade
end

function Plans.upgradeCost(config, index, current: any, target: any)
    local tile=config.tiles[index]
    if not tile or tile.kind~="property" or not Plans.isLevel(config,current) or not Plans.isLevel(config,target) or target&lt;=current then return nil end
    return (target-current)*tile.upgrade
end

function Plans.investment(config,index,level,rentTier)
    local tile=config.tiles[index]
    return tile.price+level*tile.upgrade+((rentTier or 1)-1)*tile.upgrade*config.rentTierFeeMultiplier
end

function Plans.rentCost(config,index,current: any,target: any)
    local tile=config.tiles[index]
    if not tile or tile.kind~="property" or type(target)~="number" or target%1~=0 or target&lt;1 or target&gt;#config.rentTiers or target&lt;=(current or 1) then return nil end
    return (target-(current or 1))*tile.upgrade*config.rentTierFeeMultiplier
end

function Plans.projectedRent(config, state, id, index, level, rentTier)
    local tile=config.tiles[index]
    if not tile or tile.kind~="property" or not Plans.isLevel(config,level) then return 0 end
    local amount=tile.rent*config.rentMultipliers[level+1]
    if level==0 and id then
        local complete=true
        for other,entry in ipairs(config.tiles) do
            if other~=index and entry.group==tile.group and state.properties[other].ownerId~=id then complete=false end
        end
        if complete then amount=amount*2 end
    end
    local property=state.properties[index]
    if property.ownerId==id then amount=math.floor(amount*(config.rentTiers[rentTier or property.rentTier or 1] or 1)) end
    if property.ownerId==id and (property.boost or 0)&gt;0 then amount=math.floor(amount*config.rentBoostMultiplier) end
    return amount
end

function Plans.options(config, state, id, index, mode)
    if mode=="rent" then return Plans.rentOptions(config,state,id,index) end
    local property,tile=state.properties[index],config.tiles[index]
    if not property or not tile or tile.kind~="property" or (mode~="buy" and mode~="upgrade") then return {} end
    local player
    for _,entry in ipairs(state.players) do if entry.id==id then player=entry end end
    if not player then return {} end
    local options={}
    for level=0,config.maxLevel do
        local cost
        if mode=="buy" then cost=Plans.purchaseCost(config,index,level)
        else cost=Plans.upgradeCost(config,index,property.level,level) end
        table.insert(options, { level=level, name=config.homeNames[level+1], description=config.homeDescriptions[level+1],
            cost=cost or 0, available=cost~=nil, affordable=cost~=nil and player.cash&gt;=cost,
            remaining=player.cash-(cost or 0), rent=Plans.projectedRent(config,state,id,index,level),
            current=mode=="upgrade" and property.level==level })
    end
    return options
end
function Plans.rentOptions(config,state,id,index)
    local property,tile=state.properties[index],config.tiles[index]
    if not property or not tile or tile.kind~="property" then return {} end
    local player
    for _,entry in ipairs(state.players) do if entry.id==id then player=entry end end
    if not player then return {} end
    local result={}
    for tier,multiplier in ipairs(config.rentTiers) do
        local cost=Plans.rentCost(config,index,property.rentTier or 1,tier)
        table.insert(result,{level=tier-1,tier=tier,name=tostring(multiplier).."× rent",description="A paid rental improvement. This multiplier applies to future rent payments on this property.",
            cost=cost or 0,available=cost~=nil,affordable=cost~=nil and player.cash&gt;=cost,remaining=player.cash-(cost or 0),
            rent=Plans.projectedRent(config,state,id,index,property.level,tier),current=tier==(property.rentTier or 1)})
    end
    return result
end
return Plans
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">QueuePlanner</string>
          <string name="Source">-- Exact-size party packing, unique match colors and queue record validation.
local Queue={}
function Queue.valid(record,seats,now)
    if type(record)~="table" or record.seats~=seats or type(record.users)~="table" or #record.users&lt;1 or #record.users&gt;seats then return false end
    if type(record.updated)~="number" or now-record.updated&gt;60 or record.matchId then return false end
    if record.cancelled or (record.claim and (record.claimUntil or 0)&gt;now) then return false end
    local seen={}
    for _,user in ipairs(record.users) do
        if type(user.id)~="number" or user.id%1~=0 or seen[user.id] then return false end
        seen[user.id]=true
    end
    return true
end
function Queue.select(entries,seats,now)
    local candidates={}
    for _,entry in ipairs(entries) do if Queue.valid(entry.value,seats,now) then table.insert(candidates,entry) end end
    local function fill(from,remaining,selected,users)
        if remaining==0 then return selected end
        for i=from,#candidates do
            local entry=candidates[i]
            if #entry.value.users&lt;=remaining then
                local duplicate=false
                for _,user in ipairs(entry.value.users) do if users[user.id] then duplicate=true end end
                if not duplicate then
                    local nextUsers=table.clone(users)
                    for _,user in ipairs(entry.value.users) do nextUsers[user.id]=true end
                    local nextSelected=table.clone(selected);table.insert(nextSelected,entry)
                    local result=fill(i+1,remaining-#entry.value.users,nextSelected,nextUsers)
                    if result then return result end
                end
            end
        end
        return nil
    end
    return fill(1,seats,{}, {})
end
function Queue.roster(selected,colorCount)
    local roster,used={},{}
    for _,entry in ipairs(selected) do
        for _,user in ipairs(entry.value.users) do
            local color=user.colorIndex
            if type(color)~="number" or color%1~=0 or color&lt;1 or color&gt;colorCount or used[color] then color=1;while used[color] do color=color+1 end end
            if color&gt;colorCount then return nil end
            used[color]=true
            table.insert(roster,{id=user.id,name=user.name,colorIndex=color})
        end
    end
    return roster
end
return Queue
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">Scene</string>
          <string name="Source">-- The same part descriptions power the world and the property ViewportFrames.
local Scene = {}
function Scene.populate(entries, parent, preview)
    local objects = {}
    for _, entry in ipairs(entries) do
        local object = Instance.new(entry.className or "Part")
        object.Name, object.Size = entry.name, Vector3.new(table.unpack(entry.size))
        local p, r = entry.position, entry.rotation or { 1,0,0,0,1,0,0,0,1 }
        object.CFrame = CFrame.new(p[1], p[2], p[3], table.unpack(r))
        object.Anchored, object.Color = true, Color3.fromHex(entry.color)
        object.Material = Enum.Material[entry.material or "SmoothPlastic"]
        object.TopSurface, object.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
        object.Transparency, object.Reflectance = entry.transparency or 0, entry.reflectance or 0
        object.CanCollide = entry.canCollide ~= false
        if entry.shape then object.Shape = Enum.PartType[entry.shape] end
        if object:IsA("SpawnLocation") then object.Neutral, object.Duration = true, 0 end
        if entry.tileIndex then object:SetAttribute("TileIndex", entry.tileIndex) end
        if entry.door then object:SetAttribute("Door", true) end
        object.Parent = parent
        if entry.text and not preview then
            local surface = Instance.new("SurfaceGui")
            surface.Name, surface.Face = "Caption", Enum.NormalId[entry.textFace or "Top"]
            surface.SizingMode, surface.PixelsPerStud, surface.LightInfluence = Enum.SurfaceGuiSizingMode.PixelsPerStud, 40, 0.25
            surface.Parent = object
            local label = Instance.new("TextLabel")
            label.Size, label.BackgroundTransparency = UDim2.fromScale(1,1), 1
            label.Text, label.TextColor3 = entry.text, Color3.fromHex(entry.textColor or "3C5149")
            label.Font, label.TextWrapped, label.TextScaled = Enum.Font.GothamBold, true, true
            label.Parent = surface
            local limit = Instance.new("UITextSizeConstraint")
            limit.MaxTextSize, limit.MinTextSize, limit.Parent = entry.textSize or 72, 8, label
            local padding = Instance.new("UIPadding")
            padding.PaddingTop, padding.PaddingBottom, padding.PaddingLeft, padding.PaddingRight = UDim.new(0.08,0), UDim.new(0.08,0), UDim.new(0.06,0), UDim.new(0.06,0)
            padding.Parent = label
        end
        if entry.light and not preview then
            local light = Instance.new("PointLight")
            light.Color, light.Brightness, light.Range = Color3.fromHex("FFE2B3"), 0.7, 13
            light.Parent = object
        end
        table.insert(objects, object)
    end
    return objects
end
function Scene.model(entries, name, parent, preview)
    local model = Instance.new("Model")
    model.Name, model.Parent = name, parent
    Scene.populate(entries, model, preview)
    return model
end
return Scene
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">Tactics</string>
          <string name="Source">-- Server-owned tactical cards and claimable challenges; no Roblox dependencies.
local Tactics={}
function Tactics.resetProperty(property)
    property.ownerId,property.level,property.paint,property.shield,property.boost,property.rentTier=false,0,0,false,0,1
end
function Tactics.initialize(config,player,seat)
    player.cards={demolish=1,collect=1,boost=1,shield=1,repair=1}
    player.stats={upgrades=0,rent=0,passes=0,news=0,tactics=0,blocks=0}
    player.completedChallenges=0
    player.challengeIndex=(seat-1)%#config.challenges+1
    player.challengeBaseline=0
    player.challenge={id=config.challenges[player.challengeIndex].id,progress=0,ready=false}
end
function Tactics.metric(engine,player,id)
    if id=="homes" then
        local count=0
        for _,property in ipairs(engine.state.properties) do if property.ownerId==player.id then count=count+1 end end
        return count
    elseif id=="districts" then
        local count=0
        for group in pairs(engine.config.groups) do if engine:ownsGroup(player.id,group) then count=count+1 end end
        return count
    end
    return player.stats[id] or 0
end
function Tactics.refresh(engine)
    for _,player in ipairs(engine.state.players) do
        local definition=engine.config.challenges[player.challengeIndex]
        local metric=Tactics.metric(engine,player,definition.id)
        local progress=math.max(0,metric-(player.challengeBaseline or 0))
        player.challenge={id=definition.id,name=definition.name,description=definition.description,target=definition.target,
            reward=definition.reward,progress=math.min(progress,definition.target),ready=player.alive and progress&gt;=definition.target}
    end
end
function Tactics.nextChallenge(engine,player)
    player.challengeIndex=player.challengeIndex%#engine.config.challenges+1
    local definition=engine.config.challenges[player.challengeIndex]
    player.challengeBaseline=(definition.id=="homes" or definition.id=="districts") and 0 or Tactics.metric(engine,player,definition.id)
end
function Tactics.grant(engine,player,kind,count)
    if not engine.config.cardDefinitions[kind] then return 0 end
    local previous=player.cards[kind] or 0
    player.cards[kind]=math.min(engine.config.cardLimit,previous+(count or 1))
    return player.cards[kind]-previous
end
function Tactics.draw(engine,player,count)
    for _=1,count or 1 do
        local kind=engine.config.cardTypes[engine.random(1,#engine.config.cardTypes)]
        Tactics.grant(engine,player,kind,1)
    end
end
function Tactics.claim(engine,player)
    Tactics.refresh(engine)
    if engine.state.challengeClaimed then return false,"You can claim one challenge each turn." end
    if not player.challenge.ready then return false,"Finish the challenge before claiming it." end
    player.cash=player.cash+player.challenge.reward
    player.completedChallenges=player.completedChallenges+1
    engine.state.challengeClaimed=true
    engine:log(player.name.." completed "..player.challenge.name.." and collected $"..player.challenge.reward.." plus a card!")
    Tactics.draw(engine,player,1)
    Tactics.nextChallenge(engine,player)
    return true
end
function Tactics.swap(engine,player)
    if engine.state.challengeSwapped then return false,"You can change your challenge once each turn." end
    if player.cash&lt;engine.config.challengeSwapCost then return false,"A new challenge costs $"..engine.config.challengeSwapCost.."." end
    player.cash=player.cash-engine.config.challengeSwapCost
    engine.state.challengeSwapped=true
    Tactics.nextChallenge(engine,player)
    engine:log(player.name.." chose a new challenge for $"..engine.config.challengeSwapCost..".")
    return true
end
function Tactics.play(engine,id,kind,index,targetId,turn)
    local state,config=engine.state,engine.config
    if state.status~="playing" then return false,"Start a match first." end
    local player=engine:current()
    if not player or player.id~=id or not player.alive then return false,"Play cards during your own turn." end
    if turn~=state.turnCount then return false,"That card selection expired. Choose a target again." end
    if state.actionUsed then return false,"You can play one tactical card per turn." end
    if type(kind)~="string" or not config.cardDefinitions[kind] then return false,"Choose a valid tactical card." end
    if (player.cards[kind] or 0)&lt;1 then return false,"You do not have that card." end
    if type(index)~="number" or index%1~=0 or not config.tiles[index] or config.tiles[index].kind~="property" then return false,"Choose a property." end
    local property=state.properties[index]
    local owner=property.ownerId and engine:player(property.ownerId)
    if not owner or not owner.alive then return false,"Choose an owned property." end
    if kind=="demolish" then
        if property.ownerId==id then return false,"Choose an opponent's house for demolition." end
    elseif property.ownerId~=id then return false,"Choose one of your own properties." end
    local target
    if kind=="collect" then
        if type(targetId)~="number" and type(targetId)~="string" then return false,"Choose the opponent who must pay." end
        target=engine:player(targetId)
        if not target or not target.alive or target.id==id then return false,"Choose an active opponent to pay rent." end
    elseif kind=="shield" and property.shield then return false,"This home already has a shield."
    elseif kind=="boost" and (property.boost or 0)&gt;0 then return false,"This home still has an active rent boost."
    elseif kind=="repair" and property.level&gt;=config.maxLevel then return false,"This home is already fully upgraded." end
    player.cards[kind]=player.cards[kind]-1
    player.stats.tactics=player.stats.tactics+1
    state.actionUsed=true
    local event={seq=(state.lastAction and state.lastAction.seq or 0)+1,kind=kind,tile=index,actorId=id,targetId=target and target.id or property.ownerId,blocked=false,amount=0}
    state.lastAction=event
    local name=config.tiles[index].name
    if kind=="demolish" then
        if property.shield then
            property.shield=false;event.blocked=true;owner.stats.blocks=owner.stats.blocks+1
            engine:log(owner.name.."'s shield blocked demolition at "..name.."!")
        elseif (state.rules and state.rules.attackMode=="destroy") or property.level==0 then
            Tactics.resetProperty(property)
            engine:log(player.name.." demolished "..owner.name.."'s house at "..name..". The empty lot returns to the city.")
        else
            property.level=property.level-1
            engine:log(player.name.." removed one building level from "..owner.name.."'s "..name..".")
        end
    elseif kind=="collect" then
        local amount=math.min(config.demandCap,engine:rent(index)*config.demandMultiplier)
        engine:log(player.name.." demands $"..amount.." from "..target.name.." using "..name.."!")
        event.amount=engine:pay(target,amount,player,"rent")
        if event.amount&gt;0 and (property.boost or 0)&gt;0 then property.boost=property.boost-1 end
    elseif kind=="boost" then
        property.boost=config.rentBoostPayments
        engine:log(player.name.." boosted rent at "..name.." by 50% for the next two payments.")
    elseif kind=="shield" then
        property.shield=true
        engine:log(player.name.." protected "..name.." against its next demolition attempt.")
    elseif kind=="repair" then
        property.level=property.level+1;player.stats.upgrades=player.stats.upgrades+1
        engine:log(player.name.." used a renovation grant to upgrade "..name.." to level "..property.level.." for free.")
    end
    Tactics.refresh(engine)
    return true
end
function Tactics.botMove(engine,id)
    local player=engine:player(id)
    if not player or not player.alive or engine.state.actionUsed then return nil end
    local own,unshielded,repair,boost,rival,opponent
    local rentValue,repairValue,rivalValue=-1,-1,-1
    for index,property in ipairs(engine.state.properties) do
        if property.ownerId==id then
            local value=engine:rent(index)
            if value&gt;rentValue then own,rentValue=index,value end
            if not property.shield and (not unshielded or property.level&gt;engine.state.properties[unshielded].level) then unshielded=index end
            if property.level&lt;engine.config.maxLevel and engine.config.tiles[index].rent&gt;repairValue then repair,repairValue=index,engine.config.tiles[index].rent end
            if (property.boost or 0)==0 and (not boost or value&gt;engine:rent(boost)) then boost=index end
        elseif property.ownerId and not property.shield then
            local value=engine.config.tiles[index].price+property.level*engine.config.tiles[index].upgrade
            if value&gt;rivalValue then rival,rivalValue=index,value end
        end
    end
    for _,entry in ipairs(engine.state.players) do if entry.alive and entry.id~=id and (not opponent or entry.cash&gt;opponent.cash) then opponent=entry end end
    local kind,index,target
    if repair and player.cards.repair&gt;0 then kind,index="repair",repair
    elseif unshielded and engine.state.properties[unshielded].level&gt;=2 and player.cards.shield&gt;0 then kind,index="shield",unshielded
    elseif rival and player.cards.demolish&gt;0 then kind,index="demolish",rival
    elseif own and opponent and player.cards.collect&gt;0 then kind,index,target="collect",own,opponent.id
    elseif boost and player.cards.boost&gt;0 then kind,index="boost",boost
    elseif unshielded and player.cards.shield&gt;0 then kind,index="shield",unshielded end
    if kind then return {kind=kind,tile=index,targetId=target,turn=engine.state.turnCount} end
    return nil
end
return Tactics
</string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="19">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="20">
      <Properties>
        <string name="Name">CitymoneyServer</string>
        <token name="RunContext">0</token>
        <string name="Source">local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local shared = ReplicatedStorage:WaitForChild("Citymoney")
local Config = require(shared.Config)
local Engine = require(shared.Engine)
local Parties = require(shared.Parties)
local Tactics = require(shared.Tactics)
local Matchmaker = require(script.Matchmaker)
local World = require(script.World)
local random = Random.new()
local engine = Engine.new(Config, function(low, high) return random:NextInteger(low, high) end)
local world = World.new(Config)
local parties = Parties.new(Config)
local matcher

local remotes = Instance.new("Folder")
remotes.Name, remotes.Parent = "Remotes", shared
local action = Instance.new("RemoteEvent")
action.Name, action.Parent = "Action", remotes
local snapshot = Instance.new("RemoteEvent")
snapshot.Name, snapshot.Parent = "Snapshot", remotes
local feedback = Instance.new("RemoteEvent")
feedback.Name, feedback.Parent = "Feedback", remotes

local lastRequest = {}
local deadline = 0
local revision = 0
local botReadyAt = 0
local function payload(id)
    local party=parties:get(id)
    local lobby=party and party.members or {}
    local settings=party and party:snapshot() or {seats=2,fillBots=true,attackMode="destroy",hostId=false,members={}}
    return { game = engine:view(id), lobby = lobby, lobbyConfig=settings,hostId = party and party:hostId() or false,
        matchmaking=matcher and matcher:status(id) or nil,
        deadline = deadline, serverTime = workspace:GetServerTimeNow(), revision = revision, visitors = world:visitorList() }
end

local function publish(resetTimer)
    revision = revision + 1
    if resetTimer then deadline = workspace:GetServerTimeNow() + Config.turnSeconds end
    if resetTimer or botReadyAt == 0 then botReadyAt = workspace:GetServerTimeNow() + 2.1 end
    world:sync(engine.state)
    for _,recipient in ipairs(Players:GetPlayers()) do snapshot:FireClient(recipient,payload(recipient.UserId)) end
end

local function perform(id, command, index, level, expectedTurn)
    local previousTurn = engine.state.turnCount
    local previousPhase = engine.state.phase
    local ok, message = engine:act(id, command, index, level, expectedTurn)
    if ok then
        if command == "Roll" or command == "End" then world:endVisit(id) end
        local changedTurn = previousTurn ~= engine.state.turnCount
        publish(changedTurn or previousPhase ~= engine.state.phase)
    end
    return ok, message
end

matcher=Matchmaker.new(Config,{
    changed=function() publish(false) end,
    canStart=function() return engine.state.status~="playing" end,
    canQueue=function(id)
        local player=engine:player(id)
        return not (engine.state.status=="playing" and player and player.alive)
    end,
    start=function(roster,rules)
        local ok,message=engine:start(roster,rules)
        if ok then
            parties:combine(roster)
            for id in pairs(world.visiting) do world:endVisit(id) end
            publish(true)
        end
        return ok,message
    end,
    joinParty=function(id,leader)
        if matcher:isQueued(id) or matcher:isQueued(leader) then return false,"Your friend is already queued." end
        local ok,message=parties:join(id,leader)
        if ok then publish(false) end
        return ok,message
    end,
})

local function addPlayer(player)
    if parties:get(player.UserId) then return end
    parties:add(player.UserId,player.DisplayName)
    player.CharacterAdded:Connect(function(character) task.spawn(function() world:prepareCharacter(player, character) end) end)
    if player.Character then task.spawn(function() world:prepareCharacter(player, player.Character) end) end
    publish(false)
    task.spawn(function() matcher:playerAdded(player) end)
end
Players.PlayerAdded:Connect(addPlayer)
for _, player in ipairs(Players:GetPlayers()) do addPlayer(player) end

Players.PlayerRemoving:Connect(function(player)
    matcher:remove(player.UserId)
    parties:remove(player.UserId)
    lastRequest[player] = nil
    engine:remove(player.UserId)
    local remaining=0
    for _,other in ipairs(Players:GetPlayers()) do if other~=player then remaining=remaining+1 end end
    if remaining == 0 then
        engine = Engine.new(Config, function(low, high) return random:NextInteger(low, high) end)
    end
    publish(true)
end)

action.OnServerEvent:Connect(function(player, command, index, level, expectedTurn)
    if type(command) ~= "string" or #command &gt; 16 then return end
    local now = os.clock()
    if lastRequest[player] and now - lastRequest[player] &lt; 0.18 then return end
    lastRequest[player] = now
    if command == "Sync" then snapshot:FireClient(player, payload(player.UserId)); return end
    local party=parties:get(player.UserId)
    if not party then return end
    if command=="Queue" then
        local active=engine:player(player.UserId)
        if engine.state.status=="playing" and active and active.alive then feedback:FireClient(player,"Finish this match or leave it before queuing.");return end
        local ok,message=matcher:enqueue(player.UserId,party)
        if not ok then feedback:FireClient(player,message) end
        return
    elseif command=="QueueCancel" then
        local ok,message=matcher:cancel(player.UserId,false)
        if not ok then feedback:FireClient(player,message) end
        return
    elseif command=="BackLobby" then
        local ok,message=matcher:backToLobby(player)
        if not ok then feedback:FireClient(player,message) end
        return
    elseif command=="LeaveParty" then
        if matcher.reserved then
            local ok,message=matcher:backToLobby(player)
            if not ok then feedback:FireClient(player,message) end
            return
        end
        local ok,message=matcher:cancel(player.UserId,false)
        if ok then ok,message=parties:leave(player.UserId) end
        if ok then publish(false) else feedback:FireClient(player,message) end
        return
    elseif command=="JoinParty" then
        if type(index)~="number" or matcher:isQueued(player.UserId) or matcher:isQueued(index) then feedback:FireClient(player,"Choose an available party leader.");return end
        local ok,message=parties:join(player.UserId,index)
        if ok then publish(false) else feedback:FireClient(player,message) end
        return
    end
    if command=="Seats" or command=="Bots" or command=="AttackRule" or command=="Color" or command=="Ready" then
        local ok,message
        local active=engine:player(player.UserId)
        if matcher:isQueued(player.UserId) then ok,message=false,"Cancel matchmaking before changing party settings."
        elseif matcher.reserved then ok,message=false,"Return to the lobby to change the party."
        elseif command=="Ready" then ok,message=party:setReady(player.UserId,index)
        elseif engine.state.status=="playing" and active and active.alive then ok,message=false,"Change match settings and colors between games."
        elseif command=="Color" then ok,message=party:setColor(player.UserId,index)
        else
            local field=command=="Seats" and "seats" or (command=="Bots" and "bots" or "attack")
            ok,message=party:configure(player.UserId,field,index)
        end
        if ok then publish(false) else feedback:FireClient(player,message) end
        return
    end
    if command=="Card" then
        if type(index)~="table" then feedback:FireClient(player,"Choose a tactical card and its targets.");return end
        local ok,message=engine:playCard(player.UserId,index.kind,index.tile,index.targetId,index.turn)
        if ok then publish(false) else feedback:FireClient(player,message) end
        return
    end
    if command == "Return" then
        if world.visiting[player.UserId] then world:endVisit(player.UserId); publish(false) end
        return
    end
    if command == "Start" then
        if matcher.reserved then feedback:FireClient(player,"Return to the lobby to queue another online match.");return end
        if matcher:isQueued(player.UserId) then feedback:FireClient(player,"Cancel matchmaking before starting practice.");return end
        local lobby,message=party:buildRoster(player.UserId)
        if not lobby then feedback:FireClient(player,message);return end
        local ok
        ok, message = engine:start(lobby,{attackMode=party.attackMode})
        if ok then
            for id in pairs(world.visiting) do world:endVisit(id) end
            publish(true)
        else feedback:FireClient(player, message) end
        return
    end
    if index ~= nil and (type(index) ~= "number" or index ~= index or index % 1 ~= 0 or index &lt; 1 or index &gt; #Config.tiles) then return end
    if command=="Buy" or command=="Upgrade" then
        if level~=nil and (type(level)~="number" or level~=level or level%1~=0 or level&lt;0 or level&gt;Config.maxLevel) then
            feedback:FireClient(player,"Choose a valid home level."); return
        end
        if expectedTurn~=nil and expectedTurn~=engine.state.turnCount then
            feedback:FireClient(player,"That home selection expired. Open the options again."); return
        end
    end
    if command == "Visit" then
        local ok, message = engine:canVisit(player.UserId, index)
        if ok then ok, message = world:visit(player, index) end
        if ok then publish(false) else feedback:FireClient(player, message) end
        return
    end
    local ok, message = perform(player.UserId, command, index, level, expectedTurn)
    if not ok then feedback:FireClient(player, message) end
end)

-- A short server-owned clock prevents an AFK player from blocking the table.
task.spawn(function()
    while true do
        task.wait(0.5)
        if engine.state.status == "playing" then
            local current = engine:current()
            local now = workspace:GetServerTimeNow()
            if (current.bot and now &gt;= botReadyAt) or now &gt;= deadline then
                local handled=false
                if current.bot and current.alive then
                    if current.challenge.ready and not engine.state.challengeClaimed then
                        handled=perform(current.id,"Claim",nil,nil,engine.state.turnCount)
                    elseif not engine.state.actionUsed then
                        local move=Tactics.botMove(engine,current.id)
                        if move then
                            handled=engine:playCard(current.id,move.kind,move.tile,move.targetId,move.turn)
                            if handled then publish(false) end
                        end
                    end
                    if handled then botReadyAt=now+1.2 end
                end
                local phase = engine.state.phase
                if handled then
                    -- The next tick resumes the normal decision after its card/goal animation.
                elseif phase == "roll" then
                    perform(current.id, "Roll")
                elseif phase == "buy" then
                    local tile = Config.tiles[engine.state.pendingTile]
                    local buy = current.bot and current.cash &gt;= tile.price + 180
                    local level=current.bot and current.cash&gt;=tile.price+tile.upgrade+350 and 1 or 0
                    perform(current.id, buy and "Buy" or "Skip",nil,level)
                else
                    if current.bot then
                        for index, property in ipairs(engine.state.properties) do
                            local tile = Config.tiles[index]
                            if property.ownerId == current.id and property.level &lt; Config.maxLevel
                                and current.cash &gt;= tile.upgrade + 250 then
                                engine:act(current.id, "Upgrade", index)
                            end
                        end
                    end
                    perform(current.id, "End")
                end
            end
        end
    end
end)

matcher:start()

print("[Citymoney] Board ready. Open the client lobby to start a match.")
</string>
      </Properties>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">Matchmaker</string>
          <string name="Source">-- Cross-server party queues. Studio uses a local adapter; live games use
-- MemoryStore claims and reserved servers, never client-supplied match rosters.
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local Teleport=game:GetService("TeleportService")
local MemoryStore=game:GetService("MemoryStoreService")
local Http=game:GetService("HttpService")
local Queue=require(game:GetService("ReplicatedStorage"):WaitForChild("Citymoney").QueuePlanner)
local Protocol=require(game:GetService("ReplicatedStorage"):WaitForChild("Citymoney").MatchProtocol)
local Matchmaker={}
Matchmaker.__index=Matchmaker
function Matchmaker.new(config,callbacks)
    local self=setmetatable({config=config,callbacks=callbacks,groups={},byPlayer={},errors={},ticket=nil,arrivalDeadline=nil,matchStarted=false},Matchmaker)
    self.localMode=RunService:IsStudio() or game.PlaceId==0
    self.reserved=not self.localMode and game.PrivateServerId~="" and game.PrivateServerOwnerId==0
    if not self.localMode then
        self.maps={ [2]=MemoryStore:GetSortedMap("CitymoneyQueue2_v1"),[4]=MemoryStore:GetSortedMap("CitymoneyQueue4_v1") }
        self.tickets=MemoryStore:GetSortedMap("CitymoneyMatches_v1")
        Teleport.TeleportInitFailed:Connect(function(player)
            local group=self.groups[self.byPlayer[player.UserId]]
            if group then
                group.teleporting=false;group.retryAt=os.clock()+3
                group.failed=(group.attempts or 0)&gt;=3
                group.status=group.failed and "Teleport failed. Cancel and queue again." or "Roblox could not connect yet. Retrying the reserved match."
                callbacks.changed()
            end
        end)
    end
    return self
end
function Matchmaker:isQueued(id) return self.byPlayer[id]~=nil end
function Matchmaker:status(id)
    local group=self.groups[self.byPlayer[id]]
    if group then return {mode="lobby",queued=true,seats=group.seats,count=#group.users,status=group.status or "Searching for a match…",connecting=group.teleporting==true} end
    if self.reserved then return {mode="match",queued=false,status=self.matchStarted and "Online match" or "Waiting for the matched players to arrive…",seats=self.ticket and self.ticket.seats or 0} end
    return {mode="lobby",queued=false,status=self.errors[id] or (self.localMode and "Studio local matchmaking" or "Online matchmaking ready"),studio=self.localMode}
end
function Matchmaker:clear(group)
    for _,user in ipairs(group.users) do if self.byPlayer[user.id]==group.id then self.byPlayer[user.id]=nil end end
    self.groups[group.id]=nil
end
function Matchmaker:enqueue(id,party)
    if self.reserved then return false,"Return to the public lobby before joining a new queue." end
    if party:hostId()~=id then return false,"Your party leader joins the queue for everyone." end
    if #party.members&gt;party.seats then return false,"Choose 4 players, or leave the larger party first." end
    local users={}
    for _,member in ipairs(party.members) do
        if not Players:GetPlayerByUserId(member.id) then return false,"A party member has left this server." end
        if self.callbacks.canQueue and not self.callbacks.canQueue(member.id) then return false,member.name.." must finish the current match first." end
        if not member.ready then return false,member.name.." must be ready before your party queues." end
        if self.byPlayer[member.id] then return false,"Someone in your party is already queued." end
        table.insert(users,{id=member.id,name=member.name,colorIndex=member.colorIndex})
    end
    for _,member in ipairs(party.members) do self.errors[member.id]=nil end
    local group={id=Http:GenerateGUID(false),users=users,seats=party.seats,job=game.JobId,updated=os.time(),joined=os.time(),status="Searching for a "..party.seats.."-player match…"}
    self.groups[group.id]=group
    for _,user in ipairs(users) do self.byPlayer[user.id]=group.id end
    if not self.localMode then
        local ok=pcall(function() self.maps[group.seats]:SetAsync(group.id,group,90,group.joined) end)
        if not ok then self:clear(group);return false,"Roblox matchmaking is temporarily unavailable. Please try again." end
        if group.cancelled then pcall(function() self.maps[group.seats]:RemoveAsync(group.id) end);return false,"Queue entry was cancelled." end
    end
    self.callbacks.changed()
    return true
end
function Matchmaker:cancel(id,force)
    local group=self.groups[self.byPlayer[id]]
    if not group then return true end
    if group.teleporting and force then return true end -- Normal departure into the reserved match.
    if not self.localMode then
        local ok,record=pcall(function() return self.maps[group.seats]:GetAsync(group.id) end)
        if not ok and not force then return false,"Could not reach the queue. Try cancel again." end
        if record and (record.matchId or ((record.claimUntil or 0)&gt;os.time())) and not force and not group.failed then
            return false,"Your match is connecting. Please wait for the teleport."
        end
        pcall(function()
            self.maps[group.seats]:UpdateAsync(group.id,function(current,sort)
                if current then current.cancelled=true;return current,sort end
                return nil
            end,10)
        end)
    end
    group.cancelled=true;self:clear(group);self.callbacks.changed();return true
end
function Matchmaker:remove(id)
    local group=self.groups[self.byPlayer[id]]
    if not group then return end
    if group.teleporting then
        self.byPlayer[id]=nil
        local present=false
        for _,user in ipairs(group.users) do if user.id~=id and Players:GetPlayerByUserId(user.id) then present=true end end
        if not present then
            self.groups[group.id]=nil
            if not self.localMode then pcall(function() self.maps[group.seats]:RemoveAsync(group.id) end) end
        end
    else self:cancel(id,true) end
end
function Matchmaker:matchLive(seats)
    local map=self.maps[seats]
    local entries=map:GetRangeAsync(Enum.SortDirection.Ascending,50)
    local selected=Queue.select(entries,seats,os.time())
    if selected then
        Protocol.create(self.config,selected,map,self.tickets,{
            now=os.time,guid=function() return Http:GenerateGUID(false) end,
            reserve=function() return Teleport:ReserveServerAsync(game.PlaceId) end,
        })
    end
end
function Matchmaker:teleportGroup(group,ticket)
    if group.teleporting or group.failed or (group.retryAt and os.clock()&lt;group.retryAt) then return end
    local members={}
    for _,user in ipairs(group.users) do
        local player=Players:GetPlayerByUserId(user.id)
        if player then table.insert(members,player) end
    end
    if #members==0 then self:clear(group);return end
    group.teleporting=true;group.attempts=(group.attempts or 0)+1
    group.status="Match found! Connecting "..#members.." player(s)…"
    self.callbacks.changed()
    local options=Instance.new("TeleportOptions")
    options.ReservedServerAccessCode=ticket.code
    options:SetTeleportData({citymoneyMatch=ticket.id})
    local ok=pcall(function() Teleport:TeleportAsync(game.PlaceId,members,options) end)
    if not ok then
        group.teleporting=false;group.retryAt=os.clock()+3;group.failed=group.attempts&gt;=3
        group.status=group.failed and "Could not connect. Cancel the queue and try again." or "Connecting failed. Retrying your match…"
        self.callbacks.changed()
    end
end
function Matchmaker:tickLive()
    for id,group in pairs(self.groups) do
        if not group.cancelled and not group.teleporting then
            local record=self.maps[group.seats]:GetAsync(id)
            if record and record.matchId then
                local ticket=self.tickets:GetAsync(record.matchId)
                if ticket and ticket.status=="ready" then self:teleportGroup(group,ticket)
                else Protocol.recover(self.maps[group.seats],id,record,ticket,os.time()) end
            elseif record and not record.cancelled then
                if os.time()-(group.heartbeat or 0)&gt;15 then
                    group.heartbeat=os.time()
                    self.maps[group.seats]:UpdateAsync(id,function(current,sort)
                        if current and not current.cancelled and not current.matchId then current.updated=os.time();return current,sort end
                        return nil
                    end,90)
                end
            else
                group.status="Queue entry expired. Please queue again."
                self:clear(group);self.callbacks.changed()
            end
        end
    end
    self:matchLive(2);self:matchLive(4)
end
function Matchmaker:tickLocal()
    if not self.callbacks.canStart() then return end
    local entries={}
    for id,group in pairs(self.groups) do group.updated=os.time();table.insert(entries,{key=id,value=group}) end
    table.sort(entries,function(a,b) return a.value.joined&lt;b.value.joined or (a.value.joined==b.value.joined and a.key&lt;b.key) end)
    for _,seats in ipairs({2,4}) do
        local selected=Queue.select(entries,seats,os.time())
        if selected then
            local roster=Queue.roster(selected,#self.config.playerColors)
            local ok=self.callbacks.start(roster,{attackMode="destroy"})
            if ok then for _,entry in ipairs(selected) do self:clear(entry.value) end;self.callbacks.changed() end
            return
        end
    end
end
function Matchmaker:backToLobby(player)
    if self.localMode then return false,"This is a Studio local test. Stop/restart Play to return to the test lobby." end
    local options=Instance.new("TeleportOptions")
    options:SetTeleportData({citymoneyReturn=true})
    local ok=pcall(function() Teleport:TeleportAsync(game.PlaceId,{player},options) end)
    return ok,if ok then nil else "Could not return to the lobby. Please try again."
end
function Matchmaker:playerAdded(player)
    local ok,join=pcall(function() return player:GetJoinData() end)
    if not ok then join={} end
    local transfer=type(join.TeleportData)=="table" and join.TeleportData or {}
    if self.reserved then
        local id=transfer.citymoneyMatch
        if type(id)~="string" then self:backToLobby(player);return end
        local success,ticket=pcall(function() return self.tickets:GetAsync(id) end)
        local admitted=false
        if success and ticket and ticket.privateId==game.PrivateServerId and ticket.status=="ready" then
            for _,user in ipairs(ticket.users) do if user.id==player.UserId then admitted=true end end
        end
        if not admitted then self:backToLobby(player);return end
        self.ticket=ticket;self.arrivalDeadline=self.arrivalDeadline or os.clock()+60
        self.callbacks.changed()
        return
    end
    local invite
    if type(join.LaunchData)=="string" and #join.LaunchData&lt;2000 then
        pcall(function() invite=Http:JSONDecode(join.LaunchData) end)
    end
    if type(invite)=="table" and type(invite.citymoneyJob)=="string" and type(invite.leaderId)=="number" then
        if invite.citymoneyJob~=game.JobId and not self.localMode then
            local options=Instance.new("TeleportOptions");options.ServerInstanceId=invite.citymoneyJob
            options:SetTeleportData({citymoneyPartyLeader=invite.leaderId})
            local moved=pcall(function() Teleport:TeleportAsync(game.PlaceId,{player},options) end)
            if moved then return end
        else transfer.citymoneyPartyLeader=invite.leaderId end
    end
    if type(transfer.citymoneyPartyLeader)=="number" then
        local joined,message
        for _=1,6 do
            joined,message=self.callbacks.joinParty(player.UserId,transfer.citymoneyPartyLeader)
            if joined then break end
            task.wait(0.5)
        end
        if not joined then self.errors[player.UserId]=message or "Your friend is no longer available in this lobby.";self.callbacks.changed() end
    end
end
function Matchmaker:tickReserved()
    if self.matchStarted or not self.ticket then return end
    local complete=true
    for _,user in ipairs(self.ticket.users) do if not Players:GetPlayerByUserId(user.id) then complete=false end end
    if complete then
        local ok=self.callbacks.start(self.ticket.users,{attackMode="destroy"})
        if ok then self.matchStarted=true;self.callbacks.changed() end
    elseif self.arrivalDeadline and os.clock()&gt;self.arrivalDeadline then
        self.arrivalDeadline=nil
        for _,player in ipairs(Players:GetPlayers()) do self:backToLobby(player) end
    end
end
function Matchmaker:start()
    task.spawn(function()
        while true do
            task.wait(2)
            local ok=pcall(function()
                if self.reserved then self:tickReserved()
                elseif self.localMode then self:tickLocal()
                else self:tickLive() end
            end)
            if not ok then
                -- Do not print reserved access codes or raw backend errors.
                for _,group in pairs(self.groups) do group.status="Matchmaking service is retrying. Your place in the queue is kept." end
                self.callbacks.changed()
            end
        end
    end)
    game:BindToClose(function()
        for _,group in pairs(self.groups) do
            if not group.teleporting then
                group.cancelled=true
                if not self.localMode then task.spawn(function() pcall(function() self.maps[group.seats]:RemoveAsync(group.id) end) end) end
            end
        end
    end)
end
return Matchmaker
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">World</string>
          <string name="Source">local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local shared = game:GetService("ReplicatedStorage"):WaitForChild("Citymoney")
local Board, Architecture, Scene = require(shared.Board), require(shared.Architecture), require(shared.Scene)
local World = {}
World.__index = World

function World.tilePosition(index)
    return Vector3.new(table.unpack(Board.position(index)))
end

function World.new(config)
    local self = setmetatable({ config=config, tokens={}, positions={}, motions={}, generations={}, propertyViews={}, visiting={} }, World)
    local old = workspace:FindFirstChild("CitymoneyBoard")
    if old then old:Destroy() end
    self.root = Instance.new("Folder")
    self.root.Name, self.root.Parent = "CitymoneyBoard", workspace
    -- Parcel geometry is replaced independently on purchase, repaint and upgrade.
    local entries = {}
    for _, entry in ipairs(Board.generate(config)) do
        if not (entry.tileIndex and config.tiles[entry.tileIndex].kind == "property" and entry.name ~= "Tile"..entry.tileIndex and entry.name ~= "DistrictInlay") then
            table.insert(entries, entry)
        end
    end
    Scene.populate(entries, self.root)
    for index, tile in ipairs(config.tiles) do
        if tile.kind == "property" then self.propertyViews[index] = { key="", model=nil } end
    end
    return self
end

function World:cancelMotion(id)
    self.generations[id] = (self.generations[id] or 0) + 1
    local motion = self.motions[id]
    if motion then
        motion.connection:Disconnect()
        motion.tween:Cancel()
        motion.value:Destroy()
        self.motions[id] = nil
    end
end

function World:tokenFrame(index, seat, model)
    local position = World.tilePosition(index)
    local x, z = ((seat-1)%3-1)*2.2, math.floor((seat-1)/3)*2.2-1
    local humanoid = model and model:FindFirstChildOfClass("Humanoid")
    local root = model and model:FindFirstChild("HumanoidRootPart")
    local height = humanoid and root and (humanoid.HipHeight+root.Size.Y/2+0.2) or 2.3
    return CFrame.new(position + Vector3.new(x, height, z)) * CFrame.Angles(0, math.rad(-35), 0)
end

function World:figure(resident)
    local tint = self.config.playerColors[resident.colorIndex]
    local origin = { 0,0,0 }
    local parts = {
        { name="Torso", size={1.4,1.5,0.8}, position={0,0,0}, color=tint },
        { name="Head", size={1,1,1}, position={0,1.25,0}, color="E7C8A2", shape="Ball" },
        { name="Hair", size={1.1,0.4,1.05}, position={0,1.65,0}, color="4D4B47" },
        { name="LeftLeg", size={0.5,1.1,0.65}, position={-0.4,-1.25,0}, color="394E52" },
        { name="RightLeg", size={0.5,1.1,0.65}, position={0.4,-1.25,0}, color="394E52" },
        { name="LeftArm", size={0.4,1.4,0.6}, position={-0.95,0,0}, color=tint },
        { name="RightArm", size={0.4,1.4,0.6}, position={0.95,0,0}, color=tint },
        { name="Briefcase", size={0.8,0.7,0.3}, position={1.2,-0.7,0}, color="A58E6F" },
    }
    local model = Scene.model(parts,"Figure_"..resident.id,self.root)
    model.PrimaryPart = model:FindFirstChild("Torso")
    model:PivotTo(CFrame.new(table.unpack(origin)))
    return model
end

function World:prepareCharacter(player, character)
    local humanoid = character:WaitForChild("Humanoid", 10)
    local root = character:WaitForChild("HumanoidRootPart", 10)
    if not humanoid or not root or player.Character ~= character then return end
    if not character:GetAttribute("CitymoneyScaled") then
        pcall(function() character:ScaleTo(0.72) end)
        character:SetAttribute("CitymoneyScaled", true)
    end
    humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
    if self.visiting[player.UserId] then
        self:visit(player, self.visiting[player.UserId])
    else
        humanoid.WalkSpeed, humanoid.AutoRotate, root.Anchored = 0, false, true
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
    end
    if self.state then self:sync(self.state) end
end

function World:visitorList()
    local list = {}
    for id, tile in pairs(self.visiting) do table.insert(list,{ id=id, tile=tile }) end
    return list
end

function World:visit(player, index)
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not humanoid or not root then return false, "Your avatar is still loading." end
    self:cancelMotion(player.UserId)
    self.visiting[player.UserId] = index
    local position, yaw = Architecture.porch(index)
    root.Anchored, humanoid.WalkSpeed, humanoid.AutoRotate = false, 12, true
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = part==root or part.Name=="Torso" or part.Name=="UpperTorso" or part.Name=="LowerTorso"
        end
    end
    humanoid.JumpPower = 32
    root.AssemblyLinearVelocity, root.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
    character:PivotTo(CFrame.new(position[1],position[2]+humanoid.HipHeight+root.Size.Y/2,position[3]) * CFrame.Angles(0,yaw,0))
    return true
end

function World:endVisit(id)
    if not self.visiting[id] then return end
    self.visiting[id] = nil
    local model = self.tokens[id]
    if model and model.Parent then
        local humanoid, root = model:FindFirstChildOfClass("Humanoid"), model:FindFirstChild("HumanoidRootPart")
        if humanoid and root then humanoid.WalkSpeed, humanoid.AutoRotate, root.Anchored = 0, false, true end
        for _, part in ipairs(model:GetDescendants()) do if part:IsA("BasePart") then part.CanCollide=false end end
        local seat = 1
        for index, resident in ipairs(self.state and self.state.players or {}) do if resident.id==id then seat=index end end
        model:PivotTo(self:tokenFrame(self.positions[id] or 1,seat,model))
    end
end

function World:wireDoor(model, ownerId)
    local door = model:FindFirstChild("Door")
    if not door then return end
    local prompt = Instance.new("ProximityPrompt")
    prompt.ActionText, prompt.ObjectText, prompt.HoldDuration = "Open / close", "Your front door", 0
    prompt.MaxActivationDistance, prompt.RequiresLineOfSight, prompt.Parent = 8, false, door
    local pieces = {}
    local hinge = door.CFrame * CFrame.new(-door.Size.X/2,0,0)
    for _, name in ipairs({ "Door", "DoorGlass", "Doorknob" }) do
        local object=model:FindFirstChild(name)
        if object then table.insert(pieces,{ object=object, offset=hinge:ToObjectSpace(object.CFrame) }) end
    end
    local opened, busy = false, false
    prompt.Triggered:Connect(function(player)
        if player.UserId ~= ownerId or busy or not model.Parent then return end
        busy, opened = true, not opened
        for _, piece in ipairs(pieces) do
            piece.object.CanCollide = not opened and piece.object==door
            TweenService:Create(piece.object,TweenInfo.new(0.35,Enum.EasingStyle.Quad),
                { CFrame=hinge*CFrame.Angles(0,opened and math.rad(105) or 0,0)*piece.offset }):Play()
        end
        task.delay(0.4,function() busy=false end)
    end)
end

function World:sync(state)
    self.state = state
    -- Buying immediately constructs a complete home, including its owner's sign.
    for index, view in pairs(self.propertyViews) do
        local property = state.properties[index]
        local key = tostring(property.ownerId)..":"..property.level..":"..(property.paint or 0)
        if key ~= view.key then
            view.key = key
            if view.model then view.model:Destroy() end
            local owner
            for _, resident in ipairs(state.players) do if resident.id==property.ownerId then owner=resident end end
            local entries = Architecture.property(self.config,index,owner and owner.name or false,
                owner and self.config.playerColors[owner.colorIndex] or "A6B4A0",property.level,property.paint or 0)
            view.model = Scene.model(entries,"Property"..index,self.root)
            view.model:SetAttribute("TileIndex",index)
            view.model:SetAttribute("OwnerId",owner and owner.id or false)
            view.model:SetAttribute("OwnerName",owner and owner.name or "For sale")
            view.model:SetAttribute("OwnerColor",owner and self.config.playerColors[owner.colorIndex] or "DCC098")
            view.effectsKey=nil
            if owner then
                self:wireDoor(view.model,owner.id)
                local glow=Instance.new("Highlight")
                glow.FillTransparency,glow.OutlineColor,glow.OutlineTransparency=1,Color3.fromHex(self.config.playerColors[owner.colorIndex]),0.1
                glow.Adornee,glow.Parent=view.model,view.model
                TweenService:Create(glow,TweenInfo.new(1.1),{OutlineTransparency=1}):Play()
                task.delay(1.2,function() glow:Destroy() end)
            end
            for id, visitingIndex in pairs(self.visiting) do
                if visitingIndex==index then
                    local visitor=Players:GetPlayerByUserId(id)
                    if owner and owner.id==id and visitor then self:visit(visitor,index) else self:endVisit(id) end
                end
            end
        end
        local effectsKey=tostring(property.shield)..":"..(property.boost or 0)..":"..(property.rentTier or 1)
        if view.model and view.effectsKey~=effectsKey then
            view.effectsKey=effectsKey
            for _,name in ipairs({"ProtectionSign","RentBoostSign","RentRateSign"}) do
                local sign=view.model:FindFirstChild(name)
                if sign then sign:Destroy() end
            end
            local owner
            for _,entry in ipairs(state.players) do if entry.id==property.ownerId then owner=entry end end
            if owner then
                local effects={}
                for _,entry in ipairs(Architecture.property(self.config,index,owner.name,self.config.playerColors[owner.colorIndex],property.level,property.paint or 0,property)) do
                    if entry.name=="ProtectionSign" or entry.name=="RentBoostSign" or entry.name=="RentRateSign" then table.insert(effects,entry) end
                end
                Scene.populate(effects,view.model)
            end
        end
    end
    local present = {}
    for seat, resident in ipairs(state.players) do
        present[resident.id] = true
        local player = type(resident.id)=="number" and Players:GetPlayerByUserId(resident.id) or nil
        local character = player and player.Character
        if character and not character:FindFirstChild("HumanoidRootPart") then character=nil end
        local model = self.tokens[resident.id]
        if character and model~=character then
            self:cancelMotion(resident.id)
            if model and model:GetAttribute("GeneratedFigure") then model:Destroy() end
            model, self.tokens[resident.id], self.positions[resident.id] = character, character, nil
        elseif not model or not model.Parent then
            model = self:figure(resident)
            model:SetAttribute("GeneratedFigure",true)
            self.tokens[resident.id], self.positions[resident.id] = model, nil
        end
        local tag = model:FindFirstChild("ResidentTag")
        if not tag then
            tag=Instance.new("BillboardGui")
            tag.Name, tag.Size, tag.StudsOffset, tag.AlwaysOnTop, tag.MaxDistance = "ResidentTag", UDim2.fromOffset(100,22),Vector3.new(0,3.5,0),true,500
            tag.Adornee, tag.Parent = model:FindFirstChild("Head") or model.PrimaryPart, model
            local label=Instance.new("TextLabel")
            label.Size,label.BackgroundTransparency,label.TextSize,label.Font = UDim2.fromScale(1,1),1,12,Enum.Font.GothamBold
            label.TextColor3,label.TextStrokeTransparency,label.Parent = Color3.fromHex("FFFFFF"),0.5,tag
        end
        local active = state.status=="playing" and state.players[state.turn].id==resident.id
        tag.TextLabel.Text = (active and "▸ " or "")..resident.name
        tag.TextLabel.TextColor3=Color3.fromHex(self.config.playerColors[resident.colorIndex])
        tag.Enabled = resident.alive
        if not model:FindFirstChild("PlayerColorRing") then
            local root=model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
            local humanoid=model:FindFirstChildOfClass("Humanoid")
            if root then
                local ring=Instance.new("Part")
                ring.Name,ring.Shape,ring.Size="PlayerColorRing",Enum.PartType.Cylinder,Vector3.new(0.12,3.6,3.6)
                ring.Color,ring.Transparency=Color3.fromHex(self.config.playerColors[resident.colorIndex]),0.18
                ring.CanCollide,ring.CanTouch,ring.CanQuery,ring.Massless=false,false,false,true
                local offset=humanoid and (humanoid.HipHeight+root.Size.Y/2) or 2.1
                ring.CFrame=root.CFrame*CFrame.new(0,-offset+0.06,0)*CFrame.Angles(0,0,math.pi/2)
                ring.Parent=model
                local weld=Instance.new("WeldConstraint");weld.Part0,weld.Part1,weld.Parent=root,ring,ring
            end
        end
        local colorRing=model:FindFirstChild("PlayerColorRing")
        if colorRing then colorRing.Color=Color3.fromHex(self.config.playerColors[resident.colorIndex]);colorRing.Transparency=resident.alive and 0.18 or 1 end
        if model:GetAttribute("GeneratedFigure") then
            for _,name in ipairs({"Torso","LeftArm","RightArm"}) do
                local part=model:FindFirstChild(name)
                if part then part.Color=Color3.fromHex(self.config.playerColors[resident.colorIndex]) end
            end
        end
        if self.visiting[resident.id] and (not resident.alive or state.status~="playing") then self:endVisit(resident.id) end
        if not self.visiting[resident.id] then
            local old = self.positions[resident.id]
            if old~=resident.position then
                self:cancelMotion(resident.id)
                self.positions[resident.id] = resident.position
                local generation = self.generations[resident.id]
                local destination, detained = resident.position, resident.detained
                task.spawn(function()
                    if self.generations[resident.id]~=generation or not model.Parent then return end
                    local steps=old and (destination-old)%#self.config.tiles or 0
                    if not old or detained or steps&gt;12 then model:PivotTo(self:tokenFrame(destination,seat,model)); return end
                    for step=1,steps do
                        if self.generations[resident.id]~=generation or not model.Parent then return end
                        local value=Instance.new("CFrameValue")
                        value.Value=model:GetPivot()
                        local target=self:tokenFrame((old+step-1)%#self.config.tiles+1,seat,model)
                        local connection=value.Changed:Connect(function(frame) if model.Parent then model:PivotTo(frame) end end)
                        local tween=TweenService:Create(value,TweenInfo.new(0.18,Enum.EasingStyle.Sine),{Value=target})
                        self.motions[resident.id]={ value=value, connection=connection, tween=tween }
                        tween:Play(); tween.Completed:Wait()
                        if self.generations[resident.id]~=generation then return end
                        connection:Disconnect(); value:Destroy(); self.motions[resident.id]=nil
                    end
                end)
            end
        end
    end
    for id, model in pairs(self.tokens) do
        if not present[id] then
            self:cancelMotion(id)
            if model:GetAttribute("GeneratedFigure") then model:Destroy()
            elseif model.Parent then
                local tag=model:FindFirstChild("ResidentTag");if tag then tag.Enabled=false end
                local ring=model:FindFirstChild("PlayerColorRing");if ring then ring.Transparency=1 end
                model:PivotTo(CFrame.new(0,5,42))
            end
            self.tokens[id],self.positions[id],self.visiting[id] = nil,nil,nil
        end
    end
    local event=state.lastAction
    if not event then self.lastActionSeq=0
    elseif event.seq~=self.lastActionSeq then
        self.lastActionSeq=event.seq
        local site=Architecture.site(event.tile)
        local position=Vector3.new(table.unpack(site))
        local pulse=Instance.new("Part")
        pulse.Name,pulse.Shape,pulse.Size="TacticalEffect",Enum.PartType.Ball,Vector3.new(2,2,2)
        pulse.Position,pulse.Anchored,pulse.CanCollide,pulse.CanQuery=position+Vector3.new(0,3,0),true,false,false
        pulse.Color=Color3.fromHex(event.blocked and "9AC5DE" or (event.kind=="demolish" and "D5B18B" or "9FCAAC"))
        pulse.Transparency,pulse.Parent=0.2,self.root
        TweenService:Create(pulse,TweenInfo.new(0.8),{Size=Vector3.new(12,7,12),Transparency=1,Position=position+Vector3.new(0,6,0)}):Play()
        task.delay(0.9,function() pulse:Destroy() end)
    end
end
return World
</string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="23">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="24">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="25">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="26">
        <Properties>
          <string name="Name">CitymoneyClient</string>
          <string name="Source">local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Input = game:GetService("UserInputService")
local Lighting = game:GetService("Lighting")
local StarterGui = game:GetService("StarterGui")
local player = Players.LocalPlayer
local shared = RS:WaitForChild("Citymoney")
local Config, Architecture, Scene, Layout = require(shared.Config),require(shared.Architecture),require(shared.Scene),require(shared.Layout)
local Plans=require(shared.PropertyPlans)
local Menus=require(script:WaitForChild("Menus"))
local remotes=shared:WaitForChild("Remotes")
local action,snapshot,feedback=remotes:WaitForChild("Action"),remotes:WaitForChild("Snapshot"),remotes:WaitForChild("Feedback")
-- The default chat and player-list panels obscured the old game HUD.
task.spawn(function()
    for _=1,8 do
        local ok=pcall(function()
            for _, kind in ipairs({Enum.CoreGuiType.Chat,Enum.CoreGuiType.PlayerList,Enum.CoreGuiType.Backpack,Enum.CoreGuiType.Health}) do StarterGui:SetCoreGuiEnabled(kind,false) end
        end)
        if ok then break end
        task.wait(0.5)
    end
end)
local C={ card=Color3.fromHex("FAF7EF"),paper=Color3.fromHex("EFEBDD"),ink=Color3.fromHex("2E443A"),muted=Color3.fromHex("798579"),
    line=Color3.fromHex("DDDCCF"),green=Color3.fromHex("3E6C57"),gold=Color3.fromHex("DCC098"),mint=Color3.fromHex("DCE8DA"),red=Color3.fromHex("B66758"),white=Color3.new(1,1,1) }
local gui=Instance.new("ScreenGui")
gui.Name,gui.ResetOnSpawn,gui.IgnoreGuiInset,gui.ZIndexBehavior="Citymoney",false,false,Enum.ZIndexBehavior.Sibling
gui.Parent=player:WaitForChild("PlayerGui")
local safe=Instance.new("Frame")
safe.Size,safe.BackgroundTransparency,safe.Parent=UDim2.fromScale(1,1),1,gui
local root=Instance.new("Frame")
root.BackgroundTransparency,root.Parent=1,safe
local uiScale=Instance.new("UIScale"); uiScale.Parent=root
local function round(object,radius)
    local value=Instance.new("UICorner");value.CornerRadius,value.Parent=UDim.new(0,radius or 15),object
end
local function place(object,x,y,w,h) object.Position,object.Size=UDim2.fromOffset(x,y),UDim2.fromOffset(w,h) end
local function frame(parent,x,y,w,h,tint)
    local object=Instance.new("Frame");place(object,x,y,w,h)
    object.BackgroundColor3,object.BorderSizePixel,object.Parent=tint or C.card,0,parent
    round(object)
    local stroke=Instance.new("UIStroke");stroke.Color,stroke.Transparency,stroke.Parent=C.line,0.2,object
    return object
end
local function text(parent,value,x,y,w,h,size,tint,bold)
    local object=Instance.new("TextLabel");place(object,x,y,w,h)
    object.BackgroundTransparency,object.Text,object.TextColor3=1,value,tint or C.ink
    object.TextSize,object.Font=size or 16,bold and Enum.Font.GothamBold or Enum.Font.Gotham
    object.TextXAlignment,object.TextYAlignment,object.TextWrapped=Enum.TextXAlignment.Left,Enum.TextYAlignment.Center,true
    object.Parent=parent;return object
end
local function button(parent,value,x,y,w,h,tint,callback)
    local object=Instance.new("TextButton");place(object,x,y,w,h)
    object.Text,object.TextSize,object.Font=value,14,Enum.Font.GothamBold
    object.BackgroundColor3,object.TextColor3,object.BorderSizePixel=tint or C.green,tint==C.paper and C.ink or C.white,0
    object.Parent=parent;round(object,11)
    object.Activated:Connect(function() if object.Active then callback() end end)
    return object
end
local function available(object,enabled,tint)
    object.Active,object.AutoButtonColor=enabled,enabled
    object.BackgroundColor3=enabled and tint or C.paper
    object.TextColor3=enabled and (tint==C.paper and C.ink or C.white) or C.muted
end
local function truncate(object) object.TextWrapped,object.TextTruncate=false,Enum.TextTruncate.AtEnd end
local data,selected,focusIndex,mainCommand,visitIndex,layout
local inspectorOpen,portfolioOpen,rolling,locked=false,false,false,false
local notify,render,requestSale,openPlans,renderPlans,mainAction,menus
local function send(command,index,level,expectedTurn)
    if locked or (rolling and command~="Return") then return false end
    locked=true;action:FireServer(command,index,level,expectedTurn)
    task.delay(0.22,function() locked=false end)
    return true
end
